      <!-- ========================================== -->
      <h2>Customization Patterns</h2>
      <!-- ========================================== -->

      <h3 style="font-size: 0.875rem; font-weight: 600; margin: calc(var(--n-space) * 6) 0 calc(var(--n-space) * 2); color: var(--n-ink-strong-neutral);">State-conditional intent</h3>
      <n-text size="sm" muted spacing="tight">
        Override <code>--n-*</code> locals in a state selector to change intent on hover, focus, etc.
      </n-text>
      <pre style="font-size: 0.75rem; background: var(--n-panel-neutral); border: 1px solid var(--n-border-muted-neutral); border-radius: var(--n-radius); padding: calc(var(--n-space) * 3); overflow-x: auto; margin-bottom: calc(var(--n-space) * 6); color: var(--n-ink-neutral);"><code set:html={stateIntentCSS} /></pre>

      <h3 style="font-size: 0.875rem; font-weight: 600; margin: calc(var(--n-space) * 6) 0 calc(var(--n-space) * 2); color: var(--n-ink-strong-neutral);">Debug state attributes (<code>force-*</code>)</h3>
      <n-text size="sm" muted spacing="tight">
        Every pseudo-state with a visual effect has a <code>force-*</code> attribute mirror for DevTools debugging and state demos.
        Add the attribute to the host element to simulate the pseudo-state.
      </n-text>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head>
          <n-table-row>
            <n-table-header>Pseudo</n-table-header>
            <n-table-header>Attribute</n-table-header>
            <n-table-header>Components</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>:hover</code></n-table-cell>
            <n-table-cell><code>[force-hover]</code></n-table-cell>
            <n-table-cell>All interactive components + n-card[interactive]</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>:active</code></n-table-cell>
            <n-table-cell><code>[force-active]</code></n-table-cell>
            <n-table-cell>n-button, n-option, n-command-item, n-tab, n-segment</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>:focus</code></n-table-cell>
            <n-table-cell><code>[force-focus]</code></n-table-cell>
            <n-table-cell>n-input, n-textarea, n-input-otp</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>:focus-visible</code></n-table-cell>
            <n-table-cell><code>[force-focus-visible]</code></n-table-cell>
            <n-table-cell>All components with focus rings</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <pre style="font-size: 0.75rem; background: var(--n-panel-neutral); border: 1px solid var(--n-border-muted-neutral); border-radius: var(--n-radius); padding: calc(var(--n-space) * 3); overflow-x: auto; margin-bottom: calc(var(--n-space) * 6); color: var(--n-ink-neutral);"><code>&lt;!-- Toggle in DevTools to simulate hover --&gt;
&lt;n-button force-hover&gt;Hovered&lt;/n-button&gt;

&lt;!-- Compound states work too --&gt;
&lt;n-checkbox force-hover aria-checked="true"&gt;Checked + Hovered&lt;/n-checkbox&gt;

&lt;!-- Internal children: force-* on host triggers all children --&gt;
&lt;n-calendar force-hover&gt;...&lt;/n-calendar&gt;</code></pre>

      <h3 style="font-size: 0.875rem; font-weight: 600; margin: calc(var(--n-space) * 6) 0 calc(var(--n-space) * 2); color: var(--n-ink-strong-neutral);">Scoped intent override</h3>
      <n-text size="sm" muted spacing="tight">
        Override locals on a container to affect all children.
      </n-text>
