---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  events: `&lt;!-- Listening to component events --&gt;
&lt;n-button id="my-btn"&gt;Click me&lt;/n-button&gt;
&lt;script&gt;
  document.getElementById('my-btn')
    .addEventListener('native:press', (e) =&gt; {
      console.log('Button pressed');
    });
&lt;/script&gt;

&lt;n-input id="name"&gt;&lt;/n-input&gt;
&lt;script&gt;
  document.getElementById('name')
    .addEventListener('native:change', (e) =&gt; {
      console.log('Value:', e.detail.value);
    });
&lt;/script&gt;`,
  formAssociation: `&lt;!-- Form-associated components work with native forms --&gt;
&lt;form&gt;
  &lt;n-field label="Email" required&gt;
    &lt;n-input name="email" placeholder="you@example.com"&gt;&lt;/n-input&gt;
  &lt;/n-field&gt;

  &lt;n-field label="Role"&gt;
    &lt;n-select name="role" placeholder="Choose..."
      options='[{"value":"admin","label":"Admin"},{"value":"user","label":"User"}]'&gt;
    &lt;/n-select&gt;
  &lt;/n-field&gt;

  &lt;n-button type="submit" variant="primary"&gt;Submit&lt;/n-button&gt;
&lt;/form&gt;`,
};
const rangeSelectDetail = `{ start, end }`;
const slideChangeDetail = `{ index, slide }`;
const stateIntentCSS = `/* Neutral button \u2192 accent on hover */
n-button.cta:hover {
  --n-ink:        var(--n-ink-accent);
  --n-ink-strong: var(--n-ink-strong-accent);
  --n-surface:    var(--n-surface-accent);
  --n-panel:      var(--n-panel-accent);
  --n-border:     var(--n-border-accent);
}

/* Danger intent on focus (e.g. delete confirmation) */
n-button.danger-focus:focus-visible {
  --n-ink:        var(--n-ink-danger);
  --n-surface:    var(--n-surface-danger);
}`;
const scopedIntentCSS = `/* All controls inside .danger-zone get danger colors */
.danger-zone {
  --n-ink:           var(--n-ink-danger);
  --n-ink-strong:    var(--n-ink-strong-danger);
  --n-surface:       var(--n-surface-danger);
  --n-border:        var(--n-border-danger);
  --n-border-muted:  var(--n-border-muted-danger);
}`;
