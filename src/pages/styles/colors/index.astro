---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';

const codeExamples = {
  example: `/* ── Color Environment Parameters ── */
:root {
  --color-env-lightness-min: 0.25;
  --color-env-lightness-max: 0.98;
  --color-env-chroma: 0.15;
  --color-env-alpha: 0.5;
}

/* ── Per-Family Hue Override ── */
:root {
  --color-env-hue-accent: 250;
  --color-env-hue-success: 145;
  --color-env-hue-danger: 25;
}

/* ── Using Semantic Tokens ── */
.card {
  background: var(--n-panel-accent);
  color: var(--n-ink-accent);
  border: 1px solid var(--n-border-muted-accent);
}

.surface-fill {
  background: var(--n-surface-accent);
  color: var(--n-surface-ink-accent);
}`,
};
---
<SidebarLayout title="Colors">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Colors</h1>
      </div>
    </div>
    <div slot="description">

      Interactive color environment explorer. Adjust global and per-family parameters to see live changes across all tokens.

    </div>
    <div slot="actions">
      <n-select id="export-select" size="sm" variant="outline" placeholder="Export Colors">
        <n-listbox popover="auto">
          <n-option value="figma-computed">Figma (computed)</n-option>
          <n-option value="figma-all">Figma (computed + semantic)</n-option>
          <n-option value="css-computed">CSS (computed)</n-option>
          <n-option value="css-all">CSS (computed + semantic)</n-option>
        </n-listbox>
      </n-select>
      <n-select id="theme-select" size="sm" variant="outline" placeholder="Theme">
        <n-listbox popover="auto">
          <n-option value="">Default</n-option>
          <n-option value="forest">Forest</n-option>
          <n-option value="rose">Rose</n-option>
          <n-option value="zinc">Zinc</n-option>
        </n-listbox>
      </n-select>
      <n-select id="scheme-select" size="sm" variant="outline" placeholder="Scheme">
        <n-listbox popover="auto">
          <n-option value="system">System</n-option>
          <n-option value="light">Light</n-option>
          <n-option value="dark">Dark</n-option>
        </n-listbox>
      </n-select>
    </div>
  </header>
  <section>
    <n-container data-kind="panel" bordered>
      <pre class="code-block"><code set:html={codeExamples.example} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <native-design></native-design>
  </section>

  <script>
    import '@nonoun/native-design';
    import { exportCss, exportFigma } from './colors-export.ts';

    document.addEventListener('astro:page-load', () => {
      const sel = document.getElementById('export-select');
      if (!sel) return;

      // ── Export select ──
      sel.addEventListener('native:change', (e: Event) => {
        const v = (e as CustomEvent).detail.value;
        if (!v) return;
        switch (v) {
          case 'figma-computed': exportFigma('computed'); break;
          case 'figma-all':      exportFigma('all'); break;
          case 'css-computed':   exportCss('computed'); break;
          case 'css-all':        exportCss('all'); break;
        }
        (sel as HTMLElement & { value: string }).value = '';
      });

      // ── Theme select ──
      const themeSel = document.getElementById('theme-select');
      themeSel?.addEventListener('native:change', (e: Event) => {
        const val = (e as CustomEvent).detail.value;
        const root = document.documentElement;
        if (val) {
          root.setAttribute('theme', val);
        } else {
          root.removeAttribute('theme');
        }
      });

      // ── Scheme select ──
      const schemeSel = document.getElementById('scheme-select');
      const storedScheme = localStorage.getItem('color-scheme');
      if (storedScheme) {
        document.documentElement.style.colorScheme = storedScheme;
        (schemeSel as HTMLElement & { value: string }).value = storedScheme;
      }
      schemeSel?.addEventListener('native:change', (e: Event) => {
        const scheme = (e as CustomEvent).detail.value;
        const root = document.documentElement;
        if (scheme === 'system') {
          root.style.removeProperty('colorScheme');
          localStorage.removeItem('color-scheme');
        } else {
          root.style.colorScheme = scheme;
          localStorage.setItem('color-scheme', scheme);
        }
      });
    });
  </script>
</SidebarLayout>
