---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';

const codeExamples = {
  example: `/* ── Color Environment Parameters ── */
:root {
  --color-env-lightness-min: 0.25;
  --color-env-lightness-max: 0.98;
  --color-env-chroma: 0.15;
  --color-env-alpha: 0.5;
}

/* ── Per-Family Hue Override ── */
:root {
  --color-env-hue-accent: 250;
  --color-env-hue-success: 145;
  --color-env-hue-danger: 25;
}

/* ── Using Semantic Tokens ── */
.card {
  background: var(--n-panel-accent);
  color: var(--n-ink-accent);
  border: 1px solid var(--n-border-muted-accent);
}

.surface-fill {
  background: var(--n-surface-accent);
  color: var(--n-surface-ink-accent);
}`,
};
---
<SidebarLayout title="Colors">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Colors</h1>
      </div>
    </div>
    <div slot="description">

      Interactive color environment explorer. Adjust global and per-family parameters to see live changes across all tokens.

    </div>
    <div slot="actions">
      <n-select id="export-select" size="sm" variant="outline" placeholder="Export Colors" density="inline">
        <n-listbox popover="auto">
          <n-option value="all">Export All Tokens (CSS)</n-option>
          <n-option value="computed">Export Computed Colors (CSS)</n-option>
          <n-option value="semantic">Export Semantic Colors (CSS)</n-option>
          <n-option value="figma">Export Figma Variables (JSON)</n-option>
        </n-listbox>
      </n-select>
    </div>
  </header>
  <section>
    <n-container data-kind="panel" bordered>
      <pre class="code-block"><code set:html={codeExamples.example} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <native-design></native-design>
  </section>

  <script>
    import '@nonoun/native-design';
    import { exportCss, exportFigma } from './colors-export.js';

    document.addEventListener('astro:page-load', () => {
      const sel = document.getElementById('export-select');
      if (!sel) return;

      sel.addEventListener('native:change', (e) => {
        const v = /** @type {CustomEvent} */ (e).detail.value;
        if (!v) return;
        if (v === 'figma') {
          exportFigma();
        } else {
          exportCss(v);
        }
        // Reset so the same option can be picked again
        /** @type {any} */ (sel).value = '';
      });
    });
  </script>
</SidebarLayout>
