---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  example: `/* ── Color Environment Parameters ── */
:root {
  --color-env-lightness-min: 0.25;
  --color-env-lightness-max: 0.98;
  --color-env-chroma: 0.15;
  --color-env-alpha: 0.5;
}

/* ── Per-Family Hue Override ── */
:root {
  --color-env-hue-accent: 250;
  --color-env-hue-success: 145;
  --color-env-hue-danger: 25;
}

/* ── Using Semantic Tokens ── */
.card {
  background: var(--n-panel-accent);
  color: var(--n-ink-accent);
  border: 1px solid var(--n-border-muted-accent);
}

.surface-fill {
  background: var(--n-surface-accent);
  color: var(--n-surface-ink-accent);
}`,
};
---
<SidebarLayout title="Colors">
  <main>
    <h1>Colors</h1>
    <p style="color: var(--n-ink-muted-neutral); margin-bottom: 1.5rem;">
      Interactive color environment explorer. Adjust global and per-family parameters to see live changes across all tokens.
    </p>

    <div class="layout-section">
      <pre class="layout-code"><code set:html={codeExamples.example} /><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <native-tokens></native-tokens>
  </main>

  <script>
    import '@nonoun/native-tokens';
  </script>
</SidebarLayout>
