---
import SidebarLayout from '../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Icons">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Icon</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-icon&gt;</span> Phosphor icon element with registry, late-registration, and accessibility support.
          </div>
  </header>

  <section>

    <!-- ── Basic Icons ── -->

    <h2>Basic Icons</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center" gap="3">
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="house"></n-icon>
              <span class="text-xs text-muted"><code>house</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="gear"></n-icon>
              <span class="text-xs text-muted"><code>gear</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="bell"></n-icon>
              <span class="text-xs text-muted"><code>bell</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="magnifying-glass"></n-icon>
              <span class="text-xs text-muted"><code>magnifying-glass</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="heart"></n-icon>
              <span class="text-xs text-muted"><code>heart</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="star"></n-icon>
              <span class="text-xs text-muted"><code>star</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="check"></n-icon>
              <span class="text-xs text-muted"><code>check</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="x"></n-icon>
              <span class="text-xs text-muted"><code>x</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="trash"></n-icon>
              <span class="text-xs text-muted"><code>trash</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="pencil-simple"></n-icon>
              <span class="text-xs text-muted"><code>pencil-simple</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
      </n-stack>
    </n-container>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-container data-kind="panel" bordered>
      <div class="grid">
        <n-stack>
          <span class="col-label">xs (0.75rem)</span>
          <n-icon name="house" size="xs"></n-icon>
        </n-stack>
        <n-stack>
          <span class="col-label">sm (0.875rem)</span>
          <n-icon name="house" size="sm"></n-icon>
        </n-stack>
        <n-stack>
          <span class="col-label">md (1rem, default)</span>
          <n-icon name="house" size="md"></n-icon>
        </n-stack>
        <n-stack>
          <span class="col-label">lg (1.125rem)</span>
          <n-icon name="house" size="lg"></n-icon>
        </n-stack>
        <n-stack>
          <span class="col-label">xl (1.25rem)</span>
          <n-icon name="house" size="xl"></n-icon>
        </n-stack>
      </div>
    </n-container>

    <!-- ── Color Inheritance ── -->

    <h2>Color Inheritance</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center" gap="3">
        <span class="text-accent"><n-icon name="heart"></n-icon> Accent</span>
        <span class="text-success"><n-icon name="check-circle"></n-icon> Success</span>
        <span class="text-warning"><n-icon name="warning"></n-icon> Warning</span>
        <span class="text-danger"><n-icon name="x-circle"></n-icon> Danger</span>
        <span class="text-info"><n-icon name="info"></n-icon> Info</span>
      </n-stack>
    </n-container>

    <!-- ── Accessibility ── -->

    <h2>Accessibility</h2>
    <n-container data-kind="panel" bordered>
      <h3>Decorative (default — aria-hidden="true")</h3>
      <n-stack direction="row" wrap align="center" gap="3">
        <n-icon name="house"></n-icon>
        <span class="text-xs text-muted"><code>&rarr; aria-hidden="true", no role</code></span>
      </n-stack>

      <h3>Meaningful (aria-label present)</h3>
      <n-stack direction="row" wrap align="center" gap="3">
        <n-icon name="check-circle" aria-label="Approved"></n-icon>
        <span class="text-xs text-muted"><code>&rarr; role="img", aria-label="Approved"</code></span>
      </n-stack>
    </n-container>

    <!-- ── Inside Buttons ── -->

    <h2>Inside Buttons</h2>
    <n-container data-kind="panel" bordered intent="accent" size="sm">
      <n-stack direction="row" wrap align="center" gap="3">
        <button variant="primary">
          <n-icon name="plus"></n-icon>
          <span>Add Item</span>
        </button>
        <button variant="secondary">
          <n-icon name="pencil-simple"></n-icon>
          <span>Edit</span>
        </button>
        <button variant="outline">
          <n-icon name="trash"></n-icon>
          <span>Delete</span>
        </button>
        <button variant="ghost" aria-label="Close">
          <n-icon name="x"></n-icon>
        </button>
      </n-stack>
    </n-container>

    <!-- ── Dynamic Name Change ── -->

    <h2>Dynamic Name Change</h2>
    <n-container data-kind="panel" bordered>
      <div class="grid">
        <n-stack>
          <n-icon id="dynamic-icon" name="house" size="xl"></n-icon>
          <select id="icon-picker" style="font-size: 0.75rem; padding: 0.25rem;">
            <option value="house">house</option>
            <option value="gear">gear</option>
            <option value="bell">bell</option>
            <option value="heart">heart</option>
            <option value="star">star</option>
            <option value="magnifying-glass">magnifying-glass</option>
            <option value="check">check</option>
            <option value="x">x</option>
          </select>
        </n-stack>
      </div>
    </n-container>

    <!-- ── Late Registration ── -->

    <h2>Late Registration</h2>
    <n-container data-kind="panel" bordered>
      <n-stack gap="2">
      <span class="text-xs text-muted">
        The icon below has name="late-demo" but the icon hasn't been registered yet.
        Click the button to register it dynamically.
      </span>
      <n-stack direction="row" wrap align="center" gap="3">
        <n-icon id="late-icon" name="late-demo" size="xl"></n-icon>
        <button id="register-btn" variant="secondary" size="sm">Register "late-demo" icon</button>
      </n-stack>
      <div class="log" id="late-log"></div>
      </n-stack>
    </n-container>

    <!-- ── Navigation Icons ── -->

    <h2>Navigation Icons</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center" gap="3">
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="caret-up"></n-icon>
              <span class="text-xs text-muted"><code>caret-up</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="caret-down"></n-icon>
              <span class="text-xs text-muted"><code>caret-down</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="caret-left"></n-icon>
              <span class="text-xs text-muted"><code>caret-left</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="caret-right"></n-icon>
              <span class="text-xs text-muted"><code>caret-right</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="arrow-up"></n-icon>
              <span class="text-xs text-muted"><code>arrow-up</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="arrow-down"></n-icon>
              <span class="text-xs text-muted"><code>arrow-down</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="arrow-left"></n-icon>
              <span class="text-xs text-muted"><code>arrow-left</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
        <div class="icon-card-wrap">
          <n-container inline padding="tight"><n-body>
            <n-stack align="center" gap="1">
              <n-icon name="arrow-right"></n-icon>
              <span class="text-xs text-muted"><code>arrow-right</code></span>
            </n-stack>
          </n-body></n-container>
        </div>
      </n-stack>
    </n-container>
  </section>

  <script>
import { logPrepend } from '../scripts/event-log';
import { registerIcon } from '@nonoun/native-ui';

document.addEventListener('astro:page-load', () => {
  const dynamicIcon = document.getElementById('dynamic-icon');
  if (!dynamicIcon) return;

  // ── Dynamic name change ──

  const iconPicker = document.getElementById('icon-picker');
  iconPicker?.addEventListener('change', () => {
    dynamicIcon.setAttribute('name', iconPicker?.value ?? 'house');
  });

  // ── Late registration demo ──

  const registerBtn = document.getElementById('register-btn');
  const lateLog = document.getElementById('late-log');

  function log(msg) {
    logPrepend(lateLog, msg);
  }

  log('n-icon[name="late-demo"] created — icon not yet registered, renders empty.');

  registerBtn?.addEventListener('click', () => {
    registerIcon('late-demo', '<svg viewBox="0 0 256 256" fill="currentColor"><path d="M229.66,77.66l-128,128a8,8,0,0,1-11.32,0l-56-56a8,8,0,0,1,11.32-11.32L96,188.69,218.34,66.34a8,8,0,0,1,11.32,11.32Z"/></svg>');
    log('registerIcon("late-demo", ...) called — icon should now appear!');
    if (registerBtn) registerBtn.disabled = true;
  });
});
  </script>
  <style is:global>
    .icon-card-wrap {
      min-width: 5rem;
    }
</style>

</SidebarLayout>
