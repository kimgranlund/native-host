---
import SidebarLayout from '../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Icons">
  <main>
<h1>&lt;n-icon&gt;</h1>
    <n-text size="md" muted spacing="relaxed">
      Phosphor icon element with registry, late-registration, and accessibility support.
    </n-text>

    <!-- ── Basic Icons ── -->

    <h2>Basic Icons</h2>
    <n-panel bordered>
      <div class="icon-row">
        <div class="icon-card">
          <n-icon name="house"></n-icon>
          <span class="icon-card-label">house</span>
        </div>
        <div class="icon-card">
          <n-icon name="gear"></n-icon>
          <span class="icon-card-label">gear</span>
        </div>
        <div class="icon-card">
          <n-icon name="bell"></n-icon>
          <span class="icon-card-label">bell</span>
        </div>
        <div class="icon-card">
          <n-icon name="magnifying-glass"></n-icon>
          <span class="icon-card-label">magnifying-glass</span>
        </div>
        <div class="icon-card">
          <n-icon name="heart"></n-icon>
          <span class="icon-card-label">heart</span>
        </div>
        <div class="icon-card">
          <n-icon name="star"></n-icon>
          <span class="icon-card-label">star</span>
        </div>
        <div class="icon-card">
          <n-icon name="check"></n-icon>
          <span class="icon-card-label">check</span>
        </div>
        <div class="icon-card">
          <n-icon name="x"></n-icon>
          <span class="icon-card-label">x</span>
        </div>
        <div class="icon-card">
          <n-icon name="trash"></n-icon>
          <span class="icon-card-label">trash</span>
        </div>
        <div class="icon-card">
          <n-icon name="pencil-simple"></n-icon>
          <span class="icon-card-label">pencil-simple</span>
        </div>
      </div>
    </n-panel>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-panel bordered>
      <div class="layout-grid">
        <n-stack>
          <span class="layout-col-label">xs (0.75rem)</span>
          <n-icon name="house" size="xs"></n-icon>
        </n-stack>
        <n-stack>
          <span class="layout-col-label">sm (0.875rem)</span>
          <n-icon name="house" size="sm"></n-icon>
        </n-stack>
        <n-stack>
          <span class="layout-col-label">md (1rem, default)</span>
          <n-icon name="house" size="md"></n-icon>
        </n-stack>
        <n-stack>
          <span class="layout-col-label">lg (1.125rem)</span>
          <n-icon name="house" size="lg"></n-icon>
        </n-stack>
        <n-stack>
          <span class="layout-col-label">xl (1.25rem)</span>
          <n-icon name="house" size="xl"></n-icon>
        </n-stack>
      </div>
    </n-panel>

    <!-- ── Color Inheritance ── -->

    <h2>Color Inheritance</h2>
    <n-panel bordered>
      <div class="icon-row">
        <span style="color: var(--n-ink-accent);">
          <n-icon name="heart"></n-icon> Accent
        </span>
        <span style="color: var(--n-ink-success);">
          <n-icon name="check-circle"></n-icon> Success
        </span>
        <span style="color: var(--n-ink-warning);">
          <n-icon name="warning"></n-icon> Warning
        </span>
        <span style="color: var(--n-ink-danger);">
          <n-icon name="x-circle"></n-icon> Danger
        </span>
        <span style="color: var(--n-ink-info);">
          <n-icon name="info"></n-icon> Info
        </span>
      </div>
    </n-panel>

    <!-- ── Accessibility ── -->

    <h2>Accessibility</h2>
    <n-panel bordered>
      <h3>Decorative (default — aria-hidden="true")</h3>
      <div class="icon-row">
        <n-icon name="house"></n-icon>
        <span style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); font-family: ui-monospace, monospace;">
          → aria-hidden="true", no role
        </span>
      </div>

      <h3>Meaningful (aria-label present)</h3>
      <div class="icon-row">
        <n-icon name="check-circle" aria-label="Approved"></n-icon>
        <span style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); font-family: ui-monospace, monospace;">
          → role="img", aria-label="Approved"
        </span>
      </div>
    </n-panel>

    <!-- ── Inside Buttons ── -->

    <h2>Inside Buttons</h2>
    <n-panel bordered intent="accent" size="sm">
      <div class="icon-row">
        <button variant="primary">
          <n-icon name="plus"></n-icon>
          <span slot="label">Add Item</span>
        </button>
        <button variant="secondary">
          <n-icon name="pencil-simple"></n-icon>
          <span slot="label">Edit</span>
        </button>
        <button variant="outline">
          <n-icon name="trash"></n-icon>
          <span slot="label">Delete</span>
        </button>
        <button variant="ghost" aria-label="Close">
          <n-icon name="x"></n-icon>
        </button>
      </div>
    </n-panel>

    <!-- ── Dynamic Name Change ── -->

    <h2>Dynamic Name Change</h2>
    <n-panel bordered>
      <div class="layout-grid">
        <n-stack>
          <n-icon id="dynamic-icon" name="house" size="xl"></n-icon>
          <select id="icon-picker" style="font-size: 0.75rem; padding: 0.25rem;">
            <option value="house">house</option>
            <option value="gear">gear</option>
            <option value="bell">bell</option>
            <option value="heart">heart</option>
            <option value="star">star</option>
            <option value="magnifying-glass">magnifying-glass</option>
            <option value="check">check</option>
            <option value="x">x</option>
          </select>
        </n-stack>
      </div>
    </n-panel>

    <!-- ── Late Registration ── -->

    <h2>Late Registration</h2>
    <n-panel bordered>
      <n-text size="xs" muted style="margin-bottom: 0.5rem;">
        The icon below has name="late-demo" but the icon hasn't been registered yet.
        Click the button to register it dynamically.
      </n-text>
      <div class="icon-row" style="margin-bottom: 0.5rem;">
        <n-icon id="late-icon" name="late-demo" size="xl"></n-icon>
        <button id="register-btn" variant="secondary" size="sm">Register "late-demo" icon</button>
      </div>
      <div class="log" id="late-log"></div>
    </n-panel>

    <!-- ── Navigation Icons ── -->

    <h2>Navigation Icons</h2>
    <n-panel bordered>
      <div class="icon-row">
        <div class="icon-card">
          <n-icon name="caret-up"></n-icon>
          <span class="icon-card-label">caret-up</span>
        </div>
        <div class="icon-card">
          <n-icon name="caret-down"></n-icon>
          <span class="icon-card-label">caret-down</span>
        </div>
        <div class="icon-card">
          <n-icon name="caret-left"></n-icon>
          <span class="icon-card-label">caret-left</span>
        </div>
        <div class="icon-card">
          <n-icon name="caret-right"></n-icon>
          <span class="icon-card-label">caret-right</span>
        </div>
        <div class="icon-card">
          <n-icon name="arrow-up"></n-icon>
          <span class="icon-card-label">arrow-up</span>
        </div>
        <div class="icon-card">
          <n-icon name="arrow-down"></n-icon>
          <span class="icon-card-label">arrow-down</span>
        </div>
        <div class="icon-card">
          <n-icon name="arrow-left"></n-icon>
          <span class="icon-card-label">arrow-left</span>
        </div>
        <div class="icon-card">
          <n-icon name="arrow-right"></n-icon>
          <span class="icon-card-label">arrow-right</span>
        </div>
      </div>
    </n-panel>
  </main>

  <script>
import { logPrepend } from '../scripts/event-log';
// Register specific icons for the demo

      // Dynamic name change
      const dynamicIcon = document.getElementById('dynamic-icon');
      const iconPicker = document.getElementById('icon-picker');
      iconPicker.addEventListener('change', () => {
        dynamicIcon.setAttribute('name', iconPicker.value);
      });

      // Late registration demo
      const registerBtn = document.getElementById('register-btn');
      const lateLog = document.getElementById('late-log');

      function log(msg) {
        logPrepend(lateLog, msg);
      }

      log('n-icon[name="late-demo"] created — icon not yet registered, renders empty.');

      registerBtn.addEventListener('click', () => {
        registerIcon('late-demo', '<svg viewBox="0 0 256 256" fill="currentColor"><path d="M229.66,77.66l-128,128a8,8,0,0,1-11.32,0l-56-56a8,8,0,0,1,11.32-11.32L96,188.69,218.34,66.34a8,8,0,0,1,11.32,11.32Z"/></svg>');
        log('registerIcon("late-demo", ...) called — icon should now appear!');
        registerBtn.disabled = true;
      });
  </script>
  <style is:global>
    .icon-row {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .icon-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      padding: 0.75rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.375rem;
      min-width: 5rem;
    }

    .icon-card-label {
      font-size: 0.625rem;
      color: var(--n-ink-muted-neutral);
      font-family: ui-monospace, monospace;
    }
</style>

</SidebarLayout>
