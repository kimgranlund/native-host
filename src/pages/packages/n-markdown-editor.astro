---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="n-markdown-editor">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>n-markdown-editor</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-markdown-editor&gt;</span> Markdown content editor with live preview and source modes.
      Built on CodeMirror 6, renders a toolbar with formatting commands and an Obsidian-style live preview.
          </div>
  </header>

  <section>

    <!-- ── Default (Live Preview) ── -->

    <h2>Default — Live Preview Mode</h2>
    <div class="editor-wrap"><n-markdown-editor id="demo-default"></n-markdown-editor></div>
    <pre class="code-block"><code>&lt;n-markdown-editor&gt;
  &lt;script type="text/markdown"&gt;
# Hello World

This is a **bold** and *italic* text.
  &lt;/script&gt;
&lt;/n-markdown-editor&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>

    <!-- ── Source Mode ── -->

    <h2>Source Mode</h2>
    <n-markdown-editor id="demo-source" mode="source"></n-markdown-editor>
    <pre class="code-block"><code>&lt;n-markdown-editor mode="source"&gt;
  &lt;script type="text/markdown"&gt;
# Source Mode
Raw markdown without decorations.
  &lt;/script&gt;
&lt;/n-markdown-editor&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>

    <!-- ── Placeholder ── -->

    <h2>Placeholder</h2>
    <n-markdown-editor id="demo-placeholder" placeholder="Start typing your markdown here..."></n-markdown-editor>
    <pre class="code-block"><code>&lt;n-markdown-editor placeholder="Start typing..."&gt;&lt;/n-markdown-editor&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>

    <!-- ── Read-only ── -->

    <h2>Read-only</h2>
    <n-markdown-editor id="demo-readonly" readonly></n-markdown-editor>
    <pre class="code-block"><code>&lt;n-markdown-editor readonly&gt;
  &lt;script type="text/markdown"&gt;
# Read-only Document
Content is not editable.
  &lt;/script&gt;
&lt;/n-markdown-editor&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>

    <!-- ── Disabled ── -->

    <h2>Disabled</h2>
    <n-markdown-editor id="demo-disabled" disabled></n-markdown-editor>
    <pre class="code-block"><code>&lt;n-markdown-editor disabled&gt;...&lt;/n-markdown-editor&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>

    <!-- ── Form Integration ── -->

    <h2>Form Integration</h2>
    <n-stack gap="4">
      <form id="demo-form">
        <div class="editor-short"><n-markdown-editor id="demo-form-editor" name="content"></n-markdown-editor></div>
      </form>
      <n-stack direction="row">
        <n-button type="submit" form="demo-form" variant="primary">Submit</n-button>
        <n-button type="reset" form="demo-form" variant="secondary">Reset</n-button>
      </n-stack>
    </n-stack>
    <div class="log" id="form-output"></div>
    <pre class="code-block"><code>&lt;form&gt;
  &lt;n-markdown-editor name="content"&gt;...&lt;/n-markdown-editor&gt;
  &lt;n-button type="submit"&gt;Submit&lt;/n-button&gt;
  &lt;n-button type="reset"&gt;Reset&lt;/n-button&gt;
&lt;/form&gt;

&lt;script&gt;
  form.addEventListener('submit', (e) =&gt; &#123;
    e.preventDefault();
    const data = new FormData(form);
    console.log(data.get('content'));
  &#125;);
&lt;/script&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>

    <!-- ── Change Events ── -->

    <h2>Change Events</h2>
    <div class="editor-compact"><n-markdown-editor id="demo-events"></n-markdown-editor></div>
    <div class="log event-log" id="event-log"></div>
    <pre class="code-block"><code>&lt;n-markdown-editor id="editor"&gt;...&lt;/n-markdown-editor&gt;

&lt;script&gt;
  editor.addEventListener('change', (e) =&gt; &#123;
    console.log(e.detail.value.length, 'chars');
  &#125;);
&lt;/script&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>

    <!-- ── Data Gateway (src) ── -->

    <h2>Data Gateway — Load from URL</h2>
    <n-markdown-editor id="demo-gateway"></n-markdown-editor>
    <div class="gateway-actions">
      <n-stack direction="row" align="center">
        <n-button id="gateway-save" variant="primary" disabled>Save</n-button>
        <n-button id="gateway-reload" variant="secondary">Reload</n-button>
        <span class="gateway-status" id="gateway-status"></span>
      </n-stack>
    </div>
    <pre class="code-block"><code>&lt;n-markdown-editor id="editor" src="/api/content"&gt;&lt;/n-markdown-editor&gt;

&lt;script&gt;
  editor.addEventListener('dirty-change', (e) =&gt; &#123;
    saveBtn.disabled = !e.detail.dirty;
  &#125;);
  saveBtn.addEventListener('native:press', () =&gt; editor.save());
  reloadBtn.addEventListener('native:press', () =&gt; editor.reload());
&lt;/script&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
  </section>

  <script>
  import { logPrepend } from '../../scripts/event-log';

  document.addEventListener('astro:page-load', () => {
  if (!document.getElementById('demo-default')) return;

  // ── Seed editor content via .value ──

  const demoDefault = document.getElementById('demo-default');
  if (demoDefault) {
    demoDefault.value = [
      '# Hello World',
      '',
      'This is a **bold** and *italic* text with `inline code`.',
      '',
      '## Features',
      '',
      '- Toolbar with formatting commands',
      '- Live preview with decorations',
      '- Source mode toggle',
      '',
      '> Blockquotes are styled with a blue left border.',
      '',
      '### Links & Images',
      '',
      'Check out [NativeUI](https://github.com/nonoun/native-ui) for more info.',
      '',
      '---',
      '',
      '```js',
      "console.log('Code blocks are highlighted');",
      '```',
      '',
      '1. Ordered lists',
      '2. Work too',
      '3. With proper numbering',
    ].join('\n');
  }

  const demoSource = document.getElementById('demo-source');
  if (demoSource) {
    demoSource.value = [
      '# Source Mode',
      '',
      'In source mode, you see the **raw markdown** without live preview decorations.',
      'Syntax highlighting is provided by `@codemirror/lang-markdown`.',
      '',
      '- No inline styling',
      '- Just syntax colors',
      '- Full editing power',
    ].join('\n');
  }

  const demoReadonly = document.getElementById('demo-readonly');
  if (demoReadonly) {
    demoReadonly.value = [
      '# Read-only Document',
      '',
      'This editor is in **read-only** mode. You can select text but cannot edit.',
      '',
      '- Toolbar buttons are disabled',
      '- Content is not editable',
      '- Useful for preview/display',
    ].join('\n');
  }

  const demoDisabled = document.getElementById('demo-disabled');
  if (demoDisabled) {
    demoDisabled.value = [
      '# Disabled Editor',
      '',
      'This editor is completely disabled.',
    ].join('\n');
  }

  const demoFormEditor = document.getElementById('demo-form-editor');
  if (demoFormEditor) {
    demoFormEditor.value = [
      '# Form Field',
      '',
      'This editor participates in form submission via `FormData`.',
    ].join('\n');
  }

  const demoEvents = document.getElementById('demo-events');
  if (demoEvents) {
    demoEvents.value = [
      '# Try editing',
      '',
      'Type something to see change events in the log below.',
    ].join('\n');
  }

  const gatewayEditor = document.getElementById('demo-gateway');
  if (gatewayEditor) {
    gatewayEditor.value = [
      '# Data Gateway Demo',
      '',
      'Edit this content, then observe the **dirty** state.',
      '',
      'The save and reload buttons wire to `editor.save()` and `editor.reload()`.',
    ].join('\n');
  }

  // ── Form demo ──

  const form = document.getElementById('demo-form');
  const formOutput = document.getElementById('form-output');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const content = data.get('content');
    logPrepend(formOutput, `FormData "content": ${content?.toString().slice(0, 100)}...`);
  });

  // ── Event log demo ──

  const eventLog = document.getElementById('event-log');
  let count = 0;
  demoEvents?.addEventListener('change', (e) => {
    count++;
    const detail = e.detail;
    logPrepend(eventLog, `#${count} change — ${detail.value.length} chars`);
  });

  // ── Gateway demo ──

  const gatewayStatus = document.getElementById('gateway-status');
  const saveBtn = document.getElementById('gateway-save');
  const reloadBtn = document.getElementById('gateway-reload');

  gatewayEditor?.addEventListener('dirty-change', (e) => {
    const dirty = e.detail.dirty;
    if (saveBtn) saveBtn.disabled = !dirty;
    if (gatewayStatus) gatewayStatus.textContent = dirty ? 'Unsaved changes' : 'Clean';
  });

  gatewayEditor?.addEventListener('native:save', () => {
    if (gatewayStatus) gatewayStatus.textContent = 'Saved!';
  });

  gatewayEditor?.addEventListener('native:error', (e) => {
    if (gatewayStatus) gatewayStatus.textContent = `Error: ${e.detail.error}`;
  });

  saveBtn?.addEventListener('native:press', () => gatewayEditor?.save());
  reloadBtn?.addEventListener('native:press', () => gatewayEditor?.reload());
  });
</script>
  <style is:global>
    @import '@nonoun/native-code/css';

    .editor-wrap {
      height: 400px;
    }

    .editor-short {
      height: 250px;
    }

    .editor-compact {
      height: 200px;
    }

    .editor-wrap > n-markdown-editor,
    .editor-short > n-markdown-editor,
    .editor-compact > n-markdown-editor {
      height: 100%;
    }

    .event-log {
      max-height: 100px;
    }

    .gateway-actions {
      margin-top: 0.75rem;
    }

    .gateway-status {
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
    }
</style>

</SidebarLayout>
