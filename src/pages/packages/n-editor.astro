---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="n-editor">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>n-editor</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-editor&gt;</span> Shared CodeMirror 6 integration layer for the NativeUI ecosystem.
      Provides a dark theme, syntax highlighting, base extensions (keymaps, history, brackets, autocomplete, line numbers),
      and a <code>createEditorView()</code> factory.
          </div>
  </header>

  <section>

    <!-- ── Factory: createEditorView ── -->

    <h2>createEditorView()</h2>
    <span class="text-sm text-muted">One-line factory — creates a themed editor with all base extensions.</span>
    <n-container data-kind="panel" bordered>
      <div class="editor-container" id="factory-demo"></div>
    <pre class="code-block"><code>import &#123; createEditorView &#125; from '@nonoun/native-code';
import &#123; javascript &#125; from '@codemirror/lang-javascript';

const view = createEditorView(document.getElementById('editor'), &#123;
  doc: 'console.log("hello");',
  extensions: [javascript()],
&#125;);</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── JavaScript ── -->

    <h2>JavaScript</h2>
    <n-container data-kind="panel" bordered>
      <div class="editor-container" id="js-demo"></div>
    <pre class="code-block"><code>import &#123; javascript &#125; from '@codemirror/lang-javascript';

createEditorView(container, &#123;
  doc: source,
  extensions: [javascript()],
&#125;);</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── HTML ── -->

    <h2>HTML</h2>
    <n-container data-kind="panel" bordered>
      <div class="editor-container" id="html-demo"></div>
    <pre class="code-block"><code>import &#123; html &#125; from '@codemirror/lang-html';

createEditorView(container, &#123;
  doc: source,
  extensions: [html()],
&#125;);</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── CSS ── -->

    <h2>CSS</h2>
    <n-container data-kind="panel" bordered>
      <div class="editor-container" id="css-demo"></div>
    <pre class="code-block"><code>import &#123; css &#125; from '@codemirror/lang-css';

createEditorView(container, &#123;
  doc: source,
  extensions: [css()],
&#125;);</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Markdown ── -->

    <h2>Markdown</h2>
    <n-container data-kind="panel" bordered>
      <div class="editor-container" id="md-demo"></div>
    <pre class="code-block"><code>import &#123; markdown &#125; from '@codemirror/lang-markdown';

createEditorView(container, &#123;
  doc: source,
  extensions: [markdown()],
&#125;);</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Read-only ── -->

    <h2>Read-only</h2>
    <span class="text-sm text-muted">Selectable but not editable. Useful for documentation code blocks.</span>
    <n-container data-kind="panel" bordered>
      <div class="editor-container editor-container-sm" id="readonly-demo"></div>
    <pre class="code-block"><code>createEditorView(container, &#123;
  doc: source,
  extensions: [javascript()],
  readonly: true,
&#125;);</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Custom Extensions ── -->

    <h2>Custom Extensions</h2>
    <span class="text-sm text-muted">Pass additional extensions via the <code>extensions</code> option. This example adds a change listener.</span>
    <n-container data-kind="panel" bordered>
      <div class="editor-container editor-container-sm" id="custom-demo"></div>
      <div class="log" id="change-log" style="max-height: 80px;"></div>
    <pre class="code-block"><code>import &#123; EditorView &#125; from '@nonoun/native-code';

createEditorView(container, &#123;
  doc: source,
  extensions: [
    javascript(),
    EditorView.updateListener.of(update =&gt; &#123;
      if (update.docChanged) &#123;
        console.log(update.state.doc.length, 'chars');
      &#125;
    &#125;),
  ],
&#125;);</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ── <n-editor> Element ── -->

    <n-divider></n-divider>
    <h2>&lt;n-editor&gt; Element</h2>
    <span class="text-sm text-muted">Declarative custom element wrapper — set content via <code>value</code> attribute or child <code>&lt;script type="text/plain"&gt;</code>.</span>

    <!-- ── Element: Basic ── -->

    <h3>Basic</h3>
    <n-container data-kind="panel" bordered>
      <n-editor id="el-basic" style="height: 180px;"></n-editor>
    <pre class="code-block"><code>&lt;n-editor&gt;
  &lt;script type="text/plain"&gt;
    const greeting = 'Hello from &lt;n-editor&gt;!';
  &lt;/script&gt;
&lt;/n-editor&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Element: Placeholder ── -->

    <h3>Placeholder</h3>
    <n-container data-kind="panel" bordered>
      <n-editor id="el-placeholder" placeholder="Type some code here..." style="height: 120px;"></n-editor>
    <pre class="code-block"><code>&lt;n-editor placeholder="Type some code here..."&gt;&lt;/n-editor&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Element: Read-only ── -->

    <h3>Read-only</h3>
    <n-container data-kind="panel" bordered>
      <n-editor id="el-readonly" readonly style="height: 120px;"></n-editor>
    <pre class="code-block"><code>&lt;n-editor readonly&gt;...&lt;/n-editor&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Element: Disabled ── -->

    <h3>Disabled</h3>
    <n-container data-kind="panel" bordered>
      <n-editor id="el-disabled" disabled style="height: 120px;"></n-editor>
    <pre class="code-block"><code>&lt;n-editor disabled&gt;...&lt;/n-editor&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Element: No Line Numbers ── -->

    <h3>No Line Numbers</h3>
    <n-container data-kind="panel" bordered>
      <n-editor id="el-no-lines" line-numbers="false" style="height: 120px;"></n-editor>
    <pre class="code-block"><code>&lt;n-editor line-numbers="false"&gt;...&lt;/n-editor&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Element: Line Wrapping ── -->

    <h3>Line Wrapping</h3>
    <n-container data-kind="panel" bordered>
      <n-editor id="el-wrap" line-wrapping style="height: 120px;"></n-editor>
    <pre class="code-block"><code>&lt;n-editor line-wrapping&gt;...&lt;/n-editor&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Element: Events ── -->

    <h3>Events</h3>
    <span class="text-sm text-muted">Fires <code>native:input</code> on every keystroke and <code>native:change</code> on blur.</span>
    <n-container data-kind="panel" bordered>
      <n-editor id="el-events" style="height: 120px;"></n-editor>
      <div class="log" id="editor-event-log" style="max-height: 80px;"></div>
    <pre class="code-block"><code>&lt;n-editor&gt;...&lt;/n-editor&gt;

editor.addEventListener('native:input', (e) =&gt; &#123;
  console.log('input', e.detail.value.length, 'chars');
&#125;);
editor.addEventListener('native:change', (e) =&gt; &#123;
  console.log('change', e.detail.value.length, 'chars');
&#125;);</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>
  </section>

  <script>
  import { createEditorView, EditorView } from '@nonoun/native-code';
  import { javascript } from '@codemirror/lang-javascript';
  import { html } from '@codemirror/lang-html';
  import { css } from '@codemirror/lang-css';
  import { markdown } from '@codemirror/lang-markdown';
  import { logPrepend } from '../../scripts/event-log';

  document.addEventListener('astro:page-load', () => {
  if (!document.getElementById('factory-demo')) return;

  // ── Factory demo ──

  createEditorView(document.getElementById('factory-demo'), {
    doc: `import { createEditorView } from '@nonoun/native-code';

const view = createEditorView(document.getElementById('editor'), {
  doc: 'console.log("hello");',
  readonly: true,
});

// Add a language extension for syntax highlighting:
import { javascript } from '@codemirror/lang-javascript';

const view2 = createEditorView(container, {
  doc: source,
  extensions: [javascript()],
});`,
    extensions: [javascript()],
  });

  // ── JavaScript demo ──

  createEditorView(document.getElementById('js-demo'), {
    doc: `/**
 * Fibonacci sequence generator using memoization.
 */
function fibonacci(n, memo = new Map()) {
  if (n <= 1) return n;
  if (memo.has(n)) return memo.get(n);

  const result = fibonacci(n - 1, memo) + fibonacci(n - 2, memo);
  memo.set(n, result);
  return result;
}

// Generate first 20 numbers
const sequence = Array.from({ length: 20 }, (_, i) => fibonacci(i));
console.log(sequence); // [0, 1, 1, 2, 3, 5, 8, 13, 21, ...]

// ES2025 pattern matching (proposal)
const classify = (n) => {
  if (n === 0) return 'zero';
  if (n > 0) return 'positive';
  return 'negative';
};

export { fibonacci, classify };`,
    extensions: [javascript()],
  });

  // ── HTML demo ──

  createEditorView(document.getElementById('html-demo'), {
    doc: `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Hello NativeUI</title>
  <link rel="stylesheet" href="native-ui.css" />
</head>
<body>
  <native-app>
    <main>
      <h1>Welcome</h1>
      <p>A zero-specificity web component library.</p>

      <n-button variant="primary" size="md">
        <span slot="label">Get Started</span>
      </n-button>

      <n-input placeholder="Search..." size="md">
        <n-icon name="magnifying-glass" slot="leading"></n-icon>
      </n-input>

      <n-select placeholder="Pick a country">
        <n-listbox popover>
          <n-option value="us">United States</n-option>
          <n-option value="se">Sweden</n-option>
          <n-option value="jp">Japan</n-option>
        </n-listbox>
      </n-select>
    </main>
  </native-app>
</body>
</html>`,
    extensions: [html()],
  });

  // ── CSS demo ──

  createEditorView(document.getElementById('css-demo'), {
    doc: `@layer ui {
  /* Button component — zero-specificity attribute selectors */

  :where(n-button) {
    display: inline-grid;
    grid-template-columns: auto auto auto;
    align-items: center;
    gap: calc(var(--_space) * 2);
    min-height: var(--_min-height);
    padding-block: var(--_space);
    padding-inline: calc(var(--_space-k) * var(--_space));
    border-radius: var(--_radius);
    background: var(--_background, var(--_panel));
    color: var(--_color, var(--_ink));
    border: 1px solid var(--_border-color, var(--_border-muted));
    font-size: var(--_font-size);
    font-weight: var(--n-font-weight-button, 500);
    cursor: pointer;
    user-select: none;
    transition:
      background 150ms ease,
      color 150ms ease,
      border-color 150ms ease,
      opacity 150ms ease,
      transform 150ms ease;
  }

  :where(n-button):hover,
  :where(n-button)[force-hover] {
    background: var(--_background-hover, var(--_panel-hover));
    color: var(--_color-hover, var(--_ink-hover));
  }

  :where(n-button):active,
  :where(n-button)[force-active] {
    transform: scale(0.97);
  }
}`,
    extensions: [css()],
  });

  // ── Markdown demo ──

  createEditorView(document.getElementById('md-demo'), {
    doc: `# NativeUI Components

A **zero-specificity** web component library built on OKLCH color science.

## Getting Started

\`\`\`bash
npm install @nonoun/native-ui
\`\`\`

### Usage

Import the CSS foundation and register components:

\`\`\`html
<link rel="stylesheet" href="native-ui.css" />
\`\`\`

Then use components in your markup:

- \`<n-button>\` — pressable button with variant/size/intent
- \`<n-input>\` — text input with leading/trailing slots
- \`<n-select>\` — dropdown selector with popover

> All components use \`:where()\` selectors for **zero specificity**.

### Three-Tier Token Model

| Tier | Prefix | Purpose |
|------|--------|---------|
| Public | \`--n-*\` | Themeable scale on \`:root\` |
| Local | \`--_*\` | Resolved by attribute selectors |
| Component | — | Reads locals directly |

---

See the [documentation](https://native-ui.dev) for the full API.`,
    extensions: [markdown()],
  });

  // ── Read-only demo ──

  createEditorView(document.getElementById('readonly-demo'), {
    doc: `// This editor is read-only — you can select text but cannot edit.
const greeting = 'Hello from n-editor!';
console.log(greeting);`,
    extensions: [javascript()],
    readonly: true,
  });

  // ── Custom extensions demo ──

  const log = document.getElementById('change-log');
  let count = 0;

  createEditorView(document.getElementById('custom-demo'), {
    doc: `// Type here to see change events in the log below\nconst x = 42;`,
    extensions: [
      javascript(),
      EditorView.updateListener.of(update => {
        if (update.docChanged) {
          count++;
          logPrepend(log, `#${count} change — ${update.state.doc.length} chars`);
        }
      }),
    ],
  });

  // ── <n-editor> element demos — populate values ──

  const elValues: Record<string, string> = {
    'el-basic': "const greeting = 'Hello from <n-editor>!';\nconsole.log(greeting);",
    'el-readonly': '// Read-only — selectable but not editable\nconst PI = 3.14159;',
    'el-disabled': '// Disabled — not focusable\nconst x = 0;',
    'el-no-lines': '// Line numbers hidden\nfunction add(a, b) { return a + b; }',
    'el-wrap': '// This is a very long line that should wrap when the editor is narrower than the text content, rather than showing a horizontal scrollbar like it would by default.',
    'el-events': '// Type here to see events',
  };
  for (const [id, val] of Object.entries(elValues)) {
    const el = document.getElementById(id) as HTMLElement & { value: string } | null;
    if (el) el.value = val;
  }

  // ── <n-editor> element events demo ──

  const editorEventLog = document.getElementById('editor-event-log');
  const elEvents = document.getElementById('el-events');
  if (elEvents && editorEventLog) {
    let evtCount = 0;
    elEvents.addEventListener('native:input', ((e: CustomEvent) => {
      evtCount++;
      logPrepend(editorEventLog, `#${evtCount} input — ${e.detail.value.length} chars`);
    }) as EventListener);
    elEvents.addEventListener('native:change', ((e: CustomEvent) => {
      evtCount++;
      logPrepend(editorEventLog, `#${evtCount} change — ${e.detail.value.length} chars`);
    }) as EventListener);
  }
  });
</script>
  <style is:global>
    @import '@nonoun/native-code/css';

    .editor-container {
      overflow: hidden;
      height: 300px;
    }

    .editor-container .cm-editor {
      height: 100%;
    }

    .editor-container-sm {
      height: 180px;
    }
</style>

</SidebarLayout>
