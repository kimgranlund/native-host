---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';

if (Astro.locals.user) return Astro.redirect('/blocks/data-dashboard-stats');
---
<BaseLayout title="Log In">
  <style is:global>
    @import '../styles/global.css';
  </style>

  <div class="login-screen">
    <n-stack align="center" justify="center">
      <div class="login-card">
        <div class="login-logo">
          <n-stack align="center">
            <Logo size={48} />
          </n-stack>
        </div>
        <div class="login-heading">
          <n-text size="lg" strong>Log in to NativeUI</n-text>
        </div>
        <div class="login-subheading">
          <n-text size="sm" muted>Choose a method to continue</n-text>
        </div>

        <div class="login-buttons">
          <n-stack gap="3">
            <n-button variant="primary" intent="accent" size="lg" id="google-login">
              <n-icon name="google-logo" slot="leading"></n-icon>
              <span slot="label">Continue with Google</span>
            </n-button>
            <n-button size="lg" id="email-login">
              <n-icon name="envelope" slot="leading"></n-icon>
              <span slot="label">Continue with email</span>
            </n-button>
          </n-stack>
        </div>

        <div class="login-divider-wrap">
          <n-divider>or</n-divider>
        </div>

        <div class="login-skip">
          <n-button size="lg" id="skip-login">
            <span slot="label">Skip</span>
          </n-button>
        </div>

        <div class="login-footer">
          <n-text size="sm" muted>
            Don't have an account? <a href="/auth/register">Sign up</a>
          </n-text>
        </div>
      </div>

      <div class="login-legal">
        <n-text size="xs" muted>
          By continuing, you agree to our <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
        </n-text>
      </div>
    </n-stack>
  </div>

  <script>
    import { authClient } from '../lib/auth-client';
    import { navigate } from 'astro:transitions/client';

    document.addEventListener('astro:page-load', () => {
      const googleBtn = document.getElementById('google-login');
      const emailBtn = document.getElementById('email-login');
      const skipBtn = document.getElementById('skip-login');
      if (!googleBtn) return;

      googleBtn.addEventListener('click', async () => {
        await authClient.signIn.social({
          provider: 'google',
          callbackURL: '/blocks/data-dashboard-stats',
        });
      });

      emailBtn?.addEventListener('click', () => {
        navigate('/auth/login');
      });

      skipBtn?.addEventListener('click', () => {
        navigate('/blocks/data-dashboard-stats');
      });
    });
  </script>

  <style is:global>
    .login-screen {
      min-height: 100dvh;
      padding: 2rem;
    }

    .login-card {
      width: 100%;
      max-width: 22rem;
    }

    .login-logo {
      margin-bottom: 1.5rem;
    }

    .login-heading {
      text-align: center;
      margin: 0 0 0.25rem;
    }

    .login-subheading {
      text-align: center;
      margin: 0 0 1.5rem;
    }

    .login-footer {
      text-align: center;
      margin-top: 1.5rem;
    }

    .login-footer a {
      color: var(--n-ink-accent);
      text-decoration: none;
      font-weight: 500;
    }

    .login-footer a:hover {
      text-decoration: underline;
    }

    .login-divider-wrap {
      margin: 1.25rem 0;
    }

    .login-skip {
      display: grid;
    }

    .login-legal {
      position: fixed;
      bottom: 1.5rem;
      text-align: center;
      opacity: 0.6;
    }

    .login-legal a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--n-border-muted-neutral);
      text-underline-offset: 2px;
    }

    .login-legal a:hover {
      color: var(--n-ink-neutral);
    }
  </style>
</BaseLayout>
