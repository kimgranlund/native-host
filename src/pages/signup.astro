---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
---
<BaseLayout title="Sign Up">
  <style is:global>
    @import '../styles/layout.css';
  </style>

  <main class="login-screen">
    <div class="login-card">
      <div class="login-logo">
        <Logo size={48} />
      </div>
      <h1 class="login-heading">Create your account</h1>
      <p class="login-subheading">Get started with NativeUI for free</p>

      <n-stack gap="3" class="login-buttons">
        <n-button variant="primary" intent="accent" size="lg">
          <span slot="label">Sign up with Google</span>
        </n-button>
        <n-button size="lg">
          <span slot="label">Sign up with GitHub</span>
        </n-button>
      </n-stack>

      <n-divider class="signup-divider">or</n-divider>

      <form class="signup-form">
        <n-stack gap="6">
          <n-field required>
            <label slot="label">Full name</label>
            <n-input placeholder="Kim Granlund" name="name">
              <n-icon name="user" slot="leading"></n-icon>
            </n-input>
          </n-field>
          <n-field required>
            <label slot="label">Email</label>
            <n-input type="email" placeholder="kim@example.com" name="email">
              <n-icon name="envelope" slot="leading"></n-icon>
            </n-input>
          </n-field>
          <n-field required>
            <label slot="label">Password</label>
            <n-input type="password" placeholder="At least 8 characters" name="password">
              <n-icon name="lock" slot="leading"></n-icon>
            </n-input>
          </n-field>
          <n-button variant="primary" intent="accent" size="lg" type="submit" class="signup-submit">
            <span slot="label">Create account</span>
          </n-button>
        </n-stack>
      </form>

      <p class="login-footer">
        Already have an account? <a href="/">Log in</a>
      </p>
    </div>

    <p class="login-legal">
      By continuing, you agree to our <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
    </p>
  </main>

  <script>
    import { navigate } from 'astro:transitions/client';

    document.addEventListener('astro:page-load', () => {
      for (const btn of document.querySelectorAll('.login-buttons n-button')) {
        btn.addEventListener('click', () => {
          navigate('/blocks/data-dashboard-stats');
        });
      }
      for (const form of document.querySelectorAll('.signup-form')) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          navigate('/blocks/data-dashboard-stats');
        });
      }
    });
  </script>

  <style is:global>
    .login-screen {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      min-height: 100dvh;
      padding: 2rem;
    }

    .login-card {
      width: 100%;
      max-width: 22rem;
    }

    .login-logo {
      display: flex;
      justify-content: center;
      margin-bottom: 1.5rem;
    }

    .login-heading {
      text-align: center;
      font-size: 1.25rem;
      font-weight: 700;
      margin: 0 0 0.25rem;
    }

    .login-subheading {
      text-align: center;
      font-size: 0.875rem;
      color: var(--n-ink-muted-neutral);
      margin: 0 0 1.5rem;
    }

    .signup-divider {
      margin: 1.5rem 0;
    }

    .signup-form n-field {
      gap: calc(var(--n-space) * 2);
    }

    .login-footer {
      text-align: center;
      font-size: 0.8125rem;
      color: var(--n-ink-muted-neutral);
      margin-top: 1.5rem;
    }

    .login-footer a {
      color: var(--n-ink-accent);
      text-decoration: none;
      font-weight: 500;
    }

    .login-footer a:hover {
      text-decoration: underline;
    }

    .login-legal {
      position: fixed;
      bottom: 1.5rem;
      text-align: center;
      font-size: 0.6875rem;
      color: var(--n-ink-muted-neutral);
      opacity: 0.6;
    }

    .login-legal a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--n-border-muted-neutral);
      text-underline-offset: 2px;
    }

    .login-legal a:hover {
      color: var(--n-ink-neutral);
    }
  </style>
</BaseLayout>
