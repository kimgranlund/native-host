---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';

const codeProvider = `&lt;div class="arena" id="provider-arena"&gt;
  &lt;n-controller traits="tossable"&gt;
    &lt;div class="toss-card accent"&gt;
      &lt;span class="toss-label"&gt;1&lt;/span&gt;
      &lt;span&gt;Accent&lt;/span&gt;
    &lt;/div&gt;
  &lt;/n-controller&gt;

  &lt;n-controller traits="tossable"
    data-trait-tossable-bounce="true"
    data-trait-tossable-return-on-end="true"&gt;
    &lt;div class="toss-card warning"&gt;
      &lt;span class="toss-label"&gt;4&lt;/span&gt;
      &lt;span&gt;Return&lt;/span&gt;
    &lt;/div&gt;
  &lt;/n-controller&gt;

  &lt;n-controller traits="tossable"
    data-trait-tossable-gravity="0.8"
    data-trait-tossable-spin="true"&gt;
    &lt;div class="toss-card accent"&gt;
      &lt;span class="toss-label"&gt;6&lt;/span&gt;
      &lt;span&gt;Gravity + Spin&lt;/span&gt;
    &lt;/div&gt;
  &lt;/n-controller&gt;
  &lt;!-- ... 7 cards total --&gt;
&lt;/div&gt;`;

const codeController = `import { TossController } from '@nonoun/native-ui';

const card = document.getElementById('controller-card');
const toss = new TossController(card, {
  friction: 0.95,
  bounce: true,
  bounceDamping: 0.6,
  returnOnEnd: false,
});

// Update options live
toss.friction = 0.98;
toss.spin = true;

// Reset position
card.style.translate = '';
card.style.rotate = '';
toss.destroy();`;

const detailToss = `{ x, y, velocityX, velocityY, bounces, rotation }`;
const detailBounce = `{ edge, x, y }`;
---
<SidebarLayout title="Tossable">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Tossable</h1>
      </div>
    </div>
    <div slot="description">

      Physics-based throw/toss with momentum. Sets a <code>[tossing]</code> attribute during deceleration and dispatches <code>native:toss</code> on release and <code>native:bounce</code> when hitting container edges.

    </div>
  </header>

  <section>

    <!-- ── Provider Demo ── -->

    <h2>Provider (n-controller)</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Wrap elements with <code>&lt;n-controller traits="tossable"&gt;</code> to make them tossable. Pick up and fling the cards below.
      </span>

      <div class="arena" id="provider-arena">
        <n-controller traits="tossable">
          <div class="toss-card accent">
            <span class="toss-label">1</span>
            <span>Accent</span>
          </div>
        </n-controller>
        <n-controller traits="tossable">
          <div class="toss-card info">
            <span class="toss-label">2</span>
            <span>Info</span>
          </div>
        </n-controller>
        <n-controller traits="tossable">
          <div class="toss-card success">
            <span class="toss-label">3</span>
            <span>Success</span>
          </div>
        </n-controller>
        <n-controller traits="tossable" data-trait-tossable-bounce="true" data-trait-tossable-return-on-end="true">
          <div class="toss-card warning">
            <span class="toss-label">4</span>
            <span>Return</span>
          </div>
        </n-controller>
        <n-controller traits="tossable" data-trait-tossable-friction="0.98">
          <div class="toss-card danger">
            <span class="toss-label">5</span>
            <span>Low friction</span>
          </div>
        </n-controller>
        <n-controller traits="tossable" data-trait-tossable-gravity="0.8" data-trait-tossable-spin="true">
          <div class="toss-card accent">
            <span class="toss-label">6</span>
            <span>Gravity + Spin</span>
          </div>
        </n-controller>
        <n-controller traits="tossable" data-trait-tossable-spin="true" data-trait-tossable-return-on-end="true">
          <div class="toss-card info">
            <span class="toss-label">7</span>
            <span>Spin + Return</span>
          </div>
        </n-controller>
      </div>

      <div id="provider-log" class="output"></div>
      <pre class="code-block"><code set:html={codeProvider} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Controller Demo ── -->

    <h2>Controller (programmatic)</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        <code>new TossController(el, options)</code> gives you full programmatic control. Adjust options live with the controls below.
      </span>

      <div class="arena" id="controller-arena">
        <div class="toss-card accent toss-card--large" id="controller-card">
          <span class="toss-label">Toss me</span>
          <span>Controller mode</span>
        </div>
      </div>

      <div id="controller-log" class="output"></div>
      <pre class="code-block"><code set:html={codeController} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Options Card ── -->

    <h2>Options</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        These controls update the TossController instance in real time. Try changing values and then tossing the card above.
      </span>

      <n-stack gap="3">
        <n-stack direction="row" align="center" gap="3">
          <span class="text-sm opt-label">Friction: <strong id="friction-val">0.95</strong></span>
          <n-range id="opt-friction" min="0.8" max="0.99" step="0.01" value="0.95" class="opt-range"></n-range>
        </n-stack>
        <n-stack direction="row" align="center" gap="3">
          <span class="text-sm opt-label">Bounce damping: <strong id="damping-val">0.60</strong></span>
          <n-range id="opt-damping" min="0.1" max="0.9" step="0.05" value="0.6" class="opt-range"></n-range>
        </n-stack>
        <n-stack direction="row" align="center" gap="3">
          <span class="text-sm opt-label">Gravity: <strong id="gravity-val">0.00</strong></span>
          <n-range id="opt-gravity" min="0" max="2" step="0.1" value="0" class="opt-range"></n-range>
        </n-stack>
        <n-stack direction="row" align="center" gap="3">
          <n-switch id="opt-spin">Spin</n-switch>
        </n-stack>
        <n-stack direction="row" align="center" gap="3">
          <n-switch id="opt-bounce" checked>Bounce off edges</n-switch>
        </n-stack>
        <n-stack direction="row" align="center" gap="3">
          <n-switch id="opt-return">Return to origin</n-switch>
        </n-stack>
        <n-stack direction="row" gap="2">
          <n-button id="btn-reset" variant="secondary" size="sm">Reset Position</n-button>
        </n-stack>
      </n-stack>
    </n-container>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Attributes</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>data-trait-tossable-friction</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>0.95</code></n-table-cell>
            <n-table-cell>Velocity decay per frame. Lower values stop faster, higher values slide further.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-tossable-bounce</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>true</code></n-table-cell>
            <n-table-cell>Bounce off container edges.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-tossable-bounce-damping</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>0.6</code></n-table-cell>
            <n-table-cell>Energy retained after bounce (velocity multiplier).</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-tossable-gravity</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>0</code></n-table-cell>
            <n-table-cell>Downward acceleration per frame (px/frame&sup2;).</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-tossable-spin</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Add rotation during toss based on horizontal pointer movement.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-tossable-return-on-end</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Animate back to origin when momentum stops.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-tossable-disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disable toss behavior. Pointer events are ignored.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>

      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:toss</code></n-table-cell>
            <n-table-cell><code set:html={detailToss} /></n-table-cell>
            <n-table-cell>Fired when momentum ends. Includes final position, velocity, bounce count, and rotation.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:bounce</code></n-table-cell>
            <n-table-cell><code set:html={detailBounce} /></n-table-cell>
            <n-table-cell>Fired on container edge collision. <code>edge</code> is <code>"top"</code>, <code>"right"</code>, <code>"bottom"</code>, or <code>"left"</code>.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>

      <h3>CSS</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Selector</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>[tossing]</code></n-table-cell>
            <n-table-cell>Present on the element during the momentum/deceleration phase after release.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </section>

  <script>
    import './tossable.ts';
  </script>
  <style is:global>
    @import './tossable.css';
  </style>

</SidebarLayout>
