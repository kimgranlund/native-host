---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  basicPresent: `import { PresentController } from '@nonoun/native-ui';

const content = document.getElementById('my-content');
const ctrl = new PresentController(content);

// Present in fullscreen overlay
ctrl.present();

// Dismiss programmatically
ctrl.dismiss();

// Or let the user click the X button / backdrop / press Escape`,
  realWorldJs: `// From &lt;native-a2ui&gt; — a2ui-element.ts
import { PresentController } from '@nonoun/native-ui';

class A2UIElement extends NativeElement {
  #presentController: PresentController;

  setup() {
    this.#presentController = new PresentController(this);

    // Wire the expand button in the toolbar
    expandBtn.addEventListener('native:press', () =&gt; {
      this.#presentController.present();
    });
  }

  teardown() {
    this.#presentController.destroy();
  }
}`,
  realWorldCss: `/* Normal bounded state */
:where(native-a2ui) {
  display: grid;
  grid-template-rows: auto 1fr;
  min-height: 400px;
  border: var(--n-pg-border);
  border-radius: var(--n-radius-lg, 0.75rem);
  overflow: hidden;
}

/* Full-viewport presented state — [presented] set by PresentController */
:where(native-a2ui)[presented] {
  width: 100%;
  height: 100%;
  justify-self: stretch;
  align-self: stretch;
  border: none;
  border-radius: 0;
}`,
  customInset: `&lt;!-- Declarative via n-controller --&gt;
&lt;n-controller traits="presentable" presentable-inset="4rem"&gt;
  &lt;div id="content"&gt;...&lt;/div&gt;
&lt;/n-controller&gt;

&lt;!-- Imperative --&gt;
&lt;script&gt;
  import { PresentController } from '@nonoun/native-ui';
  const ctrl = new PresentController(el, { inset: '4rem' });
  ctrl.present();
&lt;/script&gt;`,
  noCloseButton: `const ctrl = new PresentController(el, {
  closeButton: false
});

// Must dismiss programmatically or via backdrop/Escape
ctrl.present();`,
};
---
<SidebarLayout title="Presentable">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Presentable</h1>
      </div>
    </div>
    <div data-slot="description">

      Composable trait that shows content in a full-viewport dialog overlay. Wraps the host element in a modal <code>&lt;dialog&gt;</code> at its current DOM position so CSS custom properties inherit normally. On dismiss the host is unwrapped back to its original position.

    </div>
  </header>

  <main>

    <!-- ── Basic ── -->

    <h2>Basic</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Click the button to present the card in a fullscreen overlay. Close with the X button, click outside, or press Escape.
      </n-text>
      <n-button id="present-basic">Present Content</n-button>
      <div class="present-card"><n-card id="present-content-1">
        <n-header><h3>Presented Content</h3></n-header>
        <n-body>
          <n-text size="sm">This card is now displayed in a full-viewport dialog overlay. The content is wrapped in a modal <code>&lt;dialog&gt;</code> using <code>showModal()</code> for top-layer rendering.</n-text>
          <n-text size="sm">Close by clicking the X button, clicking the backdrop, or pressing Escape.</n-text>
        </n-body>
      </n-card></div>
      <pre class="layout-code"><code set:html={codeExamples.basicPresent} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Custom Inset ── -->

    <h2>Custom Inset</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        The <code>inset</code> option controls the safety margin from viewport edges. Default is <code>2rem</code>. Try different values to see the effect.
      </n-text>
      <n-stack direction="row" gap="3">
        <n-button id="present-inset-1rem">Inset: 1rem</n-button>
        <n-button id="present-inset-4rem">Inset: 4rem</n-button>
        <n-button id="present-inset-8rem">Inset: 8rem</n-button>
      </n-stack>
      <div class="present-card"><n-card id="present-content-2">
        <n-header><h3>Custom Inset</h3></n-header>
        <n-body>
          <n-text size="sm">This card is presented with a custom inset value. The inset controls how much space is reserved between the dialog wrapper and the viewport edges.</n-text>
        </n-body>
      </n-card></div>
      <pre class="layout-code"><code set:html={codeExamples.customInset} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Without Close Button ── -->

    <h2>Without Close Button</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Set <code>closeButton: false</code> to hide the X button. The overlay can still be dismissed via backdrop click or Escape, or programmatically with <code>dismiss()</code>.
      </n-text>
      <n-button id="present-no-close">Present (no X button)</n-button>
      <div class="present-card"><n-card id="present-content-3">
        <n-header><h3>No Close Button</h3></n-header>
        <n-body>
          <n-text size="sm">There is no X button in this overlay. Click outside the card or press Escape to dismiss.</n-text>
        </n-body>
      </n-card></div>
      <pre class="layout-code"><code set:html={codeExamples.noCloseButton} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Events ── -->

    <h2>Events</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        <code>native:present</code> fires after the dialog opens. <code>native:dismiss</code> fires after the dialog closes and the host is restored to its original DOM position.
      </n-text>
      <n-button id="present-events">Present with Events</n-button>
      <div class="present-card"><n-card id="present-content-4">
        <n-header><h3>Event Demo</h3></n-header>
        <n-body>
          <n-text size="sm">Open and close this overlay to see events logged below.</n-text>
        </n-body>
      </n-card></div>
      <div id="log" class="output"></div>
    </n-panel>

    <!-- ── Real-World Usage ── -->

    <h2>Real-World Usage</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        The <code>&lt;native-a2ui&gt;</code> workbench uses PresentController to provide a full-viewport expand mode. Click the <n-icon name="arrows-out-simple" size="sm"></n-icon> button in any workbench toolbar to see it in action.
      </n-text>
      <h3>Component Setup</h3>
      <n-text size="xs" muted spacing="tight">
        The component creates a <code>PresentController</code> on itself during <code>setup()</code> and wires an expand button to call <code>present()</code>. The controller is destroyed in <code>teardown()</code>.
      </n-text>
      <pre class="layout-code"><code set:html={codeExamples.realWorldJs} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
      <h3>CSS Hook — <code>[presented]</code></h3>
      <n-text size="xs" muted spacing="tight">
        When <code>present()</code> is called, PresentController sets <code>[presented]</code> on the host element. The component uses this to switch from a bounded card layout to full-viewport mode. On dismiss, the attribute is removed and CSS reverts.
      </n-text>
      <pre class="layout-code"><code set:html={codeExamples.realWorldCss} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
      <h3>Key Design Decisions</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>showModal()</code></n-table-cell>
            <n-table-cell>Promotes to top layer for rendering, but the element stays at its DOM position. CSS custom properties from ancestors inherit normally.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Centering wrapper</n-table-cell>
            <n-table-cell><code>&lt;dialog&gt; &gt; &lt;div&gt; &gt; host</code> — the wrapper uses <code>display: grid; place-items: center</code> with the configurable inset margin.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Clean unwrap</n-table-cell>
            <n-table-cell><code>dialog.replaceWith(this.host)</code> restores the original DOM structure on dismiss. The <code>[presented]</code> attribute is removed so CSS reverts.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <n-text size="xs" muted spacing="tight">
        Try it: <a href="/a2ui/a2ui-workbench">A2UI Workbench</a> — click the expand icon in the toolbar header.
      </n-text>
    </n-panel>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Constructor</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Option</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>inset</code></n-table-cell>
            <n-table-cell><code>'2rem'</code></n-table-cell>
            <n-table-cell>Safety margin from viewport edges. Any valid CSS length.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>closeButton</code></n-table-cell>
            <n-table-cell><code>true</code></n-table-cell>
            <n-table-cell>Show a close X button in the top-right corner of the overlay.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Methods</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Method</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>present()</code></n-table-cell>
            <n-table-cell>Wraps the host element in a modal <code>&lt;dialog&gt;</code> and calls <code>showModal()</code>. No-op if already open.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>dismiss()</code></n-table-cell>
            <n-table-cell>Closes the dialog and restores the host to its original DOM position. No-op if not open.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>destroy()</code></n-table-cell>
            <n-table-cell>Dismisses if open and cleans up. Call in <code>teardown()</code>.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Properties</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Property</n-table-header><n-table-header>Type</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>open</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell>Read-only. Whether the overlay is currently open.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:present</code></n-table-cell>
            <n-table-cell>--</n-table-cell>
            <n-table-cell>Dispatched on the host after the dialog opens via <code>showModal()</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:dismiss</code></n-table-cell>
            <n-table-cell>--</n-table-cell>
            <n-table-cell>Dispatched on the host after the dialog closes and the host is restored to its original DOM position.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Provider Attributes</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>presentable-inset</code></n-table-cell>
            <n-table-cell><code>2rem</code></n-table-cell>
            <n-table-cell>Safety margin from viewport edges when used with <code>&lt;n-controller traits="presentable"&gt;</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>presentable-close-button</code></n-table-cell>
            <n-table-cell><code>true</code></n-table-cell>
            <n-table-cell>Set to <code>"false"</code> to hide the close button.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </main>

  <script>
    import { PresentController } from '@nonoun/native-ui';
    import { logAppend } from '../../scripts/event-log';

    document.addEventListener('astro:page-load', () => {
      if (!document.getElementById('present-basic')) return;

      // ── Basic Demo ──

      const content1 = document.getElementById('present-content-1');
      if (!content1) return;
      const ctrl1 = new PresentController(content1);

      document.getElementById('present-basic')?.addEventListener('native:press', () => {
        ctrl1.present();
      });

      // ── Custom Inset Demo ──

      const content2 = document.getElementById('present-content-2');
      if (!content2) return;
      let ctrl2 = null;

      function presentWithInset(inset) {
        // Destroy previous controller to reset options
        ctrl2?.destroy();
        ctrl2 = new PresentController(content2, { inset });
        ctrl2.present();
      }

      document.getElementById('present-inset-1rem')?.addEventListener('native:press', () => presentWithInset('1rem'));
      document.getElementById('present-inset-4rem')?.addEventListener('native:press', () => presentWithInset('4rem'));
      document.getElementById('present-inset-8rem')?.addEventListener('native:press', () => presentWithInset('8rem'));

      // ── No Close Button Demo ──

      const content3 = document.getElementById('present-content-3');
      if (!content3) return;
      const ctrl3 = new PresentController(content3, { closeButton: false });

      document.getElementById('present-no-close')?.addEventListener('native:press', () => {
        ctrl3.present();
      });

      // ── Events Demo ──

      const content4 = document.getElementById('present-content-4');
      if (!content4) return;
      const ctrl4 = new PresentController(content4);
      const logEl = document.getElementById('log');
      let count = 0;

      content4.addEventListener('native:present', () => {
        count++;
        logAppend(logEl, `#${count} native:present — overlay opened`);
      });

      content4.addEventListener('native:dismiss', () => {
        count++;
        logAppend(logEl, `#${count} native:dismiss — overlay closed, host restored`);
      });

      document.getElementById('present-events')?.addEventListener('native:press', () => {
        ctrl4.present();
      });
    });
  </script>
  <style is:global>
    .present-card {
      margin-top: 0.75rem;
      max-width: 32rem;
    }

    .output {
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      max-height: 6rem;
      overflow-y: auto;
      margin-top: 0.75rem;
      padding: 0.5rem;
      background: var(--n-panel-neutral);
      border-radius: 0.25rem;
    }

    /* ── Code Blocks ── */
</style>

</SidebarLayout>
