---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';

const codeExamples = {
  fileDropZoneProvider: `&lt;n-controller traits="droppable"&gt;
  &lt;div class="drop-zone"&gt;
    Drop files here
  &lt;/div&gt;
&lt;/n-controller&gt;

&lt;script&gt;
  zone.addEventListener('native:drop', (e) =&gt; {
    if (e.detail.type === 'file') {
      for (const file of e.detail.files) {
        console.log(file.name, file.size);
      }
    }
  });
&lt;/script&gt;`,
  textDropProvider: `&lt;n-controller traits="droppable"&gt;
  &lt;div class="drop-zone"&gt;
    Drop text here
  &lt;/div&gt;
&lt;/n-controller&gt;

&lt;script&gt;
  zone.addEventListener('native:drop', (e) =&gt; {
    if (e.detail.type === 'text') {
      console.log('Dropped text:', e.detail.text);
    }
  });
&lt;/script&gt;`,
};
const detailDrop = `{ type, files?, text?, dataTransfer? }`;
---
<SidebarLayout title="Droppable">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Droppable</h1>
      </div>
    </div>
    <div slot="description">

      External file/data drop zone using the HTML5 drag-and-drop API. Sets <code>[drop-active]</code> when a valid item is dragged over and <code>[drop-invalid]</code> when the MIME type does not match <code>droppable-accept</code>.

    </div>
  </header>

  <section>

    <!-- ── File Drop Zone (Provider) ── -->

    <h2>File Drop Zone (Provider)</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        <code>&lt;n-controller traits="droppable"&gt;</code> wraps a plain div. Drop any files onto the zone.
      </span>
      <n-controller traits="droppable">
        <div class="drop-zone" id="files-zone">
          <span class="drop-icon">&#128193;</span>
          <span>Drop files here</span>
          <span class="drop-hint">Any file type accepted</span>
        </div>
      </n-controller>
      <div id="files-list" class="file-list" class="drop-hidden"></div>
      <div id="files-log" class="output"></div>
      <pre class="code-block"><code set:html={codeExamples.fileDropZoneProvider} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Image Only (Provider) ── -->

    <h2>Image Only (Provider)</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        <code>droppable-accept="image/*"</code> filter. Shows <code>[drop-invalid]</code> when a non-image is dragged over.
      </span>
      <n-controller traits="droppable" droppable-accept="image/*">
        <div class="drop-zone" id="images-zone">
          <span class="drop-icon">&#128247;</span>
          <span>Drop images here</span>
          <span class="drop-hint">Only image files accepted</span>
        </div>
      </n-controller>
      <div id="images-list" class="file-list" class="drop-hidden"></div>
      <div id="images-log" class="output"></div>
      <pre class="code-block"><code>&lt;n-controller traits="droppable" droppable-accept="image/*"&gt;
  &lt;div class="drop-zone"&gt;
    Drop images here
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Text Drop (Provider) ── -->

    <h2>Text Drop (Provider)</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Drop plain text from a browser selection. Select text elsewhere and drag it onto the zone.
      </span>
      <n-controller traits="droppable">
        <div class="drop-zone" id="text-zone">
          <span class="drop-icon">&#128196;</span>
          <span>Drop text here</span>
          <span class="drop-hint">Select text in your browser and drag it here</span>
        </div>
      </n-controller>
      <div id="text-content" class="dropped-text" class="drop-hidden"></div>
      <div id="text-log" class="output"></div>
      <pre class="code-block"><code set:html={codeExamples.textDropProvider} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Single File (Provider) ── -->

    <h2>Single File (Provider)</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        <code>droppable-multiple="false"</code>. Only the first file is accepted when multiple are dropped.
      </span>
      <n-controller traits="droppable" droppable-multiple="false">
        <div class="drop-zone" id="single-zone">
          <span class="drop-icon">&#128206;</span>
          <span>Drop a single file</span>
          <span class="drop-hint">Only the first file will be accepted</span>
        </div>
      </n-controller>
      <div id="single-list" class="file-list" class="drop-hidden"></div>
      <div id="single-log" class="output"></div>
      <pre class="code-block"><code>&lt;n-controller traits="droppable" droppable-multiple="false"&gt;
  &lt;div class="drop-zone"&gt;
    Drop a single file
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Provider Usage</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>droppable-accept</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell><code>'*'</code></n-table-cell>
            <n-table-cell>MIME type filter (e.g. <code>'image/*'</code>, <code>'application/pdf'</code>). Uses wildcard matching.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>droppable-disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disables drop zone when true.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>droppable-multiple</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>true</code></n-table-cell>
            <n-table-cell>When <code>"false"</code>, only the first file from a multi-file drop is accepted.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:drop</code></n-table-cell>
            <n-table-cell><code set:html={detailDrop} /></n-table-cell>
            <n-table-cell>Unified drop event. <code>type</code> is <code>'file'</code> or <code>'text'</code>. File drops include <code>files</code> (array of <code>File</code>) and <code>dataTransfer</code>. Text drops include <code>text</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:drop-enter</code></n-table-cell>
            <n-table-cell>&mdash;</n-table-cell>
            <n-table-cell>Fired when a dragged item enters the drop zone.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:drop-leave</code></n-table-cell>
            <n-table-cell>&mdash;</n-table-cell>
            <n-table-cell>Fired when a dragged item leaves the drop zone.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>CSS</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Selector</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>[drop-active]</code></n-table-cell>
            <n-table-cell>Present when a valid item is being dragged over the zone.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>[drop-invalid]</code></n-table-cell>
            <n-table-cell>Present when a dragged item does not match <code>droppable-accept</code>.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </section>

  <script>
    import './droppable.ts';
  </script>
  <style is:global>
    @import './droppable.css';
  </style>

</SidebarLayout>
