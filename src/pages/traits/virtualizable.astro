---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const virtualChangeDetail = `{ start, end, totalCount }`;
const codeExamples = {
  tenThousandItems: `import { VirtualScrollController } from '@nonoun/native-ui';

const host = document.getElementById('host1');
const viewport = document.getElementById('viewport1');
const content = document.getElementById('content1');

const vctrl = new VirtualScrollController(host, {
  itemHeight: 40,
  overscan: 5,
});
vctrl.enable(viewport, content, 10000);

host.addEventListener('native:virtual-change', (e) =&gt; {
  renderRows(e.detail.start, e.detail.end);
});

// Initial render
renderRows(vctrl.start, vctrl.end);`,
  dynamicCount: `const vctrl2 = new VirtualScrollController(host2, {
  itemHeight: 40,
  overscan: 5,
});
vctrl2.enable(viewport2, content2, 100);

addBtn.addEventListener('native:press', () =&gt; {
  dynamicCount += 1000;
  vctrl2.updateCount(dynamicCount);
});

resetBtn.addEventListener('native:press', () =&gt; {
  dynamicCount = 100;
  vctrl2.updateCount(dynamicCount);
});`,
  virtualscrollcontrollerAttachToAnyElement: `import { VirtualScrollController } from '@nonoun/native-ui';

const host = document.getElementById('ctrl-host');
const viewport = document.getElementById('ctrl-viewport');
const content = document.getElementById('ctrl-content');

const vctrl = new VirtualScrollController(host, {
  itemHeight: 40,
  overscan: 5,
});
vctrl.enable(viewport, content, 5000);

host.addEventListener('native:virtual-change', (e) =&gt; {
  renderRows(e.detail.start, e.detail.end);
});`,
};
---
<SidebarLayout title="Virtualizable">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Virtualizable</h1>
      </div>
    </div>
    <div slot="description">

      Composable trait for windowed rendering of large lists. Only renders visible items plus an overscan buffer. Dispatches <code>native:virtual-change</code> with the visible range so you can render only what's needed. All demos use <code>VirtualScrollController</code> directly since <code>enable(scrollEl, container, totalCount)</code> must be called to start virtualization. <code>n-controller</code> can create the controller declaratively, but <code>enable()</code> must still be called to begin.

    </div>
  </header>

  <section>

    <!-- ── 10,000 Items ── -->

    <h2>10,000 Items</h2>
    <n-container data-kind="panel" bordered>
      <div class="stats">
        <span>Total: <strong>10,000</strong></span>
        <span>Rendered: <strong id="rendered-count">0</strong></span>
        <span>Range: <strong id="range-display">0–0</strong></span>
      </div>
      <div id="host1">
        <div class="scroll-viewport" id="viewport1">
          <div class="scroll-content" id="content1"></div>
        </div>
      </div>
      <pre class="code-block"><code set:html={codeExamples.tenThousandItems} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Dynamic Count ── -->

    <h2>Dynamic Count</h2>
    <n-container data-kind="panel" bordered>
      <div class="dynamic-actions"><n-stack direction="row">
        <n-button id="add-btn" size="sm">Add 1,000</n-button>
        <n-button id="reset-btn" size="sm">Reset to 100</n-button>
      </n-stack></div>
      <div id="host2">
        <div class="scroll-viewport" id="viewport2">
          <div class="scroll-content" id="content2"></div>
        </div>
      </div>
      <div id="dynamic-output" class="output">100 items</div>
      <pre class="code-block"><code set:html={codeExamples.dynamicCount} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── VirtualScrollController: Attach to Any Element ── -->

    <h2>VirtualScrollController — Attach to Any Element</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Use <code>VirtualScrollController</code> to add virtual scrolling to an existing element without subclassing. Same events, same API — no trait mixin required.
      </span>
      <div class="stats">
        <span>Total: <strong>5,000</strong></span>
        <span>Rendered: <strong id="ctrl-rendered">0</strong></span>
        <span>Range: <strong id="ctrl-range">0–0</strong></span>
      </div>
      <div id="ctrl-host">
        <div class="scroll-viewport" id="ctrl-viewport">
          <div class="scroll-content" id="ctrl-content"></div>
        </div>
      </div>
      <pre class="code-block"><code set:html={codeExamples.virtualscrollcontrollerAttachToAnyElement} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Constructor Options</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Option</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>itemHeight</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>40</code></n-table-cell>
            <n-table-cell>Fixed height (in pixels) of each virtual row. Used to calculate total scroll height and visible range.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>overscan</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>5</code></n-table-cell>
            <n-table-cell>Number of extra rows to render above and below the visible viewport for smoother scrolling.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Methods</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Method</n-table-header><n-table-header>Returns</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>enable(scrollEl, container, totalCount)</code></n-table-cell>
            <n-table-cell><code>void</code></n-table-cell>
            <n-table-cell>Starts virtualization. <code>scrollEl</code> is the scrollable viewport, <code>container</code> is the content wrapper, <code>totalCount</code> is the total number of items. Creates top/bottom spacer elements and attaches the scroll listener.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>disable()</code></n-table-cell>
            <n-table-cell><code>void</code></n-table-cell>
            <n-table-cell>Stops virtualization and removes the scroll listener. Spacers remain in the DOM.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>updateCount(count)</code></n-table-cell>
            <n-table-cell><code>void</code></n-table-cell>
            <n-table-cell>Updates the total item count and recalculates the visible range. Use when items are added or removed.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>destroy()</code></n-table-cell>
            <n-table-cell><code>void</code></n-table-cell>
            <n-table-cell>Fully tears down the controller: removes scroll listener and spacer elements.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:virtual-change</code></n-table-cell>
            <n-table-cell><code set:html={virtualChangeDetail} /></n-table-cell>
            <n-table-cell>Dispatched on the host element when the visible range changes. <code>start</code> is the first visible index, <code>end</code> is one past the last visible index. Render rows for indices <code>[start, end)</code>.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Properties</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Property</n-table-header><n-table-header>Type</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>start</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell>Current start index of the visible range (inclusive). Read-only.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>end</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell>Current end index of the visible range (exclusive). Read-only.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </section>

  <script>
import { VirtualScrollController } from '@nonoun/native-ui';

document.addEventListener('astro:page-load', () => {
      if (!document.getElementById('host1')) return;

      // ── Helper: render rows into a content container ──

      function renderRows(container, start, end, prefix) {
        const old = container.querySelectorAll('.virtual-row');
        for (const r of old) r.remove();

        const frag = document.createDocumentFragment();
        for (let i = start; i < end; i++) {
          const row = document.createElement('div');
          row.className = 'virtual-row';
          row.textContent = `${prefix} ${i + 1} — Item data here`;
          frag.appendChild(row);
        }
        // Insert rows between spacers
        const bottomSpacer = container.querySelector('.n-virtual-spacer-bottom');
        container.insertBefore(frag, bottomSpacer);
      }

      // ── 10,000 Items Demo ──

      const TOTAL1 = 10000;
      const host1 = document.getElementById('host1');
      const viewport1 = document.getElementById('viewport1');
      const content1 = document.getElementById('content1');
      if (!host1 || !viewport1 || !content1) return;
      const renderedEl = document.getElementById('rendered-count');
      const rangeEl = document.getElementById('range-display');

      const vctrl1 = new VirtualScrollController(host1, {
        itemHeight: 40,
        overscan: 5,
      });
      vctrl1.enable(viewport1, content1, TOTAL1);

      host1.addEventListener('native:virtual-change', (e) => {
        const { start, end } = /** @type {CustomEvent} */ (e).detail;
        renderRows(content1, start, end, 'Row');
        if (renderedEl) renderedEl.textContent = String(end - start);
        if (rangeEl) rangeEl.textContent = `${start}\u2013${end}`;
      });

      // Initial render
      renderRows(content1, vctrl1.start, vctrl1.end, 'Row');
      if (renderedEl) renderedEl.textContent = String(vctrl1.end - vctrl1.start);
      if (rangeEl) rangeEl.textContent = `${vctrl1.start}\u2013${vctrl1.end}`;

      // ── Dynamic Count Demo ──

      let dynamicCount = 100;
      const host2 = document.getElementById('host2');
      const viewport2 = document.getElementById('viewport2');
      const content2 = document.getElementById('content2');
      if (!host2 || !viewport2 || !content2) return;
      const dynOut = document.getElementById('dynamic-output');

      const vctrl2 = new VirtualScrollController(host2, {
        itemHeight: 40,
        overscan: 5,
      });
      vctrl2.enable(viewport2, content2, dynamicCount);

      host2.addEventListener('native:virtual-change', (e) => {
        const { start, end, totalCount } = /** @type {CustomEvent} */ (e).detail;
        renderRows(content2, start, end, 'Dynamic row');
        if (dynOut) dynOut.textContent = `${totalCount} items \u2014 showing ${start}\u2013${end}`;
      });

      // Initial render
      renderRows(content2, vctrl2.start, vctrl2.end, 'Dynamic row');

      document.getElementById('add-btn')?.addEventListener('native:press', () => {
        dynamicCount += 1000;
        vctrl2.updateCount(dynamicCount);
        if (dynOut) dynOut.textContent = `${dynamicCount} items`;
      });

      document.getElementById('reset-btn')?.addEventListener('native:press', () => {
        dynamicCount = 100;
        vctrl2.updateCount(dynamicCount);
        if (dynOut) dynOut.textContent = `${dynamicCount} items`;
      });

      // ── VirtualScrollController — Attach to Any Element ──

      const CTRL_TOTAL = 5000;
      const ctrlHost = document.getElementById('ctrl-host');
      const ctrlViewport = document.getElementById('ctrl-viewport');
      const ctrlContent = document.getElementById('ctrl-content');
      if (!ctrlHost || !ctrlViewport || !ctrlContent) return;
      const ctrlRendered = document.getElementById('ctrl-rendered');
      const ctrlRange = document.getElementById('ctrl-range');

      const vctrl3 = new VirtualScrollController(ctrlHost, {
        itemHeight: 40,
        overscan: 5,
      });
      vctrl3.enable(ctrlViewport, ctrlContent, CTRL_TOTAL);

      ctrlHost.addEventListener('native:virtual-change', (e) => {
        const { start, end } = /** @type {CustomEvent} */ (e).detail;
        renderRows(ctrlContent, start, end, 'Controller row');
        if (ctrlRendered) ctrlRendered.textContent = String(end - start);
        if (ctrlRange) ctrlRange.textContent = `${start}\u2013${end}`;
      });

      // Initial render
      renderRows(ctrlContent, vctrl3.start, vctrl3.end, 'Controller row');
      if (ctrlRendered) ctrlRendered.textContent = String(vctrl3.end - vctrl3.start);
      if (ctrlRange) ctrlRange.textContent = `${vctrl3.start}\u2013${vctrl3.end}`;
});
  </script>
  <style is:global>
    .scroll-viewport {
      height: 300px;
      overflow-y: auto;
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.375rem;
    }

    .scroll-content {
      position: relative;
    }

    .virtual-row {
      display: flex;
      align-items: center;
      padding: 0 1rem;
      height: 40px;
      font-size: 0.875rem;
      border-bottom: 1px solid var(--n-border-muted-neutral);
    }

    .virtual-row:nth-child(even of .virtual-row) {
      background: var(--n-panel-neutral);
    }

    .stats {
      display: flex;
      gap: 1.5rem;
      font-size: 0.8125rem;
      color: var(--n-ink-muted-neutral);
      margin-bottom: 0.75rem;
    }

    .stats strong {
      color: var(--n-ink-neutral);
    }

    .output {
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      margin-top: 0.75rem;
      padding: 0.5rem;
      background: var(--n-panel-neutral);
      border-radius: 0.25rem;
      min-height: 1.5rem;
    }

    .dynamic-actions {
      margin-bottom: 0.75rem;
    }

    /* ── Code Blocks ── */
</style>

</SidebarLayout>
