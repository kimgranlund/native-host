---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';

const codeExamples = {
  interactive: `import { NoodleController, MagnetController } from '@nonoun/native-ui';

const arena = document.getElementById('flow-arena');

// Make nodes draggable
new MagnetController(arena, {
  selector: '.flow-node',
  snapToEdges: true,
  threshold: 15,
  guides: true,
});

// Editable noodle connections
const noodle = new NoodleController(arena, {
  editable: true,
  showPorts: true,
  animated: true,
  strokeWidth: 2.5,
});

// Update noodles when nodes move
arena.addEventListener('native:magnet-snap', () =&gt; noodle.update());
arena.addEventListener('native:magnet-drop', () =&gt; noodle.update());`,
  curveStyles: `// Bezier (smooth curves — default)
new NoodleController(arena1, { style: 'bezier', tension: 0.5 });

// Step (right-angle connectors)
new NoodleController(arena2, { style: 'step' });

// Straight (direct lines)
new NoodleController(arena3, { style: 'straight' });`,
  staticConnections: `&lt;n-controller traits="noodleable"
  data-trait-noodleable-style="bezier"&gt;
  &lt;div class="noodle-arena" id="static-arena"&gt;
    &lt;div class="flow-node" intent="accent" id="node-a"
         data-noodle-port="right"
         style="left: 2rem; top: 5rem;"&gt;Input A&lt;/div&gt;
    &lt;div class="flow-node" intent="info" id="node-b"
         data-noodle-port="left right"
         style="left: 16rem; top: 5rem;"&gt;Process&lt;/div&gt;
    &lt;div class="flow-node" intent="success" id="node-c"
         data-noodle-port="left"
         style="left: 30rem; top: 5rem;"&gt;Output&lt;/div&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;`,
  disabled: `// Disabled — connections visible but not interactive
const noodle = new NoodleController(arena, {
  disabled: true,
  connections: [
    { id: 'c1', from: 'node-a', to: 'node-b',
      fromPort: 'right', toPort: 'left' },
    { id: 'c2', from: 'node-b', to: 'node-c',
      fromPort: 'right', toPort: 'left' },
  ],
});

// Toggle at runtime
noodle.disabled = false;`,
  programmatic: `import { NoodleController } from '@nonoun/native-ui';

const noodle = new NoodleController(arena, {
  editable: true,
  animated: true,
  connections: [
    { id: 'c1', from: 'node-a', to: 'node-b',
      fromPort: 'right', toPort: 'left' },
  ],
});

// Programmatic API
noodle.connect('node-b', 'node-c', 'right', 'left');
noodle.disconnect('c1');
noodle.getConnections();
noodle.clear();
noodle.update();   // force re-render
noodle.destroy();  // cleanup`,
};

const detailConnect = `{ id, from, to, fromPort, toPort }`;
const detailDisconnect = `{ id, from, to, fromPort, toPort }`;
const detailDrag = `{ from, fromPort, x, y }`;
const eventLogCode = `document.addEventListener('native:noodle-connect', (e) =&gt; {
  const { id, from, to, fromPort, toPort } = e.detail;
  log(\`connect: \${from}:\${fromPort} → \${to}:\${toPort} (\${id})\`);
});

document.addEventListener('native:noodle-disconnect', (e) =&gt; {
  const { id, from, to } = e.detail;
  log(\`disconnect: \${from} → \${to} (\${id})\`);
});`;
---
<SidebarLayout title="Noodleable">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Noodleable</h1>
      </div>
    </div>
    <div slot="description">

      Draws curved SVG connections ("noodles") between DOM elements. Use for logic flow builders, schema relationship editors, and node graphs. Supports drag-to-connect, click-to-delete, three curve styles, and flowing animations. Dispatches <code>native:noodle-connect</code> and <code>native:noodle-disconnect</code> events.

    </div>
  </header>

  <section id="noodleable-page">

    <!-- ── Interactive Flow Builder ── -->

    <h2>Interactive Flow Builder</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Drag from a port dot to another port to create a connection. Click a noodle to delete it. Nodes are draggable via MagnetController. Hover a port and click <code>+</code> to add a node. Drag empty space to pan the canvas. The JSON pane on the right is live and editable.
      </span>
      <div class="flow-split" id="flow-split">
        <n-header>
          <n-toolbar variant="ghost" size="sm">
            <span class="flow-toolbar-title">Flow Builder</span>
            <n-select id="flow-doc-select" placeholder="Load dataset…" size="sm" style="min-width: 14rem;"></n-select>
            <span fill></span>
            <n-button id="layout-flow" size="sm" variant="ghost" aria-label="Flow layout"><n-icon name="flow-arrow"></n-icon></n-button>
            <n-button id="layout-dag" size="sm" variant="ghost" aria-label="DAG layout"><n-icon name="git-branch"></n-icon></n-button>
            <n-button id="layout-grid" size="sm" variant="ghost" aria-label="Grid layout"><n-icon name="grid-four"></n-icon></n-button>
            <n-button id="layout-cluster" size="sm" variant="ghost" aria-label="Cluster layout"><n-icon name="graph"></n-icon></n-button>
            <n-button id="layout-tree" size="sm" variant="ghost" aria-label="Tree layout"><n-icon name="tree-structure"></n-icon></n-button>
            <n-button id="layout-radial" size="sm" variant="ghost" aria-label="Radial layout"><n-icon name="target"></n-icon></n-button>
            <n-button id="layout-force" size="sm" variant="ghost" aria-label="Force layout"><n-icon name="atom"></n-icon></n-button>
            <n-button id="layout-swimlane" size="sm" variant="ghost" aria-label="Swimlane layout"><n-icon name="rows"></n-icon></n-button>
            <n-divider orientation="vertical" class="flow-toolbar-divider"></n-divider>
            <n-button id="zoom-out" size="sm" variant="ghost" aria-label="Zoom out"><n-icon name="minus"></n-icon></n-button>
            <span id="zoom-label" class="flow-zoom-label">100%</span>
            <n-button id="zoom-in" size="sm" variant="ghost" aria-label="Zoom in"><n-icon name="plus"></n-icon></n-button>
            <n-divider orientation="vertical" class="flow-toolbar-divider"></n-divider>
            <n-switch id="flow-snap-toggle" size="sm">Snap</n-switch>
            <n-switch id="flow-guides-toggle" size="sm">Guides</n-switch>
            <n-button id="flow-lightbox-btn" size="sm" variant="ghost" aria-label="Expand"><n-icon name="arrows-out-simple"></n-icon></n-button>
          </n-toolbar>
        </n-header>
        <div class="flow-split-canvas" id="flow-canvas-pane">
          <div class="canvas-viewport" id="flow-viewport">
            <div class="canvas-transform" id="flow-transform">
              <div class="noodle-arena noodle-arena--tall" id="flow-arena">
                <!-- Inputs -->
                <div class="flow-node" intent="accent" id="f-sensor" data-noodle-port="right bottom" style="left: 1.5rem; top: 2rem;">Sensor</div>
                <div class="flow-node" intent="accent" id="f-api" data-noodle-port="right top bottom" style="left: 1.5rem; top: 10rem;">API</div>
                <div class="flow-node" intent="accent" id="f-timer" data-noodle-port="right top" style="left: 1.5rem; top: 18rem;">Timer</div>
                <!-- Processing -->
                <div class="flow-node" intent="info" id="f-filter" data-noodle-port="left right top bottom" style="left: 14rem; top: 3.5rem;">Filter</div>
                <div class="flow-node" intent="info" id="f-transform" data-noodle-port="left right top bottom" style="left: 14rem; top: 11.5rem;">Transform</div>
                <div class="flow-node" intent="info" id="f-merge" data-noodle-port="left right top bottom" style="left: 26rem; top: 7.5rem;">Merge</div>
                <!-- Outputs -->
                <div class="flow-node" intent="success" id="f-display" data-noodle-port="left top bottom" style="left: 38rem; top: 3.5rem;">Display</div>
                <div class="flow-node" intent="success" id="f-database" data-noodle-port="left top bottom" style="left: 38rem; top: 11.5rem;">Database</div>
                <div class="flow-node" intent="success" id="f-alert" data-noodle-port="left top" style="left: 38rem; top: 19rem;">Alert</div>
              </div>
            </div>
          </div>
          <div class="flow-split-handle" id="flow-split-handle"></div>
        </div>
        <n-pane id="flow-editor-pane">
          <n-header>
            <nav><n-icon inline name="brackets-curly"></n-icon></nav>
            <span>JSON</span>
          </n-header>
          <n-body>
            <div id="flow-json-editor"></div>
          </n-body>
        </n-pane>
      </div>
      <pre class="code-block"><code set:html={codeExamples.interactive} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Curve Styles ── -->

    <h2>Curve Styles</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Three connection styles side by side: <code>bezier</code> (smooth curves), <code>step</code> (right-angle connectors), and <code>straight</code> (direct lines).
      </span>
      <div style="display: flex; gap: 1rem;">
        <div style="flex: 1;">
          <span class="text-xs text-strong">Bezier</span>
          <div class="noodle-arena noodle-arena--short" id="style-bezier">
            <div class="flow-node" intent="accent" id="bz-a" data-noodle-port="right" style="left: 1rem; top: 2rem;">A</div>
            <div class="flow-node" intent="info" id="bz-b" data-noodle-port="left right" style="left: 8rem; top: 6rem;">B</div>
            <div class="flow-node" intent="success" id="bz-c" data-noodle-port="left" style="left: 15rem; top: 2rem;">C</div>
          </div>
        </div>
        <div style="flex: 1;">
          <span class="text-xs text-strong">Step</span>
          <div class="noodle-arena noodle-arena--short" id="style-step">
            <div class="flow-node" intent="accent" id="st-a" data-noodle-port="right" style="left: 1rem; top: 2rem;">A</div>
            <div class="flow-node" intent="info" id="st-b" data-noodle-port="left right" style="left: 8rem; top: 6rem;">B</div>
            <div class="flow-node" intent="success" id="st-c" data-noodle-port="left" style="left: 15rem; top: 2rem;">C</div>
          </div>
        </div>
        <div style="flex: 1;">
          <span class="text-xs text-strong">Straight</span>
          <div class="noodle-arena noodle-arena--short" id="style-straight">
            <div class="flow-node" intent="accent" id="sl-a" data-noodle-port="right" style="left: 1rem; top: 2rem;">A</div>
            <div class="flow-node" intent="info" id="sl-b" data-noodle-port="left right" style="left: 8rem; top: 6rem;">B</div>
            <div class="flow-node" intent="success" id="sl-c" data-noodle-port="left" style="left: 15rem; top: 2rem;">C</div>
          </div>
        </div>
      </div>
      <pre class="code-block"><code set:html={codeExamples.curveStyles} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Static Connections ── -->

    <h2>Static Connections</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Pre-wired bezier connections between three nodes. Not editable — demonstrates the simplest setup with declarative connections via the programmatic API.
      </span>
      <div class="noodle-arena" id="static-arena">
        <div class="flow-node" intent="accent" id="s-in1" data-noodle-port="right" style="left: 2rem; top: 3rem;">Input A</div>
        <div class="flow-node" intent="accent" id="s-in2" data-noodle-port="right" style="left: 2rem; top: 10rem;">Input B</div>
        <div class="flow-node" intent="info" id="s-proc" data-noodle-port="left right" style="left: 16rem; top: 6.5rem;">Process</div>
        <div class="flow-node" intent="success" id="s-out" data-noodle-port="left" style="left: 30rem; top: 6.5rem;">Output</div>
      </div>
      <pre class="code-block"><code set:html={codeExamples.staticConnections} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Disabled ── -->

    <h2>Disabled</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Connections render normally but cannot be created, deleted, or dragged. Useful for read-only views of a flow graph.
      </span>
      <div class="noodle-arena noodle-arena--short" id="disabled-arena">
        <div class="flow-node" intent="accent" disabled id="d-input" data-noodle-port="right" style="left: 2rem; top: 3rem;">Input</div>
        <div class="flow-node" intent="info" disabled id="d-process" data-noodle-port="left right" style="left: 14rem; top: 3rem;">Process</div>
        <div class="flow-node" intent="success" disabled id="d-output" data-noodle-port="left" style="left: 26rem; top: 3rem;">Output</div>
      </div>
      <pre class="code-block"><code set:html={codeExamples.disabled} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Event Log ── -->

    <h2>Event Log</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Listens on <code>document</code> for all <code>native:noodle-connect</code> and <code>native:noodle-disconnect</code> events.
      </span>
      <article bordered>
        <div class="body" padding="tight" show-scrollbar style="max-height: 8rem;">
          <div class="event-log" id="event-log"></div>
        </div>
      </article>
      <pre class="code-block"><code set:html={eventLogCode} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Port Declaration</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>data-noodle-port</code></n-table-cell>
            <n-table-cell>Space-separated list of port positions: <code>top</code>, <code>right</code>, <code>bottom</code>, <code>left</code>. Determines where connection points appear on the element.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>

      <h3>Adapter Attributes</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>data-trait-noodleable-editable</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Enable drag-to-connect and click-to-delete.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-noodleable-style</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell><code>bezier</code></n-table-cell>
            <n-table-cell>Curve style: <code>bezier</code>, <code>step</code>, or <code>straight</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-noodleable-animated</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Enable flowing dash animation on connections.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-noodleable-color</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell><code>var(--n-color-accent-500)</code></n-table-cell>
            <n-table-cell>Noodle stroke color. Accepts any CSS color value.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-noodleable-stroke-width</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>2</code></n-table-cell>
            <n-table-cell>Noodle stroke width in pixels.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-noodleable-tension</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>0.5</code></n-table-cell>
            <n-table-cell>Bezier control point distance (0–1).</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-noodleable-show-ports</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>true</code> when editable</n-table-cell>
            <n-table-cell>Show port indicator dots on connectable elements.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-noodleable-port-size</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>10</code></n-table-cell>
            <n-table-cell>Port dot size in pixels.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-noodleable-disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disables the controller.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>

      <h3>Programmatic API</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Method</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>connect(from, to, fromPort, toPort)</code></n-table-cell>
            <n-table-cell>Create a connection between two elements by ID.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>disconnect(id)</code></n-table-cell>
            <n-table-cell>Remove a connection by its ID.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>getConnections()</code></n-table-cell>
            <n-table-cell>Returns the current array of connection objects.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>setConnections(connections)</code></n-table-cell>
            <n-table-cell>Replace all connections with a new array.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>update()</code></n-table-cell>
            <n-table-cell>Force re-render after external DOM changes (e.g. node repositioned).</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>clear()</code></n-table-cell>
            <n-table-cell>Remove all connections.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>destroy()</code></n-table-cell>
            <n-table-cell>Teardown the controller and remove the SVG overlay.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>

      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:noodle-connect</code></n-table-cell>
            <n-table-cell><code set:html={detailConnect} /></n-table-cell>
            <n-table-cell>Fired when a new connection is created (drag-to-connect or programmatic).</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:noodle-disconnect</code></n-table-cell>
            <n-table-cell><code set:html={detailDisconnect} /></n-table-cell>
            <n-table-cell>Fired when a connection is removed (click-to-delete or programmatic).</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:noodle-drag</code></n-table-cell>
            <n-table-cell><code set:html={detailDrag} /></n-table-cell>
            <n-table-cell>Fired continuously while dragging a new connection from a port.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>

      <h3>Programmatic Constructor</h3>
      <pre class="code-block"><code set:html={codeExamples.programmatic} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
  </section>

  <script>
    import './noodleable.ts';
  </script>
  <style is:global>
    @import './noodleable.css';
  </style>

</SidebarLayout>
