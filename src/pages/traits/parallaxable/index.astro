---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';

const codeExamples = {
  basicTilt: `&lt;n-controller traits="parallaxable"&gt;
  &lt;div class="parallax-card holo-1"&gt;
    &lt;span class="card-label"&gt;Amethyst&lt;/span&gt;
    &lt;span class="card-sub"&gt;Basic Tilt&lt;/span&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;`,
  withGlare: `&lt;n-controller traits="parallaxable"
  data-trait-parallaxable-glare="true"
  data-trait-parallaxable-glare-opacity="0.4"&gt;
  &lt;div class="parallax-card holo-2"&gt;
    &lt;span class="card-label"&gt;Sapphire&lt;/span&gt;
    &lt;span class="card-sub"&gt;With Glare&lt;/span&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;`,
  multipleCards: `&lt;div style="display: grid; grid-template-columns: repeat(3, auto); gap: 1rem;"&gt;
  &lt;n-controller traits="parallaxable" data-trait-parallaxable-glare="true"&gt;
    &lt;div class="parallax-card holo-1"&gt;
      &lt;span class="card-label"&gt;Amethyst&lt;/span&gt;
      &lt;span class="card-sub"&gt;Rare&lt;/span&gt;
    &lt;/div&gt;
  &lt;/n-controller&gt;
  &lt;!-- ...repeat for each card --&gt;
&lt;/div&gt;`,
  highTilt: `&lt;n-controller traits="parallaxable"
  data-trait-parallaxable-max-tilt="25"
  data-trait-parallaxable-scale="1.1"
  data-trait-parallaxable-glare="true"
  data-trait-parallaxable-glare-opacity="0.5"&gt;
  &lt;div class="parallax-card holo-3" style="width: 18rem; height: 12rem;"&gt;
    &lt;span class="card-label"&gt;Emerald&lt;/span&gt;
    &lt;span class="card-sub"&gt;High Tilt&lt;/span&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;`,
  controller: `import { ParallaxController } from '@nonoun/native-ui';

const card = document.querySelector('#ctrl-card');
const parallax = new ParallaxController(card, {
  maxTilt: 15,
  perspective: 1000,
  scale: 1.05,
  speed: 300,
  glare: false,
  glareOpacity: 0.35,
});

// Update options at runtime:
parallax.maxTilt = 25;
parallax.glare = true;
parallax.reset();
parallax.destroy();`,
  cssCustomProperty: `&lt;n-controller traits="parallaxable"&gt;
  &lt;div class="shadow-card"&gt;
    &lt;span class="card-label"&gt;Shadow A&lt;/span&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;

&lt;style&gt;
.shadow-card {
  box-shadow:
    calc(var(--parallax-percent-x, 0) * 20px)
    calc(var(--parallax-percent-y, 0) * 20px)
    30px rgba(0,0,0,0.2);
}
&lt;/style&gt;`,
};
const detailMove = `{ tiltX, tiltY, percentX, percentY }`;
---
<SidebarLayout title="Parallaxable">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Parallaxable</h1>
      </div>
    </div>
    <div slot="description">

      Holographic tilt effect that follows the pointer position. Sets a CSS <code>transform</code> with <code>perspective</code>, <code>rotateX</code>/<code>rotateY</code>, and <code>scale</code>. Dispatches <code>native:parallax-move</code> on every pointer move and exposes <code>--parallax-percent-x</code>/<code>--parallax-percent-y</code> CSS custom properties.

    </div>
  </header>

  <section>

    <!-- ── Basic Tilt ── -->

    <h2>Basic Tilt</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Move your pointer over the card. Default: 15deg max tilt, 1000px perspective, 1.05x scale on hover.
      </span>
      <n-controller traits="parallaxable">
        <div class="parallax-card holo-1" id="parallax-basic">
          <span class="card-label">Amethyst</span>
          <span class="card-sub">Basic Tilt</span>
        </div>
      </n-controller>
      <div id="provider-log" class="output"></div>
      <pre class="code-block"><code set:html={codeExamples.basicTilt} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── With Glare ── -->

    <h2>With Glare</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Adds a radial glare overlay that follows the pointer. <code>data-trait-parallaxable-glare="true"</code> enables it; <code>data-trait-parallaxable-glare-opacity</code> sets the max opacity.
      </span>
      <n-controller traits="parallaxable" data-trait-parallaxable-glare="true" data-trait-parallaxable-glare-opacity="0.4">
        <div class="parallax-card holo-2" id="parallax-glare">
          <span class="card-label">Sapphire</span>
          <span class="card-sub">With Glare</span>
        </div>
      </n-controller>
      <pre class="code-block"><code set:html={codeExamples.withGlare} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Multiple Cards Grid ── -->

    <h2>Multiple Cards Grid</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Six holographic trading cards in a grid, each with independent parallax + glare.
      </span>
      <div style="display: grid; grid-template-columns: repeat(3, auto); gap: 1rem;">
        <n-controller traits="parallaxable" data-trait-parallaxable-glare="true">
          <div class="parallax-card holo-1" id="grid-card-1">
            <span class="card-label">Amethyst</span>
            <span class="card-sub">Rare</span>
          </div>
        </n-controller>
        <n-controller traits="parallaxable" data-trait-parallaxable-glare="true">
          <div class="parallax-card holo-2" id="grid-card-2">
            <span class="card-label">Sapphire</span>
            <span class="card-sub">Epic</span>
          </div>
        </n-controller>
        <n-controller traits="parallaxable" data-trait-parallaxable-glare="true">
          <div class="parallax-card holo-3" id="grid-card-3">
            <span class="card-label">Emerald</span>
            <span class="card-sub">Legendary</span>
          </div>
        </n-controller>
        <n-controller traits="parallaxable" data-trait-parallaxable-glare="true">
          <div class="parallax-card holo-4" id="grid-card-4">
            <span class="card-label">Ruby</span>
            <span class="card-sub">Mythic</span>
          </div>
        </n-controller>
        <n-controller traits="parallaxable" data-trait-parallaxable-glare="true">
          <div class="parallax-card holo-5" id="grid-card-5">
            <span class="card-label">Opal</span>
            <span class="card-sub">Ultra Rare</span>
          </div>
        </n-controller>
        <n-controller traits="parallaxable" data-trait-parallaxable-glare="true">
          <div class="parallax-card holo-6" id="grid-card-6">
            <span class="card-label">Diamond</span>
            <span class="card-sub">Prismatic</span>
          </div>
        </n-controller>
      </div>
      <pre class="code-block"><code set:html={codeExamples.multipleCards} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── High Tilt (Exaggerated) ── -->

    <h2>High Tilt (Exaggerated)</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Cranked up: <code>max-tilt="25"</code>, <code>scale="1.1"</code>, glare with <code>opacity="0.5"</code>. Larger card for dramatic effect.
      </span>
      <n-controller traits="parallaxable" data-trait-parallaxable-max-tilt="25" data-trait-parallaxable-scale="1.1" data-trait-parallaxable-glare="true" data-trait-parallaxable-glare-opacity="0.5">
        <div class="parallax-card holo-3" id="parallax-high" style="width: 18rem; height: 12rem;">
          <span class="card-label">Emerald</span>
          <span class="card-sub">High Tilt</span>
        </div>
      </n-controller>
      <pre class="code-block"><code set:html={codeExamples.highTilt} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Controller (Programmatic) ── -->

    <h2>Controller (Programmatic)</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        <code>new ParallaxController(el, options)</code> attaches directly to any element. Adjust options in real time with the controls below.
      </span>
      <n-stack direction="row" gap="6" wrap>
        <div class="parallax-card holo-5" id="ctrl-card" style="width: 16rem; height: 12rem;">
          <span class="card-label">Opal</span>
          <span class="card-sub">Programmatic</span>
        </div>
        <n-container padding="relaxed" style="flex: 1; min-width: 16rem;">
          <n-stack gap="3">
            <n-stack gap="1">
              <span class="text-xs text-muted">Max Tilt: <span id="ctrl-tilt-val">15</span>deg</span>
              <n-range id="ctrl-tilt" min="1" max="45" step="1" value="15"></n-range>
            </n-stack>
            <n-stack gap="1">
              <span class="text-xs text-muted">Perspective: <span id="ctrl-persp-val">1000</span>px</span>
              <n-range id="ctrl-persp" min="200" max="2000" step="50" value="1000"></n-range>
            </n-stack>
            <n-stack gap="1">
              <span class="text-xs text-muted">Scale: <span id="ctrl-scale-val">1.05</span></span>
              <n-range id="ctrl-scale" min="1" max="1.3" step="0.01" value="1.05"></n-range>
            </n-stack>
            <n-stack gap="1">
              <span class="text-xs text-muted">Speed: <span id="ctrl-speed-val">300</span>ms</span>
              <n-range id="ctrl-speed" min="50" max="800" step="25" value="300"></n-range>
            </n-stack>
            <n-stack direction="row" gap="2" align="center">
              <n-switch id="ctrl-glare"></n-switch>
              <span class="text-xs text-muted">Glare overlay</span>
            </n-stack>
            <n-stack gap="1">
              <span class="text-xs text-muted">Glare opacity: <span id="ctrl-gopacity-val">0.35</span></span>
              <n-range id="ctrl-gopacity" min="0" max="1" step="0.05" value="0.35"></n-range>
            </n-stack>
            <n-button id="ctrl-reset" size="sm" variant="ghost">Reset Tilt</n-button>
          </n-stack>
        </n-container>
      </n-stack>
      <div id="ctrl-log" class="output"></div>
      <pre class="code-block"><code set:html={codeExamples.controller} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── CSS Custom Property Demo ── -->

    <h2>CSS Custom Property Demo</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        <code>--parallax-percent-x</code> and <code>--parallax-percent-y</code> are set on the host during pointer move. Use them to drive any CSS property, such as <code>box-shadow</code>.
      </span>
      <n-stack direction="row" gap="4" wrap>
        <n-controller traits="parallaxable">
          <div class="shadow-card" id="shadow-a">
            <span class="card-label">Shadow A</span>
            <span class="card-sub">Default</span>
          </div>
        </n-controller>
        <n-controller traits="parallaxable" data-trait-parallaxable-max-tilt="20" data-trait-parallaxable-scale="1">
          <div class="shadow-card" id="shadow-b">
            <span class="card-label">Shadow B</span>
            <span class="card-sub">max-tilt: 20, scale: 1</span>
          </div>
        </n-controller>
      </n-stack>
      <div id="shadow-log" class="output"></div>
      <pre class="code-block"><code set:html={codeExamples.cssCustomProperty} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Adapter Attributes</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>data-trait-parallaxable-max-tilt</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>15</code></n-table-cell>
            <n-table-cell>Max rotation degrees</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-parallaxable-perspective</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>1000</code></n-table-cell>
            <n-table-cell>CSS perspective in px</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-parallaxable-scale</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>1.05</code></n-table-cell>
            <n-table-cell>Hover scale factor</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-parallaxable-speed</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>300</code></n-table-cell>
            <n-table-cell>Transition speed in ms</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-parallaxable-glare</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Enable glare overlay</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-parallaxable-glare-opacity</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>0.35</code></n-table-cell>
            <n-table-cell>Max glare opacity (0-1)</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-parallaxable-disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disable parallax effect</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:parallax-move</code></n-table-cell>
            <n-table-cell><code set:html={detailMove} /></n-table-cell>
            <n-table-cell>Fired on every pointer move over the element. <code>tiltX</code>/<code>tiltY</code> in degrees, <code>percentX</code>/<code>percentY</code> in -1..1 range.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>CSS</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Selector / Property</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>[parallax-active]</code></n-table-cell>
            <n-table-cell>Present on the element while the pointer is over it. Removed on leave.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>--parallax-percent-x</code></n-table-cell>
            <n-table-cell>Pointer X position relative to center (-1 to 1). Use in <code>calc()</code> for dynamic styles.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>--parallax-percent-y</code></n-table-cell>
            <n-table-cell>Pointer Y position relative to center (-1 to 1). Use in <code>calc()</code> for dynamic styles.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </section>

  <script>
    import './parallaxable.ts';
  </script>
  <style is:global>
    @import './parallaxable.css';
  </style>

</SidebarLayout>
