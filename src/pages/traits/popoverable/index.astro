---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';

const codeExamples = {
  basicPopover: `import { PopoverController, signal } from '@nonoun/native-ui';

const host = document.getElementById('pop-host');
const popover = new PopoverController(host);
const open = signal(false);

popover.wirePopover(anchor, panel);

anchor.addEventListener('native:press', () =&gt; {
  open.value = !open.value;
});

host.addEventListener('native:dismiss', () =&gt; {
  open.value = false;
});

// In an effect:
popover.syncPopover(open.value);`,
  builtInUiSelect: `&lt;n-select placeholder="Pick a framework"
  options='[
    {"value":"react","label":"React"},
    {"value":"vue","label":"Vue"},
    {"value":"svelte","label":"Svelte"}
  ]'&gt;&lt;/n-select&gt;`,
};
---
<SidebarLayout title="Popoverable">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Popoverable</h1>
      </div>
    </div>
    <div slot="description">

      Composable trait that extends <code>Dismissable</code> with CSS Anchor positioning. Provides <code>wirePopover(anchor, popover)</code> to set up anchor-name/position-anchor, and <code>syncPopover(open)</code> to show/hide with <code>popover="manual"</code>.

    </div>
  </header>

  <section>

    <!-- ── Basic Popover ── -->

    <h2>Basic Popover</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Uses <code>PopoverController</code> directly to wire an anchor button to a popover panel. Click outside or press Escape to close.
      </span>
      <div id="popoverable-demo-1" class="popover-anchor">
        <n-button id="pop-trigger-1">Toggle Popover</n-button>
        <div class="pop-content" id="pop-content-1" popover="manual">
          <span>This popover is anchored to the button using CSS Anchor positioning. Click outside or press Escape to close.</span>
        </div>
      </div>
      <pre class="code-block"><code set:html={codeExamples.basicPopover} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Multiple Popovers ── -->

    <h2>Multiple Popovers</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Each popover joins the dismissable layer stack. Only the topmost one is dismissed first.
      </span>
      <n-stack direction="row" gap="3">
        <div id="pop-2" class="popover-anchor">
          <n-button id="pop-trigger-2">Popover A</n-button>
          <div class="pop-content" id="pop-content-2" popover="manual">
            <span><strong>Popover A</strong> — First layer</span>
          </div>
        </div>
        <div id="pop-3" class="popover-anchor">
          <n-button id="pop-trigger-3">Popover B</n-button>
          <div class="pop-content" id="pop-content-3" popover="manual">
            <span><strong>Popover B</strong> — Second layer</span>
          </div>
        </div>
      </n-stack>
    </n-container>

    <!-- ── Built-in: n-select ── -->

    <h2>Built-in: n-select</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        <code>n-select</code> uses Popoverable internally to anchor its dropdown listbox to the trigger button. CSS Anchor Positioning and dismiss-on-click-outside are handled automatically.
      </span>
      <div class="demo-select-wrap"><n-select placeholder="Pick a framework" options='[{"value":"react","label":"React"},{"value":"vue","label":"Vue"},{"value":"svelte","label":"Svelte"},{"value":"lit","label":"Lit"}]'></n-select></div>
      <pre class="code-block"><code set:html={codeExamples.builtInUiSelect} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Methods</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Method</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>wirePopover(anchor, popover)</code></n-table-cell>
            <n-table-cell>Sets up CSS <code>anchor-name</code> / <code>position-anchor</code> styles between the anchor and popover elements.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>syncPopover(open)</code></n-table-cell>
            <n-table-cell>Call in an effect. Shows (<code>showPopover()</code>) or hides (<code>hidePopover()</code>) the popover based on the boolean <code>open</code> state. Also manages the dismiss layer.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>destroy()</code></n-table-cell>
            <n-table-cell>Cleans up the dismiss layer and styles.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:dismiss</code></n-table-cell>
            <n-table-cell>—</n-table-cell>
            <n-table-cell>Inherited from Dismissable. Fired when click-outside or Escape occurs while the popover is the topmost layer.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>CSS Pattern</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Selector</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>[popover]:not(:popover-open)</code></n-table-cell>
            <n-table-cell>Must set <code>display: none</code> to prevent author-layer display from overriding UA hide.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>position-area: block-end</code></n-table-cell>
            <n-table-cell>Anchors the popover below the trigger. Use <code>position-try-fallbacks: flip-block</code> for viewport clipping.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </section>

  <script>
    import './popoverable.ts';
  </script>
  <style is:global>
    @import './popoverable.css';
  </style>

</SidebarLayout>
