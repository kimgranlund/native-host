---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
const detailPointerType = `{ pointerType }`;
---
<SidebarLayout title="Hoverable">
  <main>
<h1>Hoverable</h1>
    <n-text size="md" muted spacing="relaxed">
      Pointer hover state with configurable enter/leave delays. Sets <code>[hovered]</code> attribute and dispatches <code>native:hover-enter</code> / <code>native:hover-leave</code> events.
    </n-text>

    <!-- ── Instant Hover ── -->

    <h2>Instant Hover</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Default 0ms delays. The <code>[hovered]</code> attribute toggles immediately on pointer enter/leave.
      </n-text>
      <n-controller traits="hoverable">
        <div class="hover-card" id="instant-card">
          Hover over me <span class="hover-status">idle</span>
        </div>
      </n-controller>
      <div id="instant-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="hoverable"&gt;
  &lt;div class="hover-card"&gt;
    Hover over me
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Hover Intent ── -->

    <h2>Hover Intent (500ms)</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        <code>hoverable-delay="500"</code> prevents accidental hover triggers. Pointer must rest on the element for 500ms before activation.
      </n-text>
      <n-controller traits="hoverable" hoverable-delay="500">
        <div class="hover-card" id="intent-card">
          Hover and wait 500ms <span class="hover-status">idle</span>
        </div>
      </n-controller>
      <div id="intent-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="hoverable" hoverable-delay="500"&gt;
  &lt;div class="hover-card"&gt;
    Hover and wait 500ms
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sticky Hover ── -->

    <h2>Sticky Hover (300ms leave)</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        <code>hoverable-leave-delay="300"</code> so the hover state persists briefly after the pointer leaves. Useful for menus or tooltips with a gap between trigger and content.
      </n-text>
      <n-controller traits="hoverable" hoverable-leave-delay="300">
        <div class="hover-card" id="sticky-card">
          Hover, then leave slowly <span class="hover-status">idle</span>
        </div>
      </n-controller>
      <div id="sticky-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="hoverable" hoverable-leave-delay="300"&gt;
  &lt;div class="hover-card"&gt;
    Hover, then leave slowly
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Combined Delays ── -->

    <h2>Combined Delays</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Both <code>hoverable-delay="400"</code> and <code>hoverable-leave-delay="200"</code>. Requires intent to activate and lingers briefly on leave.
      </n-text>
      <n-controller traits="hoverable" hoverable-delay="400" hoverable-leave-delay="200">
        <div class="hover-card" id="combined-card">
          400ms enter + 200ms leave <span class="hover-status">idle</span>
        </div>
      </n-controller>
      <div id="combined-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="hoverable" hoverable-delay="400" hoverable-leave-delay="200"&gt;
  &lt;div class="hover-card"&gt;
    400ms enter + 200ms leave
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Properties</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Property</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>hoverDelay</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>0</code></n-table-cell>
            <n-table-cell>Milliseconds to wait after pointer enter before setting <code>[hovered]</code>. Prevents accidental hover triggers.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>hoverLeaveDelay</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>0</code></n-table-cell>
            <n-table-cell>Milliseconds to wait after pointer leave before removing <code>[hovered]</code>. Useful for menus with gaps.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>hoverDisabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disables hover behavior when true. Pointer events are ignored.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:hover-enter</code></n-table-cell>
            <n-table-cell><code set:html={detailPointerType} /></n-table-cell>
            <n-table-cell>Fired when hover activates (after delay, if configured). <code>pointerType</code> is <code>'mouse'</code>, <code>'pen'</code>, etc.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:hover-leave</code></n-table-cell>
            <n-table-cell><code set:html={detailPointerType} /></n-table-cell>
            <n-table-cell>Fired when hover deactivates (after leave delay, if configured).</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>CSS</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Selector</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>[hovered]</code></n-table-cell>
            <n-table-cell>Present on the element while hover is active. Use for styling hover states with delay support.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </main>

  <script>
import { logAppend as appendLog } from '../../scripts/event-log';

document.addEventListener('astro:page-load', () => {
      if (!document.getElementById('instant-card')) return;

      // ── Helper: update status badge ──

      function bindStatus(el: Element) {
        const badge = el.querySelector('.hover-status');
        el.addEventListener('native:hover-enter', () => { if (badge) badge.textContent = 'hovered'; });
        el.addEventListener('native:hover-leave', () => { if (badge) badge.textContent = 'idle'; });
      }

      // ── Bind status badges ──

      for (const el of document.querySelectorAll('.hover-card')) {
        bindStatus(el);
      }

      // ── Instant Hover ──

      const instantCard = document.getElementById('instant-card')!;
      const instantLogEl = document.getElementById('instant-log');
      instantCard.addEventListener('native:hover-enter', (e: CustomEvent) => {
        appendLog(instantLogEl, `Enter (${e.detail.pointerType})`);
      });
      instantCard.addEventListener('native:hover-leave', (e: CustomEvent) => {
        appendLog(instantLogEl, `Leave (${e.detail.pointerType})`);
      });

      // ── Hover Intent ──

      const intentCard = document.getElementById('intent-card')!;
      const intentLogEl = document.getElementById('intent-log');
      intentCard.addEventListener('native:hover-enter', (e: CustomEvent) => {
        appendLog(intentLogEl, `Enter after 500ms (${e.detail.pointerType})`);
      });
      intentCard.addEventListener('native:hover-leave', (e: CustomEvent) => {
        appendLog(intentLogEl, `Leave (${e.detail.pointerType})`);
      });

      // ── Sticky Hover ──

      const stickyCard = document.getElementById('sticky-card')!;
      const stickyLogEl = document.getElementById('sticky-log');
      stickyCard.addEventListener('native:hover-enter', (e: CustomEvent) => {
        appendLog(stickyLogEl, `Enter (${e.detail.pointerType})`);
      });
      stickyCard.addEventListener('native:hover-leave', (e: CustomEvent) => {
        appendLog(stickyLogEl, `Leave after 300ms delay (${e.detail.pointerType})`);
      });

      // ── Combined Delays ──

      const combinedCard = document.getElementById('combined-card')!;
      const combinedLogEl = document.getElementById('combined-log');
      combinedCard.addEventListener('native:hover-enter', (e: CustomEvent) => {
        appendLog(combinedLogEl, `Enter after 400ms (${e.detail.pointerType})`);
      });
      combinedCard.addEventListener('native:hover-leave', (e: CustomEvent) => {
        appendLog(combinedLogEl, `Leave after 200ms (${e.detail.pointerType})`);
      });
});
  </script>
  <style is:global>
    /* ── Hover Cards ── */

    .hover-card {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: var(--n-radius);
      font-size: 0.875rem;
      color: var(--n-ink-neutral);
      transition: background 200ms ease, border-color 200ms ease, color 200ms ease, box-shadow 200ms ease;
      user-select: none;
      cursor: default;
    }

    .hover-card[hovered] {
      background: var(--n-surface-accent);
      border-color: var(--n-border-accent);
      color: var(--n-surface-ink-accent);
      box-shadow: 0 0 0 3px var(--n-surface-accent);
    }

    .hover-status {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      background: var(--n-border-muted-neutral);
      color: var(--n-ink-muted-neutral);
      margin-left: 0.75rem;
      transition: background 200ms ease, color 200ms ease;
    }

    [hovered] .hover-status {
      background: var(--n-ink-accent);
      color: var(--n-surface-accent);
    }

    .output {
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      max-height: 6rem;
      overflow-y: auto;
      margin-top: 0.75rem;
      padding: 0.5rem;
      background: var(--n-panel-neutral);
      border-radius: 0.25rem;
    }

    /* ── Code Blocks ── */
</style>

</SidebarLayout>
