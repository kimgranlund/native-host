---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  siblingSnap: `&lt;n-controller traits="magnetizable"
  data-trait-magnetizable-threshold="20"
  data-trait-magnetizable-snap-to-edges="true"
  data-trait-magnetizable-snap-to-siblings="true"&gt;
  &lt;div class="magnet-arena"&gt;
    &lt;div class="magnet-box accent" style="left: 2rem; top: 2rem;"&gt;A&lt;/div&gt;
    &lt;div class="magnet-box info" style="left: 10rem; top: 2rem;"&gt;B&lt;/div&gt;
    &lt;!-- ... --&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;`,
  gridSnap: `&lt;n-controller traits="magnetizable"
  data-trait-magnetizable-grid-size="50"
  data-trait-magnetizable-threshold="25"
  data-trait-magnetizable-strength="0.6"
  data-trait-magnetizable-snap-to-siblings="false"&gt;
  &lt;div class="magnet-arena grid-bg"&gt;
    &lt;div class="magnet-box accent" style="left: 0; top: 0;"&gt;1&lt;/div&gt;
    &lt;div class="magnet-box info" style="left: 150px; top: 0;"&gt;2&lt;/div&gt;
    &lt;!-- ... --&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;`,
  edgeOnly: `&lt;n-controller traits="magnetizable"
  data-trait-magnetizable-snap-to-siblings="false"
  data-trait-magnetizable-snap-to-edges="true"
  data-trait-magnetizable-threshold="30"&gt;
  &lt;div class="magnet-arena"&gt;
    &lt;div class="magnet-box neutral" style="left: 4rem; top: 4rem;"&gt;X&lt;/div&gt;
    &lt;div class="magnet-box neutral" style="left: 12rem; top: 8rem;"&gt;Y&lt;/div&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;`,
  playground: `import { MagnetController } from '@nonoun/native-ui';

const arena = document.getElementById('playground-arena');
const ctrl = new MagnetController(arena, {
  threshold: 20,
  gridSize: 0,
  strength: 1,
  guides: true,
  snapToEdges: true,
  snapToSiblings: true,
});

// Update options dynamically:
ctrl.threshold = 40;
ctrl.gridSize = 25;`,
  alignmentTool: `&lt;n-controller traits="magnetizable"
  data-trait-magnetizable-threshold="15"
  data-trait-magnetizable-strength="0.5"
  data-trait-magnetizable-snap-to-edges="true"
  data-trait-magnetizable-snap-to-siblings="true"&gt;
  &lt;div class="magnet-arena"&gt;
    &lt;div class="box"&gt;Header&lt;/div&gt;
    &lt;div class="box wide"&gt;Nav Bar&lt;/div&gt;
    &lt;div class="box tall"&gt;Sidebar&lt;/div&gt;
    &lt;div class="box"&gt;Content&lt;/div&gt;
    &lt;div class="box wide"&gt;Footer&lt;/div&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;`,
};

const detailSnap = `{ snappedTo, axis, x, y }`;
const detailDrop = `{ x, y }`;
const eventLogCode = `document.addEventListener('native:magnet-snap', (e) =&gt; {
  const { snappedTo, axis, x, y } = e.detail;
  log(\`snap: \${snappedTo} on \${axis} at (\${x}, \${y})\`);
});

document.addEventListener('native:magnet-drop', (e) =&gt; {
  const { x, y } = e.detail;
  log(\`drop at (\${x}, \${y})\`);
});`;
---
<SidebarLayout title="Magnetizable">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Magnetizable</h1>
      </div>
    </div>
    <div slot="description">

      Snaps elements to alignment guides when dragged near siblings or container edges. Supports grid snapping, configurable threshold and strength, and visual guide lines. Dispatches <code>native:magnet-snap</code> on snap and <code>native:magnet-drop</code> on release.

    </div>
  </header>

  <section id="magnetizable-page">

    <!-- ── Sibling Snap ── -->

    <h2>Sibling Snap</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Drag any box near another to see snap guides appear. Edges and centers align within the 20px threshold. All five boxes snap to each other and to the container edges.
      </n-text>
      <n-controller traits="magnetizable" data-trait-magnetizable-threshold="20" data-trait-magnetizable-snap-to-edges="true" data-trait-magnetizable-snap-to-siblings="true">
        <div class="magnet-arena" id="sibling-arena">
          <div class="magnet-box accent" style="left: 2rem; top: 2rem;">A</div>
          <div class="magnet-box info" style="left: 10rem; top: 2rem;">B</div>
          <div class="magnet-box success" style="left: 2rem; top: 10rem;">C</div>
          <div class="magnet-box warning" style="left: 10rem; top: 10rem;">D</div>
          <div class="magnet-box danger" style="left: 18rem; top: 6rem;">E</div>
        </div>
      </n-controller>
      <pre class="code-block"><code set:html={codeExamples.siblingSnap} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Grid Snap ── -->

    <h2>Grid Snap (50px)</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Elements snap to a 50px grid. Sibling snapping is disabled so only the grid governs alignment. Strength is set to 0.6 for a softer snap feel.
      </n-text>
      <n-controller traits="magnetizable" data-trait-magnetizable-grid-size="50" data-trait-magnetizable-threshold="25" data-trait-magnetizable-strength="0.6" data-trait-magnetizable-snap-to-siblings="false">
        <div class="magnet-arena grid-bg" id="grid-arena">
          <div class="magnet-box accent" style="left: 0; top: 0;">1</div>
          <div class="magnet-box info" style="left: 150px; top: 0;">2</div>
          <div class="magnet-box success" style="left: 0; top: 150px;">3</div>
          <div class="magnet-box warning" style="left: 150px; top: 150px;">4</div>
        </div>
      </n-controller>
      <pre class="code-block"><code set:html={codeExamples.gridSnap} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Edge Snap Only ── -->

    <h2>Edge Snap Only</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Sibling snapping is disabled. Boxes only snap to the container edges with a 30px threshold. Useful for constraining layout to boundaries.
      </n-text>
      <n-controller traits="magnetizable" data-trait-magnetizable-snap-to-siblings="false" data-trait-magnetizable-snap-to-edges="true" data-trait-magnetizable-threshold="30">
        <div class="magnet-arena" id="edge-arena">
          <div class="magnet-box neutral" style="left: 4rem; top: 4rem;">X</div>
          <div class="magnet-box neutral" style="left: 12rem; top: 8rem;">Y</div>
        </div>
      </n-controller>
      <pre class="code-block"><code set:html={codeExamples.edgeOnly} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Options Playground ── -->

    <h2>Options Playground</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Uses <code>MagnetController</code> programmatically. Adjust options in real time and see the effect on snap behavior.
      </n-text>
      <div class="magnet-arena" id="playground-arena">
        <div class="magnet-box accent" style="left: 2rem; top: 2rem;">P1</div>
        <div class="magnet-box info" style="left: 10rem; top: 2rem;">P2</div>
        <div class="magnet-box success" style="left: 2rem; top: 10rem;">P3</div>
        <div class="magnet-box warning" style="left: 10rem; top: 10rem;">P4</div>
      </div>
      <n-card padding="relaxed">
        <n-stack gap="3">
          <n-stack direction="row" gap="4" align="center">
            <n-text size="xs" muted style="min-width: 7rem;">Threshold</n-text>
            <n-range id="opt-threshold" min="5" max="60" step="1" value="20"></n-range>
            <n-text size="xs" muted id="opt-threshold-val">20</n-text>
          </n-stack>
          <n-stack direction="row" gap="4" align="center">
            <n-text size="xs" muted style="min-width: 7rem;">Grid size</n-text>
            <n-range id="opt-grid-size" min="0" max="100" step="5" value="0"></n-range>
            <n-text size="xs" muted id="opt-grid-size-val">0</n-text>
          </n-stack>
          <n-stack direction="row" gap="4" align="center">
            <n-text size="xs" muted style="min-width: 7rem;">Strength</n-text>
            <n-range id="opt-strength" min="0.05" max="1" step="0.05" value="1"></n-range>
            <n-text size="xs" muted id="opt-strength-val">1</n-text>
          </n-stack>
          <n-stack direction="row" gap="4" align="center">
            <n-text size="xs" muted style="min-width: 7rem;">Show guides</n-text>
            <n-switch id="opt-guides" checked></n-switch>
          </n-stack>
          <n-stack direction="row" gap="4" align="center">
            <n-text size="xs" muted style="min-width: 7rem;">Snap to edges</n-text>
            <n-switch id="opt-snap-edges" checked></n-switch>
          </n-stack>
          <n-stack direction="row" gap="4" align="center">
            <n-text size="xs" muted style="min-width: 7rem;">Snap to siblings</n-text>
            <n-switch id="opt-snap-siblings" checked></n-switch>
          </n-stack>
          <n-button id="opt-reset" size="sm" variant="ghost">Reset Positions</n-button>
        </n-stack>
      </n-card>
      <pre class="code-block"><code set:html={codeExamples.playground} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Alignment Tool ── -->

    <h2>Alignment Tool</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        A practical layout-building example. Drag mixed-size boxes to arrange a page structure. Boxes snap to each other and container edges with a 15px threshold and 0.5 strength for a smooth feel.
      </n-text>
      <n-controller traits="magnetizable" data-trait-magnetizable-threshold="15" data-trait-magnetizable-strength="0.5" data-trait-magnetizable-snap-to-edges="true" data-trait-magnetizable-snap-to-siblings="true">
        <div class="magnet-arena magnet-arena--tall" id="alignment-arena">
          <div class="magnet-box box accent" style="left: 2rem; top: 2rem;">Header</div>
          <div class="magnet-box box wide info" style="left: 2rem; top: 9rem;">Nav Bar</div>
          <div class="magnet-box box tall success" style="left: 16rem; top: 2rem;">Sidebar</div>
          <div class="magnet-box box warning" style="left: 6rem; top: 14rem;">Content</div>
          <div class="magnet-box box wide danger" style="left: 2rem; top: 22rem;">Footer</div>
        </div>
      </n-controller>
      <pre class="code-block"><code set:html={codeExamples.alignmentTool} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Global Event Log ── -->

    <h2>Global Event Log</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Listens on <code>document</code> for all <code>native:magnet-snap</code> and <code>native:magnet-drop</code> events from any arena on this page.
      </n-text>
      <div id="magnet-global-log" class="output"></div>
      <pre class="code-block"><code set:html={eventLogCode} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Adapter Attributes</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>data-trait-magnetizable-threshold</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>20</code></n-table-cell>
            <n-table-cell>Snap distance in pixels. Elements within this distance of a guide will snap.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-magnetizable-grid-size</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>0</code></n-table-cell>
            <n-table-cell>Grid snap size in pixels. <code>0</code> disables grid snapping.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-magnetizable-strength</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>1</code></n-table-cell>
            <n-table-cell>Snap strength from 0 to 1. <code>1</code> is instant snap; lower values ease toward the snap point.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-magnetizable-guides</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>true</code></n-table-cell>
            <n-table-cell>Show visual guide lines when snapping.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-magnetizable-snap-to-edges</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>true</code></n-table-cell>
            <n-table-cell>Enable snapping to container edges.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-magnetizable-snap-to-siblings</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>true</code></n-table-cell>
            <n-table-cell>Enable snapping to sibling element edges and centers.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-magnetizable-disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disables magnet behavior. Elements drag freely without snapping.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:magnet-snap</code></n-table-cell>
            <n-table-cell><code set:html={detailSnap} /></n-table-cell>
            <n-table-cell>Fired when an element snaps to a guide. <code>snappedTo</code> is <code>'grid'</code>, <code>'edge'</code>, or <code>'sibling'</code>; <code>axis</code> is <code>'x'</code> or <code>'y'</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:magnet-drop</code></n-table-cell>
            <n-table-cell><code set:html={detailDrop} /></n-table-cell>
            <n-table-cell>Fired on release after dragging. <code>x</code> and <code>y</code> are the final coordinates.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>CSS</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Selector</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>[magnet-snapping]</code></n-table-cell>
            <n-table-cell>Present on the element while it is actively snapped to a guide. Use for visual snap feedback (ring, shadow, border).</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </section>

  <script>
import { MagnetController } from '@nonoun/native-ui';
import { logAppend as appendLog } from '../../scripts/event-log';

document.addEventListener('astro:page-load', () => {
  if (!document.getElementById('magnetizable-page')) return;

  // ── Options Playground (programmatic MagnetController) ──

  const playgroundArena = /** @type {HTMLElement} */ (document.getElementById('playground-arena'));
  if (playgroundArena) {
    const ctrl = new MagnetController(playgroundArena, {
      threshold: 20,
      gridSize: 0,
      strength: 1,
      guides: true,
      snapToEdges: true,
      snapToSiblings: true,
    });

    const thresholdRange = /** @type {HTMLInputElement} */ (document.getElementById('opt-threshold'));
    const gridSizeRange = /** @type {HTMLInputElement} */ (document.getElementById('opt-grid-size'));
    const strengthRange = /** @type {HTMLInputElement} */ (document.getElementById('opt-strength'));
    const guidesSwitch = /** @type {HTMLInputElement} */ (document.getElementById('opt-guides'));
    const edgesSwitch = /** @type {HTMLInputElement} */ (document.getElementById('opt-snap-edges'));
    const siblingsSwitch = /** @type {HTMLInputElement} */ (document.getElementById('opt-snap-siblings'));
    const resetBtn = document.getElementById('opt-reset');

    const thresholdVal = document.getElementById('opt-threshold-val');
    const gridSizeVal = document.getElementById('opt-grid-size-val');
    const strengthVal = document.getElementById('opt-strength-val');

    thresholdRange?.addEventListener('input', () => {
      ctrl.threshold = Number(thresholdRange.value);
      if (thresholdVal) thresholdVal.textContent = thresholdRange.value;
    });
    gridSizeRange?.addEventListener('input', () => {
      ctrl.gridSize = Number(gridSizeRange.value);
      if (gridSizeVal) gridSizeVal.textContent = gridSizeRange.value;
    });
    strengthRange?.addEventListener('input', () => {
      ctrl.strength = Number(strengthRange.value);
      if (strengthVal) strengthVal.textContent = strengthRange.value;
    });
    guidesSwitch?.addEventListener('change', () => {
      ctrl.guides = guidesSwitch.checked;
    });
    edgesSwitch?.addEventListener('change', () => {
      ctrl.snapToEdges = edgesSwitch.checked;
    });
    siblingsSwitch?.addEventListener('change', () => {
      ctrl.snapToSiblings = siblingsSwitch.checked;
    });

    resetBtn?.addEventListener('click', () => {
      for (const box of playgroundArena.querySelectorAll('.magnet-box')) {
        /** @type {HTMLElement} */ (box).style.translate = '';
      }
    });
  }

  // ── Global Event Log ──

  const logEl = document.getElementById('magnet-global-log');

  document.addEventListener('native:magnet-snap', (e) => {
    /** @type {CustomEvent} */ const ce = /** @type {any} */ (e);
    const { snappedTo, axis, x, y } = ce.detail;
    appendLog(logEl, `snap: ${snappedTo} on ${axis} at (${Math.round(x)}, ${Math.round(y)})`, 50);
  });

  document.addEventListener('native:magnet-drop', (e) => {
    /** @type {CustomEvent} */ const ce = /** @type {any} */ (e);
    const { x, y } = ce.detail;
    appendLog(logEl, `drop at (${Math.round(x)}, ${Math.round(y)})`, 50);
  });
});
  </script>
  <style is:global>
    /* ── Magnet Arena ── */

    .magnet-arena {
      position: relative;
      min-height: 400px;
      border: 2px dashed var(--n-border-muted-neutral);
      border-radius: 0.5rem;
      overflow: hidden;
    }

    .magnet-arena--tall {
      min-height: 500px;
    }

    /* ── Magnet Box ── */

    .magnet-box {
      position: absolute;
      width: 5rem;
      height: 5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 0.375rem;
      touch-action: none;
      cursor: grab;
      font-size: 0.75rem;
      font-weight: 700;
      user-select: none;
      transition: box-shadow 150ms ease;
    }

    .magnet-box:active {
      cursor: grabbing;
    }

    .magnet-box[magnet-snapping] {
      box-shadow: 0 0 0 2px var(--n-surface-accent), 0 0 8px var(--n-surface-accent);
    }

    /* ── Color variants ── */

    .magnet-box.accent {
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
      border: 1px solid var(--n-border-accent);
    }

    .magnet-box.info {
      background: var(--n-surface-info);
      color: var(--n-surface-ink-info);
      border: 1px solid var(--n-border-info);
    }

    .magnet-box.success {
      background: var(--n-surface-success);
      color: var(--n-surface-ink-success);
      border: 1px solid var(--n-border-success);
    }

    .magnet-box.warning {
      background: var(--n-surface-warning);
      color: var(--n-surface-ink-warning);
      border: 1px solid var(--n-border-warning);
    }

    .magnet-box.danger {
      background: var(--n-surface-danger);
      color: var(--n-surface-ink-danger);
      border: 1px solid var(--n-border-danger);
    }

    .magnet-box.neutral {
      background: var(--n-surface-neutral);
      color: var(--n-surface-ink-neutral);
      border: 1px solid var(--n-border-neutral);
    }

    /* ── Grid Background ── */

    .grid-bg {
      background-image:
        linear-gradient(to right, var(--n-border-muted-neutral) 1px, transparent 1px),
        linear-gradient(to bottom, var(--n-border-muted-neutral) 1px, transparent 1px);
      background-size: 50px 50px;
    }

    /* ── Layout Boxes (Alignment Tool) ── */

    .box {
      width: 8rem;
      height: 5rem;
      font-size: 0.6875rem;
    }

    .box.wide {
      width: 12rem;
      height: 3rem;
    }

    .box.tall {
      width: 4rem;
      height: 8rem;
    }

    /* ── Output Log ── */

    .output {
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      max-height: 8rem;
      overflow-y: auto;
      margin-top: 0.75rem;
      padding: 0.5rem;
      background: var(--n-panel-neutral);
      border-radius: 0.25rem;
    }

    /* ── Code Blocks ── */
</style>

</SidebarLayout>
