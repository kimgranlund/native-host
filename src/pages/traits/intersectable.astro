---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  scrollIntoViewProvider: `&lt;n-controller traits="intersectable"&gt;
  &lt;div class="intersect-box"&gt;
    Box 1
  &lt;/div&gt;
&lt;/n-controller&gt;

&lt;!-- CSS --&gt;
.intersect-box {
  opacity: 0;
  transform: translateY(1.5rem);
  transition: opacity 600ms ease, transform 600ms ease;
}
.intersect-box[intersecting] {
  opacity: 1;
  transform: translateY(0);
}`,
};
const detailIntersection = `{ isIntersecting, ratio }`;
---
<SidebarLayout title="Intersectable">
  <main>
<h1>Intersectable</h1>
    <n-text size="md" muted spacing="relaxed">
      IntersectionObserver wrapper for visibility-triggered behavior. Sets <code>[intersecting]</code> when the element enters the viewport and dispatches <code>native:intersect</code>.
    </n-text>

    <!-- ── Scroll Into View (Provider) ── -->

    <h2>Scroll Into View (Provider)</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        <code>&lt;n-controller traits="intersectable"&gt;</code> wraps each box. Scroll down to see them appear with a CSS fade-in animation.
      </n-text>
      <div class="scroll-spacer">&#8595; Scroll down to reveal boxes &#8595;</div>
      <n-controller traits="intersectable">
        <div class="intersect-box">
          <span class="intersect-label">Box 1</span>
          <span class="intersect-status">hidden</span>
        </div>
      </n-controller>
      <n-controller traits="intersectable">
        <div class="intersect-box">
          <span class="intersect-label">Box 2</span>
          <span class="intersect-status">hidden</span>
        </div>
      </n-controller>
      <n-controller traits="intersectable">
        <div class="intersect-box">
          <span class="intersect-label">Box 3</span>
          <span class="intersect-status">hidden</span>
        </div>
      </n-controller>
      <n-controller traits="intersectable">
        <div class="intersect-box">
          <span class="intersect-label">Box 4</span>
          <span class="intersect-status">hidden</span>
        </div>
      </n-controller>
      <div id="scroll-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.scrollIntoViewProvider} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Once Mode (Provider) ── -->

    <h2>Once Mode (Provider)</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        <code>intersectable-once="true"</code>. The element fades in and stays visible permanently. The observer disconnects after the first intersection.
      </n-text>
      <div class="scroll-spacer">&#8595; Scroll down — these only animate once &#8595;</div>
      <n-controller traits="intersectable" intersectable-once="true">
        <div class="intersect-box" id="once-a">
          <span class="intersect-label">Once A</span>
          <span class="intersect-status">hidden</span>
        </div>
      </n-controller>
      <n-controller traits="intersectable" intersectable-once="true">
        <div class="intersect-box" id="once-b">
          <span class="intersect-label">Once B</span>
          <span class="intersect-status">hidden</span>
        </div>
      </n-controller>
      <n-controller traits="intersectable" intersectable-once="true">
        <div class="intersect-box" id="once-c">
          <span class="intersect-label">Once C</span>
          <span class="intersect-status">hidden</span>
        </div>
      </n-controller>
      <div id="once-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="intersectable" intersectable-once="true"&gt;
  &lt;div class="intersect-box"&gt;
    Once A
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Threshold (Provider) ── -->

    <h2>Threshold (50%)</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        <code>intersectable-threshold="0.5"</code>. Only triggers when at least 50% of the element is visible.
      </n-text>
      <div class="scroll-spacer">&#8595; Scroll down — requires 50% visibility &#8595;</div>
      <n-controller traits="intersectable" intersectable-threshold="0.5">
        <div class="intersect-box">
          <span class="intersect-label">50% Threshold A</span>
          <span class="intersect-status">hidden</span>
        </div>
      </n-controller>
      <n-controller traits="intersectable" intersectable-threshold="0.5">
        <div class="intersect-box">
          <span class="intersect-label">50% Threshold B</span>
          <span class="intersect-status">hidden</span>
        </div>
      </n-controller>
      <div id="threshold-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="intersectable" intersectable-threshold="0.5"&gt;
  &lt;div class="intersect-box"&gt;
    50% Threshold
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Provider Usage</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>intersectable-threshold</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>0</code></n-table-cell>
            <n-table-cell>Visibility ratio (0 to 1) required to trigger. <code>0</code> = any pixel visible.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>intersectable-once</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>When <code>"true"</code>, the observer disconnects after the first intersection.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>intersectable-disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disables the observer when <code>"true"</code>.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:intersect</code></n-table-cell>
            <n-table-cell><code set:html={detailIntersection} /></n-table-cell>
            <n-table-cell>Fired when visibility changes.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>CSS</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Selector</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>[intersecting]</code></n-table-cell>
            <n-table-cell>Present on the element while it meets the intersection threshold.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </main>

  <script>
import { logAppend as appendLog } from '../../scripts/event-log';

import { onPageLoad } from '../../scripts/on-page-load';

onPageLoad('scroll-log', () => {

  function bindStatus(el: Element) {
    const badge = el.querySelector('.intersect-status');
    el.addEventListener('native:intersect', (e: CustomEvent) => {
      if (badge) badge.textContent = e.detail.isIntersecting ? 'visible' : 'hidden';
    });
  }

  // ── Bind status badges ──

  for (const el of document.querySelectorAll('.intersect-box')) {
    bindStatus(el);
  }

  // ── Once mode: add .revealed class on first intersection ──

  for (const el of [document.getElementById('once-a'), document.getElementById('once-b'), document.getElementById('once-c')]) {
    el?.addEventListener('native:intersect', ((e: CustomEvent) => {
      if (e.detail.isIntersecting) el.classList.add('revealed');
    }) as EventListener);
  }

  // ── Event logging: Scroll Into View ──

  const scrollLogEl = document.getElementById('scroll-log');
  const scrollBoxes = document.querySelectorAll('.layout-section:nth-of-type(1) .intersect-box');
  for (const el of scrollBoxes) {
    el.addEventListener('native:intersect', (e: CustomEvent) => {
      const label = el.querySelector('.intersect-label')?.textContent;
      appendLog(scrollLogEl, `${label}: ${e.detail.isIntersecting ? 'enter' : 'leave'} (ratio: ${e.detail.ratio.toFixed(2)})`);
    });
  }

  // ── Event logging: Once mode ──

  const onceLogEl = document.getElementById('once-log');
  for (const el of [document.getElementById('once-a'), document.getElementById('once-b'), document.getElementById('once-c')]) {
    el?.addEventListener('native:intersect', ((e: CustomEvent) => {
      const label = el.querySelector('.intersect-label')?.textContent;
      appendLog(onceLogEl, `${label}: ${e.detail.isIntersecting ? 'enter (observer disconnects)' : 'leave'}`);
    }) as EventListener);
  }

  // ── Event logging: Threshold ──

  const thresholdLogEl = document.getElementById('threshold-log');
  const thresholdBoxes = document.querySelectorAll('.layout-section:last-of-type .intersect-box');
  for (const el of thresholdBoxes) {
    el.addEventListener('native:intersect', (e: CustomEvent) => {
      const label = el.querySelector('.intersect-label')?.textContent;
      appendLog(thresholdLogEl, `${label}: ${e.detail.isIntersecting ? 'enter' : 'leave'} (ratio: ${e.detail.ratio.toFixed(2)})`);
    });
  }
});
  </script>
  <style is:global>
    /* ── Intersect Boxes ── */

    .scroll-spacer {
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      text-align: center;
      padding: 1rem 0;
    }

    .intersect-box {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 6rem;
      padding: 1rem;
      margin-bottom: 1rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: var(--n-radius);
      font-size: 0.875rem;
      color: var(--n-ink-muted-neutral);
      opacity: 0;
      transform: translateY(1.5rem);
      transition: opacity 600ms ease, transform 600ms ease, background 300ms ease, border-color 300ms ease, color 300ms ease;
    }

    .intersect-box[intersecting] {
      opacity: 1;
      transform: translateY(0);
      background: var(--n-surface-accent);
      border-color: var(--n-border-accent);
      color: var(--n-surface-ink-accent);
    }

    /* Once mode: keep visible after first intersection */
    .intersect-box.revealed {
      opacity: 1;
      transform: translateY(0);
    }

    .intersect-label {
      font-weight: 600;
    }

    .intersect-status {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      background: var(--n-border-muted-neutral);
      color: var(--n-ink-muted-neutral);
      margin-left: 0.75rem;
      transition: background 200ms ease, color 200ms ease;
    }

    [intersecting] .intersect-status {
      background: var(--n-ink-accent);
      color: var(--n-surface-accent);
    }

    .output {
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      max-height: 6rem;
      overflow-y: auto;
      margin-top: 0.75rem;
      padding: 0.5rem;
      background: var(--n-panel-neutral);
      border-radius: 0.25rem;
    }

    /* ── Code Blocks ── */
</style>

</SidebarLayout>
