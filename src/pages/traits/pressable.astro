---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  onUiButtonBuiltIn: `&lt;n-button&gt;Button Press&lt;/n-button&gt;

&lt;script&gt;
  button.addEventListener('native:press', (e) =&gt; {
    console.log('pressed!', e.detail.pointerType);
  });
&lt;/script&gt;`,
  pointerTypes: `&lt;n-controller traits="pressable"&gt;
  &lt;div class="press-box" tabindex="0"&gt;
    Press me (check log)
  &lt;/div&gt;
&lt;/n-controller&gt;

&lt;script&gt;
  box.addEventListener('native:press', (e) =&gt; {
    console.log(e.detail.pointerType);
    // "mouse" | "touch" | "pen" | "keyboard"
  });
&lt;/script&gt;`,
};
const detailPointerType = `{ pointerType }`;
---
<SidebarLayout title="Pressable">
  <main>
<h1>Pressable</h1>
    <p style="color: var(--n-ink-muted-neutral); font-size: 0.875rem; margin-bottom: 1.5rem;">
      Composable trait that handles pointer and keyboard press states. Sets a <code>[pressed]</code> attribute during press and dispatches <code>native:press</code> on release. Supports pointer capture and Enter/Space keys.
    </p>

    <!-- ── Basic Press (Provider) ── -->

    <h2>Basic Press (Provider)</h2>
    <div class="layout-section">
      <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin-bottom: 0.75rem;">
        <code>&lt;n-controller&gt;</code> wraps each element and applies the pressable trait. Click or press Enter/Space.
      </p>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <n-controller traits="pressable">
          <div class="press-box" tabindex="0">Click or press Enter</div>
        </n-controller>
        <n-controller traits="pressable">
          <div class="press-box" tabindex="0">Another pressable</div>
        </n-controller>
        <n-controller traits="pressable" pressable-disabled="true">
          <div class="press-box" tabindex="0" disabled>Disabled</div>
        </n-controller>
      </div>
      <div id="log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="pressable"&gt;
  &lt;div class="press-box" tabindex="0"&gt;
    Click or press Enter
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── On n-button (Built-in) ── -->

    <h2>On n-button (Built-in)</h2>
    <div class="layout-section">
      <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin-bottom: 0.75rem;">
        <code>n-button</code> already uses the Pressable trait internally. The <code>native:press</code> event and <code>[pressed]</code> attribute work out of the box.
      </p>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <n-button id="btn-1">Button Press</n-button>
        <n-button id="btn-2" intent="accent">Accent Press</n-button>
        <n-button id="btn-3" disabled>Disabled</n-button>
      </div>
      <div id="btn-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.onUiButtonBuiltIn} /><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Pointer Types ── -->

    <h2>Pointer Types</h2>
    <div class="layout-section">
      <p style="font-size: 0.8125rem; color: var(--n-ink-muted-neutral); margin-bottom: 0.75rem;">
        The <code>native:press</code> event includes a <code>pointerType</code> in its detail — <code>"mouse"</code>, <code>"touch"</code>, <code>"pen"</code>, or <code>"keyboard"</code>.
      </p>
      <n-controller traits="pressable">
        <div class="press-box" id="type-box" tabindex="0">Press me (check log)</div>
      </n-controller>
      <div id="type-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.pointerTypes} /><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── API Reference ── -->

    <h2>API</h2>

    <div class="api-section">
      <h3>Provider Usage</h3>
      <table class="api-table">
        <thead><tr><th>Attribute</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>
          <tr>
            <td><code>pressable-disabled</code></td>
            <td><code>boolean</code></td>
            <td><code>false</code></td>
            <td>Disables press behavior when <code>"true"</code>. Pointer events are ignored.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="api-section">
      <h3>Events</h3>
      <table class="api-table">
        <thead><tr><th>Event</th><th>Detail</th><th>Description</th></tr></thead>
        <tbody>
          <tr>
            <td><code>native:press</code></td>
            <td><code set:html={detailPointerType} /></td>
            <td>Fired on release. <code>pointerType</code> is <code>"mouse"</code>, <code>"touch"</code>, <code>"pen"</code>, or <code>"keyboard"</code>.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="api-section">
      <h3>CSS</h3>
      <table class="api-table">
        <thead><tr><th>Selector</th><th>Description</th></tr></thead>
        <tbody>
          <tr>
            <td><code>[pressed]</code></td>
            <td>Present on the element while pointer/key is held down. Use for active-press styling.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </main>

  <script>
import { logAppend as appendLog } from '../../scripts/event-log';

document.addEventListener('astro:page-load', () => {
  if (!document.getElementById('log')) return;

  // ── Basic Press log ──

  let count = 0;
  const logEl = document.getElementById('log');
  for (const box of document.querySelectorAll('.press-box')) {
    box.addEventListener('native:press', (e: CustomEvent) => {
      count++;
      appendLog(logEl, `#${count} native:press — pointerType: "${e.detail.pointerType}"`);
    });
  }

  // ── Button Press log ──

  let btnCount = 0;
  const btnLogEl = document.getElementById('btn-log');
  for (const btn of [document.getElementById('btn-1'), document.getElementById('btn-2'), document.getElementById('btn-3')]) {
    btn?.addEventListener('native:press', ((e: CustomEvent) => {
      btnCount++;
      appendLog(btnLogEl, `#${btnCount} native:press — pointerType: "${e.detail.pointerType}"`);
    }) as EventListener);
  }

  // ── Pointer Type log ──

  const typeBox = document.getElementById('type-box');
  const typeLogEl = document.getElementById('type-log');
  typeBox?.addEventListener('native:press', ((e: CustomEvent) => {
    appendLog(typeLogEl, `pointerType: "${e.detail.pointerType}"`);
  }) as EventListener);
});
  </script>
  <style is:global>
    .press-box {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.75rem 1.5rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.375rem;
      cursor: pointer;
      user-select: none;
      font-size: 0.875rem;
      transition: background 150ms ease, transform 100ms ease;
    }

    .press-box:hover {
      background: var(--n-panel-hover-neutral);
    }

    .press-box[pressed] {
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
      transform: scale(0.97);
    }

    .press-box[disabled] {
      opacity: 0.5;
      cursor: not-allowed;
      pointer-events: none;
    }

    .press-box:focus-visible {
      outline: 2px solid var(--n-focus-ring);
      outline-offset: 2px;
    }

    .output {
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      max-height: 6rem;
      overflow-y: auto;
      margin-top: 0.75rem;
      padding: 0.5rem;
      background: var(--n-panel-neutral);
      border-radius: 0.25rem;
    }

    /* ── Code Blocks ── */

    /* ── API Reference ── */

    .api-section {
      margin-bottom: 1.5rem;
    }

    .api-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8125rem;
    }

    .api-table th {
      text-align: left;
      font-weight: 600;
      padding: 0.5rem 0.75rem;
      border-bottom: 2px solid var(--n-border-muted-neutral);
      color: var(--n-ink-strong-neutral);
    }

    .api-table td {
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--n-border-muted-neutral);
      vertical-align: top;
    }

    .api-table code {
      font-family: ui-monospace, monospace;
      font-size: 0.75rem;
      background: var(--n-panel-neutral);
      padding: 0.0625rem 0.3125rem;
      border-radius: 0.1875rem;
    }

    .api-table td:first-child code {
      white-space: nowrap;
    }
</style>

</SidebarLayout>
