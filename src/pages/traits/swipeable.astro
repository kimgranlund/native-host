---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  horizontalSwipeProvider: `&lt;n-controller traits="swipeable"
  swipeable-axis="horizontal"&gt;
  &lt;div class="swipe-card"&gt;
    &lt;span class="swipe-label"&gt;Swipe Left or Right&lt;/span&gt;
    &lt;span class="swipe-hint"&gt;Click and drag horizontally&lt;/span&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;

card.addEventListener('native:swipe', (e) =&gt; {
  const { direction, distance, velocity } = e.detail;
});`,
  swipecontrollerAttachToAnyElement: `import { SwipeController } from '@nonoun/native-ui';

const card = document.querySelector('#my-card');
const swipe = new SwipeController(card, {
  threshold: 50,
  velocityThreshold: 0.3,
  axis: 'both',
});

card.addEventListener('native:swipe', (e) =&gt; {
  const { direction, distance, velocity } = e.detail;
  log(\`\${direction} — \${distance}px @ \${velocity.toFixed(2)}px/ms\`);
});

// Later: swipe.disabled = true;
// Later: swipe.destroy();`,
};
const detailSwipe = `{ direction, distance, velocity }`;
---
<SidebarLayout title="Swipeable">
  <main>
<h1>Swipeable</h1>
    <n-text size="md" muted spacing="relaxed">
      Touch/pointer swipe gesture recognition with direction, velocity, and threshold. Supports horizontal, vertical, and both axes.
    </n-text>

    <!-- ── Horizontal Swipe (Provider) ── -->

    <h2>Horizontal Swipe <span class="pattern-badge provider">Provider</span></h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Default axis. <code>&lt;n-controller&gt;</code> applies swipeable to the first child. Detects left and right swipes. Click and drag horizontally.
      </n-text>
      <n-controller traits="swipeable" swipeable-axis="horizontal">
        <div id="h-card" class="swipe-card">
          <span class="swipe-label">Swipe Left or Right</span>
          <span class="swipe-hint">Click and drag horizontally</span>
        </div>
      </n-controller>
      <div id="h-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.horizontalSwipeProvider} /><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Vertical Swipe (Provider) ── -->

    <h2>Vertical Swipe <span class="pattern-badge provider">Provider</span></h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Axis set to <code>'vertical'</code>. Detects up and down swipes.
      </n-text>
      <n-controller traits="swipeable" swipeable-axis="vertical">
        <div id="v-card" class="swipe-card">
          <span class="swipe-label">Swipe Up or Down</span>
          <span class="swipe-hint">Click and drag vertically</span>
        </div>
      </n-controller>
      <div id="v-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="swipeable"
  swipeable-axis="vertical"&gt;
  &lt;div class="swipe-card"&gt;
    &lt;span class="swipe-label"&gt;Swipe Up or Down&lt;/span&gt;
    &lt;span class="swipe-hint"&gt;Click and drag vertically&lt;/span&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Both Axes (Provider) ── -->

    <h2>Both Axes <span class="pattern-badge provider">Provider</span></h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Axis set to <code>'both'</code>. Detects the dominant direction from the gesture.
      </n-text>
      <n-controller traits="swipeable" swipeable-axis="both">
        <div id="b-card" class="swipe-card">
          <span class="swipe-label">Swipe Any Direction</span>
          <span class="swipe-hint">Click and drag in any direction</span>
        </div>
      </n-controller>
      <div id="b-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="swipeable"
  swipeable-axis="both"&gt;
  &lt;div class="swipe-card"&gt;
    &lt;span class="swipe-label"&gt;Swipe Any Direction&lt;/span&gt;
    &lt;span class="swipe-hint"&gt;Click and drag in any direction&lt;/span&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Custom Threshold (Provider) ── -->

    <h2>Custom Threshold <span class="pattern-badge provider">Provider</span></h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Higher threshold (<strong>100px</strong>) and velocity (<strong>0.5 px/ms</strong>). Requires a longer, faster swipe to trigger.
      </n-text>
      <n-controller traits="swipeable" swipeable-axis="horizontal" swipeable-threshold="100" swipeable-velocity-threshold="0.5">
        <div id="c-card" class="swipe-card">
          <span class="swipe-label">Swipe Hard</span>
          <span class="swipe-hint">Requires 100px distance and 0.5 px/ms velocity</span>
        </div>
      </n-controller>
      <div id="c-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="swipeable"
  swipeable-axis="horizontal"
  swipeable-threshold="100"
  swipeable-velocity-threshold="0.5"&gt;
  &lt;div class="swipe-card"&gt;
    &lt;span class="swipe-label"&gt;Swipe Hard&lt;/span&gt;
    &lt;span class="swipe-hint"&gt;Requires 100px / 0.5 px/ms&lt;/span&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── SwipeController Direct ── -->

    <h2>SwipeController — Attach to Any Element</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Use <code>SwipeController</code> directly on any element without the trait adapter or <code>&lt;n-controller&gt;</code>.
      </n-text>
      <div id="controller-card" class="swipe-card">
        <span class="swipe-label">Swipe Here</span>
        <span class="swipe-hint">SwipeController attached to a plain div</span>
      </div>
      <div id="ctrl-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.swipecontrollerAttachToAnyElement} /><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Adapter Options (<code>swipeable-*</code>)</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>swipeable-threshold</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>50</code></n-table-cell>
            <n-table-cell>Minimum distance in pixels for a swipe to be recognized.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>swipeable-velocity-threshold</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>0.3</code></n-table-cell>
            <n-table-cell>Minimum velocity in px/ms for a swipe to be recognized.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>swipeable-axis</code></n-table-cell>
            <n-table-cell><code>'horizontal' | 'vertical' | 'both'</code></n-table-cell>
            <n-table-cell><code>'horizontal'</code></n-table-cell>
            <n-table-cell>Which axis to detect swipes on. <code>'both'</code> picks the dominant axis.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>swipeable-disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disables swipe detection when true.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Controller Properties</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Property</n-table-header><n-table-header>Type</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>direction</code></n-table-cell>
            <n-table-cell><code>'left' | 'right' | 'up' | 'down' | null</code></n-table-cell>
            <n-table-cell>Direction of the last recognized swipe.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>distance</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell>Distance in pixels of the last recognized swipe.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>velocity</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell>Velocity in px/ms of the last recognized swipe.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:swipe</code></n-table-cell>
            <n-table-cell><code set:html={detailSwipe} /></n-table-cell>
            <n-table-cell>Fired when a swipe gesture meets the threshold and velocity requirements.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>CSS Attributes</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Set on</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>[swiping]</code></n-table-cell>
            <n-table-cell>Host element</n-table-cell>
            <n-table-cell>Present while the pointer is down (gesture in progress).</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>[swipe-left]</code></n-table-cell>
            <n-table-cell>Host element</n-table-cell>
            <n-table-cell>Set briefly (300ms) after a left swipe is recognized.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>[swipe-right]</code></n-table-cell>
            <n-table-cell>Host element</n-table-cell>
            <n-table-cell>Set briefly (300ms) after a right swipe is recognized.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>[swipe-up]</code></n-table-cell>
            <n-table-cell>Host element</n-table-cell>
            <n-table-cell>Set briefly (300ms) after an up swipe is recognized.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>[swipe-down]</code></n-table-cell>
            <n-table-cell>Host element</n-table-cell>
            <n-table-cell>Set briefly (300ms) after a down swipe is recognized.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </main>

  <script>
import { SwipeController } from '@nonoun/native-ui';
import { logAppend as appendLog } from '../../scripts/event-log';

document.addEventListener('astro:page-load', () => {
      if (!document.getElementById('h-card')) return;

      // ── Horizontal Swipe (provider) ──

      const hCard = document.getElementById('h-card')!;
      const hLogEl = document.getElementById('h-log');
      hCard.addEventListener('native:swipe', (e: CustomEvent) => {
        const { direction, distance, velocity } = e.detail;
        appendLog(hLogEl, `${direction} — ${Math.round(distance)}px @ ${velocity.toFixed(2)}px/ms`);
      });

      // ── Vertical Swipe (provider) ──

      const vCard = document.getElementById('v-card')!;
      const vLogEl = document.getElementById('v-log');
      vCard.addEventListener('native:swipe', (e: CustomEvent) => {
        const { direction, distance, velocity } = e.detail;
        appendLog(vLogEl, `${direction} — ${Math.round(distance)}px @ ${velocity.toFixed(2)}px/ms`);
      });

      // ── Both Axes (provider) ──

      const bCard = document.getElementById('b-card')!;
      const bLogEl = document.getElementById('b-log');
      bCard.addEventListener('native:swipe', (e: CustomEvent) => {
        const { direction, distance, velocity } = e.detail;
        appendLog(bLogEl, `${direction} — ${Math.round(distance)}px @ ${velocity.toFixed(2)}px/ms`);
      });

      // ── Custom Threshold (provider) ──

      const cCard = document.getElementById('c-card')!;
      const cLogEl = document.getElementById('c-log');
      cCard.addEventListener('native:swipe', (e: CustomEvent) => {
        const { direction, distance, velocity } = e.detail;
        appendLog(cLogEl, `${direction} — ${Math.round(distance)}px @ ${velocity.toFixed(2)}px/ms`);
      });

      // ── SwipeController — attach to plain element ──

      const ctrlCard = document.getElementById('controller-card')!;
      const swipe = new SwipeController(ctrlCard, {
        threshold: 50,
        velocityThreshold: 0.3,
        axis: 'both',
      });

      const ctrlLogEl = document.getElementById('ctrl-log');
      ctrlCard.addEventListener('native:swipe', (e: CustomEvent) => {
        const { direction, distance, velocity } = e.detail;
        appendLog(ctrlLogEl, `${direction} — ${Math.round(distance)}px @ ${velocity.toFixed(2)}px/ms`);
      });
});
  </script>
  <style is:global>
    /* ── Swipe Cards ── */

    .swipe-card {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 0.5rem;
      min-height: 8rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: var(--n-radius);
      touch-action: none;
      user-select: none;
      cursor: grab;
      transition: background 200ms ease, border-color 200ms ease;
    }

    .swipe-card[swiping] {
      background: var(--n-surface-accent);
      border-color: var(--n-border-accent);
      cursor: grabbing;
    }

    .swipe-card[swipe-left],
    .swipe-card[swipe-right],
    .swipe-card[swipe-up],
    .swipe-card[swipe-down] {
      background: var(--n-surface-accent);
      border-color: var(--n-border-accent);
    }

    .swipe-label {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--n-ink-strong-neutral);
    }

    .swipe-hint {
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
    }

    .swipe-direction {
      display: flex;
      gap: 0.5rem;
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
    }

    .swipe-direction span {
      padding: 0.125rem 0.5rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.25rem;
    }

    .output {
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      max-height: 6rem;
      overflow-y: auto;
      margin-top: 0.75rem;
      padding: 0.5rem;
      background: var(--n-panel-neutral);
      border-radius: 0.25rem;
    }

    /* ── Code Blocks ── */

    /* ── Pattern Badges ── */

    .pattern-badge {
      display: inline-block;
      font-size: 0.625rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      margin-left: 0.5rem;
      vertical-align: middle;
    }

    .pattern-badge.provider {
      background: var(--n-surface-info);
      color: var(--n-surface-ink-info);
    }
</style>

</SidebarLayout>
