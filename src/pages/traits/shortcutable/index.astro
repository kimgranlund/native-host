---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';

const detailShortcut = `{ id: string, combo: string }`;

const codeExamples = {
  global: `import { ShortcutController } from '@nonoun/native-ui';

const ctrl = new ShortcutController(host, {
  shortcuts: [
    { id: 'search',  combo: 'mod+k',   handler: () =&gt; openSearch() },
    { id: 'help',    combo: 'shift+?', handler: () =&gt; showHelp() },
    { id: 'dismiss', combo: 'escape',  handler: () =&gt; closePanels() },
  ],
  global: true,
});`,
  scoped: `import { ShortcutController } from '@nonoun/native-ui';

// No global: true — listens on the host element only
const ctrl = new ShortcutController(scopedZone, {
  shortcuts: [
    { id: 'save', combo: 'mod+s', handler: () =&gt; save() },
    { id: 'undo', combo: 'mod+z', handler: () =&gt; undo() },
  ],
});`,
  editable: `const ctrl = new ShortcutController(host, {
  shortcuts: [
    {
      id: 'submit',
      combo: 'mod+enter',
      allowEditable: true,   // fires even inside &lt;input&gt;
      handler: () =&gt; submitForm(),
    },
  ],
  global: true,
});`,
  guard: `let enabled = false;

const ctrl = new ShortcutController(host, {
  shortcuts: [
    {
      id: 'guarded',
      combo: 'mod+g',
      when: () =&gt; enabled,          // guard — only fires when enabled
      handler: () =&gt; doAction(),
    },
  ],
  global: true,
});

toggleBtn.addEventListener('click', () =&gt; {
  enabled = !enabled;
});`,
  declarative: `&lt;n-controller
  traits="shortcutable"
  data-trait-shortcutable-shortcuts='[{"id":"hello","combo":"ctrl+h"},{"id":"world","combo":"ctrl+j"}]'
  data-trait-shortcutable-global="true"
&gt;
  &lt;div&gt;...&lt;/div&gt;
&lt;/n-controller&gt;

&lt;script&gt;
  ctrl.addEventListener('native:shortcut', (e) =&gt; {
    console.log(e.detail.id, e.detail.combo);
  });
&lt;/script&gt;`,
};
---
<SidebarLayout title="Shortcutable">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Shortcutable</h1>
      </div>
    </div>
    <div slot="description">

      Keyboard shortcut controller with combo-string parsing, editable filtering, and conditional guards. Supports both global (document-level) and scoped (host-focused) listeners. Fires <code>native:shortcut</code> with <code set:html="{ id, combo }" /> on every match.

    </div>
  </header>

  <section>

    <!-- ── Global Shortcuts ── -->

    <h2>Global Shortcuts</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        <code>global: true</code> listens on <code>document</code> in capture phase. These shortcuts fire from anywhere on the page — no focus required.
      </span>
      <n-stack direction="row" gap="3" wrap>
        <n-stack direction="row" gap="1" align="center">
          <n-kbd>⌘K</n-kbd>
          <span class="text-xs text-muted">Search</span>
        </n-stack>
        <n-stack direction="row" gap="1" align="center">
          <n-kbd>?</n-kbd>
          <span class="text-xs text-muted">Help</span>
        </n-stack>
        <n-stack direction="row" gap="1" align="center">
          <n-kbd>Esc</n-kbd>
          <span class="text-xs text-muted">Dismiss</span>
        </n-stack>
      </n-stack>
      <div id="log-global" class="output">Press a shortcut to see it logged here.</div>
      <pre class="code-block"><code set:html={codeExamples.global} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Scoped Shortcuts ── -->

    <h2>Scoped Shortcuts</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Without <code>global: true</code>, the controller listens on the host element only. Shortcuts fire when the host (or a descendant) has focus. Click inside the zone, then press a shortcut.
      </span>
      <div id="scoped-zone" class="scoped-zone" tabindex="0">
        <n-stack direction="row" gap="3" wrap>
          <n-stack direction="row" gap="1" align="center">
            <n-kbd>⌘S</n-kbd>
            <span class="text-xs text-muted">Save</span>
          </n-stack>
          <n-stack direction="row" gap="1" align="center">
            <n-kbd>⌘Z</n-kbd>
            <span class="text-xs text-muted">Undo</span>
          </n-stack>
        </n-stack>
        <span class="text-xs text-muted">Click here to focus, then press a shortcut.</span>
      </div>
      <div id="log-scoped" class="output">Focus the zone above, then press a shortcut.</div>
      <pre class="code-block"><code set:html={codeExamples.scoped} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Allow Editable ── -->

    <h2>Allow Editable</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        By default, shortcuts are silenced inside inputs, textareas, and <code>contenteditable</code> elements. Set <code>allowEditable: true</code> to allow a binding to fire even when an editable element is focused.
      </span>
      <n-stack direction="row" gap="1" align="center">
        <n-kbd>⌘↵</n-kbd>
        <span class="text-xs text-muted">Submit — fires inside the input below</span>
      </n-stack>
      <div id="editable-zone">
        <n-input id="editable-input" placeholder="Type here, then press ⌘Enter / Ctrl+Enter"></n-input>
      </div>
      <div id="log-editable" class="output">Focus the input above, then press ⌘Enter / Ctrl+Enter.</div>
      <pre class="code-block"><code set:html={codeExamples.editable} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Conditional Guard ── -->

    <h2>Conditional Guard</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        The <code>when()</code> guard is evaluated each time the shortcut would otherwise match. If it returns <code>false</code>, the binding is skipped. Use it to disable a shortcut contextually without re-registering it.
      </span>
      <n-stack direction="row" gap="3" align="center">
        <n-button id="guard-toggle" intent="neutral">Enable shortcut</n-button>
        <n-stack direction="row" gap="1" align="center">
          <n-kbd>⌘G</n-kbd>
          <span id="guard-status" class="guard-badge guard-badge--off">off</span>
        </n-stack>
      </n-stack>
      <span class="text-xs text-muted">Toggle the button, then try pressing <n-kbd size="xs">⌘G</n-kbd> / <n-kbd size="xs">Ctrl+G</n-kbd>.</span>
      <div id="log-guard" class="output">Enable the shortcut via the toggle, then press ⌘G / Ctrl+G.</div>
      <pre class="code-block"><code set:html={codeExamples.guard} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Declarative (Provider) ── -->

    <h2>Declarative (Provider)</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Use <code>&lt;n-controller traits="shortcutable"&gt;</code> with the <code>data-trait-shortcutable-shortcuts</code> JSON attribute and optional <code>data-trait-shortcutable-global</code>. Listen for <code>native:shortcut</code> on the host.
      </span>
      <n-controller
        id="declarative-ctrl"
        traits="shortcutable"
        data-trait-shortcutable-shortcuts='[{"id":"hello","combo":"ctrl+h"},{"id":"world","combo":"ctrl+j"}]'
        data-trait-shortcutable-global="true"
      >
        <div class="declarative-zone">
          <n-stack direction="row" gap="3" wrap>
            <n-stack direction="row" gap="1" align="center">
              <n-kbd>Ctrl+H</n-kbd>
              <span class="text-xs text-muted">Hello</span>
            </n-stack>
            <n-stack direction="row" gap="1" align="center">
              <n-kbd>Ctrl+J</n-kbd>
              <span class="text-xs text-muted">World</span>
            </n-stack>
          </n-stack>
        </div>
      </n-controller>
      <div id="log-declarative" class="output">Press Ctrl+H or Ctrl+J anywhere on the page.</div>
      <pre class="code-block"><code set:html={codeExamples.declarative} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Constructor Options</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Option</n-table-header><n-table-header>Type</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>shortcuts</code></n-table-cell>
            <n-table-cell><code>ShortcutBinding[]</code></n-table-cell>
            <n-table-cell>Initial array of shortcut bindings to register.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>global</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell>Listen on <code>document</code> in capture phase instead of on the host. Default <code>false</code>.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>ShortcutBinding</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Property</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>id</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell>—</n-table-cell>
            <n-table-cell>Unique identifier included in the <code>native:shortcut</code> event detail. Required.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>combo</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell>—</n-table-cell>
            <n-table-cell>Combo string, e.g. <code>"mod+k"</code>, <code>"shift+?"</code>, <code>"escape"</code>. Required.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>handler</code></n-table-cell>
            <n-table-cell><code>(e: KeyboardEvent) =&gt; void</code></n-table-cell>
            <n-table-cell>—</n-table-cell>
            <n-table-cell>Optional direct callback. The <code>native:shortcut</code> event fires regardless.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>when</code></n-table-cell>
            <n-table-cell><code>() =&gt; boolean</code></n-table-cell>
            <n-table-cell>—</n-table-cell>
            <n-table-cell>Conditional guard. Binding is skipped if this returns <code>false</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>preventDefault</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>true</code></n-table-cell>
            <n-table-cell>Prevents the default browser action on match.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>stopPropagation</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Stops event propagation on match.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>allowEditable</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Allow the binding to fire inside inputs, textareas, and <code>contenteditable</code> elements.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Methods</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Method</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>add(binding)</code></n-table-cell>
            <n-table-cell>Register an additional shortcut binding at runtime.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>remove(id)</code></n-table-cell>
            <n-table-cell>Remove a binding by its <code>id</code>. Detaches the listener when no bindings remain.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>destroy()</code></n-table-cell>
            <n-table-cell>Remove all bindings and detach all listeners. Call in teardown.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:shortcut</code></n-table-cell>
            <n-table-cell><code set:html={detailShortcut} /></n-table-cell>
            <n-table-cell>Fired on the host element when a matching shortcut is pressed. <code>id</code> is the binding id; <code>combo</code> is the original combo string.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Combo Syntax</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Token</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>mod</code></n-table-cell>
            <n-table-cell><code>Meta</code> (Cmd) on Mac, <code>Ctrl</code> on Windows/Linux. Recommended over <code>ctrl</code>/<code>meta</code> for cross-platform shortcuts.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>ctrl</code></n-table-cell>
            <n-table-cell>Ctrl key explicitly.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>meta</code></n-table-cell>
            <n-table-cell>Meta (Cmd on Mac, Win key on Windows) key explicitly.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>shift</code></n-table-cell>
            <n-table-cell>Shift key modifier.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>alt</code></n-table-cell>
            <n-table-cell>Alt / Option key modifier.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>key</code></n-table-cell>
            <n-table-cell>Any lowercase <code>KeyboardEvent.key</code> value — <code>k</code>, <code>enter</code>, <code>escape</code>, <code>?</code>, <code>arrowup</code>, etc. Must be the last token.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Provider Attributes</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>data-trait-shortcutable-shortcuts</code></n-table-cell>
            <n-table-cell><code>JSON string</code></n-table-cell>
            <n-table-cell>JSON array of <code>ShortcutBinding</code> objects. <code>handler</code> and <code>when</code> are not available declaratively — use <code>native:shortcut</code> event instead.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-shortcutable-global</code></n-table-cell>
            <n-table-cell><code>"true" | "false"</code></n-table-cell>
            <n-table-cell>Sets <code>global</code> option. Default <code>"false"</code>.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </section>

  <script>
    import './shortcutable.ts';
  </script>
  <style is:global>
    @import './shortcutable.css';
  </style>

</SidebarLayout>
