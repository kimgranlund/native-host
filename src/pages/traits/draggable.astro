---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  dropModeSwapProvider: `&lt;n-controller traits="draggable"
  draggable-selector=".drag-item"
  draggable-axis="vertical"
  draggable-mode="drop"&gt;
  &lt;div class="drag-list"&gt;
    &lt;div class="drag-item"&gt;Design mockups&lt;/div&gt;
    &lt;div class="drag-item"&gt;Write component API&lt;/div&gt;
    &lt;!-- ... --&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;

&lt;script&gt;
  list.addEventListener('native:drop', (e) =&gt; {
    const { item, target } = e.detail;
    if (!target || target === item) return;
    const placeholder = document.createElement('div');
    item.before(placeholder);
    target.before(item);
    placeholder.replaceWith(target);
  });
&lt;/script&gt;`,
  slotModeVerticalListProvider: `&lt;n-controller traits="draggable"
  draggable-selector=".drag-item"
  draggable-axis="vertical"
  draggable-mode="slot"&gt;
  &lt;div class="drag-list"&gt;
    &lt;div class="drag-item"&gt;Research&lt;/div&gt;
    &lt;!-- ... --&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;

&lt;script&gt;
  list.addEventListener('native:drop', (e) =&gt; {
    const { item, insertBefore } = e.detail;
    if (insertBefore) insertBefore.before(item);
    else list.appendChild(item);
  });
&lt;/script&gt;`,
};
const detailItemIndex = `{ item, index }`;
const detailItemXY = `{ item, x, y }`;
const detailItemTargetIndex = `{ item, target, index }`;
const detailItemIndexInsertBefore = `{ item, index, insertBefore }`;
const detailItemTargetFromTo = `{ item, target, fromIndex, toIndex }`;
const detailItemFromToInsertBefore = `{ item, fromIndex, toIndex, insertBefore }`;
const detailItem = `{ item }`;
---
<SidebarLayout title="Draggable">
  <main>
<h1>Draggable</h1>
    <p style="color: var(--n-ink-muted-neutral); font-size: 0.875rem; margin-bottom: 1.5rem;">
      Composable trait for drag-and-drop. Supports three modes: <strong>drop</strong> (outlines the target element), <strong>slot</strong> (shows a gap indicator between items for insertion), and <strong>preview</strong> (live DOM reordering as you drag). Ghost renders in the top layer via popover. Press Escape to cancel.
    </p>

    <!-- ── Drop Mode: Swap (Provider) ── -->

    <h2>Drop Mode — Swap (Provider)</h2>
    <div class="layout-section">
      <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin-bottom: 0.75rem;">
        <code>&lt;n-controller&gt;</code> wraps a plain <code>&lt;div&gt;</code> and applies the draggable trait. Drop onto a target to swap positions.
      </p>
      <n-controller traits="draggable" draggable-selector=".drag-item" draggable-axis="vertical" draggable-mode="drop">
        <div id="swap-list" class="drag-list">
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Design mockups</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Write component API</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Implement CSS</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Add keyboard support</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Write tests</span></div>
        </div>
      </n-controller>
      <div id="swap-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.dropModeSwapProvider} /><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Drop Mode: Replace (Provider) ── -->

    <h2>Drop Mode — Replace (Provider)</h2>
    <div class="layout-section">
      <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin-bottom: 0.75rem;">
        Drag a person onto a role to assign. Uses <code>draggable-drop-zone-selector</code> to separate drag items from drop targets.
      </p>
      <n-controller traits="draggable" draggable-selector=".drag-person" draggable-drop-zone-selector=".drag-role" draggable-mode="drop">
        <div id="replace-list" class="drag-list">
          <div class="drag-role"><span class="role-name">Lead</span><span class="role-assignee" id="role-0">—</span></div>
          <div class="drag-role"><span class="role-name">Design</span><span class="role-assignee" id="role-1">—</span></div>
          <div class="drag-role"><span class="role-name">Engineering</span><span class="role-assignee" id="role-2">—</span></div>
          <div style="display: flex; gap: 0.5rem; margin-top: 0.75rem;">
            <div class="drag-person">Alice</div>
            <div class="drag-person">Bob</div>
            <div class="drag-person">Carol</div>
          </div>
        </div>
      </n-controller>
      <div id="replace-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="draggable"
  draggable-selector=".drag-person"
  draggable-drop-zone-selector=".drag-role"
  draggable-mode="drop"&gt;
  &lt;div class="drag-list"&gt;
    &lt;div class="drag-role"&gt;Lead — &lt;span&gt;—&lt;/span&gt;&lt;/div&gt;
    &lt;div class="drag-person"&gt;Alice&lt;/div&gt;
    &lt;!-- ... --&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Slot Mode: Vertical List (Provider) ── -->

    <h2>Slot Mode — Vertical List (Provider)</h2>
    <div class="layout-section">
      <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin-bottom: 0.75rem;">
        Shows a gap indicator between items. Dropping inserts the item at that position.
      </p>
      <n-controller traits="draggable" draggable-selector=".drag-item" draggable-axis="vertical" draggable-mode="slot">
        <div id="slot-list" class="drag-list">
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Research</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Prototype</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Build</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Test</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Ship</span></div>
        </div>
      </n-controller>
      <div id="slot-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.slotModeVerticalListProvider} /><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Slot Mode: Horizontal Cards (Provider) ── -->

    <h2>Slot Mode — Horizontal Cards (Provider)</h2>
    <div class="layout-section">
      <n-controller traits="draggable" draggable-selector=".drag-card" draggable-axis="horizontal" draggable-mode="slot">
        <div id="card-row" class="drag-row">
          <div class="drag-card">A</div>
          <div class="drag-card">B</div>
          <div class="drag-card">C</div>
          <div class="drag-card">D</div>
        </div>
      </n-controller>
      <pre class="layout-code"><code>&lt;n-controller traits="draggable"
  draggable-selector=".drag-card"
  draggable-axis="horizontal"
  draggable-mode="slot"&gt;
  &lt;div class="drag-row"&gt;
    &lt;div class="drag-card"&gt;A&lt;/div&gt;
    &lt;div class="drag-card"&gt;B&lt;/div&gt;
    &lt;!-- ... --&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Preview Mode: Grid Reorder ── -->

    <h2>Preview Mode — Grid Reorder</h2>
    <div class="layout-section">
      <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin-bottom: 0.75rem;">
        Live DOM reordering as you drag. The item moves to its new position in real time — no placeholder needed. Press Escape to cancel and restore the original order. Works with CSS Grid (2D hit-testing via <code>axis="both"</code>).
      </p>
      <n-controller traits="draggable" draggable-selector=".grid-cell" draggable-axis="both" draggable-mode="preview">
        <div id="preview-grid" class="drag-grid">
          <div class="grid-cell">1</div>
          <div class="grid-cell">2</div>
          <div class="grid-cell">3</div>
          <div class="grid-cell">4</div>
          <div class="grid-cell">5</div>
          <div class="grid-cell">6</div>
          <div class="grid-cell">7</div>
          <div class="grid-cell">8</div>
          <div class="grid-cell">9</div>
          <div class="grid-cell">10</div>
          <div class="grid-cell">11</div>
          <div class="grid-cell">12</div>
          <div class="grid-cell">13</div>
          <div class="grid-cell">14</div>
          <div class="grid-cell">15</div>
          <div class="grid-cell">16</div>
          <div class="grid-cell">17</div>
          <div class="grid-cell">18</div>
          <div class="grid-cell">19</div>
          <div class="grid-cell">20</div>
          <div class="grid-cell">21</div>
          <div class="grid-cell">22</div>
          <div class="grid-cell">23</div>
          <div class="grid-cell">24</div>
        </div>
      </n-controller>
      <div id="preview-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="draggable"
  draggable-selector=".grid-cell"
  draggable-axis="both"
  draggable-mode="preview"&gt;
  &lt;div class="drag-grid"&gt;
    &lt;div class="grid-cell"&gt;1&lt;/div&gt;
    &lt;div class="grid-cell"&gt;2&lt;/div&gt;
    &lt;!-- ... 24 cells in a 4×6 grid --&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;

&lt;!-- No native:drop handler needed for reordering —
     the item is already in its final position.
     Handle native:drop only to persist the new order. --&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Provider Usage</h3>
      <n-table variant="plain" size="sm" style="grid-template-columns: auto auto auto 1fr;">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>draggable-selector</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell>—</n-table-cell>
            <n-table-cell>CSS selector for draggable items within the host. Required.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>draggable-drop-zone-selector</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell><code>''</code></n-table-cell>
            <n-table-cell>CSS selector for drop zones. Defaults to <code>selector</code> items if empty.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>draggable-axis</code></n-table-cell>
            <n-table-cell><code>'vertical' | 'horizontal' | 'both'</code></n-table-cell>
            <n-table-cell><code>'both'</code></n-table-cell>
            <n-table-cell>Constrains hit-testing to one axis. Ghost always moves freely.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>draggable-mode</code></n-table-cell>
            <n-table-cell><code>'drop' | 'slot' | 'preview'</code></n-table-cell>
            <n-table-cell><code>'drop'</code></n-table-cell>
            <n-table-cell><strong>drop</strong>: outlines hovered target. <strong>slot</strong>: shows gap indicator between items. <strong>preview</strong>: live DOM reordering as you drag.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>draggable-disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disables all drag behavior when true.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" style="grid-template-columns: auto auto 1fr;">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:drag-start</code></n-table-cell>
            <n-table-cell><code set:html={detailItemIndex} /></n-table-cell>
            <n-table-cell>Fired on first pointer move after pointerdown.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:drag-move</code></n-table-cell>
            <n-table-cell><code set:html={detailItemXY} /></n-table-cell>
            <n-table-cell>Fired on every pointer move during drag.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:drag-over</code></n-table-cell>
            <n-table-cell>
              <strong>drop:</strong> <code set:html={detailItemTargetIndex} /><br>
              <strong>slot:</strong> <code set:html={detailItemIndexInsertBefore} />
            </n-table-cell>
            <n-table-cell>Fired when the pointer enters a drop zone or the slot position changes.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:drop</code></n-table-cell>
            <n-table-cell>
              <strong>drop:</strong> <code set:html={detailItemTargetFromTo} /><br>
              <strong>slot:</strong> <code set:html={detailItemFromToInsertBefore} />
            </n-table-cell>
            <n-table-cell>Fired on pointer up. Consumer handles the actual DOM reordering.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:drag-cancel</code></n-table-cell>
            <n-table-cell><code set:html={detailItem} /></n-table-cell>
            <n-table-cell>Fired when Escape is pressed or pointer is cancelled.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Attributes (set during drag)</h3>
      <n-table variant="plain" size="sm" style="grid-template-columns: auto auto 1fr;">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Set on</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>[dragging]</code></n-table-cell>
            <n-table-cell>Dragged item</n-table-cell>
            <n-table-cell>Present while the item is being dragged. Use for opacity/visibility.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>[drag-over]</code></n-table-cell>
            <n-table-cell>Drop zone (drop mode)</n-table-cell>
            <n-table-cell>Present on the zone the pointer is currently over.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>[drag-slot-before]</code></n-table-cell>
            <n-table-cell>Item (slot mode)</n-table-cell>
            <n-table-cell>The item immediately after the insertion gap.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>[drag-slot-after]</code></n-table-cell>
            <n-table-cell>Item (slot mode)</n-table-cell>
            <n-table-cell>The item immediately before the insertion gap.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>CSS</h3>
      <n-table variant="plain" size="sm" style="grid-template-columns: auto 1fr;">
        <n-table-head><n-table-row><n-table-header>Selector</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>.drag-placeholder</code></n-table-cell>
            <n-table-cell>Gap indicator element inserted by slot mode. Style height/width, background, and margin to match your layout.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </main>

  <script>
    import { logAppend as appendLog } from '../../scripts/event-log';

    // Helper: listen on the n-controller parent (events dispatch on the host,
    // not on children — they bubble UP, not down).
    function ctrl(child: Element | null) {
      return child?.closest('n-controller') ?? null;
    }

    document.addEventListener('astro:page-load', () => {
      const swapList = document.getElementById('swap-list');
      if (!swapList) return; // not on this page

      const swapLogEl = document.getElementById('swap-log');
      const replaceLogEl = document.getElementById('replace-log');
      const slotLogEl = document.getElementById('slot-log');
      const previewLogEl = document.getElementById('preview-log');

      function swapLog(msg: string) { appendLog(swapLogEl!, msg); }
      function replaceLog(msg: string) { appendLog(replaceLogEl!, msg); }
      function slotLog(msg: string) { appendLog(slotLogEl!, msg); }
      function previewLog(msg: string) { appendLog(previewLogEl!, msg); }

      // ── Drop mode — swap ──

      ctrl(swapList)?.addEventListener('native:drop', ((e: CustomEvent) => {
        const { item, target } = e.detail;
        if (!target || target === item) return;
        const itemLabel = item.querySelector('.label').textContent;
        const targetLabel = target.querySelector('.label').textContent;
        const placeholder = document.createElement('div');
        item.before(placeholder);
        target.before(item);
        placeholder.replaceWith(target);
        swapLog(`Swapped "${itemLabel}" ↔ "${targetLabel}"`);
      }) as EventListener);
      ctrl(swapList)?.addEventListener('native:drag-cancel', ((e: CustomEvent) => {
        swapLog(`Cancelled: "${e.detail.item.querySelector('.label').textContent}"`);
      }) as EventListener);

      // ── Drop mode — replace ──

      const replaceList = document.getElementById('replace-list');
      ctrl(replaceList)?.addEventListener('native:drop', ((e: CustomEvent) => {
        const { item, target } = e.detail;
        if (!target) return;
        const slot = target.querySelector('.role-assignee');
        const name = item.textContent;
        const role = target.querySelector('.role-name').textContent;
        slot.textContent = name;
        replaceLog(`Assigned "${name}" → ${role}`);
      }) as EventListener);

      // ── Slot mode — vertical list ──

      const slotList = document.getElementById('slot-list');
      ctrl(slotList)?.addEventListener('native:drop', ((e: CustomEvent) => {
        const { item, insertBefore, fromIndex, toIndex } = e.detail;
        if (toIndex === -1) return;
        if (insertBefore) {
          insertBefore.before(item);
        } else {
          slotList!.appendChild(item);
        }
        slotLog(`Inserted "${item.querySelector('.label').textContent}" at position ${toIndex}`);
      }) as EventListener);

      // ── Slot mode — horizontal cards ──

      const cardRow = document.getElementById('card-row');
      ctrl(cardRow)?.addEventListener('native:drop', ((e: CustomEvent) => {
        const { item, insertBefore } = e.detail;
        if (insertBefore) {
          insertBefore.before(item);
        } else {
          cardRow!.appendChild(item);
        }
      }) as EventListener);

      // ── Preview mode — grid reorder ──

      const previewGrid = document.getElementById('preview-grid');
      ctrl(previewGrid)?.addEventListener('native:drop', ((e: CustomEvent) => {
        const { item, fromIndex, toIndex } = e.detail;
        previewLog(`Moved cell ${item.textContent.trim()} from position ${fromIndex} → ${toIndex}`);
      }) as EventListener);
      ctrl(previewGrid)?.addEventListener('native:drag-cancel', ((e: CustomEvent) => {
        previewLog(`Cancelled: cell ${e.detail.item.textContent.trim()} restored`);
      }) as EventListener);
    });
  </script>
  <style is:global>
    /* ── Sortable List ── */

    .drag-list {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .drag-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 0.75rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.375rem;
      cursor: grab;
      user-select: none;
      transition: opacity 150ms ease, box-shadow 150ms ease;
    }

    .drag-item[dragging] {
      opacity: 0.3;
    }

    .drag-item .handle {
      color: var(--n-ink-muted-neutral);
      font-size: 0.875rem;
    }

    .drag-item .label {
      flex: 1;
    }

    /* ── Replace Mode: Roles ── */

    .drag-role {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.625rem 0.75rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.375rem;
      font-size: 0.875rem;
    }

    .role-name {
      font-weight: 600;
      color: var(--n-ink-strong-neutral);
    }

    .role-assignee {
      color: var(--n-ink-muted-neutral);
    }

    .drag-person {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.5rem 1rem;
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
      border-radius: 0.375rem;
      font-size: 0.8125rem;
      font-weight: 600;
      cursor: grab;
      user-select: none;
      transition: opacity 150ms ease;
    }

    .drag-person[dragging] {
      opacity: 0.3;
    }

    /* Slot mode: gap indicator */
    .drag-placeholder {
      height: 3px;
      background: var(--n-surface-accent);
      border-radius: 2px;
      margin: 0.125rem 0;
      transition: none;
    }

    /* ── Preview Mode: Grid ── */

    .drag-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
    }

    .grid-cell {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 4rem;
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
      border-radius: 0.5rem;
      font-weight: 700;
      font-size: 1rem;
      cursor: grab;
      user-select: none;
      transition: opacity 150ms ease;
    }

    .grid-cell[dragging] {
      opacity: 0.25;
    }

    ::view-transition-group(*) {
      animation-duration: 150ms;
      animation-timing-function: ease;
    }

    /* ── Horizontal ── */

    .drag-row {
      display: flex;
      gap: 0.5rem;
    }

    .drag-card {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 5rem;
      height: 5rem;
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
      border-radius: 0.5rem;
      font-weight: 700;
      cursor: grab;
      user-select: none;
      transition: opacity 150ms ease;
    }

