---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="RovingFocusable">
  <main>
<h1>RovingFocusable</h1>
    <p style="color: var(--n-ink-muted-neutral); font-size: 0.875rem; margin-bottom: 1.5rem;">
      Composable trait for keyboard navigation within a group. Only one item has <code>tabindex="0"</code> at a time — arrow keys move focus between items, Home/End jump to first/last. Skips disabled items.
    </p>

    <!-- ── Vertical Toolbar (Provider) ── -->

    <h2>Vertical (Arrow Up/Down)</h2>
    <div class="layout-section">
      <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin-bottom: 0.75rem;">
        <code>&lt;n-controller&gt;</code> applies roving focus with vertical orientation. Tab into the toolbar, then use Up/Down arrows. The "Italic" item is disabled and skipped.
      </p>
      <n-controller traits="roving-focusable" roving-focusable-selector=":scope > .toolbar > .tool-btn:not([disabled])" roving-focusable-orientation="vertical">
        <div>
          <div class="toolbar">
            <div class="tool-btn" role="button">Bold</div>
            <div class="tool-btn" role="button" disabled>Italic (disabled)</div>
            <div class="tool-btn" role="button">Underline</div>
            <div class="tool-btn" role="button">Strikethrough</div>
            <div class="tool-btn" role="button">Code</div>
          </div>
        </div>
      </n-controller>
      <pre class="layout-code"><code>&lt;n-controller traits="roving-focusable"
  roving-focusable-selector=".tool-btn:not([disabled])"
  roving-focusable-orientation="vertical"&gt;
  &lt;div&gt;
    &lt;div class="toolbar"&gt;
      &lt;div class="tool-btn" role="button"&gt;Bold&lt;/div&gt;
      &lt;div class="tool-btn" role="button" disabled&gt;Italic&lt;/div&gt;
      &lt;div class="tool-btn" role="button"&gt;Underline&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Horizontal Tab Bar (Provider) ── -->

    <h2>Horizontal (Arrow Left/Right)</h2>
    <div class="layout-section">
      <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin-bottom: 0.75rem;">
        Horizontal orientation with wrap-around. Use Left/Right arrows to navigate. Focus wraps from last to first.
      </p>
      <n-controller traits="roving-focusable" roving-focusable-selector=".tab-item" roving-focusable-orientation="horizontal">
        <div>
          <div class="tabbar" id="tabbar">
            <div class="tab-item active" role="tab">Overview</div>
            <div class="tab-item" role="tab">Features</div>
            <div class="tab-item" role="tab">API</div>
            <div class="tab-item" role="tab">Examples</div>
          </div>
        </div>
      </n-controller>
      <pre class="layout-code"><code>&lt;n-controller traits="roving-focusable"
  roving-focusable-selector=".tab-item"
  roving-focusable-orientation="horizontal"&gt;
  &lt;div&gt;
    &lt;div class="tabbar"&gt;
      &lt;div class="tab-item" role="tab"&gt;Overview&lt;/div&gt;
      &lt;div class="tab-item" role="tab"&gt;Features&lt;/div&gt;
      &lt;div class="tab-item" role="tab"&gt;API&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Built-in: n-listbox ── -->

    <h2>Built-in: n-listbox</h2>
    <div class="layout-section">
      <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin-bottom: 0.75rem;">
        <code>n-listbox</code> uses RovingFocusable internally. Arrow keys navigate between options.
      </p>
      <n-listbox style="max-width: 16rem;">
        <n-option value="react">React</n-option>
        <n-option value="vue">Vue</n-option>
        <n-option value="svelte">Svelte</n-option>
        <n-option value="lit">Lit</n-option>
      </n-listbox>
    </div>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Provider Usage</h3>
      <n-table variant="plain" size="sm" style="grid-template-columns: auto auto auto 1fr;">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>roving-focusable-selector</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell>—</n-table-cell>
            <n-table-cell>CSS selector for focusable items. Exclude disabled items with <code>:not([disabled])</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>roving-focusable-orientation</code></n-table-cell>
            <n-table-cell><code>'vertical' | 'horizontal' | 'both'</code></n-table-cell>
            <n-table-cell><code>'both'</code></n-table-cell>
            <n-table-cell>Which arrow keys to respond to. <code>'vertical'</code> = Up/Down, <code>'horizontal'</code> = Left/Right.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>roving-focusable-wrap</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>true</code></n-table-cell>
            <n-table-cell>Whether focus wraps from last to first (and vice versa).</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>roving-focusable-disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disables roving focus when <code>"true"</code>.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Keyboard</h3>
      <n-table variant="plain" size="sm" style="grid-template-columns: auto 1fr;">
        <n-table-head><n-table-row><n-table-header>Key</n-table-header><n-table-header>Action</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>Arrow Up/Down</code></n-table-cell>
            <n-table-cell>Move focus in vertical mode.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>Arrow Left/Right</code></n-table-cell>
            <n-table-cell>Move focus in horizontal mode.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>Home</code></n-table-cell>
            <n-table-cell>Move focus to first item.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>End</code></n-table-cell>
            <n-table-cell>Move focus to last item.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </main>

  <script>
document.addEventListener('astro:page-load', () => {
  if (!document.getElementById('tabbar')) return;

  // ── Tab bar: active class switching ──

  const tabbar = document.getElementById('tabbar')!;
  tabbar.addEventListener('focusin', (e: FocusEvent) => {
    for (const item of tabbar.querySelectorAll('.tab-item')) item.classList.remove('active');
    if (e.target !== tabbar) (e.target as HTMLElement).classList.add('active');
  });
});
  </script>
  <style is:global>
    /* ── Vertical toolbar ── */

    .toolbar {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 0.25rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.375rem;
      width: fit-content;
    }

    .tool-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      background: transparent;
      border-radius: 0.25rem;
      font-size: 0.875rem;
      cursor: pointer;
      transition: background 100ms ease;
      outline: none;
    }

    .tool-btn:hover {
      background: var(--n-panel-hover-neutral);
    }

    .tool-btn:focus-visible {
      outline: 2px solid var(--n-focus-ring);
      outline-offset: -2px;
    }

    .tool-btn[disabled] {
      opacity: 0.4;
      cursor: not-allowed;
    }

    /* ── Horizontal tab bar ── */

    .tabbar {
      display: flex;
      gap: 0;
      border-bottom: 1px solid var(--n-border-muted-neutral);
    }

    .tab-item {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      cursor: pointer;
      outline: none;
      border-bottom: 2px solid transparent;
      transition: border-color 100ms ease, color 100ms ease;
      color: var(--n-ink-muted-neutral);
    }

    .tab-item:hover {
      color: var(--n-ink-hover-neutral);
    }

    .tab-item:focus-visible {
      outline: 2px solid var(--n-focus-ring);
      outline-offset: -2px;
    }

    .tab-item.active {
      color: var(--n-surface-ink-accent);
      border-bottom-color: var(--n-surface-accent);
    }

    /* ── Code Blocks ── */
</style>

</SidebarLayout>
