---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';

const codeExamples = {
  copyAmpPaste: `&lt;n-controller traits="selectable clippable"
  selectable-selector=".clip-item"
  selectable-mode="multiple"
  clippable-selector=".clip-item"&gt;
  &lt;div class="clip-list" tabindex="0"&gt;
    &lt;div class="clip-item"&gt;src/index.ts&lt;/div&gt;
    &lt;div class="clip-item"&gt;src/core/types.ts&lt;/div&gt;
    &lt;!-- ... --&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;

list.addEventListener('native:clip-copy', (e) =&gt; {
  log(\`Copied \${e.detail.items.length} item(s)\`);
});`,
  cutAmpPaste: `&lt;n-controller traits="selectable clippable"
  selectable-selector=".clip-item"
  selectable-mode="multiple"
  clippable-selector=".clip-item"&gt;
  &lt;div class="clip-list" tabindex="0"&gt;
    &lt;div class="clip-item"&gt;Header.tsx&lt;/div&gt;
    &lt;!-- ... --&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;

list.addEventListener('native:clip-cut', (e) =&gt; {
  log(\`Cut \${e.detail.items.length} item(s)\`);
});

list.addEventListener('native:clip-paste', (e) =&gt; {
  log(\`Paste: "\${e.detail.data}"\`);
});`,
};
const detailItemsData = `{ items, data }`;
const detailData = `{ data }`;
const detailSelectedCount = `{ selected, count }`;
---
<SidebarLayout title="Clippable">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Clippable</h1>
      </div>
    </div>
    <div slot="description">

      Keyboard clipboard operations (<strong>Ctrl/Cmd+C/X/V</strong>) for structured data. Composes with <code>Selectable</code> to copy/cut selected items.

    </div>
  </header>

  <section>

    <!-- ── Copy & Paste ── -->

    <h2>Copy &amp; Paste</h2>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        Click to select items, then use keyboard shortcuts to copy. Focus the list first by clicking an item.
      </span></div>
      <div class="shortcut-row">
        <span class="shortcut-hint">Ctrl/Cmd+C — Copy</span>
        <span class="shortcut-hint">Shift+Click — Range select</span>
        <span class="shortcut-hint">Ctrl/Cmd+A — Select all</span>
      </div>
      <n-controller traits="selectable clippable" selectable-selector=".clip-item" selectable-mode="multiple" clippable-selector=".clip-item">
        <div id="copy-list" class="clip-list" tabindex="0">
          <div class="clip-item">src/index.ts</div>
          <div class="clip-item">src/core/types.ts</div>
          <div class="clip-item">src/traits/selectable.ts</div>
          <div class="clip-item">src/traits/clippable.ts</div>
          <div class="clip-item">src/components/n-button.ts</div>
        </div>
      </n-controller>
      <div id="copy-log" class="output"></div>
      <pre class="code-block"><code set:html={codeExamples.copyAmpPaste} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Cut & Paste ── -->

    <h2>Cut &amp; Paste</h2>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        <strong>Ctrl/Cmd+X</strong> marks items with <code>[clip-cut]</code> (dimmed). <strong>Ctrl/Cmd+V</strong> dispatches a paste event.
      </span></div>
      <div class="shortcut-row">
        <span class="shortcut-hint">Ctrl/Cmd+X — Cut</span>
        <span class="shortcut-hint">Ctrl/Cmd+V — Paste</span>
      </div>
      <n-controller traits="selectable clippable" selectable-selector=".clip-item" selectable-mode="multiple" clippable-selector=".clip-item">
        <div id="cut-list" class="clip-list" tabindex="0">
          <div class="clip-item">Header.tsx</div>
          <div class="clip-item">Sidebar.tsx</div>
          <div class="clip-item">Footer.tsx</div>
          <div class="clip-item">Modal.tsx</div>
          <div class="clip-item">Toast.tsx</div>
        </div>
      </n-controller>
      <div id="cut-log" class="output"></div>
      <pre class="code-block"><code set:html={codeExamples.cutAmpPaste} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Provider Usage</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>clippable-selector</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell><code>''</code></n-table-cell>
            <n-table-cell>CSS selector for clippable items. Keyboard shortcuts act on <code>[selected]</code> items within this selector.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>clippable-disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disables all clipboard operations when true.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>selectable-selector</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell><code>''</code></n-table-cell>
            <n-table-cell>CSS selector for selectable items (from the <code>selectable</code> trait).</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>selectable-mode</code></n-table-cell>
            <n-table-cell><code>'single' | 'multiple'</code></n-table-cell>
            <n-table-cell><code>'multiple'</code></n-table-cell>
            <n-table-cell>Selection mode: single or multiple (from the <code>selectable</code> trait).</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Controller Methods</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Method</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>copy(items)</code></n-table-cell>
            <n-table-cell>Copy given items to system clipboard and dispatch <code>native:clip-copy</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>cut(items)</code></n-table-cell>
            <n-table-cell>Copy items and mark them with <code>[clip-cut]</code>. Dispatch <code>native:clip-cut</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>paste()</code></n-table-cell>
            <n-table-cell>Read from clipboard and dispatch <code>native:clip-paste</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>cancelCut()</code></n-table-cell>
            <n-table-cell>Remove <code>[clip-cut]</code> from all previously cut items.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>serialize(items)</code></n-table-cell>
            <n-table-cell>Convert items to a string. Default: joins <code>textContent</code> with newlines.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>deserialize(data)</code></n-table-cell>
            <n-table-cell>Convert clipboard string back to an array of strings. Default: splits by newline.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:clip-copy</code></n-table-cell>
            <n-table-cell><code set:html={detailItemsData} /></n-table-cell>
            <n-table-cell>Fired after a copy operation. <code>data</code> is the serialized string.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:clip-cut</code></n-table-cell>
            <n-table-cell><code set:html={detailItemsData} /></n-table-cell>
            <n-table-cell>Fired after a cut operation. Items are marked with <code>[clip-cut]</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:clip-paste</code></n-table-cell>
            <n-table-cell><code set:html={detailData} /></n-table-cell>
            <n-table-cell>Fired after reading from clipboard. Consumer handles insertion.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:selection-change</code></n-table-cell>
            <n-table-cell><code set:html={detailSelectedCount} /></n-table-cell>
            <n-table-cell>Fired when the selection changes (from the <code>selectable</code> trait).</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>CSS Attributes</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Set on</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>[selected]</code></n-table-cell>
            <n-table-cell>Selected items</n-table-cell>
            <n-table-cell>Present on items currently selected (from the <code>selectable</code> trait).</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>[clip-cut]</code></n-table-cell>
            <n-table-cell>Cut items</n-table-cell>
            <n-table-cell>Present on items that have been cut. Use for dimmed/dashed styling.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </section>

  <script>
    import './clippable.ts';
  </script>
  <style is:global>
    @import './clippable.css';
  </style>

</SidebarLayout>
