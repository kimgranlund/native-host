---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="LinkPasteable">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>LinkPasteable</h1>
      </div>
    </div>
    <div slot="description">
      Select text in a contenteditable input, then paste a URL from your clipboard. The selected text is converted into a styled <code>&lt;a&gt;</code> hyperlink pointing to the pasted URL. If no text is selected, the paste proceeds normally.
    </div>
  </header>

  <section id="link-pasteable-page">

    <!-- ── Basic Link Paste ── -->

    <h2>Basic Link Paste</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Type some text, select a word, then paste a URL (e.g. <code>https://example.com</code>). The selected word becomes a hyperlink. If nothing is selected, paste behaves normally.
      </span>
      <div id="basic-wrapper" class="paste-wrapper">
        <n-textarea id="basic-textarea" placeholder="Type text, select a word, paste a URL..." rows="2"></n-textarea>
      </div>
      <div id="basic-log" class="output"></div>
    <pre class="code-block"><code>import &#123; LinkPasteController &#125; from '@nonoun/native-ui/traits';

const linkPaste = new LinkPasteController(wrapper, &#123;
  input: textarea,
&#125;);

wrapper.addEventListener('native:link-paste', (e) =&gt; &#123;
  console.log('Linked:', e.detail.text, '→', e.detail.url);
&#125;);</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Combined: All Text Commands ── -->

    <h2>Combined: All Text Commands</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        All four text command controllers on one input. Type <code>/</code> for slash commands, <code>@</code> for mentions, <code>`code`</code> for inline code, and select text + paste URL for links. All work independently without conflict.
      </span>
      <div id="combo-wrapper" class="paste-wrapper">
        <n-textarea id="combo-textarea" placeholder="Type / for commands, @ for mentions, `code` for inline code, or select + paste URL for links..." rows="3"></n-textarea>
      </div>
      <div id="combo-log" class="output"></div>
    <pre class="code-block"><code>// All four controllers on the same input
const slash = new SlashCommandController(wrapper, &#123; input, commands &#125;);
const mention = new MentionController(wrapper, &#123; input, items &#125;);
const backtick = new BacktickWrapController(wrapper, &#123; input &#125;);
const linkPaste = new LinkPasteController(wrapper, &#123; input &#125;);</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── API Reference ── -->

    <h2>API</h2>

      <h3>Constructor Options (<code>LinkPasteOptions</code>)</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Property</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>input</code></n-table-cell>
            <n-table-cell><code>HTMLElement</code></n-table-cell>
            <n-table-cell>---</n-table-cell>
            <n-table-cell>The input element to monitor.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disable the controller without destroying it.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>

      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:link-paste</code></n-table-cell>
            <n-table-cell><code>&#123; url, text, element &#125;</code></n-table-cell>
            <n-table-cell>Fired when selected text is converted to a hyperlink. <code>url</code> is the pasted URL, <code>text</code> is the original selected text, <code>element</code> is the created <code>&lt;a&gt;</code> node.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>

      <h3>Behavior</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Trigger</n-table-header><n-table-header>Action</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell>Paste URL with text selected</n-table-cell>
            <n-table-cell>Wraps selected text in <code>&lt;a href="..."&gt;</code> pointing to the pasted URL. Opens in new tab.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Paste URL with no selection</n-table-cell>
            <n-table-cell>No-op — paste proceeds normally.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Paste non-URL with selection</n-table-cell>
            <n-table-cell>No-op — paste proceeds normally.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Accepted URL formats</n-table-cell>
            <n-table-cell><code>https://</code>, <code>http://</code>, <code>ftp://</code>, <code>//</code> (protocol-relative)</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </section>

  <script>
    import './link-pasteable.ts';
  </script>

  <style is:global>
    @import './link-pasteable.css';
  </style>
</SidebarLayout>
