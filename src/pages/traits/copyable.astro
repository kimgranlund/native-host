---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const eventDetail = `{ value: string }`;
const codeExamples = {
  basicCopyInjection: `&lt;copy-demo traits="copyable pressable"
  copyable-value="npm install native-ui"&gt;
  &lt;span class="copy-label"&gt;npm install native-ui&lt;/span&gt;
  &lt;span class="copy-indicator"&gt;Copy&lt;/span&gt;
&lt;/copy-demo&gt;

// Minimal NativeElement shell
class CopyDemo extends NativeElement {}
define('copy-demo', CopyDemo);

// Wire native:press → copy
el.addEventListener('native:press', () =&gt; {
  el.getTraitController('copyable')?.copy();
});`,
  copyWithGetter: `import { CopyController } from '@nonoun/native-ui';

const el = document.querySelector('#getter-demo');
const copy = new CopyController(el, {
  value: () =&gt; new Date().toISOString(),
});

el.addEventListener('native:press', () =&gt; copy.copy());`,
};
---
<SidebarLayout title="Copyable">
  <main>
<h1>Copyable</h1>
    <n-text size="md" muted spacing="relaxed">
      One-click copy-to-clipboard with visual confirmation feedback. Sets the <code>[copied]</code> attribute during the feedback window and dispatches <code>native:copy</code>.
    </n-text>

    <!-- ── Basic Copy (Injection) ── -->

    <h2>Basic Copy <span class="pattern-badge injection">Injection</span></h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        <code>traits="copyable pressable"</code> on a minimal NativeElement shell. Click triggers copy via <code>native:press</code>. The <code>[copied]</code> attribute provides visual feedback for 2 seconds.
      </n-text>
      <copy-demo traits="copyable pressable" copyable-value="npm install native-ui" class="copy-card">
        <span class="copy-label">npm install native-ui</span>
        <span class="copy-indicator"><n-icon name="copy"></n-icon> Copy</span>
      </copy-demo>
      <div id="basic-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.basicCopyInjection} /><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Copy with Getter ── -->

    <h2>Copy with Getter</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        The copyable adapter takes static <code>value</code> strings. For dynamic values (like timestamps), use <code>CopyController</code> directly with a getter function.
      </n-text>
      <copy-demo id="getter-demo" traits="pressable" class="copy-card">
        <span class="copy-label">Copy current timestamp</span>
        <span class="copy-indicator"><n-icon name="copy"></n-icon> Copy</span>
      </copy-demo>
      <div id="getter-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.copyWithGetter} /><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Custom Duration (Injection) ── -->

    <h2>Custom Duration (500ms) <span class="pattern-badge injection">Injection</span></h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        <code>copyable-feedback-duration="500"</code> for quick feedback instead of the default 2000ms.
      </n-text>
      <copy-demo traits="copyable pressable" copyable-value="Quick feedback copy" copyable-feedback-duration="500" class="copy-card">
        <span class="copy-label">Quick feedback copy</span>
        <span class="copy-indicator"><n-icon name="copy"></n-icon> Copy</span>
      </copy-demo>
      <div id="fast-log" class="output"></div>
      <pre class="layout-code"><code>&lt;copy-demo traits="copyable pressable"
  copyable-value="Quick feedback copy"
  copyable-feedback-duration="500"&gt;
  &lt;span class="copy-label"&gt;Quick feedback copy&lt;/span&gt;
  &lt;span class="copy-indicator"&gt;Copy&lt;/span&gt;
&lt;/copy-demo&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Provider Pattern ── -->

    <h2>Provider Pattern <span class="pattern-badge provider">Provider</span></h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        <code>&lt;n-controller&gt;</code> applies copyable to a plain <code>&lt;div&gt;</code>. No NativeElement subclass needed for the target. The controller manages <code>[copied]</code> feedback; a click listener triggers <code>copy()</code>.
      </n-text>
      <n-controller id="provider-ctrl" traits="copyable" copyable-value="npx create-native-ui@latest">
        <div id="provider-card" class="copy-card">
          <span class="copy-label">npx create-native-ui@latest</span>
          <span class="copy-indicator"><n-icon name="copy"></n-icon> Copy</span>
        </div>
      </n-controller>
      <div id="provider-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="copyable"
  copyable-value="npx create-native-ui@latest"&gt;
  &lt;div class="copy-card"&gt;
    &lt;span class="copy-label"&gt;npx create-native-ui@latest&lt;/span&gt;
    &lt;span class="copy-indicator"&gt;Copy&lt;/span&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Adapter Options (<code>copyable-*</code>)</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>copyable-value</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell><code>''</code></n-table-cell>
            <n-table-cell>The static string to copy. For dynamic values, use <code>CopyController</code> directly with a getter function.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>copyable-feedback-duration</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>2000</code></n-table-cell>
            <n-table-cell>Duration in milliseconds that the <code>[copied]</code> attribute remains set after a successful copy.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Controller Methods</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Method</n-table-header><n-table-header>Returns</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>copy()</code></n-table-cell>
            <n-table-cell><code>Promise&lt;void&gt;</code></n-table-cell>
            <n-table-cell>Writes the value to the clipboard, sets <code>[copied]</code>, and dispatches <code>native:copy</code>.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:copy</code></n-table-cell>
            <n-table-cell><code set:html={eventDetail} /></n-table-cell>
            <n-table-cell>Fired after a successful copy. <code>detail.value</code> contains the copied string.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>CSS</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Selector</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>[copied]</code></n-table-cell>
            <n-table-cell>Present on the element during the feedback window after a successful copy. Use for visual confirmation styling.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </main>

  <script>
import { NativeElement, define, CopyController } from "@nonoun/native-ui";
import { logAppend as appendLog } from '../../scripts/event-log';

// ── Minimal NativeElement shell for injection demos ──
if (!customElements.get('copy-demo')) {
      class CopyDemo extends NativeElement {}
      define('copy-demo', CopyDemo);
}

document.addEventListener('astro:page-load', () => {
      if (!document.getElementById('basic-log')) return;

      // ── Basic Copy (injection) — wire native:press → copy ──

      for (const el of document.querySelectorAll('copy-demo[traits*="copyable"]')) {
        el.addEventListener('native:press', () => {
          (el as any).getTraitController('copyable')?.copy();
        });
      }

      const basicLogEl = document.getElementById('basic-log');
      document.querySelector('copy-demo[copyable-value="npm install native-ui"]')?.addEventListener('native:copy', (e: CustomEvent) => {
        appendLog(basicLogEl, `Copied: "${e.detail.value}"`);
      });

      // ── Copy with Getter (CopyController direct) ──

      const getterEl = document.getElementById('getter-demo')!;
      const getterCopy = new CopyController(getterEl, {
        value: () => new Date().toISOString(),
      });

      getterEl.addEventListener('native:press', () => getterCopy.copy());

      const getterLogEl = document.getElementById('getter-log');
      getterEl.addEventListener('native:copy', (e: CustomEvent) => {
        appendLog(getterLogEl, `Copied: "${e.detail.value}"`);
      });

      // ── Custom Duration (injection) — log ──

      const fastLogEl = document.getElementById('fast-log');
      document.querySelector('copy-demo[copyable-feedback-duration="500"]')?.addEventListener('native:copy', (e: CustomEvent) => {
        appendLog(fastLogEl, `Copied: "${e.detail.value}"`);
      });

      // ── Provider Pattern — wire click → copy ──
      // The CopyController is managed by n-controller on the first child.
      // Since targets are plain divs (not NativeElement), we read the value from
      // the controller attribute and invoke clipboard API directly.

      const providerCard = document.getElementById('provider-card');
      providerCard?.addEventListener('click', async () => {
        const value = document.getElementById('provider-ctrl')?.getAttribute('copyable-value') ?? '';
        await navigator.clipboard.writeText(value);
        providerCard.toggleAttribute('copied', true);
        setTimeout(() => providerCard.removeAttribute('copied'), 2000);
        providerCard.dispatchEvent(new CustomEvent('native:copy', { bubbles: true, detail: { value } }));
      });

      const providerLogEl = document.getElementById('provider-log');
      providerCard?.addEventListener('native:copy', (e: CustomEvent) => {
        appendLog(providerLogEl, `Copied: "${e.detail.value}"`);
      });
});
  </script>
  <style is:global>
    /* ── Copy Cards ── */

    .copy-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.375rem;
      cursor: pointer;
      user-select: none;
      transition: border-color 150ms ease, background 150ms ease, color 150ms ease;
      font-size: 0.875rem;
    }

    .copy-card:hover {
      border-color: var(--n-border-neutral);
    }

    .copy-card[copied] {
      border-color: var(--n-border-accent);
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
    }

    .copy-indicator {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      transition: color 150ms ease;
    }

    [copied] .copy-indicator {
      color: var(--n-surface-ink-accent);
    }

    .copy-label {
      flex: 1;
    }

    .output {
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      max-height: 6rem;
      overflow-y: auto;
      margin-top: 0.75rem;
      padding: 0.5rem;
      background: var(--n-panel-neutral);
      border-radius: 0.25rem;
    }

    /* ── Code Blocks ── */

    /* ── Pattern Badges ── */

    .pattern-badge {
      display: inline-block;
      font-size: 0.625rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      margin-left: 0.5rem;
      vertical-align: middle;
    }

    .pattern-badge.injection {
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
    }

    .pattern-badge.provider {
      background: var(--n-surface-info);
      color: var(--n-surface-ink-info);
    }
</style>

</SidebarLayout>
