---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="BacktickWrappable">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>BacktickWrappable</h1>
      </div>
    </div>
    <div slot="description">
      Watches for paired backtick delimiters in a contenteditable input. When the user types a closing <code>`</code> that matches an opening <code>`</code>, the text between them is wrapped in a styled <code>&lt;code&gt;</code> element. Also wraps selected text when <code>`</code> is typed with an active selection.
    </div>
  </header>

  <section id="backtick-wrappable-page">

    <!-- ── Basic Backtick Wrap ── -->

    <h2>Basic Backtick Wrap</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Type <code>`hello`</code> — when you type the closing backtick, "hello" becomes an inline <code>&lt;code&gt;</code> element. You can also select text and press <code>`</code> to wrap the selection.
      </span>
      <div id="basic-wrapper" class="wrap-wrapper">
        <n-textarea id="basic-textarea" placeholder="Type `code` to see inline code wrapping..." rows="2"></n-textarea>
      </div>
      <div id="basic-log" class="output"></div>
    <pre class="code-block"><code>import &#123; BacktickWrapController &#125; from '@nonoun/native-ui';

const backtick = new BacktickWrapController(wrapper, &#123;
  input: textarea,
&#125;);

wrapper.addEventListener('native:backtick-wrap', (e) =&gt; &#123;
  console.log('Wrapped:', e.detail.text);
&#125;);</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Combined: All Text Commands ── -->

    <h2>Combined: Slash + Mention + Backtick</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        All three text command controllers on one input. Type <code>/</code> for slash commands, <code>@</code> for mentions, and <code>`code`</code> for inline code. All work independently without conflict.
      </span>
      <div id="combo-wrapper" class="wrap-wrapper">
        <n-textarea id="combo-textarea" placeholder="Type / for commands, @ for mentions, `code` for inline code..." rows="3"></n-textarea>
      </div>
      <div id="combo-log" class="output"></div>
    <pre class="code-block"><code>// All three controllers on the same input
const slash = new SlashCommandController(wrapper, &#123; input, commands &#125;);
const mention = new MentionController(wrapper, &#123; input, items &#125;);
const backtick = new BacktickWrapController(wrapper, &#123; input &#125;);</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── API Reference ── -->

    <h2>API</h2>

      <h3>Constructor Options (<code>BacktickWrapOptions</code>)</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Property</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>input</code></n-table-cell>
            <n-table-cell><code>HTMLElement</code></n-table-cell>
            <n-table-cell>---</n-table-cell>
            <n-table-cell>The input element to monitor.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disable the controller without destroying it.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>

      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:backtick-wrap</code></n-table-cell>
            <n-table-cell><code>&#123; text, element &#125;</code></n-table-cell>
            <n-table-cell>Fired when text is wrapped in a <code>&lt;code&gt;</code> element. <code>text</code> is the wrapped string, <code>element</code> is the created node.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>

      <h3>Behavior</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Trigger</n-table-header><n-table-header>Action</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell>Closing <code>`</code> after opening <code>`</code></n-table-cell>
            <n-table-cell>Wraps text between the backtick pair in a <code>&lt;code&gt;</code> element. Single-line only.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>`</code> with text selected</n-table-cell>
            <n-table-cell>Wraps the selected text in a <code>&lt;code&gt;</code> element.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Empty backtick pair <code>``</code></n-table-cell>
            <n-table-cell>No-op — types normally.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><n-kbd>Cmd</n-kbd>/<n-kbd>Ctrl</n-kbd>/<n-kbd>Alt</n-kbd>+<code>`</code></n-table-cell>
            <n-table-cell>Ignored — modifier combinations pass through.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </section>

  <script>
    import './backtick-wrappable.ts';
  </script>

  <style is:global>
    @import './backtick-wrappable.css';
  </style>
</SidebarLayout>
