---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';

const codeExamples = {
  clickOutsideToDismiss: `import { DismissController } from '@nonoun/native-ui';

const panel = document.getElementById('panel');
const dismiss = new DismissController(panel);

function showPanel() {
  panel.removeAttribute('hidden');
  dismiss.enable();
}

function hidePanel() {
  dismiss.disable();
  panel.setAttribute('hidden', '');
}

panel.addEventListener('native:dismiss', () =&gt; hidePanel());`,
};
---
<SidebarLayout title="Dismissable">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Dismissable</h1>
      </div>
    </div>
    <div slot="description">

      Composable trait that manages a global layer stack. When enabled, clicking outside the element or pressing Escape dispatches a <code>native:dismiss</code> event. Only the topmost layer in the stack receives dismiss events.

    </div>
  </header>

  <section>

    <!-- ── Click Outside to Dismiss ── -->

    <h2>Click Outside to Dismiss</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Uses <code>DismissController</code> directly on a plain element. Call <code>enable()</code> to join the dismiss stack, <code>disable()</code> to leave.
      </span>
      <n-button id="open-btn">Open Panel</n-button>
      <div class="dismiss-panel" id="panel" hidden>
        This panel is dismissable. Click anywhere outside it or press <strong>Escape</strong> to close.
        <br><br>
        Clicking inside the panel will not dismiss it.
      </div>
      <div id="log" class="output"></div>
      <pre class="code-block"><code set:html={codeExamples.clickOutsideToDismiss} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Nested Layers ── -->

    <h2>Nested Layers (Stack)</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Open both panels. Only the topmost one receives dismiss events. After the top panel is dismissed, the bottom panel becomes the new top.
      </span>
      <n-stack direction="row">
        <n-button id="open-a">Open Panel A</n-button>
        <n-button id="open-b">Open Panel B</n-button>
      </n-stack>
      <div class="dismiss-panel" id="panel-a" hidden>
        <strong>Panel A</strong> — I'm the first layer.
      </div>
      <div class="dismiss-panel dismiss-panel-b" id="panel-b" hidden>
        <strong>Panel B</strong> — I'm on top of Panel A.
      </div>
      <pre class="code-block"><code>&lt;!-- Each panel has its own DismissController --&gt;
const dismissA = new DismissController(panelA);
const dismissB = new DismissController(panelB);

// Open Panel A — joins dismiss stack
panelA.removeAttribute('hidden');
dismissA.enable();

// Open Panel B — becomes top of stack
panelB.removeAttribute('hidden');
dismissB.enable();

// Escape/click-outside dismisses B first, then A</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Built-in: n-dialog ── -->

    <h2>Built-in: n-dialog</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        <code>n-dialog</code> uses Dismissable internally. Escape and backdrop click close the dialog automatically.
      </span>
      <n-button id="open-dialog">Open Dialog</n-button>
      <n-dialog id="demo-dialog">
        <div class="dialog-card"><n-container>
          <span>This dialog uses Dismissable internally. Press Escape or click the backdrop to close.</span>
          <n-button id="close-dialog" intent="accent">Close</n-button>
        </n-container></div>
      </n-dialog>
      <pre class="code-block"><code>&lt;n-button id="open"&gt;Open Dialog&lt;/n-button&gt;
&lt;n-dialog id="dialog"&gt;
  &lt;n-container&gt;
    &lt;p&gt;Dialog content&lt;/p&gt;
    &lt;n-button id="close"&gt;Close&lt;/n-button&gt;
  &lt;/n-container&gt;
&lt;/n-dialog&gt;

&lt;script&gt;
  open.addEventListener('native:press', () =&gt; dialog.showModal());
  close.addEventListener('native:press', () =&gt; dialog.close());
&lt;/script&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Methods</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Method</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>enable()</code></n-table-cell>
            <n-table-cell>Pushes the element onto the global dismiss stack. Click-outside and Escape will fire <code>native:dismiss</code> on this element.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>disable()</code></n-table-cell>
            <n-table-cell>Removes the element from the dismiss stack. No more dismiss events.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>destroy()</code></n-table-cell>
            <n-table-cell>Removes from stack and cleans up. Call in <code>teardown()</code>.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:dismiss</code></n-table-cell>
            <n-table-cell>—</n-table-cell>
            <n-table-cell>Fired when click-outside or Escape occurs while this element is the topmost layer. Consumer handles hiding.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </section>

  <script>
    import './dismissable.ts';
  </script>
  <style is:global>
    @import './dismissable.css';
  </style>

</SidebarLayout>
