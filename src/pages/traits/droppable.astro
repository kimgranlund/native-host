---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  fileDropZoneProvider: `&lt;n-controller traits="droppable"&gt;
  &lt;div class="drop-zone"&gt;
    Drop files here
  &lt;/div&gt;
&lt;/n-controller&gt;

&lt;script&gt;
  zone.addEventListener('native:drop', (e) =&gt; {
    if (e.detail.type === 'file') {
      for (const file of e.detail.files) {
        console.log(file.name, file.size);
      }
    }
  });
&lt;/script&gt;`,
  textDropProvider: `&lt;n-controller traits="droppable"&gt;
  &lt;div class="drop-zone"&gt;
    Drop text here
  &lt;/div&gt;
&lt;/n-controller&gt;

&lt;script&gt;
  zone.addEventListener('native:drop', (e) =&gt; {
    if (e.detail.type === 'text') {
      console.log('Dropped text:', e.detail.text);
    }
  });
&lt;/script&gt;`,
};
const detailDrop = `{ type, files?, text?, dataTransfer? }`;
---
<SidebarLayout title="Droppable">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Droppable</h1>
      </div>
    </div>
    <div data-slot="description">

      External file/data drop zone using the HTML5 drag-and-drop API. Sets <code>[drop-active]</code> when a valid item is dragged over and <code>[drop-invalid]</code> when the MIME type does not match <code>droppable-accept</code>.

    </div>
  </header>

  <main>

    <!-- ── File Drop Zone (Provider) ── -->

    <h2>File Drop Zone (Provider)</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        <code>&lt;n-controller traits="droppable"&gt;</code> wraps a plain div. Drop any files onto the zone.
      </n-text>
      <n-controller traits="droppable">
        <div class="drop-zone" id="files-zone">
          <span class="drop-icon">&#128193;</span>
          <span>Drop files here</span>
          <span class="drop-hint">Any file type accepted</span>
        </div>
      </n-controller>
      <div id="files-list" class="file-list" class="drop-hidden"></div>
      <div id="files-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.fileDropZoneProvider} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Image Only (Provider) ── -->

    <h2>Image Only (Provider)</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        <code>droppable-accept="image/*"</code> filter. Shows <code>[drop-invalid]</code> when a non-image is dragged over.
      </n-text>
      <n-controller traits="droppable" droppable-accept="image/*">
        <div class="drop-zone" id="images-zone">
          <span class="drop-icon">&#128247;</span>
          <span>Drop images here</span>
          <span class="drop-hint">Only image files accepted</span>
        </div>
      </n-controller>
      <div id="images-list" class="file-list" class="drop-hidden"></div>
      <div id="images-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="droppable" droppable-accept="image/*"&gt;
  &lt;div class="drop-zone"&gt;
    Drop images here
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Text Drop (Provider) ── -->

    <h2>Text Drop (Provider)</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Drop plain text from a browser selection. Select text elsewhere and drag it onto the zone.
      </n-text>
      <n-controller traits="droppable">
        <div class="drop-zone" id="text-zone">
          <span class="drop-icon">&#128196;</span>
          <span>Drop text here</span>
          <span class="drop-hint">Select text in your browser and drag it here</span>
        </div>
      </n-controller>
      <div id="text-content" class="dropped-text" class="drop-hidden"></div>
      <div id="text-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.textDropProvider} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Single File (Provider) ── -->

    <h2>Single File (Provider)</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        <code>droppable-multiple="false"</code>. Only the first file is accepted when multiple are dropped.
      </n-text>
      <n-controller traits="droppable" droppable-multiple="false">
        <div class="drop-zone" id="single-zone">
          <span class="drop-icon">&#128206;</span>
          <span>Drop a single file</span>
          <span class="drop-hint">Only the first file will be accepted</span>
        </div>
      </n-controller>
      <div id="single-list" class="file-list" class="drop-hidden"></div>
      <div id="single-log" class="output"></div>
      <pre class="layout-code"><code>&lt;n-controller traits="droppable" droppable-multiple="false"&gt;
  &lt;div class="drop-zone"&gt;
    Drop a single file
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Provider Usage</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>droppable-accept</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell><code>'*'</code></n-table-cell>
            <n-table-cell>MIME type filter (e.g. <code>'image/*'</code>, <code>'application/pdf'</code>). Uses wildcard matching.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>droppable-disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disables drop zone when true.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>droppable-multiple</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>true</code></n-table-cell>
            <n-table-cell>When <code>"false"</code>, only the first file from a multi-file drop is accepted.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:drop</code></n-table-cell>
            <n-table-cell><code set:html={detailDrop} /></n-table-cell>
            <n-table-cell>Unified drop event. <code>type</code> is <code>'file'</code> or <code>'text'</code>. File drops include <code>files</code> (array of <code>File</code>) and <code>dataTransfer</code>. Text drops include <code>text</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:drop-enter</code></n-table-cell>
            <n-table-cell>&mdash;</n-table-cell>
            <n-table-cell>Fired when a dragged item enters the drop zone.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>native:drop-leave</code></n-table-cell>
            <n-table-cell>&mdash;</n-table-cell>
            <n-table-cell>Fired when a dragged item leaves the drop zone.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>CSS</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Selector</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>[drop-active]</code></n-table-cell>
            <n-table-cell>Present when a valid item is being dragged over the zone.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>[drop-invalid]</code></n-table-cell>
            <n-table-cell>Present when a dragged item does not match <code>droppable-accept</code>.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </main>

  <script>
import { logAppend as appendLog } from '../../scripts/event-log';

document.addEventListener('astro:page-load', () => {
  const filesZone = document.getElementById('files-zone');
  if (!filesZone) return;

  /** @param {number} bytes */
  function formatSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  /**
   * @param {HTMLElement | null} listEl
   * @param {File[]} files
   */
  function renderFiles(listEl, files) {
    if (!listEl) return;
    listEl.innerHTML = '';
    listEl.classList.remove('drop-hidden');
    for (const file of files) {
      const item = document.createElement('div');
      item.className = 'file-item';
      item.innerHTML = `<span class="file-name">${file.name}</span><span class="file-size">${formatSize(file.size)}</span>`;
      listEl.appendChild(item);
    }
  }

  filesZone.addEventListener('native:drop', (e) => {
    /** @type {CustomEvent} */ const evt = e;
    if (evt.detail.type !== 'file') return;
    renderFiles(document.getElementById('files-list'), evt.detail.files);
    for (const file of evt.detail.files) {
      appendLog(document.getElementById('files-log'), `${file.name} (${formatSize(file.size)})`);
    }
  });

  document.getElementById('images-zone')?.addEventListener('native:drop', (e) => {
    /** @type {CustomEvent} */ const evt = e;
    if (evt.detail.type !== 'file') return;
    renderFiles(document.getElementById('images-list'), evt.detail.files);
    for (const file of evt.detail.files) {
      appendLog(document.getElementById('images-log'), `${file.name} (${file.type}, ${formatSize(file.size)})`);
    }
  });

  document.getElementById('text-zone')?.addEventListener('native:drop', (e) => {
    /** @type {CustomEvent} */ const evt = e;
    if (evt.detail.type !== 'text') return;
    const contentEl = document.getElementById('text-content');
    if (contentEl) {
      contentEl.classList.remove('drop-hidden');
      contentEl.textContent = evt.detail.text;
    }
    appendLog(document.getElementById('text-log'), `Dropped ${evt.detail.text.length} characters`);
  });

  document.getElementById('single-zone')?.addEventListener('native:drop', (e) => {
    /** @type {CustomEvent} */ const evt = e;
    if (evt.detail.type !== 'file') return;
    renderFiles(document.getElementById('single-list'), evt.detail.files);
    const file = evt.detail.files[0];
    appendLog(document.getElementById('single-log'), `${file.name} (${formatSize(file.size)}) — only 1 file accepted`);
  });
});
  </script>
  <style is:global>
    .drop-hidden {
      display: none;
    }

    /* ── Drop Zones ── */

    .drop-zone {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 8rem;
      padding: 1.5rem;
      background: var(--n-panel-neutral);
      border: 2px dashed var(--n-border-muted-neutral);
      border-radius: 0.5rem;
      font-size: 0.875rem;
      color: var(--n-ink-muted-neutral);
      transition: border-color 200ms ease, background 200ms ease, color 200ms ease;
      text-align: center;
    }

    .drop-zone[drop-active] {
      border-color: var(--n-border-accent);
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
    }

    #images-zone[drop-invalid] {
      border-color: var(--n-border-danger, #e55);
      background: var(--n-surface-danger, #fee);
      color: var(--n-surface-ink-danger, #c33);
    }

    .drop-icon {
      font-size: 1.5rem;
      opacity: 0.5;
    }

    .drop-hint {
      font-size: 0.75rem;
      opacity: 0.7;
    }

    .file-list {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      margin-top: 0.75rem;
      width: 100%;
    }

    .file-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.5rem 0.75rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.375rem;
      font-size: 0.8125rem;
    }

    .file-name {
      font-weight: 500;
      color: var(--n-ink-strong-neutral);
    }

    .file-size {
      color: var(--n-ink-muted-neutral);
      font-size: 0.75rem;
    }

    .dropped-text {
      margin-top: 0.75rem;
      padding: 0.75rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.375rem;
      font-size: 0.8125rem;
      color: var(--n-ink-neutral);
      white-space: pre-wrap;
      word-break: break-word;
      max-height: 6rem;
      overflow-y: auto;
    }

    .output {
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      max-height: 6rem;
      overflow-y: auto;
      margin-top: 0.75rem;
      padding: 0.5rem;
      background: var(--n-panel-neutral);
      border-radius: 0.25rem;
    }

    /* ── Code Blocks ── */
</style>

</SidebarLayout>
