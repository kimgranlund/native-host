---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  clickOutsideToDismiss: `import { DismissController } from '@nonoun/native-ui';

const panel = document.getElementById('panel');
const dismiss = new DismissController(panel);

function showPanel() {
  panel.removeAttribute('hidden');
  dismiss.enable();
}

function hidePanel() {
  dismiss.disable();
  panel.setAttribute('hidden', '');
}

panel.addEventListener('native:dismiss', () =&gt; hidePanel());`,
};
---
<SidebarLayout title="Dismissable">
  <main>
<h1>Dismissable</h1>
    <n-text size="md" muted spacing="relaxed">
      Composable trait that manages a global layer stack. When enabled, clicking outside the element or pressing Escape dispatches a <code>native:dismiss</code> event. Only the topmost layer in the stack receives dismiss events.
    </n-text>

    <!-- ── Click Outside to Dismiss ── -->

    <h2>Click Outside to Dismiss</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Uses <code>DismissController</code> directly on a plain element. Call <code>enable()</code> to join the dismiss stack, <code>disable()</code> to leave.
      </n-text>
      <n-button id="open-btn">Open Panel</n-button>
      <div class="dismiss-panel" id="panel" hidden>
        This panel is dismissable. Click anywhere outside it or press <strong>Escape</strong> to close.
        <br><br>
        Clicking inside the panel will not dismiss it.
      </div>
      <div id="log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.clickOutsideToDismiss} /><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Nested Layers ── -->

    <h2>Nested Layers (Stack)</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Open both panels. Only the topmost one receives dismiss events. After the top panel is dismissed, the bottom panel becomes the new top.
      </n-text>
      <n-stack direction="row">
        <n-button id="open-a">Open Panel A</n-button>
        <n-button id="open-b">Open Panel B</n-button>
      </n-stack>
      <div class="dismiss-panel" id="panel-a" hidden>
        <strong>Panel A</strong> — I'm the first layer.
      </div>
      <div class="dismiss-panel" id="panel-b" hidden style="background: var(--n-surface-info); color: var(--n-surface-ink-info);">
        <strong>Panel B</strong> — I'm on top of Panel A.
      </div>
      <pre class="layout-code"><code>&lt;!-- Each panel has its own DismissController --&gt;
const dismissA = new DismissController(panelA);
const dismissB = new DismissController(panelB);

// Open Panel A — joins dismiss stack
panelA.removeAttribute('hidden');
dismissA.enable();

// Open Panel B — becomes top of stack
panelB.removeAttribute('hidden');
dismissB.enable();

// Escape/click-outside dismisses B first, then A</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Built-in: n-dialog ── -->

    <h2>Built-in: n-dialog</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        <code>n-dialog</code> uses Dismissable internally. Escape and backdrop click close the dialog automatically.
      </n-text>
      <n-button id="open-dialog">Open Dialog</n-button>
      <n-dialog id="demo-dialog">
        <n-card class="dialog-card">
          <p style="margin: 0 0 1rem;">This dialog uses Dismissable internally. Press Escape or click the backdrop to close.</p>
          <n-button id="close-dialog" intent="accent">Close</n-button>
        </n-card>
      </n-dialog>
      <pre class="layout-code"><code>&lt;n-button id="open"&gt;Open Dialog&lt;/n-button&gt;
&lt;n-dialog id="dialog"&gt;
  &lt;n-card&gt;
    &lt;p&gt;Dialog content&lt;/p&gt;
    &lt;n-button id="close"&gt;Close&lt;/n-button&gt;
  &lt;/n-card&gt;
&lt;/n-dialog&gt;

&lt;script&gt;
  open.addEventListener('native:press', () =&gt; dialog.showModal());
  close.addEventListener('native:press', () =&gt; dialog.close());
&lt;/script&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Methods</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Method</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>enable()</code></n-table-cell>
            <n-table-cell>Pushes the element onto the global dismiss stack. Click-outside and Escape will fire <code>native:dismiss</code> on this element.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>disable()</code></n-table-cell>
            <n-table-cell>Removes the element from the dismiss stack. No more dismiss events.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>destroy()</code></n-table-cell>
            <n-table-cell>Removes from stack and cleans up. Call in <code>teardown()</code>.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:dismiss</code></n-table-cell>
            <n-table-cell>—</n-table-cell>
            <n-table-cell>Fired when click-outside or Escape occurs while this element is the topmost layer. Consumer handles hiding.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </main>

  <script>
import { DismissController } from '@nonoun/native-ui';
import { logAppend as appendLog } from '../../scripts/event-log';

document.addEventListener('astro:page-load', () => {
      if (!document.getElementById('panel')) return;

      // ── Click Outside Demo ──

      const panel = document.getElementById('panel')!;
      const dismiss = new DismissController(panel);
      const logEl = document.getElementById('log');
      let count = 0;

      function showPanel() {
        panel.removeAttribute('hidden');
        dismiss.enable();
        count++;
        appendLog(logEl, `#${count} Panel opened`);
      }

      function hidePanel() {
        dismiss.disable();
        panel.setAttribute('hidden', '');
      }

      document.getElementById('open-btn')?.addEventListener('native:press', () => showPanel());
      panel.addEventListener('native:dismiss', () => {
        count++;
        appendLog(logEl, `#${count} Panel dismissed`);
        hidePanel();
      });

      // ── Nested Layers Demo ──

      const panelA = document.getElementById('panel-a')!;
      const panelB = document.getElementById('panel-b')!;
      const dismissA = new DismissController(panelA);
      const dismissB = new DismissController(panelB);

      function showPanelEl(el: HTMLElement, ctrl: DismissController) {
        el.removeAttribute('hidden');
        ctrl.enable();
      }

      function hidePanelEl(el: HTMLElement, ctrl: DismissController) {
        ctrl.disable();
        el.setAttribute('hidden', '');
      }

      document.getElementById('open-a')?.addEventListener('native:press', () => showPanelEl(panelA, dismissA));
      document.getElementById('open-b')?.addEventListener('native:press', () => showPanelEl(panelB, dismissB));
      panelA.addEventListener('native:dismiss', () => hidePanelEl(panelA, dismissA));
      panelB.addEventListener('native:dismiss', () => hidePanelEl(panelB, dismissB));

      // ── Dialog Demo ──

      const dialog = document.getElementById('demo-dialog') as any;
      document.getElementById('open-dialog')?.addEventListener('native:press', () => dialog?.showModal());
      document.getElementById('close-dialog')?.addEventListener('native:press', () => dialog?.close());
});
  </script>
  <style is:global>
    .dismiss-panel {
      display: block;
      padding: 1rem;
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
      border-radius: 0.5rem;
      margin-top: 0.75rem;
      font-size: 0.875rem;
    }

    .dismiss-panel[hidden] {
      display: none;
    }

    .output {
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      max-height: 6rem;
      overflow-y: auto;
      margin-top: 0.75rem;
      padding: 0.5rem;
      background: var(--n-panel-neutral);
      border-radius: 0.25rem;
    }

    n-card.dialog-card {
      width: 20rem;
      padding: 1.5rem;
    }

    /* ── Code Blocks ── */
</style>

</SidebarLayout>
