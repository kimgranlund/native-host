---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  basicFlip: `&lt;n-controller traits="flippable"&gt;
  &lt;div class="flip-card" tabindex="0"&gt;
    &lt;div class="flip-face flip-front"&gt;Front&lt;/div&gt;
    &lt;div class="flip-face flip-back" data-flip-back&gt;Back&lt;/div&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;

&lt;!-- Hover trigger --&gt;
&lt;n-controller traits="flippable"
  data-trait-flippable-trigger="hover"&gt;
  &lt;div class="flip-card" tabindex="0"&gt;
    &lt;div class="flip-face flip-front"&gt;Hover&lt;/div&gt;
    &lt;div class="flip-face flip-back" data-flip-back&gt;Back&lt;/div&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;`,
  axisOptions: `&lt;!-- Y-axis (default) --&gt;
&lt;n-controller traits="flippable"
  data-trait-flippable-axis="y"&gt;
  &lt;div class="flip-card" tabindex="0"&gt;
    &lt;div class="flip-face flip-front"&gt;Y-Axis&lt;/div&gt;
    &lt;div class="flip-face flip-back" data-flip-back&gt;Back&lt;/div&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;

&lt;!-- X-axis --&gt;
&lt;n-controller traits="flippable"
  data-trait-flippable-axis="x"&gt;
  &lt;div class="flip-card" tabindex="0"&gt;
    &lt;div class="flip-face flip-front"&gt;X-Axis&lt;/div&gt;
    &lt;div class="flip-face flip-back x-axis" data-flip-back&gt;Back&lt;/div&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;`,
  programmatic: `import { FlipController } from '@nonoun/native-ui';

const el = document.querySelector('.flip-card');
const ctrl = new FlipController(el, { trigger: 'manual' });

ctrl.flip();    // flip to back
ctrl.unflip();  // flip to front
ctrl.toggle();  // toggle state`,
  optionsPlayground: `const ctrl = new FlipController(el, {
  axis: 'y',
  duration: 600,
  perspective: 1000,
  trigger: 'click',
  disabled: false,
});`,
};
const detailFlip = `{ flipped: boolean, axis: string }`;
---
<SidebarLayout title="Flippable">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Flippable</h1>
      </div>
    </div>
    <div data-slot="description">

      3D card flip between front and back faces. Sets a <code>[flipped]</code> attribute on the element and dispatches <code>native:flip</code> with the current state. The child needs a front face and a back face marked with <code>[data-flip-back]</code>.

    </div>
  </header>

  <main id="flippable-page">

    <!-- ── Basic Flip ── -->

    <h2>Basic Flip</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Click the card to flip between front and back faces. The hover card flips on pointer enter/leave.
      </n-text>
      <n-stack direction="row" gap="4" style="flex-wrap: wrap;">
        <n-controller traits="flippable">
          <div class="flip-card" id="flip-click" tabindex="0">
            <div class="flip-face flip-front"><n-stack align="center" gap="2"><span class="flip-label">Front</span><n-text size="xs" muted>Click to flip</n-text></n-stack></div>
            <div class="flip-face flip-back" data-flip-back><n-stack align="center" gap="2"><span class="flip-label">Back</span><n-text size="xs" muted>Click to return</n-text></n-stack></div>
          </div>
        </n-controller>
        <n-controller traits="flippable" data-trait-flippable-trigger="hover">
          <div class="flip-card" id="flip-hover" tabindex="0">
            <div class="flip-face flip-front"><n-stack align="center" gap="2"><span class="flip-label">Hover</span><n-text size="xs" muted>Pointer enter/leave</n-text></n-stack></div>
            <div class="flip-face flip-back" data-flip-back><n-stack align="center" gap="2"><span class="flip-label">Back</span><n-text size="xs" muted>Move pointer away</n-text></n-stack></div>
          </div>
        </n-controller>
      </n-stack>
      <div id="basic-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.basicFlip} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Axis Options ── -->

    <h2>Axis Options</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Y-axis rotates around the vertical axis (default). X-axis rotates around the horizontal axis. The back face needs <code>rotateX(180deg)</code> for X-axis cards.
      </n-text>
      <n-stack direction="row" gap="4" style="flex-wrap: wrap;">
        <n-controller traits="flippable" data-trait-flippable-axis="y">
          <div class="flip-card" id="flip-y" tabindex="0">
            <div class="flip-face flip-front"><n-stack align="center" gap="2"><span class="flip-label">Y-Axis</span><n-text size="xs" muted>rotateY(180deg)</n-text></n-stack></div>
            <div class="flip-face flip-back" data-flip-back><n-stack align="center" gap="2"><span class="flip-label">Back</span></n-stack></div>
          </div>
        </n-controller>
        <n-controller traits="flippable" data-trait-flippable-axis="x">
          <div class="flip-card" id="flip-x" tabindex="0">
            <div class="flip-face flip-front"><n-stack align="center" gap="2"><span class="flip-label">X-Axis</span><n-text size="xs" muted>rotateX(180deg)</n-text></n-stack></div>
            <div class="flip-face flip-back x-axis" data-flip-back><n-stack align="center" gap="2"><span class="flip-label">Back</span></n-stack></div>
          </div>
        </n-controller>
      </n-stack>
      <div id="axis-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.axisOptions} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Programmatic Demo ── -->

    <h2>Programmatic Control</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Use <code>FlipController</code> directly with <code>trigger: 'manual'</code>. Call <code>flip()</code>, <code>unflip()</code>, or <code>toggle()</code> to control the card programmatically.
      </n-text>
      <n-stack direction="row" gap="4" align="start" style="flex-wrap: wrap;">
        <div id="flip-manual" class="flip-card" tabindex="0">
          <div class="flip-face flip-front"><n-stack align="center" gap="2"><span class="flip-label">Manual</span><n-text size="xs" muted>Use the buttons below</n-text></n-stack></div>
          <div class="flip-face flip-back" data-flip-back><n-stack align="center" gap="2"><span class="flip-label">Back</span><n-text size="xs" muted>Programmatic flip</n-text></n-stack></div>
        </div>
        <n-stack gap="2">
          <n-button id="btn-flip" size="sm">flip()</n-button>
          <n-button id="btn-unflip" size="sm">unflip()</n-button>
          <n-button id="btn-toggle" size="sm">toggle()</n-button>
        </n-stack>
      </n-stack>
      <div id="manual-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.programmatic} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Options Playground ── -->

    <h2>Options Playground</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Adjust controller options in real time. The card is destroyed and recreated when axis or trigger changes.
      </n-text>
      <n-stack direction="row" gap="4" align="start" style="flex-wrap: wrap;">
        <div id="flip-playground" class="flip-card" tabindex="0">
          <div class="flip-face flip-front"><n-stack align="center" gap="2"><span class="flip-label">Playground</span><n-text size="xs" muted>Adjust options</n-text></n-stack></div>
          <div class="flip-face flip-back" data-flip-back><n-stack align="center" gap="2"><span class="flip-label">Back</span></n-stack></div>
        </div>
        <n-card id="options-card" padding="relaxed" style="min-width: 260px; flex: 1;">
          <n-stack gap="3">
            <n-select id="opt-axis" label="Axis" size="sm" options='[{"label":"Y-axis","value":"y"},{"label":"X-axis","value":"x"}]' value="y"></n-select>
            <div>
              <n-text size="xs" muted>Duration: <span id="opt-duration-value">600</span>ms</n-text>
              <n-range id="opt-duration" min="100" max="2000" step="50" value="600" size="sm"></n-range>
            </div>
            <div>
              <n-text size="xs" muted>Perspective: <span id="opt-perspective-value">1000</span>px</n-text>
              <n-range id="opt-perspective" min="200" max="3000" step="50" value="1000" size="sm"></n-range>
            </div>
            <n-select id="opt-trigger" label="Trigger" size="sm" options='[{"label":"Click","value":"click"},{"label":"Hover","value":"hover"},{"label":"Manual","value":"manual"}]' value="click"></n-select>
            <n-switch id="opt-disabled" label="Disabled" size="sm"></n-switch>
          </n-stack>
        </n-card>
      </n-stack>
      <div id="playground-log" class="output"></div>
      <pre class="layout-code"><code set:html={codeExamples.optionsPlayground} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── API Reference ── -->

    <h2>API</h2>
      <h3>Adapter Attributes</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Attribute</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>data-trait-flippable-axis</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell><code>"y"</code></n-table-cell>
            <n-table-cell>Flip axis: <code>"x"</code> or <code>"y"</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-flippable-trigger</code></n-table-cell>
            <n-table-cell><code>string</code></n-table-cell>
            <n-table-cell><code>"click"</code></n-table-cell>
            <n-table-cell>Trigger mode: <code>"click"</code>, <code>"hover"</code>, or <code>"manual"</code>.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-flippable-duration</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>600</code></n-table-cell>
            <n-table-cell>Animation duration in milliseconds.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-flippable-perspective</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>1000</code></n-table-cell>
            <n-table-cell>CSS perspective in pixels.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>data-trait-flippable-disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disable flip behavior. Click and keyboard events are ignored.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Controller Options</h3>
      <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Option</n-table-header><n-table-header>Type</n-table-header><n-table-header>Default</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>axis</code></n-table-cell>
            <n-table-cell><code>'x' | 'y'</code></n-table-cell>
            <n-table-cell><code>'y'</code></n-table-cell>
            <n-table-cell>Flip axis.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>trigger</code></n-table-cell>
            <n-table-cell><code>'click' | 'hover' | 'manual'</code></n-table-cell>
            <n-table-cell><code>'click'</code></n-table-cell>
            <n-table-cell>How the flip is triggered.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>duration</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>600</code></n-table-cell>
            <n-table-cell>Animation duration in ms.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>perspective</code></n-table-cell>
            <n-table-cell><code>number</code></n-table-cell>
            <n-table-cell><code>1000</code></n-table-cell>
            <n-table-cell>CSS perspective in px.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>disabled</code></n-table-cell>
            <n-table-cell><code>boolean</code></n-table-cell>
            <n-table-cell><code>false</code></n-table-cell>
            <n-table-cell>Disable the controller.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Events</h3>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head><n-table-row><n-table-header>Event</n-table-header><n-table-header>Detail</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>native:flip</code></n-table-cell>
            <n-table-cell><code set:html={detailFlip} /></n-table-cell>
            <n-table-cell>Fired after the flip completes. <code>flipped</code> is <code>true</code> when showing the back face.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>Methods</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Method</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>flip()</code></n-table-cell>
            <n-table-cell>Flip to the back face (no-op if already flipped).</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>unflip()</code></n-table-cell>
            <n-table-cell>Return to the front face (no-op if already unflipped).</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>toggle()</code></n-table-cell>
            <n-table-cell>Toggle between front and back.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>destroy()</code></n-table-cell>
            <n-table-cell>Detach listeners and clear inline styles.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>detach()</code></n-table-cell>
            <n-table-cell>Remove event listeners without clearing styles.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>attach()</code></n-table-cell>
            <n-table-cell>Re-attach event listeners after <code>detach()</code>.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <h3>CSS</h3>
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head><n-table-row><n-table-header>Selector</n-table-header><n-table-header>Description</n-table-header></n-table-row></n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>[flipped]</code></n-table-cell>
            <n-table-cell>Present on the host element when showing the back face.</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>[data-flip-back]</code></n-table-cell>
            <n-table-cell>Mark a child element as the back face.</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
  </main>

  <script>
    import { FlipController } from '@nonoun/native-ui';
    import { logAppend as appendLog } from '../../scripts/event-log';

    document.addEventListener('astro:page-load', () => {
      if (!document.getElementById('flippable-page')) return;

      // ── Basic Flip + Hover log ──

      let basicCount = 0;
      const basicLogEl = document.getElementById('basic-log');
      for (const id of ['flip-click', 'flip-hover']) {
        const card = document.getElementById(id);
        card?.addEventListener('native:flip', (e) => {
          const { flipped, axis } = (e as CustomEvent).detail;
          basicCount++;
          appendLog(basicLogEl, `#${basicCount} ${id} — ${flipped ? 'back' : 'front'} (${axis}-axis)`);
        });
      }

      // ── Axis Options log ──

      let axisCount = 0;
      const axisLogEl = document.getElementById('axis-log');
      for (const id of ['flip-y', 'flip-x']) {
        const card = document.getElementById(id);
        card?.addEventListener('native:flip', (e) => {
          const { flipped, axis } = (e as CustomEvent).detail;
          axisCount++;
          appendLog(axisLogEl, `#${axisCount} ${id} — ${flipped ? 'back' : 'front'} (${axis}-axis)`);
        });
      }

      // ── Programmatic Demo ──

      const manualEl = document.getElementById('flip-manual');
      const manualLogEl = document.getElementById('manual-log');
      let manualCount = 0;

      if (manualEl) {
        const manualCtrl = new FlipController(manualEl, { trigger: 'manual' });

        manualEl.addEventListener('native:flip', (e) => {
          const { flipped, axis } = (e as CustomEvent).detail;
          manualCount++;
          appendLog(manualLogEl, `#${manualCount} — ${flipped ? 'back' : 'front'} (${axis}-axis)`);
        });

        document.getElementById('btn-flip')?.addEventListener('native:press', () => manualCtrl.flip());
        document.getElementById('btn-unflip')?.addEventListener('native:press', () => manualCtrl.unflip());
        document.getElementById('btn-toggle')?.addEventListener('native:press', () => manualCtrl.toggle());
      }

      // ── Options Playground ──

      const pgEl = document.getElementById('flip-playground');
      const pgLogEl = document.getElementById('playground-log');
      let pgCount = 0;

      if (pgEl) {
        let currentAxis: 'x' | 'y' = 'y';
        let currentDuration = 600;
        let currentPerspective = 1000;
        let currentTrigger: 'click' | 'hover' | 'manual' = 'click';
        let currentDisabled = false;

        let pgCtrl = new FlipController(pgEl, {
          axis: currentAxis,
          duration: currentDuration,
          perspective: currentPerspective,
          trigger: currentTrigger,
          disabled: currentDisabled,
        });

        pgEl.addEventListener('native:flip', (e) => {
          const { flipped, axis } = (e as CustomEvent).detail;
          pgCount++;
          appendLog(pgLogEl, `#${pgCount} — ${flipped ? 'back' : 'front'} (${axis}-axis)`);
        });

        function recreateController() {
          pgCtrl.destroy();
          // Reset back face transform for axis changes
          const backFace = pgEl!.querySelector('[data-flip-back]') as HTMLElement;
          if (backFace) {
            backFace.classList.toggle('x-axis', currentAxis === 'x');
          }
          pgCtrl = new FlipController(pgEl!, {
            axis: currentAxis,
            duration: currentDuration,
            perspective: currentPerspective,
            trigger: currentTrigger,
            disabled: currentDisabled,
          });
        }

        // Axis select
        const axisSelect = document.getElementById('opt-axis');
        axisSelect?.addEventListener('native:change', (e) => {
          currentAxis = (e as CustomEvent).detail.value as 'x' | 'y';
          recreateController();
        });

        // Duration range
        const durationRange = document.getElementById('opt-duration');
        const durationLabel = document.getElementById('opt-duration-value');
        durationRange?.addEventListener('native:change', (e) => {
          currentDuration = Number((e as CustomEvent).detail.value);
          if (durationLabel) durationLabel.textContent = String(currentDuration);
          pgCtrl.duration = currentDuration;
          // Re-apply host styles with new duration
          recreateController();
        });

        // Perspective range
        const perspectiveRange = document.getElementById('opt-perspective');
        const perspectiveLabel = document.getElementById('opt-perspective-value');
        perspectiveRange?.addEventListener('native:change', (e) => {
          currentPerspective = Number((e as CustomEvent).detail.value);
          if (perspectiveLabel) perspectiveLabel.textContent = String(currentPerspective);
          pgCtrl.perspective = currentPerspective;
          recreateController();
        });

        // Trigger select
        const triggerSelect = document.getElementById('opt-trigger');
        triggerSelect?.addEventListener('native:change', (e) => {
          currentTrigger = (e as CustomEvent).detail.value as 'click' | 'hover' | 'manual';
          recreateController();
        });

        // Disabled switch
        const disabledSwitch = document.getElementById('opt-disabled');
        disabledSwitch?.addEventListener('native:change', (e) => {
          currentDisabled = (e as CustomEvent).detail.checked;
          pgCtrl.disabled = currentDisabled;
        });
      }
    });
  </script>
  <style is:global>
    /* ── Flip Card ── */

    .flip-card {
      position: relative;
      width: 200px;
      height: 260px;
      cursor: pointer;
    }

    .flip-card:focus-visible {
      outline: 2px solid var(--n-focus-ring);
      outline-offset: 2px;
    }

    .flip-inner {
      position: relative;
      width: 100%;
      height: 100%;
    }

    .flip-face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      display: grid;
      place-items: center;
      border-radius: 0.5rem;
      padding: 1rem;
    }

    .flip-front {
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
    }

    .flip-back {
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
      transform: rotateY(180deg);
    }

    .flip-back.x-axis {
      transform: rotateX(180deg);
    }

    .flip-label {
      font-size: 1.25rem;
      font-weight: 700;
    }

    .output {
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      max-height: 6rem;
      overflow-y: auto;
      margin-top: 0.75rem;
      padding: 0.5rem;
      background: var(--n-panel-neutral);
      border-radius: 0.25rem;
    }
</style>

</SidebarLayout>
