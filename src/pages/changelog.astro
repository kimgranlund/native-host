---
import SidebarLayout from '../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Changelog">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Changelog</h1>
      </div>
    </div>
    <div data-slot="description">

      Version history for the NativeUI documentation site. Each release lists new features, updates, and breaking changes with links to relevant pages.

    </div>
  </header>

  <section>

    <!-- ── 0.7.11 ── -->

    <div class="changelog-version">
      <h2>0.7.11 <span class="changelog-date">— March 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Features</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Admin pages <span class="changelog-sep">::</span> Org management interfaces</div>
          <ul>
            <li><a href="/admin/members">Members</a> — invite, change roles, remove org members</li>
            <li><a href="/admin/groups">Groups</a> — create groups with tier-based access</li>
            <li><a href="/admin/permissions">Permissions</a> — tier permission matrix + grant overrides</li>
            <li><a href="/admin/registry/llm">LLM Registry</a> and <a href="/admin/registry/connectors">Connectors</a> — content object CRUD</li>
            <li>Admin nav in org dropdown menu (owner/admin only)</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header">6 new fun traits <span class="changelog-sep">::</span> Physics and visual effects</div>
          <ul>
            <li><a href="/traits/tossable">Tossable</a> — physics-based throw with momentum and bounce</li>
            <li><a href="/traits/flippable">Flippable</a> — 3D card flip between front/back faces</li>
            <li><a href="/traits/parallaxable">Parallaxable</a> — holographic tilt following pointer</li>
            <li><a href="/traits/confettible">Confettible</a> — confetti particle burst</li>
            <li><a href="/traits/magnetizable">Magnetizable</a> — snap-to-guide alignment</li>
            <li><a href="/traits/css-inspectable">CSSInspectable</a> — 3D layer inspector (Alt+click)</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Four-layer data model <span class="changelog-sep">::</span> Identity, Permissions, Content Schemas, Registries</div>
          <ul>
            <li>10 new database tables: organization, member, invitation, group, permission, grant, contentType, contentObject, and more</li>
            <li>better-auth organization plugin with tier-based access (owner/admin/user/preview)</li>
            <li>Permission resolution with baseline tiers + explicit grant overrides</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3>Breaking Changes</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Trait option attributes <span class="changelog-sep">::</span> <code>data-trait-*</code> namespace</div>
          <ul>
            <li>All trait options renamed: <code>draggable-axis</code> → <code>data-trait-draggable-axis</code></li>
            <li>Prevents collisions between trait options and component API attributes</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="accent">Updated</n-badge> Updates</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Ecosystem upgrade <span class="changelog-sep">::</span> <code>native-ui@0.7.45</code>, <code>native-app@0.3.19</code></div>
          <ul>
            <li><code>n-app-panel</code> body scroll delegation — header/footer stay fixed</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── 0.7.10 ── -->

    <div class="changelog-version">
      <h2>0.7.10 <span class="changelog-date">— March 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Features</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/a2ui/a2ui">A2UI Session Layer</a> <span class="changelog-sep">::</span> Multi-agent sessions and protocol adapters</div>
          <ul>
            <li>Session manager, surface registry with single-owner write gating</li>
            <li>Protocol adapters: Direct, A2A (Google), AG-UI</li>
            <li>4 new demo pages including tic-tac-toe multi-agent game</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><code>.n-chat-starter</code> <span class="changelog-sep">::</span> Starter surface preset for chat seed + structured input</div>
          <ul>
            <li><code>[compact]</code> variant for sidebars and small cards</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="accent">Updated</n-badge> Updates</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Ecosystem upgrade <span class="changelog-sep">::</span> <code>native-ui@0.7.39</code>, <code>native-app@0.3.17</code>, <code>native-chat@0.5.24</code>, <code>native-a2ui@0.2.3</code></div>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Codebase audit <span class="changelog-sep">::</span> ~460 rule violations fixed across 54 files</div>
          <ul>
            <li>12 Hard Rules enforced: scoped selectors, <code>:where()</code> overrides, attribute API only</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><code>n-app-panel</code> <span class="changelog-sep">::</span> Semantic <code>&lt;header&gt;</code> / <code>&lt;main&gt;</code> / <code>&lt;footer&gt;</code> sub-containers</div>
          <ul>
            <li>Pinned header/footer with scrollable main, CSS custom properties for padding and max-width</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3>Breaking Changes</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/containers/ui-stack"><code>&lt;n-stack&gt;</code></a> <span class="changelog-sep">::</span> Flex-basis and gap defaults changed</div>
          <ul>
            <li><code>flex-basis</code>: <code>100%</code> → <code>0%</code> — stacks share space proportionally</li>
            <li>Default gap widened from <code>space × 2</code> to <code>space × 4</code></li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/containers/ui-header"><code>&lt;n-header&gt;</code></a> <span class="changelog-sep">::</span> Default block padding doubled</div>
          <ul>
            <li>Use <code>padding="tight"</code> to restore compact headers</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/components/ui-select"><code>&lt;n-select&gt;</code></a> <span class="changelog-sep">::</span> Dropdown aligns flush with trigger edge</div>
        </div>
      </div>

      <div class="changelog-section">
        <h3>Fixes</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/traits/draggable"><code>DragController</code></a> <span class="changelog-sep">::</span> Grid support for slot and drop modes</div>
          <ul>
            <li>Proper 2D coordinate detection for <code>axis: 'both'</code> layouts</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── 0.7.9 ── -->

    <div class="changelog-version">
      <h2>0.7.9 <span class="changelog-date">— March 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Components</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/components/ui-chart"><code>&lt;n-chart&gt;</code></a> <span class="changelog-sep">::</span> SVG charting component</div>
          <ul>
            <li>Line, bar, scatter, and sparkline chart types across three usage tiers</li>
            <li>Reactive data store with auto-detected scales, crosshair + tooltip interactions</li>
            <li>10 OKLCH color palettes (default, vivid, pastel, earth, ocean, sunset, forest, neon, mono, accessible)</li>
            <li>Reference lines, average lines, stacked/grouped/horizontal modes</li>
            <li>Comprehensive docs page with 20 interactive demos</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="accent">Updated</n-badge> Updates</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Ecosystem upgrade <span class="changelog-sep">::</span> <code>native-ui@0.7.22</code>, <code>native-app@0.3.12</code>, <code>native-chat@0.5.12</code>, <code>native-tokens@0.5.10</code></div>
          <ul>
            <li>Coordinated release across all <code>@nonoun/*</code> packages</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><code>n-gripper</code> <span class="changelog-sep">::</span> Now auto-registered</div>
          <ul>
            <li>Included in <code>@nonoun/native-ui/register</code> since 0.7.17 — manual registration removed from <code>setup.ts</code></li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Collapsed sidebar <span class="changelog-sep">::</span> Selected highlight removed</div>
          <ul>
            <li>Dark circle/pill highlight on the active section icon in collapsed mode removed — icon color change is sufficient</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── 0.7.8 ── -->

    <div class="changelog-version">
      <h2>0.7.8 <span class="changelog-date">— March 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Features</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Authentication <span class="changelog-sep">::</span> Email/password + Google OAuth</div>
          <ul>
            <li>Powered by <code>better-auth</code> with Drizzle adapter on Turso</li>
            <li>Functional <a href="/auth/login">login</a> and <a href="/auth/register">register</a> pages</li>
            <li><a href="/account/settings">Account settings</a> — profile, password, and account deletion</li>
            <li>Optional auth — anonymous browsing fully supported</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header">User-scoped preferences <span class="changelog-sep">::</span> DB-synced settings</div>
          <ul>
            <li>Theme, sidebar state, and nav group preferences follow the user across devices</li>
            <li>Cookie-based fallback for anonymous users</li>
            <li>Preferences auto-migrate from cookies on first login</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Resizable panels <span class="changelog-sep">::</span> Main content, inspector, and chat</div>
          <ul>
            <li>Drag handles between panels for custom layout widths</li>
            <li>Panel sizes persist across page navigations</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="accent">Updated</n-badge> Updates</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Ecosystem upgrade <span class="changelog-sep">::</span> <code>native-ui@0.7.8</code>, <code>native-app@0.3.5</code>, <code>native-chat@0.5.2</code>, <code>native-a2ui@0.1.5</code></div>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Sidebar footer <span class="changelog-sep">::</span> Auth-aware user menu</div>
          <ul>
            <li>Shows user avatar and name when authenticated</li>
            <li>Account settings and sign-out in dropdown</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Rule #9 <span class="changelog-sep">::</span> No CSS classes on <code>n-*</code> elements</div>
          <ul>
            <li>Use <code>id</code>, <code>aria-label</code>, or contextual selectors instead</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3>Fixes</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Theme and code toggles <span class="changelog-sep">::</span> Broken after client-side navigation</div>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Invisible buttons <span class="changelog-sep">::</span> Added <code>better-auth/client</code> to Vite <code>optimizeDeps</code></div>
        </div>
      </div>
    </div>

    <!-- ── 0.7.5 ── -->

    <div class="changelog-version">
      <h2>0.7.5 <span class="changelog-date">— March 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Components</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/components/ui-pagination-dots"><code>&lt;n-pagination-dots&gt;</code></a> <span class="changelog-sep">::</span> Dot indicator with sliding pill</div>
          <ul>
            <li>Horizontal/vertical dot navigation for slideshows, onboarding, and wizards</li>
            <li>Windowed mode for large counts, optional prev/next paddles</li>
            <li>Now included in <code>@nonoun/native-ui/register</code></li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Pages</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/a2ui/a2ui-workbench">A2UI Workbench</a> <span class="changelog-sep">::</span> JSONL editor with sandboxed preview and protocol inspector</div>
          <ul>
            <li>Uses <code>&lt;native-a2ui&gt;</code> element — edit A2UI envelopes, step through with playback controls</li>
            <li>20 preset menus in 3 groups matching the <a href="/a2ui/a2ui">Protocol page</a>: General, Interactive, Clinical</li>
            <li>Two layout modes: 2/1 (editor + preview top, inspector bottom) and 1+1+1 (three columns)</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="accent">Updated</n-badge> Updates</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/traits/presentable"><code>Presentable</code></a> <span class="changelog-sep">::</span> Real-World Usage section</div>
          <ul>
            <li>A2UI workbench PresentController integration example with JS setup, CSS hook, and design decisions</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Collapsed sidebar <span class="changelog-sep">::</span> Selected state and badge indicators</div>
          <ul>
            <li>Active group gets a neutral background highlight on the icon row</li>
            <li>Groups with badged pages show a dot indicator on the icon well</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><code>&lt;native-codemirror&gt;</code> <span class="changelog-sep">::</span> Flex growth for editor element</div>
          <ul>
            <li>Editors now fill their flex/grid parent automatically via <code>flex: 1</code></li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/reference">Reference</a> and <a href="/state-grid">State Grid</a> pages updated</div>
        </div>
      </div>

      <div class="changelog-section">
        <h3>Fixes</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header">CodeMirror pages <span class="changelog-sep">::</span> Blank after client-side navigation</div>
          <ul>
            <li>Added <code>astro:page-load</code> wrappers to editor, playground, and A2UI pages</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header">A2UI pages <span class="changelog-sep">::</span> Custom element registration race condition</div>
          <ul>
            <li>Fixed element definitions not available after View Transition navigations</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── 0.7.4 ── -->

    <div class="changelog-version">
      <h2>0.7.4 <span class="changelog-date">— March 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Pages</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/traits/shortcutable"><code>Shortcutable</code></a> <span class="changelog-sep">::</span> Trait page for ShortcutController</div>
          <ul>
            <li>Global and scoped keyboard shortcuts</li>
            <li>Allow-editable, conditional guards, declarative adapter</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="accent">Updated</n-badge> Updates</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/components/ui-table"><code>&lt;n-table&gt;</code></a> <span class="changelog-sep">::</span> New <code>cols</code> attribute for column definitions</div>
          <ul>
            <li>Direct pass-through to <code>grid-template-columns</code></li>
            <li>Replaced 75 CSS class workarounds and ~57 inline styles across ~30 pages</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><code>NController</code> <span class="changelog-sep">::</span> CE upgrade fix for View Transitions</div>
          <ul>
            <li>Guard changed from <code>isConnected</code> to <code>#alive</code> — prevents double-initialization after <code>adoptNode</code> + <code>replaceWith</code></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── 0.7.3 ── -->

    <div class="changelog-version">
      <h2>0.7.3 <span class="changelog-date">— March 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Pages</h3>

        <div class="changelog-entry">
