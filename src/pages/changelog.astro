---
import SidebarLayout from '../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Changelog" panels={[]}>
  <main>
    <h1>Changelog</h1>
    <n-text size="md" muted spacing="relaxed">
      Version history for the NativeUI documentation site. Each release lists new features, updates, and breaking changes with links to relevant pages.
    </n-text>

    <!-- ── 0.7.5 ── -->

    <div class="changelog-version">
      <h2>0.7.5 <span class="changelog-date">— March 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Components</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/components/ui-pagination-dots"><code>&lt;n-pagination-dots&gt;</code></a> <span class="changelog-sep">::</span> Dot indicator with sliding pill</div>
          <ul>
            <li>Horizontal/vertical dot navigation for slideshows, onboarding, and wizards</li>
            <li>Windowed mode for large counts, optional prev/next paddles</li>
            <li>Now included in <code>@nonoun/native-ui/register</code></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── 0.7.4 ── -->

    <div class="changelog-version">
      <h2>0.7.4 <span class="changelog-date">— March 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Pages</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/traits/shortcutable"><code>Shortcutable</code></a> <span class="changelog-sep">::</span> Trait page for ShortcutController</div>
          <ul>
            <li>Global and scoped keyboard shortcuts</li>
            <li>Allow-editable, conditional guards, declarative adapter</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="accent">Updated</n-badge> Updates</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/components/ui-table"><code>&lt;n-table&gt;</code></a> <span class="changelog-sep">::</span> New <code>cols</code> attribute for column definitions</div>
          <ul>
            <li>Direct pass-through to <code>grid-template-columns</code></li>
            <li>Replaced 75 CSS class workarounds and ~57 inline styles across ~30 pages</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><code>NController</code> <span class="changelog-sep">::</span> CE upgrade fix for View Transitions</div>
          <ul>
            <li>Guard changed from <code>isConnected</code> to <code>#alive</code> — prevents double-initialization after <code>adoptNode</code> + <code>replaceWith</code></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── 0.7.3 ── -->

    <div class="changelog-version">
      <h2>0.7.3 <span class="changelog-date">— March 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Pages</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/containers/ui-text"><code>&lt;n-text&gt;</code></a> <span class="changelog-sep">::</span> Dedicated container page</div>
          <ul>
            <li>Size, muted, spacing, truncate, and uppercase demos</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/containers/ui-body"><code>&lt;n-body&gt;</code></a> <span class="changelog-sep">::</span> Sub-container page</div>
          <ul>
            <li>Scrollable content, padding variants, and divider integration</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/containers/ui-footer"><code>&lt;n-footer&gt;</code></a> <span class="changelog-sep">::</span> Sub-container page</div>
          <ul>
            <li>Justify, dividers, sticky, and dialog demos</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/traits/dialogable"><code>Dialogable</code></a> <span class="changelog-sep">::</span> Trait page for DialogController</div>
          <ul>
            <li>Modal, form, and persistent dialog demos</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/traits/list-navigable"><code>ListNavigable</code></a> <span class="changelog-sep">::</span> Trait page for keyboard list navigation</div>
          <ul>
            <li>Orientation and selection demos</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/traits/presentable"><code>Presentable</code></a> <span class="changelog-sep">::</span> Trait page for full-viewport overlay</div>
          <ul>
            <li>Custom inset, close button, and event demos</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="accent">Updated</n-badge> Updates</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header">No-CSS rule <span class="changelog-sep">::</span> Strict enforcement across ~30 pages</div>
          <ul>
            <li>All inline <code>style=""</code> attributes removed from <code>n-*</code> elements</li>
            <li>Components now use only their attribute API</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/containers/ui-header"><code>&lt;n-header&gt;</code></a> <span class="changelog-sep">::</span> Page renamed from "Header / Body / Footer"</div>
          <ul>
            <li>Body and footer now have dedicated pages</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── 0.7.2 ── -->

    <div class="changelog-version">
      <h2>0.7.2 <span class="changelog-date">— March 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Features</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/components/ui-input"><code>&lt;n-input&gt;</code></a> <span class="changelog-sep">::</span> Inline code formatting</div>
          <ul>
            <li><code>formatting="code"</code> attribute</li>
            <li><code>Cmd/Ctrl+E</code> keyboard shortcut</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/traits/slash-commandable"><code>SlashCommandController</code></a> <span class="changelog-sep">::</span> Tab-to-select and descriptions</div>
          <ul>
            <li>Pressing Tab with 2+ char query selects the closest match</li>
            <li>Command options now render visible description spans</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── 0.7.0 ── -->

    <div class="changelog-version">
      <h2>0.7.0 <span class="changelog-date">— March 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Features</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/components/ui-pagination-dots"><code>&lt;n-pagination-dots&gt;</code></a> <span class="changelog-sep">::</span> Standalone dot indicator</div>
          <ul>
            <li>Sliding pill, windowing, and optional paddles</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><code>&lt;n-text&gt;</code> <span class="changelog-sep">::</span> CSS-only utility element for styled text blocks</div>
          <ul>
            <li>Muted, strong, sizes, truncate, spacing attributes</li>
            <li>Adopted across 73 pages</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/containers/ui-panel"><code>&lt;n-panel&gt;</code></a> <span class="changelog-sep">::</span> Scrollable and fade attributes</div>
          <ul>
            <li><code>[scrollable]</code> — opt-in overflow scrolling (replaces implicit overflow)</li>
            <li><code>[fade]</code> — fades top/bottom edges when content overflows</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="accent">Updated</n-badge> Updates</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/containers/ui-toolbar"><code>&lt;n-toolbar&gt;</code></a> <span class="changelog-sep">::</span> Overflow management</div>
          <ul>
            <li>Overflow priority, pin, and diagnostics event</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/containers/ui-header"><code>&lt;n-header&gt;</code></a> <span class="changelog-sep">::</span> Label truncation</div>
          <ul>
            <li><code>[truncate]</code> attribute for text overflow ellipsis</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/components/ui-textarea"><code>&lt;n-textarea&gt;</code></a> <span class="changelog-sep">::</span> Inline formatting</div>
          <ul>
            <li><code>formatting="code bold italic"</code> attribute</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/traits/resizable"><code>ResizeController</code></a> <span class="changelog-sep">::</span> Corner resize handles</div>
          <ul>
            <li>Diagonal resizing support</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Sidebar badges <span class="changelog-sep">::</span> Nav item indicators</div>
          <ul>
            <li>Colored badges for new and updated pages</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3>Breaking Changes</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/containers/ui-panel"><code>&lt;n-panel&gt;</code></a> <span class="changelog-sep">::</span> Overflow is now opt-in</div>
          <ul>
            <li>Panels that relied on implicit <code>overflow: auto</code> must add <code>[scrollable]</code></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── 0.6.6 ── -->

    <div class="changelog-version">
      <h2>0.6.6 <span class="changelog-date">— February 2026</span></h2>

      <div class="changelog-section">
        <h3>Updates</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><code>@nonoun/native-ui@0.6.6</code> <span class="changelog-sep">::</span> Internal CSS source file renames</div>
        </div>
      </div>
    </div>

    <!-- ── 0.6.5 ── -->

    <div class="changelog-version">
      <h2>0.6.5 <span class="changelog-date">— February 2026</span></h2>

      <div class="changelog-section">
        <h3>Updates</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/blocks/data-kanban"><code>DragController</code></a> <span class="changelog-sep">::</span> Zone-based kanban</div>
          <ul>
            <li>Cross-zone dragging support</li>
          </ul>
        </div>
      </div>

      <div class="changelog-section">
        <h3>Fixes</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><code>DragController</code> <span class="changelog-sep">::</span> View Transitions fix</div>
          <ul>
            <li>Fixed <code>native:drop</code> not firing in Astro View Transitions context</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── 0.6.2 ── -->

    <div class="changelog-version">
      <h2>0.6.2 <span class="changelog-date">— January 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Features</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/blocks/notify-toast-demo"><code>&lt;n-toast&gt;</code></a> <span class="changelog-sep">::</span> Toast notification component</div>
          <ul>
            <li>Per-controller containers</li>
          </ul>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/components/ui-pagination-dots"><code>&lt;n-pagination-dots&gt;</code></a> <span class="changelog-sep">::</span> Standalone dot indicator</div>
        </div>
      </div>
    </div>

    <!-- ── 0.6.0 ── -->

    <div class="changelog-version">
      <h2>0.6.0 <span class="changelog-date">— January 2026</span></h2>

      <div class="changelog-section">
        <h3><n-badge size="xs" intent="danger">New</n-badge> New Features</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><a href="/containers/ui-header"><code>&lt;n-header&gt;</code></a>, <code>&lt;n-body&gt;</code>, <code>&lt;n-footer&gt;</code> <span class="changelog-sep">::</span> Unified panel sub-containers</div>
        </div>

        <div class="changelog-entry">
          <div class="changelog-entry-header"><code>native-chat</code> <span class="changelog-sep">::</span> Extracted chat interface to standalone package</div>
        </div>
      </div>

      <div class="changelog-section">
        <h3>Breaking Changes</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Aside refactor <span class="changelog-sep">::</span> Component-specific panel wrappers</div>
          <ul>
            <li><code>&lt;native-tokens-panel&gt;</code> and <code>&lt;native-chat-panel&gt;</code> replace generic aside panels</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── 0.5.0 ── -->

    <div class="changelog-version">
      <h2>0.5.0 <span class="changelog-date">— December 2025</span></h2>

      <div class="changelog-section">
        <h3>Breaking Changes</h3>

        <div class="changelog-entry">
          <div class="changelog-entry-header">Namespace migration <span class="changelog-sep">::</span> Full rename across all packages</div>
          <ul>
            <li>HTML <code>ui-*</code> → <code>n-*</code>, CSS <code>--ui-*</code> → <code>--n-*</code></li>
            <li>Events <code>ui-*</code> → <code>native:*</code>, JS classes <code>UI*</code> → <code>N*</code></li>
            <li>Package renames: <code>nui-*</code> → <code>native-*</code></li>
            <li>Root element: <code>&lt;n-sidebar&gt;</code> → <code>&lt;native-app&gt;</code></li>
          </ul>
        </div>
      </div>
    </div>
  </main>

  <style is:global>
    .changelog-version {
      margin-block-start: 1.5rem;
    }
    .changelog-version h2 {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .changelog-date {
      font-size: 0.8125rem;
      font-weight: 400;
      color: var(--n-ink-muted-neutral);
    }
    .changelog-section h3 {
      font-size: 0.875rem;
      font-weight: 600;
      margin-block: 0.75rem 0.25rem;
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }
    .changelog-entry {
      margin-block: 0.5rem;
    }
    .changelog-entry-header {
      font-size: 0.875rem;
      line-height: 1.5;
      color: var(--n-ink-neutral);
    }
    .changelog-sep {
      color: var(--n-ink-muted-neutral);
    }
    .changelog-entry ul {
      margin: 0.125rem 0 0;
      padding-inline-start: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
    }
    .changelog-entry li {
      font-size: 0.8125rem;
      line-height: 1.5;
      color: var(--n-ink-muted-neutral);
    }
    .changelog-section a {
      color: var(--n-ink-strong-accent);
      text-decoration: none;
    }
    .changelog-section a:hover {
      text-decoration: underline;
    }
    .changelog-section code {
      font-size: 0.8125rem;
      background: var(--n-panel-neutral);
      padding: 0.125em 0.375em;
      border-radius: 0.25rem;
    }
  </style>
</SidebarLayout>
