---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';

if (Astro.locals.user) return Astro.redirect('/blocks/data-dashboard-stats');
---
<BaseLayout title="Sign In">
  <style is:global>
    @import '../../styles/layout.css';

    .auth-screen {
      min-height: 100dvh;
      padding: 2rem;
    }

    .auth-card-wrapper {
      width: 100%;
      max-width: 26rem;
    }

    .auth-card n-field {
      gap: calc(var(--n-space) * 2);
    }

    .auth-logo {
      margin-bottom: 1.5rem;
    }

    .auth-heading {
      text-align: center;
      margin-bottom: 0.25rem;
    }

    .auth-subheading {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .auth-footer {
      text-align: center;
      margin-top: 1.5rem;
    }

    .auth-footer a {
      color: var(--n-ink-accent);
      text-decoration: none;
      font-weight: 500;
    }

    .auth-footer a:hover {
      text-decoration: underline;
    }

    .auth-error {
      text-align: center;
      margin-bottom: 0.75rem;
      display: none;
    }

    .auth-error[visible] {
      display: block;
    }

    .auth-legal {
      position: fixed;
      bottom: 1.5rem;
      text-align: center;
      opacity: 0.6;
    }

    .auth-legal a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--n-border-muted-neutral);
      text-underline-offset: 2px;
    }

    .auth-legal a:hover {
      color: var(--n-ink-neutral);
    }
  </style>

  <n-stack class="auth-screen" align="center" justify="center">
    <div class="auth-card-wrapper">
      <n-stack align="center" class="auth-logo">
        <Logo size={40} />
      </n-stack>
      <n-text size="lg" strong class="auth-heading">Welcome back</n-text>
      <n-text size="sm" muted class="auth-subheading">Sign in to your account to continue</n-text>

      <n-text size="sm" intent="danger" class="auth-error" id="auth-error"></n-text>

      <div class="auth-card">
        <n-card padding="relaxed">
          <n-stack gap="8">
            <form id="login-form">
              <n-stack gap="6">
                <n-field required>
                  <label slot="label">Email</label>
                  <n-input size="lg" type="email" placeholder="kim@example.com" name="email">
                    <n-icon name="envelope" slot="leading"></n-icon>
                  </n-input>
                </n-field>
                <n-field required>
                  <label slot="label">Password</label>
                  <n-input size="lg" type="password" placeholder="Enter your password" name="password">
                    <n-icon name="lock" slot="leading"></n-icon>
                  </n-input>
                </n-field>
                <n-button size="lg" variant="primary" intent="accent" type="submit" id="login-submit">
                  <span slot="label">Sign In</span>
                </n-button>
              </n-stack>
            </form>
            <n-divider>or continue with</n-divider>
            <n-button size="lg" id="google-login">
              <n-icon name="google-logo" slot="leading"></n-icon>
              <span slot="label">Google</span>
            </n-button>
          </n-stack>
        </n-card>
      </div>
      <n-text size="sm" muted class="auth-footer">
        Don't have an account? <a href="/auth/register">Sign up</a> | <a href="/blocks/data-dashboard-stats">Skip</a>
      </n-text>
    </div>

    <n-text size="xs" muted class="auth-legal">
      By continuing, you agree to our <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
    </n-text>
  </n-stack>

  <script>
    import { authClient } from '../../lib/auth-client';

    document.addEventListener('astro:page-load', () => {
      const form = document.getElementById('login-form');
      const errorEl = document.getElementById('auth-error');
      const googleBtn = document.getElementById('google-login');
      if (!form) return;

      function showError(msg) {
        if (!errorEl) return;
        errorEl.textContent = msg;
        errorEl.setAttribute('visible', '');
      }

      function hideError() {
        errorEl?.removeAttribute('visible');
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();
        const data = new FormData(form);
        const email = data.get('email');
        const password = data.get('password');

        const result = await authClient.signIn.email({
          email,
          password,
        });

        if (result.error) {
          showError(result.error.message || 'Sign in failed. Please try again.');
        } else {
          window.location.href = '/blocks/data-dashboard-stats';
        }
      });

      googleBtn?.addEventListener('click', async () => {
        hideError();
        await authClient.signIn.social({
          provider: 'google',
          callbackURL: '/blocks/data-dashboard-stats',
        });
      });
    });
  </script>
</BaseLayout>
