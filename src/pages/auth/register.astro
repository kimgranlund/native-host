---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';

if (Astro.locals.user) return Astro.redirect('/blocks/data-dashboard-stats');
---
<BaseLayout title="Create Account">
  <style is:global>
    @import '../../styles/global.css';

    .auth-screen {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100dvh;
      padding: 2rem;
    }

    .auth-card-wrapper {
      width: 100%;
      max-width: 26rem;
    }

    .auth-card n-field {
      gap: calc(var(--n-space) * 2);
    }

    .auth-logo {
      margin-bottom: 1.5rem;
    }

    .auth-heading {
      text-align: center;
      margin-bottom: 0.25rem;
    }

    .auth-subheading {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .auth-footer {
      text-align: center;
      margin-top: 1.5rem;
    }

    .auth-footer a {
      color: var(--n-ink-accent);
      text-decoration: none;
      font-weight: 500;
    }

    .auth-footer a:hover {
      text-decoration: underline;
    }

    .auth-error {
      text-align: center;
      margin-bottom: 0.75rem;
      display: none;
    }

    .auth-error[visible] {
      display: block;
    }

    .auth-legal {
      position: fixed;
      bottom: 1.5rem;
      text-align: center;
      opacity: 0.6;
    }

    .auth-legal a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--n-border-muted-neutral);
      text-underline-offset: 2px;
    }

    .auth-legal a:hover {
      color: var(--n-ink-neutral);
    }
  </style>

  <div class="auth-screen">
    <div class="auth-card-wrapper">
      <div class="auth-logo">
        <n-stack align="center">
          <Logo size={40} />
        </n-stack>
      </div>
      <div class="auth-heading">
        <span class="text-lg text-strong">Create your account</span>
      </div>
      <div class="auth-subheading">
        <span class="text-sm text-muted">Get started with NativeUI for free</span>
      </div>

      <div class="auth-error" id="auth-error">
        <span class="text-sm text-danger" id="auth-error-text"></span>
      </div>

      <div class="auth-card">
        <n-container padding="relaxed">
          <n-body>
            <n-stack gap="8">
              <form id="register-form">
                <n-stack gap="6">
                  <n-field required>
                    <label slot="label">Full name</label>
                    <n-input size="lg" placeholder="Kim Granlund" name="name">
                      <n-icon name="user" slot="leading"></n-icon>
                    </n-input>
                  </n-field>
                  <n-field required>
                    <label slot="label">Email</label>
                    <n-input size="lg" type="email" placeholder="kim@example.com" name="email">
                      <n-icon name="envelope" slot="leading"></n-icon>
                    </n-input>
                  </n-field>
                  <n-field required>
                    <label slot="label">Password</label>
                    <n-input size="lg" type="password" placeholder="At least 8 characters" name="password">
                      <n-icon name="lock" slot="leading"></n-icon>
                    </n-input>
                  </n-field>
                  <n-button size="lg" variant="primary" intent="accent" type="submit" id="register-submit">
                    <span slot="label">Create account</span>
                  </n-button>
                </n-stack>
              </form>
              <n-divider>or continue with</n-divider>
              <n-button size="lg" id="google-register">
                <n-icon name="google-logo" slot="leading"></n-icon>
                <span slot="label">Google</span>
              </n-button>
            </n-stack>
          </n-body>
        </n-container>
      </div>
      <div class="auth-footer">
        <span class="text-sm text-muted">
          Already have an account? <a href="/auth/login">Sign in</a> | <a href="/blocks/data-dashboard-stats">Skip</a>
        </span>
      </div>
    </div>

    <div class="auth-legal">
      <span class="text-xs text-muted">
        By continuing, you agree to our <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
      </span>
    </div>
  </div>

  <script>
    import { authClient } from '../../lib/auth-client';

    document.addEventListener('astro:page-load', () => {
      const form = document.getElementById('register-form');
      const errorWrap = document.getElementById('auth-error');
      const errorEl = document.getElementById('auth-error-text');
      const googleBtn = document.getElementById('google-register');
      if (!form) return;

      function showError(msg) {
        if (!errorEl || !errorWrap) return;
        errorEl.textContent = msg;
        errorWrap.setAttribute('visible', '');
      }

      function hideError() {
        errorWrap?.removeAttribute('visible');
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();
        const data = new FormData(form);
        const name = data.get('name');
        const email = data.get('email');
        const password = data.get('password');

        const result = await authClient.signUp.email({
          name,
          email,
          password,
        });

        if (result.error) {
          showError(result.error.message || 'Registration failed. Please try again.');
        } else {
          window.location.href = '/blocks/data-dashboard-stats';
        }
      });

      googleBtn?.addEventListener('click', async () => {
        hideError();
        await authClient.signIn.social({
          provider: 'google',
          callbackURL: '/blocks/data-dashboard-stats',
        });
      });
    });
  </script>
</BaseLayout>
