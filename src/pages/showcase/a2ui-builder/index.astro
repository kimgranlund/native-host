---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import { db } from '../../../db/client';
import { contentType, contentObject } from '../../../db/schema';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user;

// Load builder models from DB (graceful fallback if not seeded yet)
interface BuilderModel { name: string; provider: string; modelId: string; tier: string }
let models: BuilderModel[] = [];
let hasPremiumAccess = false;

const [modelType] = await db.select().from(contentType).where(eq(contentType.slug, 'builder-model'));
if (modelType) {
  const entries = await db.select().from(contentObject).where(eq(contentObject.contentTypeId, modelType.id));
  models = entries
    .filter(e => e.status === 'active')
    .map(e => JSON.parse(e.data) as BuilderModel);
}

// Check premium access for current user
if (user?.email) {
  const [accessType] = await db.select().from(contentType).where(eq(contentType.slug, 'builder-model-access'));
  if (accessType) {
    const grants = await db.select().from(contentObject).where(eq(contentObject.contentTypeId, accessType.id));
    hasPremiumAccess = grants.some(g => {
      const parsed = JSON.parse(g.data) as { email: string };
      return parsed.email === user.email;
    });
  }
}

// Fallback: if no models in DB yet, use hardcoded defaults
if (models.length === 0) {
  models = [
    { name: 'Human', provider: 'none', modelId: 'human', tier: 'free' },
    { name: 'Claude Haiku 4.5', provider: 'anthropic', modelId: 'claude-haiku-4-5', tier: 'free' },
    { name: 'GPT-5 mini', provider: 'openai', modelId: 'gpt-5-mini', tier: 'free' },
    { name: 'GPT-5 nano', provider: 'openai', modelId: 'gpt-5-nano', tier: 'free' },
    { name: 'GPT-4.1 mini', provider: 'openai', modelId: 'gpt-4.1-mini', tier: 'free' },
    { name: 'GPT-4.1 nano', provider: 'openai', modelId: 'gpt-4.1-nano', tier: 'free' },
  ];
}

// Filter: show free models always, premium only if user has access; exclude "human"
const visibleModels = models.filter(m => m.modelId !== 'human' && (m.tier === 'free' || hasPremiumAccess));
const defaultModel = visibleModels.find(m => m.modelId === 'claude-haiku-4-5') ?? visibleModels[0];

// Group by provider for the picker (Anthropic first)
const providerLabels: Record<string, string> = { anthropic: 'Anthropic', openai: 'OpenAI' };
const providerOrder = ['Anthropic', 'OpenAI', 'Other'];
const grouped = new Map<string, BuilderModel[]>(providerOrder.map(k => [k, []]));
for (const m of visibleModels) {
  const key = providerLabels[m.provider] ?? 'Other';
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(m);
}
---
<SidebarLayout title="A2UI Builder">
  <section id="a2ui-builder-page">
    <n-container class="builder" padding="0" gap="0">

      <!-- ── Header toolbar: panel toggle chips ── -->
      <n-header dividers>
        <n-toolbar variant="ghost" size="sm">
          <span class="builder-title">A2UI Builder</span>
          <span fill></span>
          <n-button variant="ghost" size="sm" data-chip="preview">Preview</n-button>
          <n-button variant="ghost" size="sm" data-chip="concepts">Reasoning</n-button>
          <n-button variant="ghost" size="sm" data-chip="schema">Schema</n-button>
          <n-button variant="ghost" size="sm" data-chip="html">HTML</n-button>
          <n-button variant="ghost" size="sm" data-chip="css">CSS</n-button>
          <n-button variant="ghost" size="sm" data-chip="js">JS</n-button>
          <n-button variant="ghost" size="sm" data-chip="map">Map</n-button>
          <n-button variant="ghost" size="sm" data-chip="prompt">Prompt</n-button>
          <n-button variant="ghost" size="sm" id="lightbox-btn" title="Lightbox mode"><n-icon name="arrows-out-simple"></n-icon></n-button>
        </n-toolbar>
      </n-header>

      <!-- ── Split: chat left, panes right ── -->
      <n-panes handle="hover">

        <!-- Chat (left) -->
        <n-pane data-panel-id="agent-chat" data-region="chat" size-min="280">
          <n-chat-feed id="chat-feed" auto-scroll density="compact"></n-chat-feed>
          <n-agent-input id="chat-composer" density="compact">
              <n-chat-input-header>
                <nav>
                  <n-select id="model-picker" value={defaultModel?.modelId ?? 'claude-haiku-4-5'} data-role="model-picker" variant="ghost" size="sm" density="compact" placeholder={defaultModel?.name ?? 'Claude Haiku 4.5'}>
                    <n-listbox popover="auto">
                      {[...grouped.entries()].filter(([, models]) => models.length > 0).map(([label, models]) => (
                        <n-option-group>
                          <n-option-group-header>{label}</n-option-group-header>
                          {models.map(m => (
                            <n-option value={m.modelId} selected={m.modelId === defaultModel?.modelId ? true : undefined}>{m.name}</n-option>
                          ))}
                        </n-option-group>
                      ))}
                    </n-listbox>
                  </n-select>
                  <n-button variant="ghost" size="sm" density="compact"><n-icon name="brain"></n-icon> UI Builder</n-button>
                </nav>
                <aside>
                  <n-button variant="ghost" size="sm" data-role="toggle-inspector"><n-icon name="sliders"></n-icon></n-button>
                  <n-button variant="ghost" size="sm"><n-icon name="clock"></n-icon></n-button>
                </aside>
              </n-chat-input-header>
              <n-chat-input-prompt>
                <n-textarea placeholder="Describe a UI..." autogrow rows="1"></n-textarea>
                <n-button variant="ghost" size="sm" data-role="improve"><n-icon name="sparkle"></n-icon></n-button>
                <n-toolbar variant="plain" padding="3">
                  <n-button variant="ghost" radius="round"><n-icon name="plus"></n-icon></n-button>
                  <n-button variant="ghost" radius="round"><n-icon name="magnifying-glass"></n-icon></n-button>
                  <n-button variant="ghost" radius="round"><n-icon name="compass"></n-icon></n-button>
                  <n-button variant="ghost" radius="round" data-role="toggle-pipeline" title="Multi-step pipeline"><n-icon name="flask"></n-icon></n-button>
                  <span fill></span>
                  <n-button variant="ghost" radius="round"><n-icon name="record"></n-icon></n-button>
                  <n-button variant="ghost" radius="round"><n-icon name="microphone"></n-icon></n-button>
                  <n-button variant="primary" intent="accent" radius="round" disabled data-role="submit"><n-icon name="arrow-up"></n-icon></n-button>
                </n-toolbar>
              </n-chat-input-prompt>
              <n-chat-input-chips>
                <n-button variant="ghost" size="sm" radius="round"><n-icon name="lightbulb"></n-icon> Clarify problem</n-button>
                <n-button variant="ghost" size="sm" radius="round"><n-icon name="crosshair"></n-icon> Define context</n-button>
                <n-button variant="ghost" size="sm" radius="round"><n-icon name="list-checks"></n-icon> Select deliverable</n-button>
                <n-button variant="ghost" size="sm" radius="round"><n-icon name="pencil-simple"></n-icon> Refine requirements</n-button>
              </n-chat-input-chips>
          </n-agent-input>
        </n-pane>

        <!-- Pane: Preview -->
        <n-pane data-panel-id="preview" border="block" size-min="150">
          <n-header dividers>
            <nav slot="leading"><n-icon inline name="eye"></n-icon></nav>
            <span>Preview</span>
            <aside slot="trailing">
              <n-button variant="ghost" size="sm" id="inspect-toggle" title="CSS Inspector"><n-icon name="stack-simple"></n-icon></n-button>
              <n-button variant="ghost" size="sm" id="lightbox-toggle" title="Toggle light/dark preview"><n-icon name="moon"></n-icon></n-button>
              <n-button variant="ghost" size="sm" data-close-panel-id="preview"><n-icon name="x"></n-icon></n-button>
            </aside>
          </n-header>
          <n-body overflow="hidden" relative>
            <div id="preview-canvas">
              <div id="preview-mount">
                <span class="empty-state">Live preview will appear here</span>
              </div>
            </div>
          </n-body>
        </n-pane>

        <!-- Pane: Concepts -->
        <n-pane data-panel-id="concepts" border="block" size-min="150">
          <n-header dividers>
            <nav slot="leading"><n-icon inline name="lightbulb"></n-icon></nav>
            <span>Reasoning</span>
            <aside slot="trailing"><n-button variant="ghost" size="sm" data-close-panel-id="concepts"><n-icon name="x"></n-icon></n-button></aside>
          </n-header>
          <n-body scrollbar="none">
            <div id="concepts-wrap" class="concepts-wrap"></div>
          </n-body>
        </n-pane>

        <!-- Pane: Schema -->
        <n-pane data-panel-id="schema" border="block" size-min="150">
          <n-header dividers>
            <nav slot="leading"><n-icon inline name="brackets-curly"></n-icon></nav>
            <span>Schema</span>
            <aside slot="trailing"><n-button variant="ghost" size="sm" data-close-panel-id="schema"><n-icon name="x"></n-icon></n-button></aside>
          </n-header>
          <n-body scrollbar="none">
            <n-editor id="schema-pre" readonly line-numbers="false" line-wrapping></n-editor>
          </n-body>
        </n-pane>

        <!-- Pane: HTML (read-only) -->
        <n-pane data-panel-id="html" border="block" size-min="150" hidden>
          <n-header dividers>
            <nav slot="leading"><n-icon inline name="brackets-angle"></n-icon></nav>
            <span>HTML</span>
            <aside slot="trailing"><n-button variant="ghost" size="sm" data-close-panel-id="html"><n-icon name="x"></n-icon></n-button></aside>
          </n-header>
          <n-body scrollbar="none">
            <n-editor id="html-pre" readonly line-numbers="false" line-wrapping></n-editor>
          </n-body>
        </n-pane>

        <!-- Pane: CSS (editable, live-applied) -->
        <n-pane data-panel-id="css" border="block" size-min="150" hidden>
          <n-header dividers>
            <nav slot="leading"><n-icon inline name="paint-brush"></n-icon></nav>
            <span>CSS</span>
            <aside slot="trailing"><n-button variant="ghost" size="sm" data-close-panel-id="css"><n-icon name="x"></n-icon></n-button></aside>
          </n-header>
          <n-body scrollbar="none">
            <n-editor id="css-editor" line-numbers="false" line-wrapping placeholder="/* Custom styles for the preview */"></n-editor>
          </n-body>
        </n-pane>

        <!-- Pane: JS (editable, apply-on-click) -->
        <n-pane data-panel-id="js" border="block" size-min="150" hidden>
          <n-header dividers>
            <nav slot="leading"><n-icon inline name="lightning"></n-icon></nav>
            <span>JS</span>
            <aside slot="trailing">
              <n-button variant="ghost" size="sm" data-role="apply-js" title="Run JS"><n-icon name="play"></n-icon></n-button>
              <n-button variant="ghost" size="sm" data-close-panel-id="js"><n-icon name="x"></n-icon></n-button>
            </aside>
          </n-header>
          <n-body scrollbar="none">
            <n-editor id="js-editor" line-numbers="false" line-wrapping placeholder="// preview.querySelector('#btn1').addEventListener('native:press', () => { ... })"></n-editor>
          </n-body>
        </n-pane>

        <!-- Pane: Component Map -->
        <n-pane data-panel-id="map" border="block" size-min="150" hidden>
          <n-header dividers>
            <nav slot="leading"><n-icon inline name="tree-structure"></n-icon></nav>
            <span>Map</span>
            <aside slot="trailing"><n-button variant="ghost" size="sm" data-close-panel-id="map"><n-icon name="x"></n-icon></n-button></aside>
          </n-header>
          <n-body scrollbar="none">
            <table id="map-table" class="map-table">
              <thead><tr><th class="map-chevron"></th><th>A2UI Type</th><th>Native Tag</th><th>Category</th></tr></thead>
              <tbody></tbody>
            </table>
          </n-body>
        </n-pane>

        <!-- Pane: System Prompt (editable) -->
        <n-pane data-panel-id="prompt" border="block" size-min="150" hidden>
          <n-header dividers>
            <nav slot="leading"><n-icon inline name="terminal"></n-icon></nav>
            <span>Prompt</span>
            <aside slot="trailing"><n-button variant="ghost" size="sm" data-close-panel-id="prompt"><n-icon name="x"></n-icon></n-button></aside>
          </n-header>
          <n-body scrollbar="none">
            <n-editor id="prompt-editor" line-numbers="false" line-wrapping></n-editor>
          </n-body>
        </n-pane>

      </n-panes>
    </n-container>
  </section>

  <script>
    import './a2ui-builder.ts';
  </script>

  <style is:global>
    @import '@nonoun/native-ai/css';
    @import '@nonoun/native-code/css';
    @import './a2ui-builder.css';

    /* Builder fills remaining <main> flex space.
       Override content.css padding + max-width so it goes edge-to-edge. */
    #a2ui-builder-page {
      flex: 1;
      min-height: 500px;
      padding: 0;
    }
    #a2ui-builder-page > * {
      max-width: none;
      margin: 0;
    }
  </style>
</SidebarLayout>
