---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="A2UI Training Library">
  <header>
    <h1>A2UI Training Library</h1>
    <div class="demo-desc">50 reusable UI composition patterns for grounding AI generation. Click any card to open the editor.</div>
  </header>

  <section>
    <!-- Filter bar -->
    <div class="tl-filter-bar">
      <n-button variant="primary" intent="accent" size="sm" data-filter="all">All</n-button>
      <n-button variant="ghost" size="sm" data-filter="micro">Micro</n-button>
      <n-button variant="ghost" size="sm" data-filter="block">Block</n-button>
      <n-select id="category-filter" placeholder="All categories" variant="outline" size="sm" density="compact">
        <n-listbox popover="auto">
          <n-option value="">All categories</n-option>
        </n-listbox>
      </n-select>
      <span class="tl-count" id="pattern-count"></span>
    </div>

    <!-- Pattern Grid -->
    <div id="pattern-grid" class="tl-grid"></div>
  </section>

  <!-- ── Editor Lightbox ── -->
  <dialog id="editor-lightbox" class="tl-lightbox">
    <!-- ── Main toolbar ── -->
    <n-header>
      <n-toolbar variant="ghost" size="sm">
        <span id="lightbox-title" class="tl-lightbox-title">A2UI Editor</span>
        <hr aria-orientation="vertical">
        <n-select id="tl-view-select" size="sm" variant="ghost" value="examples">
          <n-listbox popover="auto">
            <n-option value="examples" selected>A2UI Examples</n-option>
          </n-listbox>
        </n-select>
        <n-button variant="ghost" size="sm" id="btn-save">
          <n-icon name="floppy-disk" slot="leading"></n-icon>
          Save
        </n-button>
        <n-select id="tl-actions-menu" size="sm" variant="ghost" placeholder="Actions">
          <n-listbox popover="auto">
            <n-option value="regenerate">Regenerate</n-option>
            <n-option value="duplicate">Duplicate</n-option>
            <n-option value="export-json">Export JSON</n-option>
            <hr>
            <n-option value="reset">Reset</n-option>
          </n-listbox>
        </n-select>
        <span fill></span>
        <n-button variant="primary" intent="accent" size="sm" data-chip="schema">Schema</n-button>
        <n-button variant="ghost" size="sm" data-chip="html">HTML</n-button>
        <n-button variant="ghost" size="sm" data-chip="css">CSS</n-button>
        <n-button variant="ghost" size="sm" data-chip="js">JS</n-button>
        <hr aria-orientation="vertical">
        <n-button variant="ghost" size="sm" id="fullscreen-toggle" aria-label="Fullscreen" overflow-pin>
          <n-icon name="arrows-out-simple"></n-icon>
        </n-button>
      </n-toolbar>
    </n-header>

    <!-- ── Split: preview left, toggle-able panes right ── -->
    <n-panes handle="hover">

      <!-- Preview -->
      <n-pane data-panel-id="preview" size-min="200">
        <div class="tl-preview-mount" id="lightbox-preview"></div>

        <!-- Compare control (floating top center) -->
        <div class="tl-floating-top">
          <n-toolbar variant="ghost" size="md" class="tl-compare-bar">
            <n-segmented-control id="compare-toggle" size="md" value="edited">
              <n-segment value="edited">Edited</n-segment>
              <n-segment value="original">Original</n-segment>
            </n-segmented-control>
          </n-toolbar>
        </div>

        <!-- Preview toolbar (floating bottom center) -->
        <div class="tl-floating-bottom">
          <n-toolbar size="md" class="tl-preview-toolbar">
            <n-button variant="ghost" id="chat-toggle" aria-label="AI Chat" overflow-pin>
              <n-icon name="chat-dots"></n-icon>
            </n-button>
            <n-button variant="ghost" id="inspect-toggle" aria-label="CSS Inspector" overflow-pin>
              <n-icon name="stack-simple"></n-icon>
            </n-button>
            <hr aria-orientation="vertical">
            <n-button variant="ghost" id="btn-center" aria-label="Center" overflow-pin>
              <n-icon name="crosshair"></n-icon>
            </n-button>
            <n-button variant="ghost" id="btn-reset-zoom" aria-label="Reset zoom" overflow-pin>
              <n-icon name="arrows-in-cardinal"></n-icon>
            </n-button>
            <hr aria-orientation="vertical">
            <n-button variant="ghost" id="btn-prev" aria-label="Previous" overflow-pin disabled>
              <n-icon name="caret-left"></n-icon>
            </n-button>
            <n-button variant="ghost" id="btn-next" aria-label="Next" overflow-pin disabled>
              <n-icon name="caret-right"></n-icon>
            </n-button>
          </n-toolbar>
        </div>
      </n-pane>

      <!-- Schema -->
      <n-pane data-panel-id="schema" border="block" size-min="150">
        <n-header dividers>
          <nav slot="leading"><n-icon inline name="brackets-curly"></n-icon></nav>
          <span>Schema</span>
          <aside slot="trailing"><n-button variant="ghost" inline size="sm" data-close-panel-id="schema"><n-icon name="x"></n-icon></n-button></aside>
        </n-header>
        <n-body scrollbar="none">
          <n-editor id="schema-editor" line-numbers="false" line-wrapping></n-editor>
        </n-body>
      </n-pane>

      <!-- HTML (read-only) -->
      <n-pane data-panel-id="html" border="block" size-min="150" hidden>
        <n-header dividers>
          <nav slot="leading"><n-icon inline name="brackets-angle"></n-icon></nav>
          <span>HTML</span>
          <aside slot="trailing"><n-button variant="ghost" inline size="sm" data-close-panel-id="html"><n-icon name="x"></n-icon></n-button></aside>
        </n-header>
        <n-body scrollbar="none">
          <n-editor id="output-pre" readonly line-numbers="false" line-wrapping></n-editor>
        </n-body>
      </n-pane>

      <!-- CSS (read-only) -->
      <n-pane data-panel-id="css" border="block" size-min="150" hidden>
        <n-header dividers>
          <nav slot="leading"><n-icon inline name="paint-brush"></n-icon></nav>
          <span>CSS</span>
          <aside slot="trailing"><n-button variant="ghost" inline size="sm" data-close-panel-id="css"><n-icon name="x"></n-icon></n-button></aside>
        </n-header>
        <n-body scrollbar="none">
          <n-editor id="css-editor" readonly line-numbers="false" line-wrapping></n-editor>
        </n-body>
      </n-pane>

      <!-- JS (read-only) -->
      <n-pane data-panel-id="js" border="block" size-min="150" hidden>
        <n-header dividers>
          <nav slot="leading"><n-icon inline name="lightning"></n-icon></nav>
          <span>JS</span>
          <aside slot="trailing"><n-button variant="ghost" inline size="sm" data-close-panel-id="js"><n-icon name="x"></n-icon></n-button></aside>
        </n-header>
        <n-body scrollbar="none">
          <n-editor id="js-editor" readonly line-numbers="false" line-wrapping></n-editor>
        </n-body>
      </n-pane>

      <!-- Insights (shown during pipeline regeneration) -->
      <n-pane data-panel-id="insights" border="block" size-min="150" hidden>
        <n-header dividers>
          <nav slot="leading"><n-icon inline name="lightbulb"></n-icon></nav>
          <span>Insights</span>
          <aside slot="trailing"><n-button variant="ghost" inline size="sm" data-close-panel-id="insights"><n-icon name="x"></n-icon></n-button></aside>
        </n-header>
        <n-body scrollbar="none">
          <div id="insights-wrap" class="tl-insights-wrap"></div>
        </n-body>
      </n-pane>

      <!-- AI Chat (hidden by default, toggled via chat button) -->
      <n-pane data-panel-id="chat" size-min="280" hidden>
        <n-header dividers>
          <nav slot="leading"><n-icon inline name="chat-dots"></n-icon></nav>
          <span>Chat</span>
          <aside slot="trailing"><n-button variant="ghost" inline size="sm" data-close-panel-id="chat"><n-icon name="x"></n-icon></n-button></aside>
        </n-header>
        <n-llm-chat-pane id="llm-chat-pane" open position="docked"></n-llm-chat-pane>
      </n-pane>

    </n-panes>
  </dialog>

  <script>
    import './training-library.ts';
  </script>

  <style is:global>
    @import '@nonoun/native-code/css';
    @import './training-library.css';
  </style>
</SidebarLayout>
