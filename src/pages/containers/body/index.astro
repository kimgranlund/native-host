---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import ApiReference from '../../../components/ApiReference.astro';
import { bodyApi } from '../../../data/api/body';
---
<SidebarLayout title="Body">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Body</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-body&gt;</span> Generic scrollable content region. Semantic sub-container that fills remaining flex space inside n-container, n-container, n-drawer, or any flex column parent. Scrollbar hidden by default.
          </div>
  </header>

  <section>

    <!-- ── Basic ── -->

    <h2>Basic</h2>
    <n-container data-kind="panel" bordered>
      <div class="body-card-wrap">
      <n-container>
        <n-header>
          <span>Panel Title</span>
        </n-header>
        <n-body>
          <span>Body content with default inline padding and flex column layout. The body fills remaining space between header and footer.</span>
        </n-body>
        <n-footer>
          <n-button variant="primary" intent="accent"><span>OK</span></n-button>
        </n-footer>
      </n-container>
      </div>
    <pre class="code-block"><code>&lt;n-container&gt;
  &lt;n-header&gt;
    &lt;span slot="label"&gt;Panel Title&lt;/span&gt;
  &lt;/n-header&gt;
  &lt;n-body&gt;
    &lt;p&gt;Body content here.&lt;/p&gt;
  &lt;/n-body&gt;
  &lt;n-footer&gt;
    &lt;n-button variant="primary" intent="accent"&gt;OK&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-container&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Scrollable Content ── -->

    <h2>Scrollable Content</h2>
    <n-container data-kind="panel" bordered>
      <div class="body-card-wrap body-card-wrap--h16">
      <n-container>
        <n-header>
          <span>Scrollable Card</span>
        </n-header>
        <n-body>
          <span>When the parent has a fixed height, n-body scrolls independently while the header and footer stay pinned.</span>
          <span>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</span>
          <span>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</span>
          <span>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</span>
          <span>Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</span>
        </n-body>
        <n-footer>
          <n-button variant="primary" intent="accent"><span>Done</span></n-button>
        </n-footer>
      </n-container>
      </div>
    <pre class="code-block"><code>&lt;n-container style="height: 16rem;"&gt;
  &lt;n-header&gt;&lt;span slot="label"&gt;Scrollable&lt;/span&gt;&lt;/n-header&gt;
  &lt;n-body&gt;
    &lt;p&gt;Long content that scrolls...&lt;/p&gt;
  &lt;/n-body&gt;
  &lt;n-footer&gt;
    &lt;n-button variant="primary" intent="accent"&gt;Done&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-container&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Show Scrollbar ── -->

    <h2>Visible Scrollbar</h2>
    <n-container data-kind="panel" bordered>
      <div class="body-card-wrap body-card-wrap--h14">
      <n-container>
        <n-header><span>With Scrollbar</span></n-header>
        <n-body show-scrollbar>
          <span>The <code>show-scrollbar</code> attribute switches from <code>scrollbar-width: none</code> to <code>scrollbar-width: thin</code>.</span>
          <span>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</span>
          <span>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</span>
          <span>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</span>
        </n-body>
      </n-container>
      </div>
    <pre class="code-block"><code>&lt;section show-scrollbar&gt;
  &lt;p&gt;Scrollable content with a thin visible scrollbar.&lt;/p&gt;
&lt;/n-body&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Padding Variants ── -->

    <h2>Padding</h2>
    <n-container data-kind="panel" bordered>
      <n-stack gap="4">
        <div class="body-card-wrap body-card-wrap--md">
        <n-container>
          <n-header><span>padding="none"</span></n-header>
          <n-body padding="none">
            <span>No inline padding. Content reaches the edges.</span>
          </n-body>
        </n-container>
        </div>
        <div class="body-card-wrap body-card-wrap--md">
        <n-container>
          <n-header><span>Default (tight)</span></n-header>
          <n-body>
            <span>Default inline padding (<code>--n-space * 4</code>).</span>
          </n-body>
        </n-container>
        </div>
        <div class="body-card-wrap body-card-wrap--md">
        <n-container>
          <n-header><span>padding="regular"</span></n-header>
          <n-body padding="regular">
            <span>Regular padding adds both block and wider inline spacing.</span>
          </n-body>
        </n-container>
        </div>
        <div class="body-card-wrap body-card-wrap--md">
        <n-container>
          <n-header><span>padding="relaxed"</span></n-header>
          <n-body padding="relaxed">
            <span>Relaxed padding for spacious layouts.</span>
          </n-body>
        </n-container>
        </div>
      </n-stack>
    <pre class="code-block"><code>&lt;section padding="none"&gt;...&lt;/n-body&gt;
&lt;n-body&gt;...&lt;/n-body&gt;                     &lt;!-- default (tight) --&gt;
&lt;section padding="regular"&gt;...&lt;/n-body&gt;
&lt;section padding="relaxed"&gt;...&lt;/n-body&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── With Card ── -->

    <h2>With Card</h2>
    <n-container data-kind="panel" bordered>
      <div class="body-card-wrap">
      <n-container>
        <n-header>
          <nav><n-badge intent="accent">3</n-badge></nav>
          <span>Notifications</span>
          <n-button variant="ghost"><n-icon name="dots-three"></n-icon></n-button>
        </n-header>
        <n-body>
          <span>You have 3 unread notifications. Check your inbox for details.</span>
          <span>The body provides a scrollable region between the header and any footer.</span>
        </n-body>
      </n-container>
      </div>
    <pre class="code-block"><code>&lt;n-container&gt;
  &lt;n-header&gt;
    &lt;n-badge slot="leading" intent="accent"&gt;3&lt;/n-badge&gt;
    &lt;span slot="label"&gt;Notifications&lt;/span&gt;
    &lt;n-button slot="trailing" variant="ghost"&gt;...&lt;/n-button&gt;
  &lt;/n-header&gt;
  &lt;n-body&gt;
    &lt;p&gt;Card body content.&lt;/p&gt;
  &lt;/n-body&gt;
&lt;/n-container&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Divider Breathing Room ── -->

    <h2>Divider Breathing Room</h2>
    <span class="text-muted">
      When an adjacent n-header or n-footer has the <code>dividers</code> attribute, n-body automatically adds block padding so content does not sit against the divider line.
    </span>
    <n-container data-kind="panel" bordered>
      <div class="body-card-wrap">
      <n-container>
        <n-header dividers>
          <span>With Divider</span>
        </n-header>
        <n-body>
          <span>The body gets automatic top padding because the header above has the <code>dividers</code> attribute.</span>
        </n-body>
        <n-footer dividers>
          <n-button variant="primary" intent="accent"><span>Save</span></n-button>
        </n-footer>
      </n-container>
      </div>
    <pre class="code-block"><code>&lt;n-header dividers&gt;
  &lt;span slot="label"&gt;With Divider&lt;/span&gt;
&lt;/n-header&gt;
&lt;n-body&gt;
  &lt;p&gt;Auto block-padding next to dividers.&lt;/p&gt;
&lt;/n-body&gt;
&lt;n-footer dividers&gt;
  &lt;n-button variant="primary" intent="accent"&gt;Save&lt;/n-button&gt;
&lt;/n-footer&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <h2>API Reference</h2>
    <ApiReference data={bodyApi} />
  </section>
</SidebarLayout>

<style is:global>
  @import './body.css';
</style>
