---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  basic: `&lt;n-text&gt;This is a default n-text element. It renders as a
  block-level paragraph with inherited font size, line height,
  and ink color.&lt;/n-text&gt;`,

  sizes: `&lt;n-text size="xs"&gt;Extra small (xs)&lt;/n-text&gt;
&lt;n-text size="sm"&gt;Small (sm)&lt;/n-text&gt;
&lt;n-text size="md"&gt;Medium (md)&lt;/n-text&gt;
&lt;n-text size="lg"&gt;Large (lg)&lt;/n-text&gt;
&lt;n-text size="xl"&gt;Extra large (xl)&lt;/n-text&gt;`,

  color: `&lt;n-text&gt;Default ink color&lt;/n-text&gt;
&lt;n-text muted&gt;Muted — secondary, de-emphasized text&lt;/n-text&gt;
&lt;n-text strong&gt;Strong — bold, high-contrast text&lt;/n-text&gt;`,

  inline: `&lt;p&gt;This is regular text with
  &lt;n-text inline muted&gt;inline muted&lt;/n-text&gt; text mixed in,
  and also &lt;n-text inline strong&gt;inline strong&lt;/n-text&gt; text
  alongside it.&lt;/p&gt;`,

  spacing: `&lt;n-text spacing="tight"&gt;Tight spacing&lt;/n-text&gt;
&lt;n-text spacing="regular"&gt;Regular spacing&lt;/n-text&gt;
&lt;n-text spacing="relaxed"&gt;Relaxed spacing&lt;/n-text&gt;`,

  truncate: `&lt;div style="max-width: 20rem;"&gt;
  &lt;n-text truncate&gt;This is a very long line of text that
    will be truncated with an ellipsis...&lt;/n-text&gt;
&lt;/div&gt;`,

  uppercase: `&lt;n-text uppercase&gt;Uppercase with letter spacing&lt;/n-text&gt;`,

  combined: `&lt;n-text size="sm" muted&gt;Last updated 3 hours ago&lt;/n-text&gt;
&lt;n-text size="xs" muted uppercase&gt;Section heading&lt;/n-text&gt;
&lt;n-text strong&gt;Important announcement&lt;/n-text&gt;
&lt;n-text size="lg" strong&gt;Large bold heading text&lt;/n-text&gt;
&lt;n-text size="sm" muted truncate&gt;user.profile...&lt;/n-text&gt;`,
};
---
<SidebarLayout title="Text">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Text</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-text&gt;</span> CSS-only utility element for styled text blocks — muted descriptions, secondary labels, section intros. No JS registration needed.
          </div>
  </header>

  <section>

    <!-- ── Basic ── -->

    <h2>Basic</h2>
    <n-panel bordered>
      <n-text>This is a default n-text element. It renders as a block-level paragraph with the inherited font size, line height, and ink color.</n-text>
    <pre class="code-block"><code set:html={codeExamples.basic} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-panel bordered>
      <n-stack gap="3">
        <n-text size="xs">Extra small (xs)</n-text>
        <n-text size="sm">Small (sm)</n-text>
        <n-text size="md">Medium (md) — same as default</n-text>
        <n-text size="lg">Large (lg)</n-text>
        <n-text size="xl">Extra large (xl)</n-text>
      </n-stack>
    <pre class="code-block"><code set:html={codeExamples.sizes} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Color Modifiers ── -->

    <h2>Color Modifiers</h2>
    <n-panel bordered>
      <n-stack gap="3">
        <n-text>Default ink color</n-text>
        <n-text muted>Muted — secondary, de-emphasized text</n-text>
        <n-text strong>Strong — bold, high-contrast text</n-text>
      </n-stack>
    <pre class="code-block"><code set:html={codeExamples.color} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Inline Mode ── -->

    <h2>Inline Mode</h2>
    <n-panel bordered>
      <p>This is regular text with <n-text inline muted>inline muted</n-text> text mixed in, and also <n-text inline strong>inline strong</n-text> text alongside it.</p>
    <pre class="code-block"><code set:html={codeExamples.inline} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Spacing ── -->

    <h2>Spacing</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Opt-in bottom margin for stacked text blocks. The spacing is visible between each text element and the divider below it.
      </n-text>
      <div>
        <n-text spacing="tight">Tight spacing — smaller bottom margin</n-text>
        <n-divider></n-divider>
      </div>
      <div>
        <n-text spacing="regular">Regular spacing — medium bottom margin</n-text>
        <n-divider></n-divider>
      </div>
      <div>
        <n-text spacing="relaxed">Relaxed spacing — large bottom margin</n-text>
        <n-divider></n-divider>
      </div>
    <pre class="code-block"><code set:html={codeExamples.spacing} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Truncate ── -->

    <h2>Truncate</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Clips overflowing text with an ellipsis. The parent must have a constrained width.
      </n-text>
      <div style="max-width: 20rem;">
        <n-text truncate>This is a very long line of text that will be truncated with an ellipsis when it overflows the container boundary.</n-text>
      </div>
    <pre class="code-block"><code set:html={codeExamples.truncate} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Uppercase ── -->

    <h2>Uppercase</h2>
    <n-panel bordered>
      <n-text uppercase>Uppercase with letter spacing</n-text>
    <pre class="code-block"><code set:html={codeExamples.uppercase} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Combined ── -->

    <h2>Combined</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="tight">
        Attributes compose freely. Mix size, color, spacing, truncate, and uppercase for common UI patterns.
      </n-text>
      <n-stack gap="3">
        <n-text size="sm" muted>Last updated 3 hours ago</n-text>
        <n-text size="xs" muted uppercase>Section heading</n-text>
        <n-text strong>Important announcement</n-text>
        <n-text size="lg" strong>Large bold heading text</n-text>
        <div style="max-width: 16rem;">
          <n-text size="sm" muted truncate>user.profile.settings.preferences.notifications.email</n-text>
        </div>
      </n-stack>
    <pre class="code-block"><code set:html={codeExamples.combined} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── API ── -->

    <h2>API</h2>
    <n-table variant="plain" size="sm" cols="auto auto auto 1fr">
      <n-table-head>
        <n-table-row>
          <n-table-header>Attribute</n-table-header>
          <n-table-header>Values</n-table-header>
          <n-table-header>Default</n-table-header>
          <n-table-header>Description</n-table-header>
        </n-table-row>
      </n-table-head>
      <n-table-body>
        <n-table-row>
          <n-table-cell><code>size</code></n-table-cell>
          <n-table-cell><code>xs</code> <code>sm</code> <code>md</code> <code>lg</code> <code>xl</code></n-table-cell>
          <n-table-cell>inherited</n-table-cell>
          <n-table-cell>Font size. Maps to <code>--n-font-{size}</code> tokens.</n-table-cell>
        </n-table-row>
        <n-table-row>
          <n-table-cell><code>muted</code></n-table-cell>
          <n-table-cell>boolean</n-table-cell>
          <n-table-cell>—</n-table-cell>
          <n-table-cell>De-emphasized text color via <code>--n-ink-muted</code>.</n-table-cell>
        </n-table-row>
        <n-table-row>
          <n-table-cell><code>strong</code></n-table-cell>
          <n-table-cell>boolean</n-table-cell>
          <n-table-cell>—</n-table-cell>
          <n-table-cell>Bold weight and high-contrast color via <code>--n-ink-strong</code>.</n-table-cell>
        </n-table-row>
        <n-table-row>
          <n-table-cell><code>inline</code></n-table-cell>
          <n-table-cell>boolean</n-table-cell>
          <n-table-cell>—</n-table-cell>
          <n-table-cell>Switches from <code>display: block</code> to <code>display: inline</code>.</n-table-cell>
        </n-table-row>
        <n-table-row>
          <n-table-cell><code>spacing</code></n-table-cell>
          <n-table-cell><code>tight</code> <code>regular</code> <code>relaxed</code></n-table-cell>
          <n-table-cell>—</n-table-cell>
          <n-table-cell>Bottom margin for stacked text blocks. Multiplier of <code>--n-space</code>.</n-table-cell>
        </n-table-row>
        <n-table-row>
          <n-table-cell><code>truncate</code></n-table-cell>
          <n-table-cell>boolean</n-table-cell>
          <n-table-cell>—</n-table-cell>
          <n-table-cell>Clips overflow with ellipsis. Requires a width-constrained parent.</n-table-cell>
        </n-table-row>
        <n-table-row>
          <n-table-cell><code>uppercase</code></n-table-cell>
          <n-table-cell>boolean</n-table-cell>
          <n-table-cell>—</n-table-cell>
          <n-table-cell>Applies <code>text-transform: uppercase</code> with <code>0.05em</code> letter spacing.</n-table-cell>
        </n-table-row>
      </n-table-body>
    </n-table>
  </section>
</SidebarLayout>
