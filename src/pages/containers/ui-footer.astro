---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Footer">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Footer</h1>
      </div>
    </div>
    <div data-slot="description">
      <span class="header-tag">&lt;n-footer&gt;</span> CSS-only sub-container for bottom-anchored actions. Flex row, end-aligned by default. Works inside n-card, n-panel, n-drawer, n-dialog, or any flex column parent.
          </div>
  </header>

  <section>

    <!-- ── Basic ── -->

    <h2>Basic</h2>
    <n-panel bordered>
      <div class="footer-card-wrap">
        <n-card>
          <header>
            <span>Panel Title</span>
          </header>
          <section>
            <n-text>Content above the footer. The footer sits at the bottom with action buttons end-aligned by default.</n-text>
          </section>
          <footer>
            <n-button variant="ghost"><span>Cancel</span></n-button>
            <n-button variant="primary" intent="accent"><span>Save</span></n-button>
          </footer>
        </n-card>
      </div>
    <pre class="layout-code"><code>&lt;n-card&gt;
  &lt;n-header&gt;
    &lt;span slot="label"&gt;Panel Title&lt;/span&gt;
  &lt;/n-header&gt;
  &lt;n-body&gt;
    &lt;p&gt;Content above the footer.&lt;/p&gt;
  &lt;/n-body&gt;
  &lt;n-footer&gt;
    &lt;n-button variant="ghost"&gt;Cancel&lt;/n-button&gt;
    &lt;n-button variant="primary" intent="accent"&gt;Save&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Justify Variants ── -->

    <h2>Justify Variants</h2>
    <n-panel bordered>
      <n-stack gap="4">
        <div class="footer-card-wrap">
          <n-card>
            <header><span>End (default)</span></header>
            <section><n-text>Actions aligned to the right.</n-text></section>
            <footer>
              <n-button variant="ghost"><span>Cancel</span></n-button>
              <n-button variant="primary" intent="accent"><span>Confirm</span></n-button>
            </footer>
          </n-card>
        </div>
        <div class="footer-card-wrap">
          <n-card>
            <header><span>Spread</span></header>
            <section><n-text>Cancel left, Save right.</n-text></section>
            <footer justify="spread">
              <n-button variant="ghost"><span>Cancel</span></n-button>
              <n-button variant="primary" intent="accent"><span>Save</span></n-button>
            </footer>
          </n-card>
        </div>
        <div class="footer-card-wrap">
          <n-card>
            <header><span>Start</span></header>
            <section><n-text>Actions aligned left.</n-text></section>
            <footer justify="start">
              <n-button variant="ghost"><span>Back</span></n-button>
              <n-button variant="primary" intent="accent"><span>Next</span></n-button>
            </footer>
          </n-card>
        </div>
        <div class="footer-card-wrap">
          <n-card>
            <header><span>Center</span></header>
            <section><n-text>Centered actions.</n-text></section>
            <footer justify="center">
              <n-button variant="primary" intent="accent"><span>Got it</span></n-button>
            </footer>
          </n-card>
        </div>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-footer&gt;...&lt;/n-footer&gt;                   &lt;!-- end (default) --&gt;
&lt;n-footer justify="spread"&gt;...&lt;/n-footer&gt;  &lt;!-- space-between --&gt;
&lt;n-footer justify="start"&gt;...&lt;/n-footer&gt;   &lt;!-- left-aligned --&gt;
&lt;n-footer justify="center"&gt;...&lt;/n-footer&gt;  &lt;!-- centered --&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Dividers ── -->

    <h2>Dividers</h2>
    <n-panel bordered>
      <div class="footer-card-wrap">
        <n-card>
          <header><span>With Divider</span></header>
          <section>
            <n-text>The <code>dividers</code> attribute adds a top border line to visually separate the footer from the body.</n-text>
          </section>
          <footer dividers>
            <n-button variant="ghost"><span>Cancel</span></n-button>
            <n-button variant="primary" intent="accent"><span>Apply</span></n-button>
          </footer>
        </n-card>
      </div>
    <pre class="layout-code"><code>&lt;n-footer dividers&gt;
  &lt;n-button variant="ghost"&gt;Cancel&lt;/n-button&gt;
  &lt;n-button variant="primary" intent="accent"&gt;Apply&lt;/n-button&gt;
&lt;/n-footer&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sticky ── -->

    <h2>Sticky</h2>
    <n-panel bordered>
      <div class="footer-card-wrap footer-card-wrap--fixed-height">
        <n-card>
          <header><span>Scrollable with Sticky Footer</span></header>
          <section>
            <n-text>When content scrolls, the sticky footer stays anchored at the bottom of the scrollable container.</n-text>
            <n-text>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</n-text>
            <n-text>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</n-text>
            <n-text>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</n-text>
            <n-text>Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</n-text>
          </section>
          <footer sticky dividers>
            <n-button variant="primary" intent="accent"><span>Done</span></n-button>
          </footer>
        </n-card>
      </div>
    <pre class="layout-code"><code>&lt;n-card style="height: 16rem;"&gt;
  &lt;n-header&gt;&lt;span slot="label"&gt;Scrollable&lt;/span&gt;&lt;/n-header&gt;
  &lt;n-body&gt;
    &lt;p&gt;Long scrollable content...&lt;/p&gt;
  &lt;/n-body&gt;
  &lt;n-footer sticky dividers&gt;
    &lt;n-button variant="primary" intent="accent"&gt;Done&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── With Card ── -->

    <h2>With Card</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="start">
        <div class="footer-card-wrap footer-card-wrap--narrow">
          <n-card>
            <div slot="media" class="footer-media footer-media--accent"></div>
            <section>
              <h3 class="footer-card-title">Product Name</h3>
              <n-text size="sm" muted>A short description of the product.</n-text>
            </section>
            <footer>
              <n-button variant="primary" intent="accent" size="sm"><span>Buy Now</span></n-button>
            </footer>
          </n-card>
        </div>
        <div class="footer-card-wrap footer-card-wrap--narrow">
          <n-card>
            <div slot="media" class="footer-media footer-media--success"></div>
            <section>
              <h3 class="footer-card-title">Another Item</h3>
              <n-text size="sm" muted>Another brief description.</n-text>
            </section>
            <footer justify="spread">
              <n-text size="sm" muted>$29.99</n-text>
              <n-button variant="primary" intent="accent" size="sm"><span>Add</span></n-button>
            </footer>
          </n-card>
        </div>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-card&gt;
  &lt;div slot="media"&gt;...&lt;/div&gt;
  &lt;n-body&gt;
    &lt;h3&gt;Product Name&lt;/h3&gt;
    &lt;n-text size="sm" muted&gt;Description.&lt;/n-text&gt;
  &lt;/n-body&gt;
  &lt;n-footer&gt;
    &lt;n-button variant="primary" intent="accent" size="sm"&gt;Buy Now&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── With Dialog ── -->

    <h2>With Dialog</h2>
    <n-panel bordered>
      <n-button id="open-footer-dialog"><span>Open Dialog</span></n-button>
      <n-dialog id="footer-dialog-demo">
        <header>
          <span>Confirm Action</span>
          <aside><n-button variant="ghost" id="close-footer-dialog"><n-icon name="x"></n-icon></n-button></aside>
        </header>
        <section>
          <n-text>Are you sure you want to proceed? This action cannot be undone.</n-text>
        </section>
        <footer justify="spread">
          <n-button variant="ghost" id="cancel-footer-dialog"><span>Cancel</span></n-button>
          <n-button variant="primary" intent="danger"><span>Delete</span></n-button>
        </footer>
      </n-dialog>
    <pre class="layout-code"><code>&lt;n-dialog&gt;
  &lt;n-header&gt;
    &lt;span slot="label"&gt;Confirm Action&lt;/span&gt;
    &lt;n-button slot="trailing" variant="ghost"&gt;&lt;n-icon name="x"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
  &lt;/n-header&gt;
  &lt;n-body&gt;
    &lt;p&gt;Are you sure you want to proceed?&lt;/p&gt;
  &lt;/n-body&gt;
  &lt;n-footer justify="spread"&gt;
    &lt;n-button variant="ghost"&gt;Cancel&lt;/n-button&gt;
    &lt;n-button variant="primary" intent="danger"&gt;Delete&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-dialog&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Padding ── -->

    <h2>Padding</h2>
    <n-panel bordered>
      <n-stack gap="4">
        <div class="footer-card-wrap">
          <n-card>
            <header><span>None</span></header>
            <section><n-text>No padding on the footer.</n-text></section>
            <footer padding="none">
              <n-button variant="primary" intent="accent"><span>OK</span></n-button>
            </footer>
          </n-card>
        </div>
        <div class="footer-card-wrap">
          <n-card>
            <header><span>Tight (default)</span></header>
            <section><n-text>Default compact padding.</n-text></section>
            <footer padding="tight">
              <n-button variant="primary" intent="accent"><span>OK</span></n-button>
            </footer>
          </n-card>
        </div>
        <div class="footer-card-wrap">
          <n-card>
            <header><span>Regular</span></header>
            <section><n-text>More breathing room.</n-text></section>
            <footer padding="regular">
              <n-button variant="primary" intent="accent"><span>OK</span></n-button>
            </footer>
          </n-card>
        </div>
        <div class="footer-card-wrap">
          <n-card>
            <header><span>Relaxed</span></header>
            <section><n-text>Spacious footer padding.</n-text></section>
            <footer padding="relaxed">
              <n-button variant="primary" intent="accent"><span>OK</span></n-button>
            </footer>
          </n-card>
        </div>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-footer padding="none"&gt;...&lt;/n-footer&gt;
&lt;n-footer padding="tight"&gt;...&lt;/n-footer&gt;    &lt;!-- default --&gt;
&lt;n-footer padding="regular"&gt;...&lt;/n-footer&gt;
&lt;n-footer padding="relaxed"&gt;...&lt;/n-footer&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── API ── -->

    <h2>API</h2>
    <n-panel bordered>
      <table class="api-table">
        <thead>
          <tr>
            <th>Attribute</th>
            <th>Values</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>justify</code></td>
            <td><code>start</code> | <code>center</code> | <code>spread</code></td>
            <td>Horizontal alignment. Default is <code>end</code> (flex-end).</td>
          </tr>
          <tr>
            <td><code>padding</code></td>
            <td><code>none</code> | <code>tight</code> | <code>regular</code> | <code>relaxed</code></td>
            <td>Override inner padding. Default is tight.</td>
          </tr>
          <tr>
            <td><code>dividers</code></td>
            <td>boolean</td>
            <td>Adds a top border line via <code>::before</code> pseudo-element.</td>
          </tr>
          <tr>
            <td><code>sticky</code></td>
            <td>boolean</td>
            <td>Sticks footer to the bottom of a scrollable container (<code>position: sticky</code>).</td>
          </tr>
        </tbody>
      </table>
    </n-panel>
  </section>

  <script>
    const dialog = document.getElementById('footer-dialog-demo');
    document.getElementById('open-footer-dialog')?.addEventListener('native:press', () => dialog?.showModal());
    document.getElementById('close-footer-dialog')?.addEventListener('native:press', () => dialog?.close());
    document.getElementById('cancel-footer-dialog')?.addEventListener('native:press', () => dialog?.close());
  </script>
</SidebarLayout>

<style is:global>
  .footer-card-wrap {
    max-width: 28rem;
  }
  .footer-card-wrap--narrow {
    max-width: 18rem;
  }
  .footer-card-wrap--fixed-height n-card {
    height: 16rem;
  }
  .footer-media {
    height: 8rem;
  }
  .footer-media--accent {
    background: linear-gradient(135deg, var(--n-surface-accent), var(--n-surface-info));
  }
  .footer-media--success {
    background: linear-gradient(135deg, var(--n-surface-success), var(--n-surface-warning));
  }
  .footer-card-title {
    margin: 0 0 0.25rem;
    text-transform: none;
    letter-spacing: 0;
    color: inherit;
  }
  .api-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--n-font-size);
    line-height: var(--n-line-height);
  }
  .api-table th,
  .api-table td {
    text-align: left;
    padding: calc(var(--n-space) * 2) calc(var(--n-space) * 3);
    border-bottom: 1px solid var(--n-border-muted);
  }
  .api-table th {
    font-weight: 600;
    color: var(--n-ink-strong);
  }
  .api-table code {
    font-family: var(--n-font-mono);
    font-size: 0.875em;
    background: var(--n-control);
    padding: 0.125em 0.375em;
    border-radius: var(--n-radius);
  }
</style>
