---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import ApiReference from '../../../components/ApiReference.astro';
import { textApi } from '../../../data/api/text';

const codeExamples = {
  basic: `&lt;span&gt;This is a default n-text element. It renders as a
  block-level paragraph with inherited font size, line height,
  and ink color.&lt;/span&gt;`,

  sizes: `&lt;span class=&quot;text-xs&quot;&gt;Extra small (xs)&lt;/span&gt;
&lt;span class=&quot;text-sm&quot;&gt;Small (sm)&lt;/span&gt;
&lt;span&gt;Medium (md)&lt;/span&gt;
&lt;span class=&quot;text-lg&quot;&gt;Large (lg)&lt;/span&gt;
&lt;span class=&quot;text-xl&quot;&gt;Extra large (xl)&lt;/span&gt;`,

  color: `&lt;span&gt;Default ink color&lt;/span&gt;
&lt;span class=&quot;text-muted&quot;&gt;Muted — secondary, de-emphasized text&lt;/span&gt;
&lt;span class=&quot;text-strong&quot;&gt;Strong — bold, high-contrast text&lt;/span&gt;`,

  inline: `&lt;p&gt;This is regular text with
  &lt;span class=&quot;text-muted&quot;&gt;inline muted&lt;/span&gt; text mixed in,
  and also &lt;span class=&quot;text-strong&quot;&gt;inline strong&lt;/span&gt; text
  alongside it.&lt;/p&gt;`,

  spacing: `&lt;span&gt;Tight spacing&lt;/span&gt;
&lt;span&gt;Regular spacing&lt;/span&gt;
&lt;span&gt;Relaxed spacing&lt;/span&gt;`,

  truncate: `&lt;div style="max-width: 20rem;"&gt;
  &lt;span class=&quot;text-truncate&quot;&gt;This is a very long line of text that
    will be truncated with an ellipsis...&lt;/span&gt;
&lt;/div&gt;`,

  uppercase: `&lt;span class=&quot;text-uppercase&quot;&gt;Uppercase with letter spacing&lt;/span&gt;`,

  combined: `&lt;span class=&quot;text-sm text-muted&quot;&gt;Last updated 3 hours ago&lt;/span&gt;
&lt;span class=&quot;text-xs text-muted text-uppercase&quot;&gt;Section heading&lt;/span&gt;
&lt;span class=&quot;text-strong&quot;&gt;Important announcement&lt;/span&gt;
&lt;span class=&quot;text-lg text-strong&quot;&gt;Large bold heading text&lt;/span&gt;
&lt;span class=&quot;text-sm text-muted text-truncate&quot;&gt;user.profile...&lt;/span&gt;`,
};
---
<SidebarLayout title="Text">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Text</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;span&gt;</span> CSS-only utility element for styled text blocks — muted descriptions, secondary labels, section intros. No JS registration needed.
          </div>
  </header>

  <section>

    <!-- ── Basic ── -->

    <h2>Basic</h2>
    <n-container data-kind="panel" bordered>
      <span>This is a default n-text element. It renders as a block-level paragraph with the inherited font size, line height, and ink color.</span>
    <pre class="code-block"><code set:html={codeExamples.basic} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-container data-kind="panel" bordered>
      <n-stack gap="3">
        <span class="text-xs">Extra small (xs)</span>
        <span class="text-sm">Small (sm)</span>
        <span>Medium (md) — same as default</span>
        <span class="text-lg">Large (lg)</span>
        <span class="text-xl">Extra large (xl)</span>
      </n-stack>
    <pre class="code-block"><code set:html={codeExamples.sizes} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Color Modifiers ── -->

    <h2>Color Modifiers</h2>
    <n-container data-kind="panel" bordered>
      <n-stack gap="3">
        <span>Default ink color</span>
        <span class="text-muted">Muted — secondary, de-emphasized text</span>
        <span class="text-strong">Strong — bold, high-contrast text</span>
      </n-stack>
    <pre class="code-block"><code set:html={codeExamples.color} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Inline Mode ── -->

    <h2>Inline Mode</h2>
    <n-container data-kind="panel" bordered>
      <p>This is regular text with <span class="text-muted">inline muted</span> text mixed in, and also <span class="text-strong">inline strong</span> text alongside it.</p>
    <pre class="code-block"><code set:html={codeExamples.inline} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Spacing ── -->

    <h2>Spacing</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Opt-in bottom margin for stacked text blocks. The spacing is visible between each text element and the divider below it.
      </span>
      <div>
        <span>Tight spacing — smaller bottom margin</span>
        <n-divider></n-divider>
      </div>
      <div>
        <span>Regular spacing — medium bottom margin</span>
        <n-divider></n-divider>
      </div>
      <div>
        <span>Relaxed spacing — large bottom margin</span>
        <n-divider></n-divider>
      </div>
    <pre class="code-block"><code set:html={codeExamples.spacing} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Truncate ── -->

    <h2>Truncate</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Clips overflowing text with an ellipsis. The parent must have a constrained width.
      </span>
      <div style="max-width: 20rem;">
        <span class="text-truncate">This is a very long line of text that will be truncated with an ellipsis when it overflows the container boundary.</span>
      </div>
    <pre class="code-block"><code set:html={codeExamples.truncate} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Uppercase ── -->

    <h2>Uppercase</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-uppercase">Uppercase with letter spacing</span>
    <pre class="code-block"><code set:html={codeExamples.uppercase} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Combined ── -->

    <h2>Combined</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Attributes compose freely. Mix size, color, spacing, truncate, and uppercase for common UI patterns.
      </span>
      <n-stack gap="3">
        <span class="text-sm text-muted">Last updated 3 hours ago</span>
        <span class="text-xs text-muted text-uppercase">Section heading</span>
        <span class="text-strong">Important announcement</span>
        <span class="text-lg text-strong">Large bold heading text</span>
        <div style="max-width: 16rem;">
          <span class="text-sm text-muted text-truncate">user.profile.settings.preferences.notifications.email</span>
        </div>
      </n-stack>
    <pre class="code-block"><code set:html={codeExamples.combined} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <h2>API Reference</h2>
    <ApiReference data={textApi} />
  </section>
</SidebarLayout>
