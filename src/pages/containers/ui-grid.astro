---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Grid">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Grid</h1>
      </div>
    </div>
    <div data-slot="description">
      <span class="header-tag">&lt;n-grid&gt;</span> CSS grid layout container. Responsive auto-fill or fixed columns. CSS-only container.
          </div>
  </header>

  <main>

    <!-- ── Auto-fill (default) ── -->

    <h2>Auto-fill (default, min 16rem)</h2>
    <n-panel bordered>
      <n-grid>
        <n-card class="layout-box">Card 1</n-card>
        <n-card class="layout-box">Card 2</n-card>
        <n-card class="layout-box">Card 3</n-card>
        <n-card class="layout-box">Card 4</n-card>
        <n-card class="layout-box">Card 5</n-card>
        <n-card class="layout-box">Card 6</n-card>
      </n-grid>
    <pre class="layout-code"><code>&lt;n-grid&gt;
  &lt;div&gt;Card 1&lt;/div&gt;
  &lt;div&gt;Card 2&lt;/div&gt;
  &lt;div&gt;Card 3&lt;/div&gt;
  &lt;div&gt;Card 4&lt;/div&gt;
&lt;/n-grid&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Fixed Columns ── -->

    <h2>Fixed Columns</h2>
    <n-panel bordered>
      <h3>cols="2"</h3>
      <n-grid cols="2">
        <n-card class="layout-box">Col 1</n-card>
        <n-card class="layout-box">Col 2</n-card>
        <n-card class="layout-box">Col 3</n-card>
        <n-card class="layout-box">Col 4</n-card>
      </n-grid>
      <h3>cols="3"</h3>
      <n-grid cols="3">
        <n-card class="layout-box">Col 1</n-card>
        <n-card class="layout-box">Col 2</n-card>
        <n-card class="layout-box">Col 3</n-card>
      </n-grid>
      <h3>cols="4"</h3>
      <n-grid cols="4">
        <n-card class="layout-box">1</n-card>
        <n-card class="layout-box">2</n-card>
        <n-card class="layout-box">3</n-card>
        <n-card class="layout-box">4</n-card>
      </n-grid>
    <pre class="layout-code"><code>&lt;n-grid cols="2"&gt;
  &lt;div&gt;Col 1&lt;/div&gt;
  &lt;div&gt;Col 2&lt;/div&gt;
&lt;/n-grid&gt;

&lt;n-grid cols="3"&gt;...&lt;/n-grid&gt;
&lt;n-grid cols="4"&gt;...&lt;/n-grid&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Min Column Width ── -->

    <h2>Min Column Width</h2>
    <n-panel bordered>
      <h3>min="10rem" (more columns)</h3>
      <n-grid min="10rem">
        <n-card class="layout-box">A</n-card>
        <n-card class="layout-box">B</n-card>
        <n-card class="layout-box">C</n-card>
        <n-card class="layout-box">D</n-card>
        <n-card class="layout-box">E</n-card>
        <n-card class="layout-box">F</n-card>
      </n-grid>
      <h3>min="24rem" (fewer columns)</h3>
      <n-grid min="24rem">
        <n-card class="layout-box">A</n-card>
        <n-card class="layout-box">B</n-card>
        <n-card class="layout-box">C</n-card>
        <n-card class="layout-box">D</n-card>
      </n-grid>
    <pre class="layout-code"><code>&lt;n-grid min="10rem"&gt;
  &lt;div&gt;A&lt;/div&gt;
  &lt;div&gt;B&lt;/div&gt;
  ...
&lt;/n-grid&gt;

&lt;n-grid min="24rem"&gt;...&lt;/n-grid&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Gap ── -->

    <h2>Gap Sizes</h2>
    <n-panel bordered>
      <h3>gap="1"</h3>
      <n-grid cols="3" gap="1">
        <n-card class="layout-box">A</n-card>
        <n-card class="layout-box">B</n-card>
        <n-card class="layout-box">C</n-card>
      </n-grid>
      <h3>gap="4"</h3>
      <n-grid cols="3" gap="4">
        <n-card class="layout-box">A</n-card>
        <n-card class="layout-box">B</n-card>
        <n-card class="layout-box">C</n-card>
      </n-grid>
      <h3>gap="8"</h3>
      <n-grid cols="3" gap="8">
        <n-card class="layout-box">A</n-card>
        <n-card class="layout-box">B</n-card>
        <n-card class="layout-box">C</n-card>
      </n-grid>
    <pre class="layout-code"><code>&lt;n-grid cols="3" gap="1"&gt;...&lt;/n-grid&gt;
&lt;n-grid cols="3" gap="4"&gt;...&lt;/n-grid&gt;
&lt;n-grid cols="3" gap="8"&gt;...&lt;/n-grid&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Composition ── -->

    <h2>Composition (stat cards)</h2>
    <n-panel bordered>
      <n-grid cols="4" gap="4">
        <div class="stat-card">
          <div class="stat-label">Revenue</div>
          <div class="stat-value">$45,231</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Users</div>
          <div class="stat-value">2,350</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Orders</div>
          <div class="stat-value">1,274</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Conversion</div>
          <div class="stat-value">3.2%</div>
        </div>
      </n-grid>
    <pre class="layout-code"><code>&lt;n-grid cols="4" gap="4"&gt;
  &lt;div class="stat-card"&gt;
    &lt;div class="stat-label"&gt;Revenue&lt;/div&gt;
    &lt;div class="stat-value"&gt;$45,231&lt;/div&gt;
  &lt;/div&gt;
  ...
&lt;/n-grid&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>
  </main>

  <style is:global>
    .stat-card {
      background: var(--n-card-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: var(--n-radius);
      padding: 1.25rem;
    }

    .stat-label {
      font-size: 0.75rem;
      color: var(--n-ink-muted-neutral);
      margin-bottom: 0.25rem;
    }

    .stat-value {
      font-size: 1.5rem;
      font-weight: 700;
    }

    /* ── Code Blocks ── */
</style>

</SidebarLayout>
