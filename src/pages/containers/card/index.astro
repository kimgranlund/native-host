---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import ApiReference from '../../../components/ApiReference.astro';
import { cardApi } from '../../../data/api/card';
---
<SidebarLayout title="Card">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Card</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-container&gt;</span> Bounded content surface with optional header, body, and footer.
          </div>
  </header>

  <section>

    <!-- ── Simple ── -->

    <h2>Simple</h2>
    <n-container data-kind="panel" bordered>
      <div class="demo-card">
        <n-container>
          <n-body><p>A simple card with just body content. No header or footer.</p></n-body>
        </n-container>
      </div>
    <pre class="code-block"><code>&lt;n-container&gt;
  &lt;n-body&gt;&lt;p&gt;A simple card with just body content.&lt;/p&gt;&lt;/n-body&gt;
&lt;/n-container&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Structured ── -->

    <h2>Structured (header + body + footer)</h2>
    <n-container data-kind="panel" bordered>
      <div class="demo-card">
        <n-container>
          <n-header>
            <span>Card Title</span>
            <n-button variant="ghost"><n-icon name="dots-three"></n-icon></n-button>
          </n-header>
          <n-body>
            <span>Card body content goes here. This demonstrates the structured layout with header, body, and footer sections.</span>
          </n-body>
        <n-footer>
          <n-button variant="ghost"><span>Cancel</span></n-button>
          <n-button variant="primary" intent="accent"><span>Save</span></n-button>
        </n-footer>
        </n-container>
      </div>
    <pre class="code-block"><code>&lt;n-container&gt;
  &lt;n-header&gt;
    &lt;span slot="label"&gt;Card Title&lt;/span&gt;
    &lt;n-button slot="trailing" variant="ghost"&gt;...&lt;/n-button&gt;
  &lt;/n-header&gt;
  &lt;n-body&gt;
    &lt;p&gt;Card body content goes here.&lt;/p&gt;
  &lt;/n-body&gt;
  &lt;n-footer&gt;
    &lt;n-button variant="ghost"&gt;Cancel&lt;/n-button&gt;
    &lt;n-button variant="primary" intent="accent"&gt;Save&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-container&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Media ── -->

    <h2>With Media</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <div class="demo-card-sm">
          <n-container>
            <div slot="media" class="demo-media demo-media-accent"></div>
            <n-body>
              <h3 class="demo-card-title">Product Name</h3>
              <span class="text-sm text-muted">A short description of the product.</span>
            </n-body>
            <n-footer>
              <n-button variant="primary" intent="accent" size="sm"><span>Buy Now</span></n-button>
            </n-footer>
          </n-container>
        </div>
        <div class="demo-card-sm">
          <n-container>
            <div slot="media" class="demo-media demo-media-success"></div>
            <n-body>
              <h3 class="demo-card-title">Another Product</h3>
              <span class="text-sm text-muted">Another description text.</span>
            </n-body>
          <n-footer>
            <n-button variant="primary" intent="accent" size="sm"><span>Buy Now</span></n-button>
            </n-footer>
          </n-container>
        </div>
      </n-stack>
      <pre class="code-block"><code>&lt;n-container&gt;
  &lt;div slot="media" class="media-placeholder"&gt;&lt;/div&gt;
  &lt;n-body&gt;
    &lt;h3&gt;Product Name&lt;/h3&gt;
    &lt;p&gt;A short description.&lt;/p&gt;
  &lt;/n-body&gt;
  &lt;n-footer&gt;
    &lt;n-button variant="primary" intent="accent" size="sm"&gt;Buy Now&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-container&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Header with Slots ── -->

    <h2>Header with Leading & Trailing</h2>
    <n-container data-kind="panel" bordered>
      <div class="demo-card-md">
        <n-container>
          <n-header>
            <nav><n-badge intent="accent">New</n-badge></nav>
          <span>Card with Actions</span>
          <n-button variant="ghost"><n-icon name="dots-three"></n-icon></n-button>
        </n-header>
        <n-body>
          <span>The header uses a 3-column grid: leading / label / trailing. The card adds contextual divider borders automatically.</span>
        </n-body>
        <n-footer justify="spread">
          <n-button variant="ghost"><span>Cancel</span></n-button>
          <n-button variant="primary" intent="accent"><span>Save</span></n-button>
        </n-footer>
        </n-container>
      </div>
    <pre class="code-block"><code>&lt;n-container&gt;
  &lt;n-header&gt;
    &lt;n-badge slot="leading" intent="accent"&gt;New&lt;/n-badge&gt;
    &lt;span slot="label"&gt;Card with Actions&lt;/span&gt;
    &lt;n-button slot="trailing" variant="ghost"&gt;...&lt;/n-button&gt;
  &lt;/n-header&gt;
  &lt;n-body&gt;...&lt;/n-body&gt;
  &lt;n-footer justify="spread"&gt;
    &lt;n-button variant="ghost"&gt;Cancel&lt;/n-button&gt;
    &lt;n-button variant="primary" intent="accent"&gt;Save&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-container&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Interactive ── -->

    <h2>Interactive</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <div class="demo-card-xs">
          <n-container interactive>
            <n-body><span>Click this card. It has hover and focus states.</span></n-body>
          </n-container>
        </div>
        <div class="demo-card-xs">
          <n-container interactive>
            <n-body><span>Another interactive card. Tab to focus.</span></n-body>
          </n-container>
        </div>
      </n-stack>
      <pre class="code-block"><code>&lt;n-container interactive&gt;
  &lt;n-body&gt;&lt;p&gt;Click this card. It has hover and focus states.&lt;/p&gt;&lt;/n-body&gt;
&lt;/n-container&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Sizes ── -->

    <h2>Sizes (inherit from parent)</h2>
    <n-container data-kind="panel" bordered>
      <h3>size="sm"</h3>
      <div class="demo-card-narrow">
        <n-container size="sm">
          <n-header><span>Small Card</span></n-header>
          <n-body><span>Compact padding.</span></n-body>
        </n-container>
      </div>
      <h3>size="lg"</h3>
      <div class="demo-card-narrow">
        <n-container size="lg">
          <n-header><span>Large Card</span></n-header>
          <n-body><span>Spacious padding.</span></n-body>
        </n-container>
      </div>
    <pre class="code-block"><code>&lt;n-container size="sm"&gt;
  &lt;n-header&gt;&lt;span slot="label"&gt;Small Card&lt;/span&gt;&lt;/n-header&gt;
  &lt;n-body&gt;&lt;p&gt;Compact padding.&lt;/p&gt;&lt;/n-body&gt;
&lt;/n-container&gt;

&lt;n-container size="lg"&gt;
  &lt;n-header&gt;&lt;span slot="label"&gt;Large Card&lt;/span&gt;&lt;/n-header&gt;
  &lt;n-body&gt;&lt;p&gt;Spacious padding.&lt;/p&gt;&lt;/n-body&gt;
&lt;/n-container&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Grid Composition ── -->

    <h2>Grid Composition</h2>
    <n-container data-kind="panel" bordered>
      <n-grid cols="3" gap="4">
        <n-container>
          <n-header><span>Revenue</span></n-header>
          <n-body><span class="stat-value">$45,231</span></n-body>
        </n-container>
        <n-container>
          <n-header><span>Users</span></n-header>
          <n-body><span class="stat-value">2,350</span></n-body>
        </n-container>
        <n-container>
          <n-header><span>Conversion</span></n-header>
          <n-body><span class="stat-value">3.2%</span></n-body>
        </n-container>
      </n-grid>
    <pre class="code-block"><code>&lt;n-grid cols="3" gap="4"&gt;
  &lt;n-container&gt;
    &lt;n-header&gt;&lt;span slot="label"&gt;Revenue&lt;/span&gt;&lt;/n-header&gt;
    &lt;n-body&gt;&lt;p&gt;$45,231&lt;/p&gt;&lt;/n-body&gt;
  &lt;/n-container&gt;
  &lt;n-container&gt;...&lt;/n-container&gt;
  &lt;n-container&gt;...&lt;/n-container&gt;
&lt;/n-grid&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <h2>API Reference</h2>
    <ApiReference data={cardApi} />
  </section>

  <style is:global>
    @import './card.css';
  </style>
</SidebarLayout>
