---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Card">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Card</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-card&gt;</span> Bounded content surface with optional header, body, and footer.
          </div>
  </header>

  <section>

    <!-- ── Simple ── -->

    <h2>Simple</h2>
    <n-panel bordered>
      <div class="demo-card">
        <n-card>
          <section><p>A simple card with just body content. No header or footer.</p></section>
        </n-card>
      </div>
    <pre class="code-block"><code>&lt;n-card&gt;
  &lt;section&gt;&lt;p&gt;A simple card with just body content.&lt;/p&gt;&lt;/section&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Structured ── -->

    <h2>Structured (header + body + footer)</h2>
    <n-panel bordered>
      <div class="demo-card">
        <n-card>
          <header>
            <span>Card Title</span>
            <aside><n-button variant="ghost"><n-icon name="dots-three"></n-icon></n-button></aside>
          </header>
          <section>
            <n-text>Card body content goes here. This demonstrates the structured layout with header, body, and footer sections.</n-text>
          </section>
        <footer>
          <n-button variant="ghost"><span>Cancel</span></n-button>
          <n-button variant="primary" intent="accent"><span>Save</span></n-button>
        </footer>
        </n-card>
      </div>
    <pre class="code-block"><code>&lt;n-card&gt;
  &lt;header&gt;
    &lt;span slot="label"&gt;Card Title&lt;/span&gt;
    &lt;n-button slot="trailing" variant="ghost"&gt;...&lt;/n-button&gt;
  &lt;/header&gt;
  &lt;section&gt;
    &lt;p&gt;Card body content goes here.&lt;/p&gt;
  &lt;/section&gt;
  &lt;footer&gt;
    &lt;n-button variant="ghost"&gt;Cancel&lt;/n-button&gt;
    &lt;n-button variant="primary" intent="accent"&gt;Save&lt;/n-button&gt;
  &lt;/footer&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Media ── -->

    <h2>With Media</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <div class="demo-card-sm">
          <n-card>
            <div slot="media" class="demo-media demo-media-accent"></div>
            <section>
              <h3 class="demo-card-title">Product Name</h3>
              <n-text size="sm" muted>A short description of the product.</n-text>
            </section>
            <footer>
              <n-button variant="primary" intent="accent" size="sm"><span>Buy Now</span></n-button>
            </footer>
          </n-card>
        </div>
        <div class="demo-card-sm">
          <n-card>
            <div slot="media" class="demo-media demo-media-success"></div>
            <section>
              <h3 class="demo-card-title">Another Product</h3>
              <n-text size="sm" muted>Another description text.</n-text>
            </section>
          <footer>
            <n-button variant="primary" intent="accent" size="sm"><span>Buy Now</span></n-button>
            </footer>
          </n-card>
        </div>
      </n-stack>
      <pre class="code-block"><code>&lt;n-card&gt;
  &lt;div slot="media" class="media-placeholder"&gt;&lt;/div&gt;
  &lt;section&gt;
    &lt;h3&gt;Product Name&lt;/h3&gt;
    &lt;p&gt;A short description.&lt;/p&gt;
  &lt;/section&gt;
  &lt;footer&gt;
    &lt;n-button variant="primary" intent="accent" size="sm"&gt;Buy Now&lt;/n-button&gt;
  &lt;/footer&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Header with Slots ── -->

    <h2>Header with Leading & Trailing</h2>
    <n-panel bordered>
      <div class="demo-card-md">
        <n-card>
          <header>
            <nav><n-badge intent="accent">New</n-badge></nav>
          <span>Card with Actions</span>
          <aside><n-button variant="ghost"><n-icon name="dots-three"></n-icon></n-button></aside>
        </header>
        <section>
          <n-text>The header uses a 3-column grid: leading / label / trailing. The card adds contextual divider borders automatically.</n-text>
        </section>
        <footer justify="spread">
          <n-button variant="ghost"><span>Cancel</span></n-button>
          <n-button variant="primary" intent="accent"><span>Save</span></n-button>
        </footer>
        </n-card>
      </div>
    <pre class="code-block"><code>&lt;n-card&gt;
  &lt;header&gt;
    &lt;n-badge slot="leading" intent="accent"&gt;New&lt;/n-badge&gt;
    &lt;span slot="label"&gt;Card with Actions&lt;/span&gt;
    &lt;n-button slot="trailing" variant="ghost"&gt;...&lt;/n-button&gt;
  &lt;/header&gt;
  &lt;section&gt;...&lt;/section&gt;
  &lt;footer justify="spread"&gt;
    &lt;n-button variant="ghost"&gt;Cancel&lt;/n-button&gt;
    &lt;n-button variant="primary" intent="accent"&gt;Save&lt;/n-button&gt;
  &lt;/footer&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Interactive ── -->

    <h2>Interactive</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <div class="demo-card-xs">
          <n-card interactive>
            <section><n-text>Click this card. It has hover and focus states.</n-text></section>
          </n-card>
        </div>
        <div class="demo-card-xs">
          <n-card interactive>
            <section><n-text>Another interactive card. Tab to focus.</n-text></section>
          </n-card>
        </div>
      </n-stack>
      <pre class="code-block"><code>&lt;n-card interactive&gt;
  &lt;section&gt;&lt;p&gt;Click this card. It has hover and focus states.&lt;/p&gt;&lt;/section&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sizes ── -->

    <h2>Sizes (inherit from parent)</h2>
    <n-panel bordered>
      <h3>size="sm"</h3>
      <div class="demo-card-narrow">
        <n-card size="sm">
          <header><span>Small Card</span></header>
          <section><n-text>Compact padding.</n-text></section>
        </n-card>
      </div>
      <h3>size="lg"</h3>
      <div class="demo-card-narrow">
        <n-card size="lg">
          <header><span>Large Card</span></header>
          <section><n-text>Spacious padding.</n-text></section>
        </n-card>
      </div>
    <pre class="code-block"><code>&lt;n-card size="sm"&gt;
  &lt;header&gt;&lt;span slot="label"&gt;Small Card&lt;/span&gt;&lt;/header&gt;
  &lt;section&gt;&lt;p&gt;Compact padding.&lt;/p&gt;&lt;/section&gt;
&lt;/n-card&gt;

&lt;n-card size="lg"&gt;
  &lt;header&gt;&lt;span slot="label"&gt;Large Card&lt;/span&gt;&lt;/header&gt;
  &lt;section&gt;&lt;p&gt;Spacious padding.&lt;/p&gt;&lt;/section&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Grid Composition ── -->

    <h2>Grid Composition</h2>
    <n-panel bordered>
      <n-grid cols="3" gap="4">
        <n-card>
          <header><span>Revenue</span></header>
          <section><span class="stat-value">$45,231</span></section>
        </n-card>
        <n-card>
          <header><span>Users</span></header>
          <section><span class="stat-value">2,350</span></section>
        </n-card>
        <n-card>
          <header><span>Conversion</span></header>
          <section><span class="stat-value">3.2%</span></section>
        </n-card>
      </n-grid>
    <pre class="code-block"><code>&lt;n-grid cols="3" gap="4"&gt;
  &lt;n-card&gt;
    &lt;header&gt;&lt;span slot="label"&gt;Revenue&lt;/span&gt;&lt;/header&gt;
    &lt;section&gt;&lt;p&gt;$45,231&lt;/p&gt;&lt;/section&gt;
  &lt;/n-card&gt;
  &lt;n-card&gt;...&lt;/n-card&gt;
  &lt;n-card&gt;...&lt;/n-card&gt;
&lt;/n-grid&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>
  </section>

  <style is:global>
    .demo-card { max-width: 24rem; }
    .demo-card-sm { max-width: 18rem; }
    .demo-card-md { max-width: 28rem; }
    .demo-card-xs { max-width: 16rem; }
    .demo-card-narrow { max-width: 20rem; }
    .demo-media { height: 10rem; }
    .demo-media-accent { background: linear-gradient(135deg, var(--n-surface-accent), var(--n-surface-info)); }
    .demo-media-success { background: linear-gradient(135deg, var(--n-surface-success), var(--n-surface-warning)); }
    .demo-card-title { margin: 0 0 0.25rem; text-transform: none; letter-spacing: 0; color: inherit; }
    .stat-value { font-size: 1.5rem; font-weight: 700; }
  </style>
</SidebarLayout>
