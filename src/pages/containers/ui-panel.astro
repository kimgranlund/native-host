---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Panel">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Panel</h1>
      </div>
    </div>
    <div data-slot="description">
      <span class="header-tag">&lt;n-panel&gt;</span> Section surface for sidebars, toolbars, and content areas. Less bounded than card. CSS-only container.
          </div>
  </header>

  <main>

    <!-- ── Basic ── -->

    <h2>Basic</h2>
    <n-panel bordered>
      <n-panel>
        <n-text>A basic panel with default padding and panel-elevation background.</n-text>
      </n-panel>
    <pre class="layout-code"><code>&lt;n-panel&gt;
  &lt;p&gt;A basic panel with default padding and panel-elevation background.&lt;/p&gt;
&lt;/n-panel&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Bordered ── -->

    <h2>Bordered</h2>
    <n-panel bordered>
      <n-panel bordered>
        <n-text>A panel with a visible border.</n-text>
      </n-panel>
    <pre class="layout-code"><code>&lt;n-panel bordered&gt;
  &lt;p&gt;A panel with a visible border.&lt;/p&gt;
&lt;/n-panel&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sidebar Layout ── -->

    <h2>Sidebar Layout</h2>
    <n-panel bordered>
      <n-stack direction="row" gap="3" class="sidebar-demo">
        <div class="sidebar-panel-wrapper">
          <n-panel bordered>
            <n-stack gap="1" align="stretch">
              <n-button variant="ghost" justify="spread"><n-icon name="house" slot="leading"></n-icon><span>Dashboard</span></n-button>
              <n-button variant="ghost" justify="spread"><n-icon name="folder" slot="leading"></n-icon><span>Projects</span></n-button>
              <n-button variant="ghost" justify="spread"><n-icon name="gear" slot="leading"></n-icon><span>Settings</span></n-button>
            </n-stack>
          </n-panel>
        </div>
        <div class="content-area">
          <n-text size="sm" muted>Main content area. The panel serves as a sidebar surface.</n-text>
        </div>
      </n-stack>
      <pre class="layout-code"><code>&lt;n-panel bordered&gt;
  &lt;n-stack gap="1"&gt;
    &lt;n-button variant="ghost" justify="spread"&gt;
      &lt;n-icon name="house" slot="leading"&gt;&lt;/n-icon&gt;
      &lt;span slot="label"&gt;Dashboard&lt;/span&gt;
    &lt;/n-button&gt;
    &lt;n-button variant="ghost" justify="spread"&gt;...&lt;/n-button&gt;
  &lt;/n-stack&gt;
&lt;/n-panel&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-panel bordered>
      <n-stack gap="4">
        <n-panel bordered size="sm">
          <n-text size="sm">Small panel — compact padding</n-text>
        </n-panel>
        <n-panel bordered size="lg">
          <n-text>Large panel — spacious padding</n-text>
        </n-panel>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-panel bordered size="sm"&gt;
  &lt;p&gt;Small panel&lt;/p&gt;
&lt;/n-panel&gt;

&lt;n-panel bordered size="lg"&gt;
  &lt;p&gt;Large panel&lt;/p&gt;
&lt;/n-panel&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── No Padding ── -->

    <h2>No Padding</h2>
    <n-panel bordered>
      <n-panel bordered padded="false">
        <n-text>This panel has <code>padded="false"</code> — no internal padding. Content touches the edges.</n-text>
      </n-panel>
    <pre class="layout-code"><code>&lt;n-panel bordered padded="false"&gt;
  &lt;p&gt;No internal padding. Content touches the edges.&lt;/p&gt;
&lt;/n-panel&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>
  </main>

  <style is:global>
    .sidebar-demo {
      height: 16rem;
    }

    .sidebar-panel-wrapper {
      width: 14rem;
      flex-shrink: 0;
    }

    .content-area {
      flex: 1;
      padding: 1rem;
    }

    /* ── Code Blocks ── */
</style>

</SidebarLayout>
