---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Divider">
  <main>
<h1>&lt;n-divider&gt;</h1>
    <n-text size="md" muted spacing="relaxed">
      Horizontal or vertical rule between content sections. CSS-only container.
    </n-text>

    <!-- ── Basic ── -->

    <h2>Horizontal (default)</h2>
    <n-panel bordered>
      <p>Content above the divider.</p>
      <n-divider></n-divider>
      <p>Content below the divider.</p>
    <pre class="layout-code"><code>&lt;p&gt;Content above the divider.&lt;/p&gt;
&lt;n-divider&gt;&lt;/n-divider&gt;
&lt;p&gt;Content below the divider.&lt;/p&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── With Label ── -->

    <h2>With Label</h2>
    <n-panel bordered>
      <p>Sign in with your account.</p>
      <n-divider>or</n-divider>
      <p>Continue as guest.</p>
    </n-panel>

    <n-panel bordered>
      <n-divider>or continue with</n-divider>
    <pre class="layout-code"><code>&lt;n-divider&gt;or&lt;/n-divider&gt;

&lt;n-divider&gt;or continue with&lt;/n-divider&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Vertical ── -->

    <h2>Vertical</h2>
    <n-panel bordered>
      <div class="vertical-container">
        <span>Left</span>
        <n-divider orientation="vertical"></n-divider>
        <span>Right</span>
      </div>
    </n-panel>

    <n-panel bordered>
      <div class="vertical-container">
        <span>One</span>
        <n-divider orientation="vertical"></n-divider>
        <span>Two</span>
        <n-divider orientation="vertical"></n-divider>
        <span>Three</span>
      </div>
      <pre class="layout-code"><code>&lt;div style="display: flex; align-items: center; gap: 1rem; height: 4rem;"&gt;
  &lt;span&gt;Left&lt;/span&gt;
  &lt;n-divider orientation="vertical"&gt;&lt;/n-divider&gt;
  &lt;span&gt;Right&lt;/span&gt;
&lt;/div&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Vertical With Label ── -->

    <h2>Vertical With Label</h2>
    <n-panel bordered>
      <div class="vertical-container" style="height: 6rem;">
        <span>Left</span>
        <n-divider orientation="vertical">or</n-divider>
        <span>Right</span>
      </div>
      <pre class="layout-code"><code>&lt;n-divider orientation="vertical"&gt;or&lt;/n-divider&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sizes ── -->

    <h2>Sizes (inherit from parent)</h2>
    <n-panel bordered>
      <h3>size="xs"</h3>
      <div size="xs">
        <n-divider>xs label</n-divider>
      </div>
      <h3>size="sm"</h3>
      <div size="sm">
        <n-divider>sm label</n-divider>
      </div>
      <h3>size="md"</h3>
      <div size="md">
        <n-divider>md label</n-divider>
      </div>
      <h3>size="lg"</h3>
      <div size="lg">
        <n-divider>lg label</n-divider>
      </div>
      <h3>size="xl"</h3>
      <div size="xl">
        <n-divider>xl label</n-divider>
      </div>
      <pre class="layout-code"><code>&lt;div size="sm"&gt;
  &lt;n-divider&gt;sm label&lt;/n-divider&gt;
&lt;/div&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Composition ── -->

    <h2>Composition (with buttons)</h2>
    <n-panel bordered>
      <n-button class="full-width" variant="primary" intent="accent"><span slot="label">Sign In</span></n-button>
      <n-divider>or continue with</n-divider>
      <n-stack direction="row">
        <n-button class="flex-fill"><n-icon name="google-logo" slot="leading"></n-icon><span slot="label">Google</span></n-button>
        <n-button class="flex-fill"><n-icon name="github-logo" slot="leading"></n-icon><span slot="label">GitHub</span></n-button>
      </n-stack>
      <pre class="layout-code"><code>&lt;n-button variant="primary" intent="accent" style="width: 100%;"&gt;Sign In&lt;/n-button&gt;
&lt;n-divider&gt;or continue with&lt;/n-divider&gt;
&lt;div style="display: flex; gap: 0.5rem;"&gt;
  &lt;n-button style="flex: 1;"&gt;Google&lt;/n-button&gt;
  &lt;n-button style="flex: 1;"&gt;GitHub&lt;/n-button&gt;
&lt;/div&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>
  </main>

  <style is:global>
    .vertical-container {
      display: flex;
      align-items: center;
      gap: 1rem;
      height: 4rem;
    }

    .full-width { width: 100%; }
    .flex-fill { flex: 1; }

    /* ── Code Blocks ── */
</style>

</SidebarLayout>
