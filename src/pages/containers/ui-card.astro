---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Card">
  <main>
<h1>&lt;n-card&gt;</h1>
    <n-text size="md" muted spacing="relaxed">
      Bounded content surface with optional header, body, and footer.
    </n-text>

    <!-- ── Simple ── -->

    <h2>Simple</h2>
    <n-panel bordered>
      <div class="demo-card">
        <n-card>
          <p>A simple card with just body content. No header or footer.</p>
        </n-card>
      </div>
    <pre class="layout-code"><code>&lt;n-card&gt;
  &lt;p&gt;A simple card with just body content.&lt;/p&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Structured ── -->

    <h2>Structured (header + body + footer)</h2>
    <n-panel bordered>
      <div class="demo-card">
        <n-card>
          <n-header>
            <span slot="label">Card Title</span>
            <n-button slot="trailing" variant="ghost"><n-icon name="dots-three"></n-icon></n-button>
          </n-header>
          <n-body>
            <p style="margin: 0;">Card body content goes here. This demonstrates the structured layout with header, body, and footer sections.</p>
          </n-body>
        <n-footer>
          <n-button variant="ghost"><span slot="label">Cancel</span></n-button>
          <n-button variant="primary" intent="accent"><span slot="label">Save</span></n-button>
        </n-footer>
        </n-card>
      </div>
    <pre class="layout-code"><code>&lt;n-card&gt;
  &lt;n-header&gt;
    &lt;span slot="label"&gt;Card Title&lt;/span&gt;
    &lt;n-button slot="trailing" variant="ghost"&gt;...&lt;/n-button&gt;
  &lt;/n-header&gt;
  &lt;n-body&gt;
    &lt;p&gt;Card body content goes here.&lt;/p&gt;
  &lt;/n-body&gt;
  &lt;n-footer&gt;
    &lt;n-button variant="ghost"&gt;Cancel&lt;/n-button&gt;
    &lt;n-button variant="primary" intent="accent"&gt;Save&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Media ── -->

    <h2>With Media</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <div class="demo-card-sm">
          <n-card>
            <div slot="media" class="demo-media demo-media-accent"></div>
            <n-body>
              <h3 class="demo-card-title">Product Name</h3>
              <n-text size="sm" muted>A short description of the product.</n-text>
            </n-body>
            <n-footer>
              <n-button variant="primary" intent="accent" size="sm"><span slot="label">Buy Now</span></n-button>
            </n-footer>
          </n-card>
        </div>
        <div class="demo-card-sm">
          <n-card>
            <div slot="media" class="demo-media demo-media-success"></div>
            <n-body>
              <h3 class="demo-card-title">Another Product</h3>
              <n-text size="sm" muted>Another description text.</n-text>
            </n-body>
          <n-footer>
            <n-button variant="primary" intent="accent" size="sm"><span slot="label">Buy Now</span></n-button>
            </n-footer>
          </n-card>
        </div>
      </n-stack>
      <pre class="layout-code"><code>&lt;n-card&gt;
  &lt;div slot="media" class="media-placeholder"&gt;&lt;/div&gt;
  &lt;n-body&gt;
    &lt;h3&gt;Product Name&lt;/h3&gt;
    &lt;p&gt;A short description.&lt;/p&gt;
  &lt;/n-body&gt;
  &lt;n-footer&gt;
    &lt;n-button variant="primary" intent="accent" size="sm"&gt;Buy Now&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Header with Slots ── -->

    <h2>Header with Leading & Trailing</h2>
    <n-panel bordered>
      <div class="demo-card-md">
        <n-card>
          <n-header>
            <n-badge slot="leading" intent="accent">New</n-badge>
          <span slot="label">Card with Actions</span>
          <n-button slot="trailing" variant="ghost"><n-icon name="dots-three"></n-icon></n-button>
        </n-header>
        <n-body>
          <p style="margin: 0;">The header uses a 3-column grid: leading / label / trailing. The card adds contextual divider borders automatically.</p>
        </n-body>
        <n-footer justify="spread">
          <n-button variant="ghost"><span slot="label">Cancel</span></n-button>
          <n-button variant="primary" intent="accent"><span slot="label">Save</span></n-button>
        </n-footer>
        </n-card>
      </div>
    <pre class="layout-code"><code>&lt;n-card&gt;
  &lt;n-header&gt;
    &lt;n-badge slot="leading" intent="accent"&gt;New&lt;/n-badge&gt;
    &lt;span slot="label"&gt;Card with Actions&lt;/span&gt;
    &lt;n-button slot="trailing" variant="ghost"&gt;...&lt;/n-button&gt;
  &lt;/n-header&gt;
  &lt;n-body&gt;...&lt;/n-body&gt;
  &lt;n-footer justify="spread"&gt;
    &lt;n-button variant="ghost"&gt;Cancel&lt;/n-button&gt;
    &lt;n-button variant="primary" intent="accent"&gt;Save&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Interactive ── -->

    <h2>Interactive</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <div class="demo-card-xs">
          <n-card interactive>
            <p style="margin: 0;">Click this card. It has hover and focus states.</p>
          </n-card>
        </div>
        <div class="demo-card-xs">
          <n-card interactive>
            <p style="margin: 0;">Another interactive card. Tab to focus.</p>
          </n-card>
        </div>
      </n-stack>
      <pre class="layout-code"><code>&lt;n-card interactive&gt;
  &lt;p&gt;Click this card. It has hover and focus states.&lt;/p&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sizes ── -->

    <h2>Sizes (inherit from parent)</h2>
    <n-panel bordered>
      <h3>size="sm"</h3>
      <div class="demo-card-narrow">
        <n-card size="sm">
          <n-header><span slot="label">Small Card</span></n-header>
          <n-body><p style="margin: 0;">Compact padding.</p></n-body>
        </n-card>
      </div>
      <h3>size="lg"</h3>
      <div class="demo-card-narrow">
        <n-card size="lg">
          <n-header><span slot="label">Large Card</span></n-header>
          <n-body><p style="margin: 0;">Spacious padding.</p></n-body>
        </n-card>
      </div>
    <pre class="layout-code"><code>&lt;n-card size="sm"&gt;
  &lt;n-header&gt;&lt;span slot="label"&gt;Small Card&lt;/span&gt;&lt;/n-header&gt;
  &lt;n-body&gt;&lt;p&gt;Compact padding.&lt;/p&gt;&lt;/n-body&gt;
&lt;/n-card&gt;

&lt;n-card size="lg"&gt;
  &lt;n-header&gt;&lt;span slot="label"&gt;Large Card&lt;/span&gt;&lt;/n-header&gt;
  &lt;n-body&gt;&lt;p&gt;Spacious padding.&lt;/p&gt;&lt;/n-body&gt;
&lt;/n-card&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Grid Composition ── -->

    <h2>Grid Composition</h2>
    <n-panel bordered>
      <n-grid cols="3" gap="4">
        <n-card>
          <n-header><span slot="label">Revenue</span></n-header>
          <n-body><p style="margin: 0; font-size: 1.5rem; font-weight: 700;">$45,231</p></n-body>
        </n-card>
        <n-card>
          <n-header><span slot="label">Users</span></n-header>
          <n-body><p style="margin: 0; font-size: 1.5rem; font-weight: 700;">2,350</p></n-body>
        </n-card>
        <n-card>
          <n-header><span slot="label">Conversion</span></n-header>
          <n-body><p style="margin: 0; font-size: 1.5rem; font-weight: 700;">3.2%</p></n-body>
        </n-card>
      </n-grid>
    <pre class="layout-code"><code>&lt;n-grid cols="3" gap="4"&gt;
  &lt;n-card&gt;
    &lt;n-header&gt;&lt;span slot="label"&gt;Revenue&lt;/span&gt;&lt;/n-header&gt;
    &lt;n-body&gt;&lt;p&gt;$45,231&lt;/p&gt;&lt;/n-body&gt;
  &lt;/n-card&gt;
  &lt;n-card&gt;...&lt;/n-card&gt;
  &lt;n-card&gt;...&lt;/n-card&gt;
&lt;/n-grid&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>
  </main>

  <style is:global>
    .demo-card { max-width: 24rem; }
    .demo-card-sm { max-width: 18rem; }
    .demo-card-md { max-width: 28rem; }
    .demo-card-xs { max-width: 16rem; }
    .demo-card-narrow { max-width: 20rem; }
    .demo-media { height: 10rem; }
    .demo-media-accent { background: linear-gradient(135deg, var(--n-surface-accent), var(--n-surface-info)); }
    .demo-media-success { background: linear-gradient(135deg, var(--n-surface-success), var(--n-surface-warning)); }
    .demo-card-title { margin: 0 0 0.25rem; text-transform: none; letter-spacing: 0; color: inherit; }
  </style>
</SidebarLayout>
