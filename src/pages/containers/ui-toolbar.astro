---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Toolbar">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Toolbar</h1>
      </div>
    </div>
    <div data-slot="description">
      <span class="header-tag">&lt;n-toolbar&gt;</span> Action bar for grouping related controls. Supports horizontal and vertical orientation with role="toolbar" and roving keyboard focus.
          </div>
  </header>

  <main>

    <!-- ── Text Formatting ── -->

    <h2>Text Formatting</h2>
    <n-panel bordered>
      <n-toolbar aria-label="Text formatting">
        <n-button variant="ghost"><n-icon name="text-b"></n-icon></n-button>
        <n-button variant="ghost"><n-icon name="text-italic"></n-icon></n-button>
        <n-button variant="ghost"><n-icon name="text-underline"></n-icon></n-button>
        <n-button variant="ghost"><n-icon name="text-strikethrough"></n-icon></n-button>
        <n-divider orientation="vertical"></n-divider>
        <n-button variant="ghost"><n-icon name="text-align-left"></n-icon></n-button>
        <n-button variant="ghost"><n-icon name="text-align-center"></n-icon></n-button>
        <n-button variant="ghost"><n-icon name="text-align-right"></n-icon></n-button>
        <n-divider orientation="vertical"></n-divider>
        <n-button variant="ghost"><n-icon name="list-bullets"></n-icon></n-button>
        <n-button variant="ghost"><n-icon name="list-numbers"></n-icon></n-button>
      </n-toolbar>
      <div class="editor-area">The quick brown fox jumps over the lazy dog.</div>
    <pre class="layout-code"><code>&lt;n-toolbar aria-label="Text formatting"&gt;
  &lt;n-button variant="ghost"&gt;&lt;n-icon name="text-b"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
  &lt;n-button variant="ghost"&gt;&lt;n-icon name="text-italic"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
  &lt;n-divider orientation="vertical"&gt;&lt;/n-divider&gt;
  &lt;n-button variant="ghost"&gt;&lt;n-icon name="text-align-left"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
&lt;/n-toolbar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Document Actions ── -->

    <h2>Document Actions</h2>
    <n-panel bordered>
      <n-toolbar aria-label="Document actions">
        <n-button variant="ghost"><n-icon name="floppy-disk" slot="leading"></n-icon><span slot="label">Save</span></n-button>
        <n-button variant="ghost"><n-icon name="download" slot="leading"></n-icon><span slot="label">Export</span></n-button>
        <n-button variant="ghost"><n-icon name="printer" slot="leading"></n-icon><span slot="label">Print</span></n-button>
        <n-divider orientation="vertical"></n-divider>
        <n-button variant="ghost"><n-icon name="arrow-counter-clockwise" slot="leading"></n-icon><span slot="label">Undo</span></n-button>
        <n-button variant="ghost"><n-icon name="arrow-clockwise" slot="leading"></n-icon><span slot="label">Redo</span></n-button>
      </n-toolbar>
    <pre class="layout-code"><code>&lt;n-toolbar aria-label="Document actions"&gt;
  &lt;n-button variant="ghost"&gt;
    &lt;n-icon name="floppy-disk" slot="leading"&gt;&lt;/n-icon&gt;
    &lt;span slot="label"&gt;Save&lt;/span&gt;
  &lt;/n-button&gt;
  &lt;n-divider orientation="vertical"&gt;&lt;/n-divider&gt;
  &lt;n-button variant="ghost"&gt;
    &lt;n-icon name="arrow-counter-clockwise" slot="leading"&gt;&lt;/n-icon&gt;
    &lt;span slot="label"&gt;Undo&lt;/span&gt;
  &lt;/n-button&gt;
&lt;/n-toolbar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Media Controls ── -->

    <h2>Media Controls</h2>
    <n-panel bordered>
      <n-toolbar aria-label="Media playback">
        <n-button variant="ghost"><n-icon name="skip-back"></n-icon></n-button>
        <n-button variant="ghost"><n-icon name="play"></n-icon></n-button>
        <n-button variant="ghost"><n-icon name="skip-forward"></n-icon></n-button>
        <n-divider orientation="vertical"></n-divider>
        <n-button variant="ghost"><n-icon name="speaker-high"></n-icon></n-button>
        <n-button variant="ghost"><n-icon name="shuffle"></n-icon></n-button>
        <n-button variant="ghost"><n-icon name="repeat"></n-icon></n-button>
      </n-toolbar>
    <pre class="layout-code"><code>&lt;n-toolbar aria-label="Media playback"&gt;
  &lt;n-button variant="ghost"&gt;&lt;n-icon name="skip-back"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
  &lt;n-button variant="ghost"&gt;&lt;n-icon name="play"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
  &lt;n-button variant="ghost"&gt;&lt;n-icon name="skip-forward"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
  &lt;n-divider orientation="vertical"&gt;&lt;/n-divider&gt;
  &lt;n-button variant="ghost"&gt;&lt;n-icon name="speaker-high"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
&lt;/n-toolbar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-panel bordered>
      <n-stack gap="4">
        <n-toolbar aria-label="Small toolbar" size="sm">
          <n-button variant="ghost"><n-icon name="magnifying-glass"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="funnel"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="sort-ascending"></n-icon></n-button>
        </n-toolbar>
        <n-toolbar aria-label="Default toolbar">
          <n-button variant="ghost"><n-icon name="magnifying-glass"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="funnel"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="sort-ascending"></n-icon></n-button>
        </n-toolbar>
        <n-toolbar aria-label="Large toolbar" size="lg">
          <n-button variant="ghost"><n-icon name="magnifying-glass"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="funnel"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="sort-ascending"></n-icon></n-button>
        </n-toolbar>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-toolbar aria-label="Small" size="sm"&gt;...&lt;/n-toolbar&gt;
&lt;n-toolbar aria-label="Default"&gt;...&lt;/n-toolbar&gt;
&lt;n-toolbar aria-label="Large" size="lg"&gt;...&lt;/n-toolbar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Density ── -->

    <h2>Density</h2>
    <n-panel bordered>
      <n-stack gap="4">
        <n-toolbar aria-label="Compact" density="compact">
          <n-button variant="ghost"><n-icon name="copy"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="scissors"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="clipboard"></n-icon></n-button>
        </n-toolbar>
        <n-toolbar aria-label="Default density">
          <n-button variant="ghost"><n-icon name="copy"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="scissors"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="clipboard"></n-icon></n-button>
        </n-toolbar>
        <n-toolbar aria-label="Loose" density="loose">
          <n-button variant="ghost"><n-icon name="copy"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="scissors"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="clipboard"></n-icon></n-button>
        </n-toolbar>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-toolbar density="compact"&gt;...&lt;/n-toolbar&gt;
&lt;n-toolbar&gt;...&lt;/n-toolbar&gt;
&lt;n-toolbar density="loose"&gt;...&lt;/n-toolbar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Plain Variant ── -->

    <h2>Plain Variant</h2>
    <n-panel bordered>
      <n-text size="xs" muted class="layout-hint">
        <code>variant="plain"</code> strips background, border, and radius so the toolbar can embed inside containers like <code>&lt;n-card&gt;</code> headers without doubling chrome.
      </n-text>
      <n-stack gap="4">
        <n-toolbar aria-label="Default toolbar">
          <n-button variant="ghost"><n-icon name="text-b"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="text-italic"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="text-underline"></n-icon></n-button>
        </n-toolbar>
        <n-toolbar variant="plain" aria-label="Plain toolbar">
          <n-button variant="ghost"><n-icon name="text-b"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="text-italic"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="text-underline"></n-icon></n-button>
        </n-toolbar>
      </n-stack>
    <pre class="layout-code"><code>&lt;!-- Default: panel background + border + radius --&gt;
&lt;n-toolbar&gt;...&lt;/n-toolbar&gt;

&lt;!-- Plain: transparent, no border, no radius --&gt;
&lt;n-toolbar variant="plain"&gt;...&lt;/n-toolbar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Orientation ── -->

    <h2>Orientation</h2>
    <n-panel bordered>
      <n-text size="xs" muted class="layout-hint">
        <code>orientation</code> controls layout direction and keyboard navigation. Arrow keys follow the orientation: Left/Right for horizontal, Up/Down for vertical.
      </n-text>
      <div class="orientation-demo">
        <div>
          <n-text size="xs" muted class="layout-hint">Horizontal (default)</n-text>
          <n-toolbar aria-label="Horizontal toolbar">
            <n-button variant="ghost"><n-icon name="text-b"></n-icon></n-button>
            <n-button variant="ghost"><n-icon name="text-italic"></n-icon></n-button>
            <n-button variant="ghost"><n-icon name="text-underline"></n-icon></n-button>
          </n-toolbar>
        </div>
        <div>
          <n-text size="xs" muted class="layout-hint">Vertical</n-text>
          <n-toolbar orientation="vertical" aria-label="Vertical toolbar">
            <n-button variant="ghost"><n-icon name="text-b"></n-icon></n-button>
            <n-button variant="ghost"><n-icon name="text-italic"></n-icon></n-button>
            <n-button variant="ghost"><n-icon name="text-underline"></n-icon></n-button>
          </n-toolbar>
        </div>
      </div>
    <pre class="layout-code"><code>&lt;n-toolbar orientation="vertical" aria-label="Vertical toolbar"&gt;
  &lt;n-button variant="ghost"&gt;&lt;n-icon name="text-b"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
  &lt;n-button variant="ghost"&gt;&lt;n-icon name="text-italic"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
  &lt;n-button variant="ghost"&gt;&lt;n-icon name="text-underline"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
&lt;/n-toolbar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Fill Mode ── -->

    <h2>Fill Mode</h2>
    <n-panel bordered>
      <n-text size="xs" muted class="layout-hint">
        <code>[fill]</code> distributes available space evenly across items. Default is compact (intrinsic width).
      </n-text>
      <n-stack gap="4">
        <n-toolbar aria-label="Compact toolbar (default)">
          <n-button variant="ghost"><n-icon name="floppy-disk" slot="leading"></n-icon><span slot="label">Save</span></n-button>
          <n-button variant="ghost"><n-icon name="download" slot="leading"></n-icon><span slot="label">Export</span></n-button>
          <n-button variant="ghost"><n-icon name="printer" slot="leading"></n-icon><span slot="label">Print</span></n-button>
        </n-toolbar>
        <n-toolbar fill aria-label="Fill toolbar">
          <n-button variant="ghost"><n-icon name="floppy-disk" slot="leading"></n-icon><span slot="label">Save</span></n-button>
          <n-button variant="ghost"><n-icon name="download" slot="leading"></n-icon><span slot="label">Export</span></n-button>
          <n-button variant="ghost"><n-icon name="printer" slot="leading"></n-icon><span slot="label">Print</span></n-button>
        </n-toolbar>
      </n-stack>
    <pre class="layout-code"><code>&lt;!-- Default: intrinsic width --&gt;
&lt;n-toolbar&gt;...&lt;/n-toolbar&gt;

&lt;!-- Fill: items grow to distribute space --&gt;
&lt;n-toolbar fill&gt;...&lt;/n-toolbar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Responsive Overflow ── -->

    <h2>Responsive Overflow</h2>
    <n-panel bordered>
      <n-text size="xs" muted class="layout-hint">
        Resize the container to see items collapse into a &bull;&bull;&bull; overflow menu.
      </n-text>
      <div style="resize: horizontal; overflow: hidden; border: 1px dashed var(--n-border-muted-neutral); padding: 0.5rem; min-width: 120px; max-width: 100%;">
        <n-toolbar aria-label="Overflow demo">
          <n-button variant="ghost"><n-icon name="text-b"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="text-italic"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="text-underline"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="text-strikethrough"></n-icon></n-button>
          <n-divider orientation="vertical"></n-divider>
          <n-button variant="ghost"><n-icon name="text-align-left"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="text-align-center"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="text-align-right"></n-icon></n-button>
          <n-divider orientation="vertical"></n-divider>
          <n-button variant="ghost"><n-icon name="list-bullets"></n-icon></n-button>
          <n-button variant="ghost"><n-icon name="list-numbers"></n-icon></n-button>
          <n-divider orientation="vertical"></n-divider>
          <n-button variant="ghost"><n-icon name="floppy-disk" slot="leading"></n-icon><span slot="label">Save</span></n-button>
          <n-button variant="ghost"><n-icon name="download" slot="leading"></n-icon><span slot="label">Export</span></n-button>
          <n-button variant="ghost"><n-icon name="printer" slot="leading"></n-icon><span slot="label">Print</span></n-button>
        </n-toolbar>
      </div>
    <pre class="layout-code"><code>&lt;!-- Resize the container to trigger overflow --&gt;
&lt;div style="resize: horizontal; overflow: hidden; width: 400px;"&gt;
  &lt;n-toolbar aria-label="Overflow demo"&gt;
    &lt;n-button variant="ghost"&gt;&lt;n-icon name="text-b"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
    &lt;n-button variant="ghost"&gt;&lt;n-icon name="text-italic"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
    &lt;!-- ... more items ... --&gt;
  &lt;/n-toolbar&gt;
&lt;/div&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Grouped Overflow ── -->

    <h2>Grouped Overflow</h2>
    <n-panel bordered>
      <n-text size="xs" muted class="layout-hint">
        <code>&lt;n-toolbar-group&gt;</code> keeps related actions together — the entire group overflows as one unit instead of splitting.
      </n-text>
      <div style="resize: horizontal; overflow: hidden; border: 1px dashed var(--n-border-muted-neutral); padding: 0.5rem; min-width: 120px; max-width: 100%;">
        <n-toolbar aria-label="Grouped overflow demo">
          <n-toolbar-group>
            <n-button variant="ghost"><n-icon name="text-b"></n-icon></n-button>
            <n-button variant="ghost"><n-icon name="text-italic"></n-icon></n-button>
            <n-button variant="ghost"><n-icon name="text-underline"></n-icon></n-button>
            <n-button variant="ghost"><n-icon name="text-strikethrough"></n-icon></n-button>
          </n-toolbar-group>
          <n-divider orientation="vertical"></n-divider>
          <n-toolbar-group>
            <n-button variant="ghost"><n-icon name="text-align-left"></n-icon></n-button>
            <n-button variant="ghost"><n-icon name="text-align-center"></n-icon></n-button>
            <n-button variant="ghost"><n-icon name="text-align-right"></n-icon></n-button>
          </n-toolbar-group>
          <n-divider orientation="vertical"></n-divider>
          <n-toolbar-group>
            <n-button variant="ghost"><n-icon name="list-bullets"></n-icon></n-button>
            <n-button variant="ghost"><n-icon name="list-numbers"></n-icon></n-button>
          </n-toolbar-group>
          <n-divider orientation="vertical"></n-divider>
          <n-toolbar-group>
            <n-button variant="ghost"><n-icon name="floppy-disk" slot="leading"></n-icon><span slot="label">Save</span></n-button>
            <n-button variant="ghost"><n-icon name="download" slot="leading"></n-icon><span slot="label">Export</span></n-button>
            <n-button variant="ghost"><n-icon name="printer" slot="leading"></n-icon><span slot="label">Print</span></n-button>
          </n-toolbar-group>
        </n-toolbar>
      </div>
    <pre class="layout-code"><code>&lt;n-toolbar aria-label="Grouped overflow"&gt;
  &lt;n-toolbar-group&gt;
    &lt;n-button variant="ghost"&gt;&lt;n-icon name="text-b"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
    &lt;n-button variant="ghost"&gt;&lt;n-icon name="text-italic"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
    &lt;n-button variant="ghost"&gt;&lt;n-icon name="text-underline"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
  &lt;/n-toolbar-group&gt;
  &lt;n-divider orientation="vertical"&gt;&lt;/n-divider&gt;
  &lt;n-toolbar-group&gt;
    &lt;n-button variant="ghost"&gt;&lt;n-icon name="text-align-left"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
    &lt;n-button variant="ghost"&gt;&lt;n-icon name="text-align-center"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
  &lt;/n-toolbar-group&gt;
&lt;/n-toolbar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>
  </main>

  <style is:global>
    .editor-area {
      margin-top: 0.75rem;
      padding: 0.75rem;
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.25rem;
      min-height: 4rem;
      font-size: 0.875rem;
      color: var(--n-ink-muted-neutral);
    }

    .orientation-demo {
      display: flex;
      gap: 2rem;
      align-items: flex-start;
    }

    /* ── Code Blocks ── */
</style>

</SidebarLayout>
