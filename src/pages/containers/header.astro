---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Header / Body / Footer">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Header / Body / Footer</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-header&gt; / &lt;n-body&gt; / &lt;n-footer&gt;</span> Composable sub-containers for structuring surfaces. Semantic HTML. Work inside n-container, n-drawer, n-container, or any flex column.
          </div>
  </header>

  <section>

    <!-- ── n-header: Basic ── -->

    <h2>n-header — Basic</h2>
    <n-container data-kind="panel" bordered>
      <div class="header-card-wrap header-card-wrap--sm">
        <n-container>
          <n-header>
            <span>Card Title</span>
          </n-header>
          <n-body>
            <span>Body content with the default padding and scrollable overflow.</span>
          </n-body>
        </n-container>
      </div>
    <pre class="code-block"><code>&lt;n-container&gt;
  &lt;n-header&gt;
    &lt;span slot="label"&gt;Card Title&lt;/span&gt;
  &lt;/n-header&gt;
  &lt;n-body&gt;
    &lt;p&gt;Body content here.&lt;/p&gt;
  &lt;/n-body&gt;
&lt;/n-container&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── n-header: With Slots ── -->

    <h2>n-header — Leading & Trailing Slots</h2>
    <n-container data-kind="panel" bordered>
      <div class="header-card-wrap header-card-wrap--md">
        <n-container>
          <n-header>
            <nav><n-badge intent="accent">New</n-badge></nav>
            <span>Card with Actions</span>
            <n-button variant="ghost"><n-icon name="dots-three"></n-icon></n-button>
          </n-header>
          <n-body>
            <span>The header uses a 3-column grid: leading / label / trailing.</span>
          </n-body>
          <n-footer>
            <n-button variant="ghost"><span>Cancel</span></n-button>
            <n-button variant="primary" intent="accent"><span>Save</span></n-button>
          </n-footer>
        </n-container>
      </div>
    <pre class="code-block"><code>&lt;n-header&gt;
  &lt;n-badge slot="leading" intent="accent"&gt;New&lt;/n-badge&gt;
  &lt;span slot="label"&gt;Card with Actions&lt;/span&gt;
  &lt;n-button slot="trailing" variant="ghost"&gt;...&lt;/n-button&gt;
&lt;/n-header&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── n-header: Align ── -->

    <h2>n-header — Align</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <div class="header-card-wrap header-card-wrap--xs">
          <n-container>
            <n-header>
              <span>Default (start)</span>
            </n-header>
            <n-body><span>Left-aligned label.</span></n-body>
          </n-container>
        </div>
        <div class="header-card-wrap header-card-wrap--xs">
          <n-container>
            <n-header align="center">
              <span>Centered</span>
            </n-header>
            <n-body><span>Center-aligned label.</span></n-body>
          </n-container>
        </div>
        <div class="header-card-wrap header-card-wrap--xs">
          <n-container>
            <n-header align="end">
              <span>End</span>
            </n-header>
            <n-body><span>End-aligned label.</span></n-body>
          </n-container>
        </div>
      </n-stack>
      <pre class="code-block"><code>&lt;n-header&gt;...&lt;/n-header&gt;
&lt;n-header align="center"&gt;...&lt;/n-header&gt;
&lt;n-header align="end"&gt;...&lt;/n-header&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── n-header: Centered with leading/trailing ── -->

    <h2>n-header — Centered with Actions</h2>
    <n-container data-kind="panel" bordered>
      <div class="header-card-wrap header-card-wrap--md">
        <n-container>
          <n-header align="center">
            <n-button slot="leading" variant="ghost"><n-icon name="caret-left"></n-icon></n-button>
            <span>Step 2 of 4</span>
            <n-button variant="ghost"><n-icon name="x"></n-icon></n-button>
          </n-header>
          <n-body>
            <span>Common pattern: back button, centered title, close button.</span>
          </n-body>
        </n-container>
      </div>
    <pre class="code-block"><code>&lt;n-header align="center"&gt;
  &lt;n-button slot="leading" variant="ghost"&gt;&lt;n-icon name="caret-left"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
  &lt;span slot="label"&gt;Step 2 of 4&lt;/span&gt;
  &lt;n-button slot="trailing" variant="ghost"&gt;&lt;n-icon name="x"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
&lt;/n-header&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── n-body: Scrollable ── -->

    <h2>n-body — Scrollable Content</h2>
    <n-container data-kind="panel" bordered>
      <div class="header-card-wrap header-card-wrap--sm header-card-wrap--h-lg">
        <n-container>
          <n-header>
            <span>Scrollable Card</span>
          </n-header>
          <n-body>
            <span>This card has a fixed height. The body scrolls independently while the header stays pinned.</span>
            <span>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</span>
            <span>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</span>
            <span>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</span>
            <span>Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</span>
          </n-body>
          <n-footer>
            <n-button variant="primary" intent="accent"><span>Done</span></n-button>
          </n-footer>
        </n-container>
      </div>
    <pre class="code-block"><code>&lt;n-container style="height: 16rem;"&gt;
  &lt;n-header&gt;&lt;span slot="label"&gt;Scrollable&lt;/span&gt;&lt;/n-header&gt;
  &lt;n-body&gt;
    &lt;p&gt;Long content that scrolls...&lt;/p&gt;
  &lt;/n-body&gt;
  &lt;n-footer&gt;
    &lt;n-button variant="primary" intent="accent"&gt;Done&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-container&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── n-body: Show Scrollbar ── -->

    <h2>n-body — Visible Scrollbar</h2>
    <n-container data-kind="panel" bordered>
      <div class="header-card-wrap header-card-wrap--sm header-card-wrap--h-md">
        <n-container>
          <n-header><span>With Scrollbar</span></n-header>
          <n-body show-scrollbar>
            <span>The <code>show-scrollbar</code> attribute reveals a thin scrollbar.</span>
            <span>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</span>
            <span>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</span>
            <span>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore.</span>
          </n-body>
        </n-container>
      </div>
    <pre class="code-block"><code>&lt;section show-scrollbar&gt;
  &lt;p&gt;Scrollable content with a visible scrollbar.&lt;/p&gt;
&lt;/n-body&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── n-footer: Justify ── -->

    <h2>n-footer — Justify Variants</h2>
    <n-container data-kind="panel" bordered>
      <n-stack gap="4">
        <div class="header-card-wrap header-card-wrap--md">
          <n-container>
            <n-header><span>End (default)</span></n-header>
            <n-body><span>Actions aligned to the right.</span></n-body>
            <n-footer>
              <n-button variant="ghost"><span>Cancel</span></n-button>
              <n-button variant="primary" intent="accent"><span>Confirm</span></n-button>
            </n-footer>
          </n-container>
        </div>
        <div class="header-card-wrap header-card-wrap--md">
          <n-container>
            <n-header><span>Spread</span></n-header>
            <n-body><span>Cancel left, Save right.</span></n-body>
            <n-footer justify="spread">
              <n-button variant="ghost"><span>Cancel</span></n-button>
              <n-button variant="primary" intent="accent"><span>Save</span></n-button>
            </n-footer>
          </n-container>
        </div>
        <div class="header-card-wrap header-card-wrap--md">
          <n-container>
            <n-header><span>Start</span></n-header>
            <n-body><span>Actions aligned left.</span></n-body>
            <n-footer justify="start">
              <n-button variant="ghost"><span>Back</span></n-button>
              <n-button variant="primary" intent="accent"><span>Next</span></n-button>
            </n-footer>
          </n-container>
        </div>
        <div class="header-card-wrap header-card-wrap--md">
          <n-container>
            <n-header><span>Center</span></n-header>
            <n-body><span>Centered actions.</span></n-body>
            <n-footer justify="center">
              <n-button variant="primary" intent="accent"><span>Got it</span></n-button>
            </n-footer>
          </n-container>
        </div>
      </n-stack>
    <pre class="code-block"><code>&lt;n-footer&gt;...&lt;/n-footer&gt;                &lt;!-- end (default) --&gt;
&lt;n-footer justify="spread"&gt;...&lt;/n-footer&gt;  &lt;!-- space-between --&gt;
&lt;n-footer justify="start"&gt;...&lt;/n-footer&gt;   &lt;!-- left-aligned --&gt;
&lt;n-footer justify="center"&gt;...&lt;/n-footer&gt;  &lt;!-- centered --&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Sizes ── -->

    <h2>Sizes (inherit from parent)</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <div class="header-card-wrap header-card-wrap--xs">
          <n-container size="sm">
            <n-header><span>Small</span></n-header>
            <n-body><span>Compact padding.</span></n-body>
            <n-footer><n-button size="sm" variant="primary" intent="accent"><span>OK</span></n-button></n-footer>
          </n-container>
        </div>
        <div class="header-card-wrap header-card-wrap--xs">
          <n-container>
            <n-header><span>Medium</span></n-header>
            <n-body><span>Default padding.</span></n-body>
            <n-footer><n-button variant="primary" intent="accent"><span>OK</span></n-button></n-footer>
          </n-container>
        </div>
        <div class="header-card-wrap header-card-wrap--xs">
          <n-container size="lg">
            <n-header><span>Large</span></n-header>
            <n-body><span>Spacious padding.</span></n-body>
            <n-footer><n-button size="lg" variant="primary" intent="accent"><span>OK</span></n-button></n-footer>
          </n-container>
        </div>
      </n-stack>
      <pre class="code-block"><code>&lt;n-container size="sm"&gt;
  &lt;n-header&gt;...&lt;/n-header&gt;
  &lt;n-body&gt;...&lt;/n-body&gt;
  &lt;n-footer&gt;...&lt;/n-footer&gt;
&lt;/n-container&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── In Drawer ── -->

    <h2>Inside a Drawer</h2>
    <n-container data-kind="panel" bordered>
      <n-button id="open-drawer"><span>Open Drawer</span></n-button>
      <n-drawer id="drawer-demo">
        <n-header>
          <span>Drawer Title</span>
          <n-button variant="ghost" id="close-drawer"><n-icon name="x"></n-icon></n-button>
        </n-header>
        <n-body>
          <span>The drawer uses n-header / n-body / n-footer. The header and footer stay fixed while the body scrolls.</span>
          <span>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt.</span>
          <span>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo.</span>
          <span>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</span>
          <span>Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit.</span>
          <span>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt.</span>
          <span>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo.</span>
          <span>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</span>
        </n-body>
        <n-footer justify="spread">
          <n-button variant="ghost" id="cancel-drawer"><span>Cancel</span></n-button>
          <n-button variant="primary" intent="accent"><span>Save Changes</span></n-button>
        </n-footer>
      </n-drawer>
    <pre class="code-block"><code>&lt;n-drawer&gt;
  &lt;n-header&gt;
    &lt;span slot="label"&gt;Drawer Title&lt;/span&gt;
    &lt;n-button slot="trailing" variant="ghost"&gt;&lt;n-icon name="x"&gt;&lt;/n-icon&gt;&lt;/n-button&gt;
  &lt;/n-header&gt;
  &lt;n-body&gt;
    &lt;p&gt;Scrollable content...&lt;/p&gt;
  &lt;/n-body&gt;
  &lt;n-footer justify="spread"&gt;
    &lt;n-button variant="ghost"&gt;Cancel&lt;/n-button&gt;
    &lt;n-button variant="primary" intent="accent"&gt;Save&lt;/n-button&gt;
  &lt;/n-footer&gt;
&lt;/n-drawer&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>
  </section>

  <script>
// Drawer demo
      const drawer = document.getElementById('drawer-demo');
      document.getElementById('open-drawer').addEventListener('native:press', () => drawer.show());
      document.getElementById('close-drawer').addEventListener('native:press', () => drawer.close());
      document.getElementById('cancel-drawer').addEventListener('native:press', () => drawer.close());
  </script>
</SidebarLayout>

<style is:global>
  .header-card-wrap {
    display: contents;
  }
  .header-card-wrap > n-container {
    max-width: var(--_header-card-max-width);
    height: var(--_header-card-height, auto);
  }
  .header-card-wrap--xs { --_header-card-max-width: 18rem; }
  .header-card-wrap--sm { --_header-card-max-width: 24rem; }
  .header-card-wrap--md { --_header-card-max-width: 28rem; }
  .header-card-wrap--h-md { --_header-card-height: 14rem; }
  .header-card-wrap--h-lg { --_header-card-height: 16rem; }
</style>
