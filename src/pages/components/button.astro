  <script>
import { logPrepend } from '../../scripts/event-log';
// Press event logging
      const pressBtn = document.getElementById('press-btn');
      const pressLog = document.getElementById('press-log');
      let pressCount = 0;

      pressBtn.addEventListener('native:press', (e) => {
        pressCount++;
        logPrepend(pressLog, `#${pressCount} native:press — pointerType: ${e.detail.pointerType}`);
      });

      // Form logging
      const form = document.getElementById('demo-form');
      const formLog = document.getElementById('form-log');

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        logPrepend(formLog, `submit — value: "${new FormData(form).get('demo')}"`);
      });

      form.addEventListener('reset', () => {
        logPrepend(formLog, 'reset');
      });
  </script>

