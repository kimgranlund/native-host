---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  pressEvents: `&lt;n-button variant="primary" id="my-btn"&gt;
  &lt;span slot="label"&gt;Click me&lt;/span&gt;
&lt;/n-button&gt;

&lt;script&gt;
  document.getElementById('my-btn')
    .addEventListener('native:press', (e) =&gt; {
      console.log('pressed', e.detail.pointerType);
    });
&lt;/script&gt;`,
};
---
<SidebarLayout title="Button">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Button</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-button&gt;</span> Custom element with Pressable trait, form association, and signal-backed attributes.
          </div>
  </header>

  <section>

    <!-- ── Custom Element vs Native ── -->

    <h2>Custom Element vs Native Button</h2>
    <n-panel bordered>
      <h3>n-button (Custom Element)</h3>
      <n-stack direction="row" wrap align="center">
        <n-button variant="primary" size="sm"><span>Primary</span></n-button>
        <n-button variant="secondary" size="sm"><span>Secondary</span></n-button>
        <n-button variant="outline" size="sm"><span>Outline</span></n-button>
        <n-button variant="ghost" size="sm"><span>Ghost</span></n-button>
        <n-button variant="default" size="sm"><span>Default</span></n-button>
        <n-button variant="selected" size="sm"><span>Selected</span></n-button>
      </n-stack>

      <h3>Native button (same CSS)</h3>
      <n-stack direction="row" wrap align="center">
        <button variant="primary" size="sm"><span>Primary</span></button>
        <button variant="secondary" size="sm"><span>Secondary</span></button>
        <button variant="outline" size="sm"><span>Outline</span></button>
        <button variant="ghost" size="sm"><span>Ghost</span></button>
        <button variant="default" size="sm"><span>Default</span></button>
        <button variant="selected" size="sm"><span>Selected</span></button>
      </n-stack>
    </n-panel>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <span class="label">xs</span>
        <n-button size="xs" variant="primary"><span>Button</span></n-button>
        <n-button size="xs" variant="secondary"><span>Button</span></n-button>
        <n-button size="xs" variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">sm</span>
        <n-button size="sm" variant="primary"><span>Button</span></n-button>
        <n-button size="sm" variant="secondary"><span>Button</span></n-button>
        <n-button size="sm" variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">md</span>
        <n-button size="md" variant="primary"><span>Button</span></n-button>
        <n-button size="md" variant="secondary"><span>Button</span></n-button>
        <n-button size="md" variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">lg</span>
        <n-button size="lg" variant="primary"><span>Button</span></n-button>
        <n-button size="lg" variant="secondary"><span>Button</span></n-button>
        <n-button size="lg" variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">xl</span>
        <n-button size="xl" variant="primary"><span>Button</span></n-button>
        <n-button size="xl" variant="secondary"><span>Button</span></n-button>
        <n-button size="xl" variant="outline"><span>Button</span></n-button>
      </n-stack>
      <pre class="code-block"><code>&lt;n-button size="sm" variant="primary"&gt;
  &lt;span slot="label"&gt;Small&lt;/span&gt;
&lt;/n-button&gt;

&lt;n-button size="lg" variant="primary"&gt;
  &lt;span slot="label"&gt;Large&lt;/span&gt;
&lt;/n-button&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Intents ── -->

    <h2>Intents</h2>
    <n-panel bordered size="sm">
      <n-stack direction="row" wrap align="center">
        <n-button variant="primary" intent="neutral"><span>Neutral</span></n-button>
        <n-button variant="primary" intent="accent"><span>Accent</span></n-button>
        <n-button variant="primary" intent="info"><span>Info</span></n-button>
        <n-button variant="primary" intent="success"><span>Success</span></n-button>
        <n-button variant="primary" intent="warning"><span>Warning</span></n-button>
        <n-button variant="primary" intent="danger"><span>Danger</span></n-button>
      </n-stack>
      <pre class="code-block"><code>&lt;n-button variant="primary" intent="accent"&gt;
  &lt;span slot="label"&gt;Accent&lt;/span&gt;
&lt;/n-button&gt;

&lt;n-button variant="primary" intent="danger"&gt;
  &lt;span slot="label"&gt;Danger&lt;/span&gt;
&lt;/n-button&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Disabled ── -->

    <h2>Disabled</h2>
    <n-panel bordered size="sm">
      <n-stack direction="row" wrap align="center">
        <n-button variant="primary" disabled><span>Primary</span></n-button>
        <n-button variant="secondary" disabled><span>Secondary</span></n-button>
        <n-button variant="outline" disabled><span>Outline</span></n-button>
        <n-button variant="ghost" disabled><span>Ghost</span></n-button>
        <n-button variant="default" disabled><span>Default</span></n-button>
        <n-button variant="selected" disabled><span>Selected</span></n-button>
      </n-stack>
      <pre class="code-block"><code>&lt;n-button variant="primary" disabled&gt;
  &lt;span slot="label"&gt;Disabled&lt;/span&gt;
&lt;/n-button&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Press Events ── -->

    <h2>Press Events</h2>
    <n-panel bordered size="sm">
      <n-stack direction="row" wrap align="center">
        <n-button variant="primary" id="press-btn"><span>Click or press Enter/Space</span></n-button>
      </n-stack>
      <div class="log" id="press-log"></div>
      <pre class="code-block"><code set:html={codeExamples.pressEvents} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Form Association ── -->

    <h2>Form Association</h2>
    <n-panel bordered size="sm">
      <form id="demo-form">
        <input type="text" name="demo" value="hello" class="demo-input" />
        <n-stack direction="row" wrap align="center">
          <n-button variant="primary" type="submit"><span>Submit</span></n-button>
          <n-button variant="secondary" type="reset"><span>Reset</span></n-button>
          <n-button variant="ghost"><span>Button (no form action)</span></n-button>
        </n-stack>
      </form>
      <div class="log" id="form-log"></div>
      <pre class="code-block"><code>&lt;form&gt;
  &lt;n-button variant="primary" type="submit"&gt;
    &lt;span slot="label"&gt;Submit&lt;/span&gt;
  &lt;/n-button&gt;
  &lt;n-button variant="secondary" type="reset"&gt;
    &lt;span slot="label"&gt;Reset&lt;/span&gt;
  &lt;/n-button&gt;
&lt;/form&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Variants ── -->

    <h2>Variants</h2>
    <n-panel bordered size="sm">
      <n-stack direction="row" wrap align="center">
        <span class="label">primary</span>
        <n-button variant="primary"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">secondary</span>
        <n-button variant="secondary"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">outline</span>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">ghost</span>
        <n-button variant="ghost"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">default</span>
        <n-button variant="default"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">selected</span>
        <n-button variant="selected"><span>Button</span></n-button>
      </n-stack>
      <pre class="code-block"><code>&lt;n-button variant="primary"&gt;&lt;span slot="label"&gt;Primary&lt;/span&gt;&lt;/n-button&gt;
&lt;n-button variant="secondary"&gt;&lt;span slot="label"&gt;Secondary&lt;/span&gt;&lt;/n-button&gt;
&lt;n-button variant="outline"&gt;&lt;span slot="label"&gt;Outline&lt;/span&gt;&lt;/n-button&gt;
&lt;n-button variant="ghost"&gt;&lt;span slot="label"&gt;Ghost&lt;/span&gt;&lt;/n-button&gt;
&lt;n-button variant="default"&gt;&lt;span slot="label"&gt;Default&lt;/span&gt;&lt;/n-button&gt;
&lt;n-button variant="selected"&gt;&lt;span slot="label"&gt;Selected&lt;/span&gt;&lt;/n-button&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Density ── -->

    <h2>Density</h2>
    <n-panel bordered>
      <h3>xs</h3>
      <n-stack direction="row" wrap align="center" size="xs" density="compact">
        <span class="label">compact</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="xs" density="default">
        <span class="label">default</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="xs" density="loose">
        <span class="label">loose</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>

      <h3>sm</h3>
      <n-stack direction="row" wrap align="center" size="sm" density="compact">
        <span class="label">compact</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="sm" density="default">
        <span class="label">default</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="sm" density="loose">
        <span class="label">loose</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>

      <h3>md</h3>
      <n-stack direction="row" wrap align="center" size="md" density="compact">
        <span class="label">compact</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="md" density="default">
        <span class="label">default</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="md" density="loose">
        <span class="label">loose</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>

      <h3>lg</h3>
      <n-stack direction="row" wrap align="center" size="lg" density="compact">
        <span class="label">compact</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="lg" density="default">
        <span class="label">default</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="lg" density="loose">
        <span class="label">loose</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>

      <h3>xl</h3>
      <n-stack direction="row" wrap align="center" size="xl" density="compact">
        <span class="label">compact</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="xl" density="default">
        <span class="label">default</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="xl" density="loose">
        <span class="label">loose</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
    </n-panel>

    <!-- ── Radius ── -->

    <h2>Radius</h2>
    <n-panel bordered size="md">
      <n-stack direction="row" wrap align="center" radius="sharp">
        <span class="label">sharp</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center" radius="default">
        <span class="label">default</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center" radius="round">
        <span class="label">round</span>
        <n-button variant="primary"><span>Button</span></n-button>
        <n-button variant="secondary"><span>Button</span></n-button>
        <n-button variant="outline"><span>Button</span></n-button>
      </n-stack>
    </n-panel>

    <!-- ── Cascading ── -->

    <h2>Cascading</h2>
    <n-panel bordered>
      <h3>Parent size="md", child overrides</h3>
      <n-stack direction="row" wrap align="center" size="md" intent="accent">
        <n-button variant="primary"><span>Inherited md</span></n-button>
        <n-button variant="primary" size="xs"><span>Override xs</span></n-button>
        <n-button variant="primary" size="lg"><span>Override lg</span></n-button>
      </n-stack>

      <h3>Parent intent="accent", child overrides</h3>
      <n-stack direction="row" wrap align="center" size="sm" intent="accent">
        <n-button variant="primary"><span>Accent</span></n-button>
        <n-button variant="primary" intent="danger"><span>Danger</span></n-button>
        <n-button variant="primary" intent="success"><span>Success</span></n-button>
      </n-stack>

      <h3>Section cascading all attributes</h3>
      <section size="sm" density="compact" radius="round" intent="accent">
        <n-stack direction="row" wrap align="center">
          <n-button variant="primary"><span>All inherited</span></n-button>
          <n-button variant="secondary"><span>All inherited</span></n-button>
          <n-button variant="outline"><span>All inherited</span></n-button>
          <n-button variant="ghost"><span>All inherited</span></n-button>
        </n-stack>
      </section>
    </n-panel>

    <!-- ── Variants x Intents ── -->

    <h2>Variants x Intents</h2>
    <n-panel bordered size="sm">
      <h3>Primary</h3>
      <n-stack direction="row" wrap align="center">
        <n-button variant="primary" intent="neutral"><span>Neutral</span></n-button>
        <n-button variant="primary" intent="accent"><span>Accent</span></n-button>
        <n-button variant="primary" intent="info"><span>Info</span></n-button>
        <n-button variant="primary" intent="success"><span>Success</span></n-button>
        <n-button variant="primary" intent="warning"><span>Warning</span></n-button>
        <n-button variant="primary" intent="danger"><span>Danger</span></n-button>
      </n-stack>
      <h3>Secondary</h3>
      <n-stack direction="row" wrap align="center">
        <n-button variant="secondary" intent="neutral"><span>Neutral</span></n-button>
        <n-button variant="secondary" intent="accent"><span>Accent</span></n-button>
        <n-button variant="secondary" intent="info"><span>Info</span></n-button>
        <n-button variant="secondary" intent="success"><span>Success</span></n-button>
        <n-button variant="secondary" intent="warning"><span>Warning</span></n-button>
        <n-button variant="secondary" intent="danger"><span>Danger</span></n-button>
      </n-stack>
      <h3>Outline</h3>
      <n-stack direction="row" wrap align="center">
        <n-button variant="outline" intent="neutral"><span>Neutral</span></n-button>
        <n-button variant="outline" intent="accent"><span>Accent</span></n-button>
        <n-button variant="outline" intent="info"><span>Info</span></n-button>
        <n-button variant="outline" intent="success"><span>Success</span></n-button>
        <n-button variant="outline" intent="warning"><span>Warning</span></n-button>
        <n-button variant="outline" intent="danger"><span>Danger</span></n-button>
      </n-stack>
      <h3>Ghost</h3>
      <n-stack direction="row" wrap align="center">
        <n-button variant="ghost" intent="neutral"><span>Neutral</span></n-button>
        <n-button variant="ghost" intent="accent"><span>Accent</span></n-button>
        <n-button variant="ghost" intent="info"><span>Info</span></n-button>
        <n-button variant="ghost" intent="success"><span>Success</span></n-button>
        <n-button variant="ghost" intent="warning"><span>Warning</span></n-button>
        <n-button variant="ghost" intent="danger"><span>Danger</span></n-button>
      </n-stack>
      <h3>Default</h3>
      <n-stack direction="row" wrap align="center">
        <n-button variant="default" intent="neutral"><span>Neutral</span></n-button>
        <n-button variant="default" intent="accent"><span>Accent</span></n-button>
        <n-button variant="default" intent="info"><span>Info</span></n-button>
        <n-button variant="default" intent="success"><span>Success</span></n-button>
        <n-button variant="default" intent="warning"><span>Warning</span></n-button>
        <n-button variant="default" intent="danger"><span>Danger</span></n-button>
      </n-stack>
      <h3>Selected</h3>
      <n-stack direction="row" wrap align="center">
        <n-button variant="selected" intent="neutral"><span>Neutral</span></n-button>
        <n-button variant="selected" intent="accent"><span>Accent</span></n-button>
        <n-button variant="selected" intent="info"><span>Info</span></n-button>
        <n-button variant="selected" intent="success"><span>Success</span></n-button>
        <n-button variant="selected" intent="warning"><span>Warning</span></n-button>
        <n-button variant="selected" intent="danger"><span>Danger</span></n-button>
      </n-stack>
    </n-panel>

    <!-- ── Justify: spread ── -->

    <h2>Justify: spread</h2>
    <div class="demo-narrow">
    <n-panel bordered size="md">
      <n-stack gap="2">
        <n-button justify="spread">
          <n-icon name="heart" slot="leading"></n-icon>
          <span>Favorites</span>
          <n-icon name="arrow-right" slot="trailing"></n-icon>
        </n-button>
        <n-button variant="outline" justify="spread">
          <n-icon name="pencil-simple" slot="leading"></n-icon>
          <span>Edit Profile</span>
          <n-icon name="arrow-right" slot="trailing"></n-icon>
        </n-button>
      </n-stack>
      <n-text size="xs" muted spacing="regular">
        <code>justify="spread"</code> switches to <code>auto 1fr auto</code> columns so the label fills available space and trailing icon pushes to the far edge. Used as dropdown triggers in <code>&lt;n-select&gt;</code>.
      </n-text>
      <pre class="code-block"><code>&lt;n-button justify="spread"&gt;
  &lt;n-icon name="heart" slot="leading"&gt;&lt;/n-icon&gt;
  &lt;span slot="label"&gt;Favorites&lt;/span&gt;
  &lt;n-icon name="arrow-right" slot="trailing"&gt;&lt;/n-icon&gt;
&lt;/n-button&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>
    </div>

    <!-- ── Icon Only ── -->

    <h2>Icon Only</h2>
    <n-panel bordered size="md">
      <n-stack direction="row" wrap align="center">
        <n-button variant="primary" aria-label="Add"><n-icon name="plus"></n-icon></n-button>
        <n-button variant="secondary" aria-label="Close"><n-icon name="x"></n-icon></n-button>
        <n-button variant="ghost" aria-label="Favorite"><n-icon name="heart"></n-icon></n-button>
        <n-button variant="outline" aria-label="Next"><n-icon name="arrow-right"></n-icon></n-button>
      </n-stack>
      <pre class="code-block"><code>&lt;n-button variant="primary" aria-label="Add"&gt;
  &lt;n-icon name="plus"&gt;&lt;/n-icon&gt;
&lt;/n-button&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Slots ── -->

    <h2>Slot Variations</h2>
    <n-panel bordered size="md">
      <h3>Full (leading + label + trailing)</h3>
      <n-stack direction="row" wrap align="center">
        <n-button variant="primary">
          <n-icon name="plus" slot="leading"></n-icon>
          <span>Add Item</span>
          <n-icon name="arrow-right" slot="trailing"></n-icon>
        </n-button>
        <n-button variant="secondary">
          <n-icon name="plus" slot="leading"></n-icon>
          <span>Add Item</span>
          <n-icon name="arrow-right" slot="trailing"></n-icon>
        </n-button>
      </n-stack>
