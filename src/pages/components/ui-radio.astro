---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  changeEvents: `&lt;n-radio-group id="my-radios"&gt;
  &lt;n-radio value="red"&gt;Red&lt;/n-radio&gt;
  &lt;n-radio value="green"&gt;Green&lt;/n-radio&gt;
  &lt;n-radio value="blue"&gt;Blue&lt;/n-radio&gt;
&lt;/n-radio-group&gt;

&lt;script&gt;
  document.getElementById('my-radios')
    .addEventListener('native:change', (e) =&gt; {
      console.log(e.detail.value, e.detail.label);
    });
&lt;/script&gt;`,
};
---
<SidebarLayout title="Radio">
  <main>
<h1>&lt;n-radio-group&gt; + &lt;n-radio&gt;</h1>
    <n-text size="md" muted spacing="relaxed">
      Exclusive single-select radio group with roving focus, form association, and arrow-key navigation.
    </n-text>

    <!-- ── Basic ── -->

    <h2>Basic (Vertical)</h2>
    <n-panel bordered>
      <n-radio-group value="banana">
        <n-radio value="apple">Apple</n-radio>
        <n-radio value="banana">Banana</n-radio>
        <n-radio value="cherry">Cherry</n-radio>
        <n-radio value="date">Date</n-radio>
      </n-radio-group>
    <pre class="layout-code"><code>&lt;n-radio-group value="banana"&gt;
  &lt;n-radio value="apple"&gt;Apple&lt;/n-radio&gt;
  &lt;n-radio value="banana"&gt;Banana&lt;/n-radio&gt;
  &lt;n-radio value="cherry"&gt;Cherry&lt;/n-radio&gt;
&lt;/n-radio-group&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Horizontal ── -->

    <h2>Horizontal</h2>
    <n-panel bordered>
      <n-radio-group orientation="horizontal" value="monthly">
        <n-radio value="daily">Daily</n-radio>
        <n-radio value="weekly">Weekly</n-radio>
        <n-radio value="monthly">Monthly</n-radio>
        <n-radio value="yearly">Yearly</n-radio>
      </n-radio-group>
    <pre class="layout-code"><code>&lt;n-radio-group orientation="horizontal" value="monthly"&gt;
  &lt;n-radio value="daily"&gt;Daily&lt;/n-radio&gt;
  &lt;n-radio value="weekly"&gt;Weekly&lt;/n-radio&gt;
  &lt;n-radio value="monthly"&gt;Monthly&lt;/n-radio&gt;
&lt;/n-radio-group&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <n-radio-group size="xs" value="a">
          <n-radio value="a">Extra small A</n-radio>
          <n-radio value="b">Extra small B</n-radio>
        </n-radio-group>
        <n-radio-group size="sm" value="a">
          <n-radio value="a">Small A</n-radio>
          <n-radio value="b">Small B</n-radio>
        </n-radio-group>
        <n-radio-group size="md" value="a">
          <n-radio value="a">Medium A</n-radio>
          <n-radio value="b">Medium B</n-radio>
        </n-radio-group>
        <n-radio-group size="lg" value="a">
          <n-radio value="a">Large A</n-radio>
          <n-radio value="b">Large B</n-radio>
        </n-radio-group>
      </n-stack>
      <pre class="layout-code"><code>&lt;n-radio-group size="sm" value="a"&gt;
  &lt;n-radio value="a"&gt;Small A&lt;/n-radio&gt;
  &lt;n-radio value="b"&gt;Small B&lt;/n-radio&gt;
&lt;/n-radio-group&gt;

&lt;n-radio-group size="lg" value="a"&gt;
  &lt;n-radio value="a"&gt;Large A&lt;/n-radio&gt;
  &lt;n-radio value="b"&gt;Large B&lt;/n-radio&gt;
&lt;/n-radio-group&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Density ── -->

    <h2>Density</h2>
    <n-panel bordered>
      <h3>compact</h3>
      <n-stack direction="row" wrap align="center" density="compact">
        <n-radio-group size="sm" value="a">
          <n-radio value="a">Small A</n-radio>
          <n-radio value="b">Small B</n-radio>
        </n-radio-group>
        <n-radio-group value="a">
          <n-radio value="a">Medium A</n-radio>
          <n-radio value="b">Medium B</n-radio>
        </n-radio-group>
      </n-stack>
      <h3>default</h3>
      <n-stack direction="row" wrap align="center">
        <n-radio-group size="sm" value="a">
          <n-radio value="a">Small A</n-radio>
          <n-radio value="b">Small B</n-radio>
        </n-radio-group>
        <n-radio-group value="a">
          <n-radio value="a">Medium A</n-radio>
          <n-radio value="b">Medium B</n-radio>
        </n-radio-group>
      </n-stack>
      <h3>loose</h3>
      <n-stack direction="row" wrap align="center" density="loose">
        <n-radio-group size="sm" value="a">
          <n-radio value="a">Small A</n-radio>
          <n-radio value="b">Small B</n-radio>
        </n-radio-group>
        <n-radio-group value="a">
          <n-radio value="a">Medium A</n-radio>
          <n-radio value="b">Medium B</n-radio>
        </n-radio-group>
      </n-stack>
      <pre class="layout-code"><code>&lt;div density="compact"&gt;
  &lt;n-radio-group value="a"&gt;...&lt;/n-radio-group&gt;
&lt;/div&gt;

&lt;div density="loose"&gt;
  &lt;n-radio-group value="a"&gt;...&lt;/n-radio-group&gt;
&lt;/div&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Radius ── -->

    <h2>Radius</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <n-radio-group value="a">
          <n-radio value="a">Default A</n-radio>
          <n-radio value="b">Default B</n-radio>
        </n-radio-group>
        <n-radio-group radius="rounded" value="a">
          <n-radio value="a">Rounded A</n-radio>
          <n-radio value="b">Rounded B</n-radio>
        </n-radio-group>
        <n-radio-group radius="sharp" value="a">
          <n-radio value="a">Sharp A</n-radio>
          <n-radio value="b">Sharp B</n-radio>
        </n-radio-group>
      </n-stack>
      <pre class="layout-code"><code>&lt;n-radio-group radius="rounded" value="a"&gt;
  &lt;n-radio value="a"&gt;Rounded A&lt;/n-radio&gt;
  &lt;n-radio value="b"&gt;Rounded B&lt;/n-radio&gt;
&lt;/n-radio-group&gt;

&lt;n-radio-group radius="sharp" value="a"&gt;
  &lt;n-radio value="a"&gt;Sharp A&lt;/n-radio&gt;
  &lt;n-radio value="b"&gt;Sharp B&lt;/n-radio&gt;
&lt;/n-radio-group&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Intents ── -->

    <h2>Intents</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <n-radio-group intent="neutral" value="a">
          <n-radio value="a">Neutral A</n-radio>
          <n-radio value="b">Neutral B</n-radio>
        </n-radio-group>
        <n-radio-group intent="accent" value="a">
          <n-radio value="a">Accent A</n-radio>
          <n-radio value="b">Accent B</n-radio>
        </n-radio-group>
        <n-radio-group intent="success" value="a">
          <n-radio value="a">Success A</n-radio>
          <n-radio value="b">Success B</n-radio>
        </n-radio-group>
        <n-radio-group intent="danger" value="a">
          <n-radio value="a">Danger A</n-radio>
          <n-radio value="b">Danger B</n-radio>
        </n-radio-group>
      </n-stack>
      <pre class="layout-code"><code>&lt;n-radio-group intent="accent" value="a"&gt;
  &lt;n-radio value="a"&gt;Accent A&lt;/n-radio&gt;
  &lt;n-radio value="b"&gt;Accent B&lt;/n-radio&gt;
&lt;/n-radio-group&gt;

&lt;n-radio-group intent="danger" value="a"&gt;
  &lt;n-radio value="a"&gt;Danger A&lt;/n-radio&gt;
  &lt;n-radio value="b"&gt;Danger B&lt;/n-radio&gt;
&lt;/n-radio-group&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Disabled ── -->

    <h2>Disabled</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <n-radio-group disabled value="b">
          <n-radio value="a">Option A</n-radio>
          <n-radio value="b">Option B (selected)</n-radio>
          <n-radio value="c">Option C</n-radio>
        </n-radio-group>

        <n-radio-group value="a">
          <n-radio value="a">Enabled</n-radio>
          <n-radio value="b" disabled>Disabled option</n-radio>
          <n-radio value="c">Enabled</n-radio>
        </n-radio-group>
      </n-stack>
      <pre class="layout-code"><code>&lt;!-- Entire group disabled --&gt;
&lt;n-radio-group disabled value="b"&gt;
  &lt;n-radio value="a"&gt;Option A&lt;/n-radio&gt;
  &lt;n-radio value="b"&gt;Option B&lt;/n-radio&gt;
&lt;/n-radio-group&gt;

&lt;!-- Single option disabled --&gt;
&lt;n-radio-group value="a"&gt;
  &lt;n-radio value="a"&gt;Enabled&lt;/n-radio&gt;
  &lt;n-radio value="b" disabled&gt;Disabled&lt;/n-radio&gt;
&lt;/n-radio-group&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Events ── -->

    <h2>Change Events</h2>
    <n-panel bordered>
      <n-radio-group id="event-rg">
        <n-radio value="red">Red</n-radio>
        <n-radio value="green">Green</n-radio>
        <n-radio value="blue">Blue</n-radio>
      </n-radio-group>
      <div class="log" id="event-log"></div>
    <pre class="layout-code"><code set:html={codeExamples.changeEvents} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Form Association ── -->

    <h2>Form Association</h2>
    <n-panel bordered>
      <form id="demo-form">
        <n-radio-group class="form-fields" name="plan" value="pro">
          <n-radio value="free">Free</n-radio>
          <n-radio value="pro">Pro</n-radio>
          <n-radio value="enterprise">Enterprise</n-radio>
        </n-radio-group>
        <n-stack direction="row">
          <n-button variant="primary" type="submit"><span slot="label">Submit</span></n-button>
          <n-button variant="secondary" type="reset"><span slot="label">Reset</span></n-button>
        </n-stack>
      </form>
      <div class="log" id="form-log"></div>
    <pre class="layout-code"><code>&lt;form&gt;
  &lt;n-radio-group name="plan" value="pro"&gt;
    &lt;n-radio value="free"&gt;Free&lt;/n-radio&gt;
    &lt;n-radio value="pro"&gt;Pro&lt;/n-radio&gt;
    &lt;n-radio value="enterprise"&gt;Enterprise&lt;/n-radio&gt;
  &lt;/n-radio-group&gt;
  &lt;button type="submit"&gt;Submit&lt;/button&gt;
&lt;/form&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Debug States (force-*) ── -->

    <h2>Debug States (<code>force-*</code>)</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="regular">
        Attribute-driven pseudo-state overrides for DevTools debugging and visual testing.
      </n-text>
      <n-stack direction="row" wrap align="center">
        <n-radio force-hover checked>Force hover (checked)</n-radio>
        <n-radio force-hover>Force hover</n-radio>
        <n-radio force-focus-visible checked>Force focus-visible (checked)</n-radio>
        <n-radio force-focus-visible>Force focus-visible</n-radio>
      </n-stack>
    </n-panel>
  </main>

  <script>
import { logPrepend } from '../../scripts/event-log';

import { onPageLoad } from '../../scripts/on-page-load';

onPageLoad('event-rg', (eventRg) => {
  const eventLog = document.getElementById('event-log');
  let count = 0;

  eventRg.addEventListener('native:change', (e) => {
    count++;
    logPrepend(eventLog, `#${count} native:change — value: "${e.detail.value}", label: "${e.detail.label}"`);
  });

  // Form logging
  const form = document.getElementById('demo-form');
  const formLog = document.getElementById('form-log');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const entries = [...data.entries()].map(([k, v]) => `${k}=${v}`).join(', ');
    logPrepend(formLog, `submit — ${entries || '(empty)'}`);
  });

  form?.addEventListener('reset', () => {
    logPrepend(formLog, 'reset');
  });
});
  </script>
  <style is:global>
    .form-fields { margin-bottom: 1rem; }
  </style>
</SidebarLayout>
