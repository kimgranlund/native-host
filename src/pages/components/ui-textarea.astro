---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  events: `&lt;n-textarea id="my-textarea" placeholder="Type..."&gt;&lt;/n-textarea&gt;

&lt;script&gt;
  const ta = document.getElementById('my-textarea');
  ta.addEventListener('native:input', (e) =&gt; {
    console.log('input:', e.detail.value);
  });
  ta.addEventListener('native:change', (e) =&gt; {
    console.log('change:', e.detail.value);
  });
&lt;/script&gt;`,
};
---
<SidebarLayout title="Textarea">
  <main>
<h1>&lt;n-textarea&gt;</h1>
    <p style="color: var(--n-ink-muted-neutral); font-size: 0.875rem; margin-bottom: 1.5rem;">
      Multi-line text input with contenteditable, autogrow, rows presets, and maxlength.
    </p>

    <!-- ── Basic ── -->

    <h2>Basic</h2>
    <div class="layout-section">
      <n-textarea placeholder="Tell us about yourself..."></n-textarea>
        <pre class="layout-code"><code>&lt;n-textarea placeholder="Tell us about yourself..."&gt;&lt;/n-textarea&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── With Value ── -->

    <h2>With Value</h2>
    <div class="layout-section">
      <n-textarea rows="4">This is a textarea with some initial content. It supports multi-line text editing with all the same styling as n-input.</n-textarea>
        <pre class="layout-code"><code>&lt;n-textarea rows="4"&gt;Initial content here.&lt;/n-textarea&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Variants ── -->

    <h2>Variants</h2>
    <div class="layout-section">
      <div class="layout-row">
        <div>
          <div class="layout-label">secondary (default)</div>
          <n-textarea placeholder="Secondary textarea"></n-textarea>
        </div>
        <div>
          <div class="layout-label">outline</div>
          <n-textarea variant="outline" placeholder="Outline textarea"></n-textarea>
        </div>
        <div>
          <div class="layout-label">ghost</div>
          <n-textarea variant="ghost" placeholder="Ghost textarea"></n-textarea>
        </div>
      </div>
      <pre class="layout-code"><code>&lt;n-textarea placeholder="Secondary (default)"&gt;&lt;/n-textarea&gt;
&lt;n-textarea variant="outline" placeholder="Outline"&gt;&lt;/n-textarea&gt;
&lt;n-textarea variant="ghost" placeholder="Ghost"&gt;&lt;/n-textarea&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <div class="layout-section">
      <div class="layout-row">
        <div size="sm">
          <div class="layout-label">sm</div>
          <n-textarea placeholder="Small textarea"></n-textarea>
        </div>
        <div>
          <div class="layout-label">md (default)</div>
          <n-textarea placeholder="Medium textarea"></n-textarea>
        </div>
        <div size="lg">
          <div class="layout-label">lg</div>
          <n-textarea placeholder="Large textarea"></n-textarea>
        </div>
      </div>
      <pre class="layout-code"><code>&lt;div size="sm"&gt;
  &lt;n-textarea placeholder="Small"&gt;&lt;/n-textarea&gt;
&lt;/div&gt;
&lt;n-textarea placeholder="Medium (default)"&gt;&lt;/n-textarea&gt;
&lt;div size="lg"&gt;
  &lt;n-textarea placeholder="Large"&gt;&lt;/n-textarea&gt;
&lt;/div&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Density ── -->

    <h2>Density</h2>
    <div class="layout-section">
      <div class="layout-row">
        <div density="compact">
          <div class="layout-label">compact</div>
          <n-textarea placeholder="Compact textarea"></n-textarea>
        </div>
        <div>
          <div class="layout-label">default</div>
          <n-textarea placeholder="Default textarea"></n-textarea>
        </div>
        <div density="loose">
          <div class="layout-label">loose</div>
          <n-textarea placeholder="Loose textarea"></n-textarea>
        </div>
      </div>
      <pre class="layout-code"><code>&lt;div density="compact"&gt;
  &lt;n-textarea placeholder="Compact"&gt;&lt;/n-textarea&gt;
&lt;/div&gt;
&lt;n-textarea placeholder="Default"&gt;&lt;/n-textarea&gt;
&lt;div density="loose"&gt;
  &lt;n-textarea placeholder="Loose"&gt;&lt;/n-textarea&gt;
&lt;/div&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Rows ── -->

    <h2>Rows</h2>
    <div class="layout-section" size="sm">
      <div class="layout-row">
        <div>
          <div class="layout-label">rows="1"</div>
          <n-textarea rows="1" placeholder="Single line height"></n-textarea>
        </div>
        <div>
          <div class="layout-label">rows="2"</div>
          <n-textarea rows="2" placeholder="Two rows"></n-textarea>
        </div>
        <div>
          <div class="layout-label">rows="3" (default)</div>
          <n-textarea placeholder="Three rows (default)"></n-textarea>
        </div>
        <div>
          <div class="layout-label">rows="5"</div>
          <n-textarea rows="5" placeholder="Five rows"></n-textarea>
        </div>
        <div>
          <div class="layout-label">rows="8"</div>
          <n-textarea rows="8" placeholder="Eight rows"></n-textarea>
        </div>
      </div>
      <pre class="layout-code"><code>&lt;n-textarea rows="1" placeholder="Single line"&gt;&lt;/n-textarea&gt;
&lt;n-textarea rows="3" placeholder="Three rows (default)"&gt;&lt;/n-textarea&gt;
&lt;n-textarea rows="5" placeholder="Five rows"&gt;&lt;/n-textarea&gt;
&lt;n-textarea rows="8" placeholder="Eight rows"&gt;&lt;/n-textarea&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Autogrow ── -->

    <h2>Autogrow</h2>
    <div class="layout-section">
      <n-textarea placeholder="Type here — grows as you type..." autogrow></n-textarea>
        <pre class="layout-code"><code>&lt;n-textarea placeholder="Type here..." autogrow&gt;&lt;/n-textarea&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Maxlength ── -->

    <h2>Maxlength</h2>
    <div class="layout-section">
      <n-field>
        <label slot="label">Bio</label>
        <n-textarea placeholder="Max 100 characters..." maxlength="100"></n-textarea>
        <span slot="description">100 character limit</span>
        <span slot="error">Exceeds maximum length</span>
      </n-field>
      <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin-top: 0.5rem;">Reports <code>tooLong</code> via the Constraint Validation API when the limit is exceeded. The value is not truncated.</p>
        <pre class="layout-code"><code>&lt;n-field&gt;
  &lt;label slot="label"&gt;Bio&lt;/label&gt;
  &lt;n-textarea placeholder="Max 100 characters..." maxlength="100"&gt;&lt;/n-textarea&gt;
  &lt;span slot="error"&gt;Exceeds maximum length&lt;/span&gt;
&lt;/n-field&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Intents ── -->

    <h2>Intents</h2>
    <div class="layout-section" size="sm">
      <div class="layout-row">
        <div intent="neutral">
          <div class="layout-label">neutral</div>
          <n-textarea placeholder="Neutral"></n-textarea>
        </div>
        <div intent="accent">
          <div class="layout-label">accent</div>
          <n-textarea placeholder="Accent"></n-textarea>
        </div>
        <div intent="info">
          <div class="layout-label">info</div>
          <n-textarea placeholder="Info"></n-textarea>
        </div>
        <div intent="success">
          <div class="layout-label">success</div>
          <n-textarea placeholder="Success"></n-textarea>
        </div>
        <div intent="warning">
          <div class="layout-label">warning</div>
          <n-textarea placeholder="Warning"></n-textarea>
        </div>
        <div intent="danger">
          <div class="layout-label">danger</div>
          <n-textarea placeholder="Danger"></n-textarea>
        </div>
      </div>
      <pre class="layout-code"><code>&lt;div intent="accent"&gt;
  &lt;n-textarea placeholder="Accent"&gt;&lt;/n-textarea&gt;
&lt;/div&gt;
&lt;div intent="success"&gt;
  &lt;n-textarea placeholder="Success"&gt;&lt;/n-textarea&gt;
&lt;/div&gt;
&lt;div intent="danger"&gt;
  &lt;n-textarea placeholder="Danger"&gt;&lt;/n-textarea&gt;
&lt;/div&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Disabled & Readonly ── -->

    <h2>Disabled &amp; Readonly</h2>
    <div class="layout-section">
      <div class="layout-row">
        <div>
          <div class="layout-label">disabled</div>
          <n-textarea disabled>This content cannot be edited.</n-textarea>
        </div>
        <div>
          <div class="layout-label">readonly</div>
          <n-textarea readonly>This content is read-only but selectable.</n-textarea>
        </div>
      </div>
      <pre class="layout-code"><code>&lt;n-textarea disabled&gt;Cannot be edited.&lt;/n-textarea&gt;
&lt;n-textarea readonly&gt;Read-only but selectable.&lt;/n-textarea&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Radius ── -->

    <h2>Radius</h2>
    <div class="layout-section">
      <div class="layout-row">
        <div radius="sharp">
          <div class="layout-label">sharp</div>
          <n-textarea placeholder="Sharp radius"></n-textarea>
        </div>
        <div>
          <div class="layout-label">default</div>
          <n-textarea placeholder="Default radius"></n-textarea>
        </div>
        <div radius="round">
          <div class="layout-label">round</div>
          <n-textarea placeholder="Round radius"></n-textarea>
        </div>
      </div>
      <pre class="layout-code"><code>&lt;div radius="sharp"&gt;
  &lt;n-textarea placeholder="Sharp"&gt;&lt;/n-textarea&gt;
&lt;/div&gt;
&lt;n-textarea placeholder="Default"&gt;&lt;/n-textarea&gt;
&lt;div radius="round"&gt;
  &lt;n-textarea placeholder="Round"&gt;&lt;/n-textarea&gt;
&lt;/div&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Events ── -->

    <h2>Events</h2>
    <div class="layout-section">
      <n-textarea id="event-textarea" placeholder="Type to see events..."></n-textarea>
      <div class="log" id="event-log"></div>
    <pre class="layout-code"><code set:html={codeExamples.events} /><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Form Association ── -->

    <h2>Form Association</h2>
    <div class="layout-section">
      <form id="demo-form">
        <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 0.75rem;">
          <n-textarea name="bio" placeholder="Write your bio..."></n-textarea>
          <n-textarea name="notes" placeholder="Additional notes..." rows="2"></n-textarea>
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <n-button variant="primary" type="submit"><span slot="label">Submit</span></n-button>
          <n-button variant="secondary" type="reset"><span slot="label">Reset</span></n-button>
        </div>
      </form>
      <div class="log" id="form-log"></div>
    <pre class="layout-code"><code>&lt;form&gt;
  &lt;n-textarea name="bio" placeholder="Write your bio..."&gt;&lt;/n-textarea&gt;
  &lt;n-button variant="primary" type="submit"&gt;
    &lt;span slot="label"&gt;Submit&lt;/span&gt;
  &lt;/n-button&gt;
&lt;/form&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── With n-field ── -->

    <h2>With n-field</h2>
    <div class="layout-section">
      <n-stack gap="4">
        <n-field>
          <label slot="label">Bio</label>
          <n-textarea placeholder="Tell us about yourself..."></n-textarea>
        </n-field>
        <n-field required>
          <label slot="label">Feedback</label>
          <n-textarea placeholder="Required field..." rows="4"></n-textarea>
          <span slot="description">We appreciate your feedback.</span>
        </n-field>
        <n-field disabled>
          <label slot="label">Locked</label>
          <n-textarea>This field is disabled via n-field.</n-textarea>
        </n-field>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-field&gt;
  &lt;label slot="label"&gt;Bio&lt;/label&gt;
  &lt;n-textarea placeholder="Tell us about yourself..."&gt;&lt;/n-textarea&gt;
&lt;/n-field&gt;
&lt;n-field required&gt;
  &lt;label slot="label"&gt;Feedback&lt;/label&gt;
  &lt;n-textarea placeholder="Required..." rows="4"&gt;&lt;/n-textarea&gt;
  &lt;span slot="description"&gt;We appreciate your feedback.&lt;/span&gt;
&lt;/n-field&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Debug States (force-*) ── -->

    <h2>Debug States (<code>force-*</code>)</h2>
    <div class="layout-section">
      <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin: 0 0 1rem;">
        Attribute-driven pseudo-state overrides for DevTools debugging and visual testing.
      </p>
      <div class="layout-row">
        <div>
          <div class="layout-label">force-hover</div>
          <n-textarea force-hover placeholder="Force hover"></n-textarea>
        </div>
        <div>
          <div class="layout-label">force-focus</div>
          <n-textarea force-focus placeholder="Force focus"></n-textarea>
        </div>
      </div>
    </div>
  </main>

  <script>
import { logPrepend } from '../../scripts/event-log';
// Event logging
      const eventTextarea = document.getElementById('event-textarea');
      const eventLog = document.getElementById('event-log');
      let count = 0;

      eventTextarea.addEventListener('native:input', (e) => {
        count++;
        logPrepend(eventLog, `#${count} native:input — value: "${e.detail.value}"`);
      });

      eventTextarea.addEventListener('native:change', (e) => {
        count++;
        logPrepend(eventLog, `#${count} native:change — value: "${e.detail.value}"`);
      });

      // Form logging
      const form = document.getElementById('demo-form');
      const formLog = document.getElementById('form-log');

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(form);
        logPrepend(formLog, `submit — ${[...data.entries()].map(([k, v]) => `${k}: "${v}"`).join(', ')}`);
      });

      form.addEventListener('reset', () => {
        logPrepend(formLog, 'reset');
      });
  </script>
</SidebarLayout>
