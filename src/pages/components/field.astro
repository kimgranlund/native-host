---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  withOtherControls: `&lt;n-field&gt;
  &lt;label slot="label"&gt;Theme preference&lt;/label&gt;
  &lt;n-select placeholder="Select theme"
    options='[{"value":"system","label":"System"},...]'&gt;
  &lt;/n-select&gt;
  &lt;span slot="description"&gt;Choose how the app appears.&lt;/span&gt;
&lt;/n-field&gt;

&lt;n-field&gt;
  &lt;label slot="label"&gt;Notifications&lt;/label&gt;
  &lt;n-switch&gt;Enable push notifications&lt;/n-switch&gt;
&lt;/n-field&gt;`,
};
---
<SidebarLayout title="Field">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Field</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-field&gt;</span> Form field wrapper with label, description, error message, and ARIA wiring.
          </div>
  </header>

  <section>

    <!-- ── Basic ── -->

    <h2>Basic</h2>
    <n-panel bordered>
      <n-stack gap="4">
        <n-field>
          <label slot="label">Email address</label>
          <n-input placeholder="you@example.com"></n-input>
          <span slot="description">We'll never share your email.</span>
        </n-field>
        <n-field>
          <label slot="label">Password</label>
          <n-input placeholder="Enter password" type="password"></n-input>
        </n-field>
      </n-stack>
      <pre class="code-block"><code>&lt;n-field&gt;
  &lt;label slot="label"&gt;Email address&lt;/label&gt;
  &lt;n-input placeholder="you@example.com"&gt;&lt;/n-input&gt;
  &lt;span slot="description"&gt;We'll never share your email.&lt;/span&gt;
&lt;/n-field&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Required ── -->

    <h2>Required</h2>
    <n-panel bordered>
      <n-stack gap="4">
        <n-field required>
          <label slot="label">Full name</label>
          <n-input placeholder="Jane Doe"></n-input>
          <span slot="description">As it appears on your ID.</span>
        </n-field>
        <n-field required>
          <label slot="label">Email</label>
          <n-input placeholder="you@example.com"></n-input>
        </n-field>
      </n-stack>
      <pre class="code-block"><code>&lt;n-field required&gt;
  &lt;label slot="label"&gt;Full name&lt;/label&gt;
  &lt;n-input placeholder="Jane Doe"&gt;&lt;/n-input&gt;
  &lt;span slot="description"&gt;As it appears on your ID.&lt;/span&gt;
&lt;/n-field&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── With Error ── -->

    <h2>With Error</h2>
    <n-panel bordered>
      <n-stack gap="4">
        <n-field required invalid>
          <label slot="label">Username</label>
          <n-input placeholder="Choose a username" invalid></n-input>
          <span slot="error">Username is already taken.</span>
        </n-field>
        <n-field invalid>
          <label slot="label">Website</label>
          <n-input placeholder="https://example.com"></n-input>
          <span slot="description">Your personal website or blog.</span>
          <span slot="error">Please enter a valid URL.</span>
        </n-field>
      </n-stack>
      <pre class="code-block"><code>&lt;n-field required invalid&gt;
  &lt;label slot="label"&gt;Username&lt;/label&gt;
  &lt;n-input placeholder="Choose a username" invalid&gt;&lt;/n-input&gt;
  &lt;span slot="error"&gt;Username is already taken.&lt;/span&gt;
&lt;/n-field&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Disabled ── -->

    <h2>Disabled</h2>
    <n-panel bordered>
      <n-field disabled>
        <label slot="label">Account ID</label>
        <n-input placeholder="Auto-generated" value="acct_29x8f"></n-input>
        <span slot="description">This field cannot be changed.</span>
      </n-field>
    </n-panel>

    <!-- ── With Other Controls ── -->

    <h2>With Other Controls</h2>
    <n-panel bordered>
      <n-stack gap="4">
        <n-field>
          <label slot="label">Theme preference</label>
          <n-select value="system" placeholder="Select theme" options='[{"value":"system","label":"System"},{"value":"light","label":"Light"},{"value":"dark","label":"Dark"}]'></n-select>
          <span slot="description">Choose how the app appears.</span>
        </n-field>
        <n-field>
          <label slot="label">Marketing emails</label>
          <n-checkbox>Send me product updates</n-checkbox>
        </n-field>
        <n-field>
          <label slot="label">Notifications</label>
          <n-switch>Enable push notifications</n-switch>
        </n-field>
      </n-stack>
      <pre class="code-block"><code set:html={codeExamples.withOtherControls} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-panel bordered>
      <n-stack gap="4">
        <n-field size="sm">
          <label slot="label">Small field</label>
          <n-input placeholder="Small input"></n-input>
        </n-field>
        <n-field>
          <label slot="label">Default field</label>
          <n-input placeholder="Default input"></n-input>
        </n-field>
        <n-field size="lg">
          <label slot="label">Large field</label>
          <n-input placeholder="Large input"></n-input>
        </n-field>
      </n-stack>
    </n-panel>

    <!-- ── Form Composition ── -->

    <h2>Form Composition</h2>
    <div class="field-form-panel"><n-panel bordered>
      <n-card>
        <header>
          <span>Create Account</span>
        </header>
        <section>
          <n-stack gap="4">
            <n-field required>
              <label slot="label">Full name</label>
              <n-input placeholder="Jane Doe"></n-input>
            </n-field>
            <n-field required>
              <label slot="label">Email</label>
              <n-input placeholder="you@example.com"></n-input>
              <span slot="description">We'll send a confirmation link.</span>
            </n-field>
            <n-field required>
              <label slot="label">Password</label>
              <n-input placeholder="At least 8 characters" type="password"></n-input>
            </n-field>
          </n-stack>
        </section>
        <footer>
          <n-button variant="ghost"><span>Cancel</span></n-button>
          <n-button variant="primary" intent="accent"><span>Create Account</span></n-button>
        </footer>
      </n-card>
    </n-panel></div>
  </section>

<style is:global>
  .field-form-panel {
    max-width: 28rem;
  }
</style>
</SidebarLayout>
