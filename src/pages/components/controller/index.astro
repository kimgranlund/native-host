          <n-table-row><n-table-cell><code>pressable</code></n-table-cell><n-table-cell><code>PressController</code></n-table-cell><n-table-cell><code>disabled</code></n-table-cell></n-table-row>
          <n-table-row><n-table-cell><code>hoverable</code></n-table-cell><n-table-cell><code>HoverController</code></n-table-cell><n-table-cell><code>delay</code>, <code>leave-delay</code>, <code>disabled</code></n-table-cell></n-table-row>
          <n-table-row><n-table-cell><code>draggable</code></n-table-cell><n-table-cell><code>DragController</code></n-table-cell><n-table-cell><code>selector</code>, <code>axis</code>, <code>mode</code>, <code>drop-zone-selector</code>, <code>disabled</code></n-table-cell></n-table-row>
          <n-table-row><n-table-cell><code>resizable</code></n-table-cell><n-table-cell><code>ResizeController</code></n-table-cell><n-table-cell><code>handle-selector</code>, <code>axis</code>, <code>min</code>, <code>max</code>, <code>disabled</code></n-table-cell></n-table-row>
          <n-table-row><n-table-cell><code>selectable</code></n-table-cell><n-table-cell><code>SelectionController</code></n-table-cell><n-table-cell><code>selector</code>, <code>mode</code>, <code>disabled</code></n-table-cell></n-table-row>
          <n-table-row><n-table-cell><code>editable</code></n-table-cell><n-table-cell><code>EditController</code></n-table-cell><n-table-cell><code>trigger</code>, <code>disabled</code></n-table-cell></n-table-row>
          <n-table-row><n-table-cell><code>copyable</code></n-table-cell><n-table-cell><code>CopyController</code></n-table-cell><n-table-cell><code>value</code>, <code>feedback-duration</code></n-table-cell></n-table-row>
