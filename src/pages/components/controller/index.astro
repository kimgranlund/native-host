---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import ApiReference from '../../../components/ApiReference.astro';
import { controllerApi } from '../../../data/api/controller';

const codeExamples = {
  injectionComplexTraitsInjection: `&lt;inject-demo traits="swipeable"
  data-trait-swipeable-axis="horizontal"
  data-trait-swipeable-threshold="40"&gt;
  Swipe left or right
&lt;/inject-demo&gt;

el.addEventListener('native:swipe', (e) =&gt; {
  const { direction, distance, velocity } = e.detail;
});`,
  providerComplexTraitsProvider: `&lt;n-controller
  traits="draggable"
  for="#list"
  data-trait-draggable-selector=".drag-item"
  data-trait-draggable-mode="drop"
&gt;
  ...
&lt;/n-controller&gt;

list.addEventListener('native:drop', (e) =&gt; {
  const { item, target } = e.detail;
  // Swap DOM positions
  const ph = document.createElement('div');
  item.before(ph);
  target.before(item);
  ph.replaceWith(target);
});`,
  providerComplexTraitsProvider2: `&lt;n-controller
  traits="selectable"
  for="#list"
  data-trait-selectable-selector=".select-item"
  data-trait-selectable-mode="multiple"
&gt;
  &lt;div id="list"&gt;
    &lt;div class="select-item"&gt;Inbox&lt;/div&gt;
    &lt;div class="select-item"&gt;Sent&lt;/div&gt;
    ...
  &lt;/div&gt;
&lt;/n-controller&gt;

list.addEventListener('native:selection-change', (e) =&gt; {
  const { selected, count } = e.detail;
});`,
  providerComplexTraitsProvider3: `&lt;n-controller
  traits="sortable"
  for="#table"
  data-trait-sortable-selector="th"
&gt;
  &lt;table id="table"&gt;
    &lt;thead&gt;
      &lt;tr&gt;
        &lt;th data-key="name"&gt;Name&lt;/th&gt;
        &lt;th data-key="role"&gt;Role&lt;/th&gt;
      &lt;/tr&gt;
    &lt;/thead&gt;
    &lt;tbody&gt;...&lt;/tbody&gt;
  &lt;/table&gt;
&lt;/n-controller&gt;

table.addEventListener('native:sort', (e) =&gt; {
  const { column, direction } = e.detail;
  // Sort rows by column...
});`,
  providerComplexTraitsProvider4: `&lt;n-controller
  traits="editable"
  for="#list"
  data-trait-editable-trigger="dblclick"
&gt;
  &lt;div id="list"&gt;
    &lt;div class="edit-item"&gt;Todo: Write documentation&lt;/div&gt;
    &lt;div class="edit-item"&gt;Todo: Review pull requests&lt;/div&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;

list.addEventListener('native:edit-commit', (e) =&gt; {
  const { value, previousValue } = e.detail;
});`,
  providerComplexTraitsProvider5: `&lt;div class="collapse-trigger" id="trigger"&gt;Section 1&lt;/div&gt;
&lt;n-controller traits="collapsible" data-trait-collapsible-duration="300"&gt;
  &lt;div class="collapse-content" id="content"&gt;
    Content here...
  &lt;/div&gt;
&lt;/n-controller&gt;

trigger.addEventListener('click', () =&gt; {
  const ctrl = content
    .closest('n-controller')
    .querySelector(':scope &gt; *');
  // Toggle via controller
});`,
};
---
<SidebarLayout title="Controller">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>n-controller</h1>
      </div>
    </div>
    <div slot="description">

      Two patterns for applying traits declaratively. <strong>Injection</strong> adds <code>traits="..."</code> directly on a component.
      <strong>Provider</strong> uses <code>&lt;n-controller&gt;</code> to apply traits to children, with options on the controller element.

    </div>
  </header>

  <section>

    <!-- ══════════════════════════════════════════════
         INJECTION PATTERN — SIMPLE
         ══════════════════════════════════════════════ -->

    <h2>Injection — Simple <span class="pattern-badge injection">Injection</span></h2>

    <!-- ── Hoverable injection ── -->

    <h3>Hoverable</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        <code>traits="hoverable"</code> on a NativeElement subclass. Options come from the element's own attributes.
      </span></div>
      <n-stack direction="row" wrap>
        <inject-demo traits="hoverable" class="card ctrl-inject-demo">
          Instant hover
        </inject-demo>
        <inject-demo traits="hoverable" data-trait-hoverable-delay="400" class="card ctrl-inject-demo">
          400ms delay
        </inject-demo>
        <inject-demo traits="hoverable" data-trait-hoverable-leave-delay="300" class="card ctrl-inject-demo">
          300ms sticky
        </inject-demo>
      </n-stack>
      <div id="inject-hover-log" class="output"></div>
      <pre class="code-block"><code>&lt;inject-demo traits="hoverable"&gt;
  Instant hover
&lt;/inject-demo&gt;

&lt;inject-demo traits="hoverable" data-trait-hoverable-delay="400"&gt;
  400ms delay
&lt;/inject-demo&gt;

&lt;inject-demo traits="hoverable" data-trait-hoverable-leave-delay="300"&gt;
  300ms sticky
&lt;/inject-demo&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Pressable + Multi-trait ── -->

    <h3>Pressable &amp; Multi-Trait</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        Space-separated names: <code>traits="hoverable pressable"</code>. Both controllers on one element.
      </span></div>
      <n-stack direction="row" wrap>
        <inject-demo traits="pressable" class="card ctrl-inject-demo ctrl-pressable">
          Pressable only
        </inject-demo>
        <inject-demo traits="hoverable pressable" class="card ctrl-inject-demo ctrl-pressable">
          Hoverable + Pressable
        </inject-demo>
      </n-stack>
      <div id="inject-press-log" class="output"></div>
      <pre class="code-block"><code>&lt;inject-demo traits="pressable"&gt;
  Pressable only
&lt;/inject-demo&gt;

&lt;inject-demo traits="hoverable pressable"&gt;
  Hoverable + Pressable
&lt;/inject-demo&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── getTraitController ── -->

    <h3>getTraitController() — Runtime Access</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        Call <code>el.getTraitController('hoverable')</code> to modify the controller at runtime.
      </span></div>
      <n-stack direction="row" wrap align="center">
        <inject-demo id="runtime-ctrl" traits="hoverable" class="card ctrl-inject-demo">
          Hover me (delay changes at runtime)
        </inject-demo>
        <n-button id="set-delay-btn" size="sm">Set delay 1000ms</n-button>
        <n-button id="reset-delay-btn" size="sm" variant="ghost">Reset</n-button>
      </n-stack>
      <div id="inject-runtime-log" class="output"></div>
      <pre class="code-block"><code>const hover = el.getTraitController('hoverable');
hover.delay = 1000; // now requires 1s hover intent</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ══════════════════════════════════════════════
         INJECTION PATTERN — COMPLEX
         ══════════════════════════════════════════════ -->

    <h2>Injection — Complex Traits <span class="pattern-badge injection">Injection</span></h2>

    <!-- ── Copyable ── -->

    <h3>Copyable</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        <code>traits="copyable"</code> with <code>data-trait-copyable-value</code>. Click to copy. Sets <code>[copied]</code> attribute for 2s feedback.
      </span></div>
      <n-stack>
        <inject-demo traits="copyable pressable" data-trait-copyable-value="npm install @nonoun/native-ui" class="copy-item">
          <span class="copy-label">npm install @nonoun/native-ui</span>
          <span class="copy-feedback">Copied!</span>
        </inject-demo>
        <inject-demo traits="copyable pressable" data-trait-copyable-value="sk-proj-abc123..." data-trait-copyable-feedback-duration="3000" class="copy-item">
          <span class="copy-label">sk-proj-abc123...</span>
          <span class="copy-feedback">Copied!</span>
        </inject-demo>
      </n-stack>
      <div id="copy-log" class="output"></div>
      <pre class="code-block"><code>&lt;inject-demo traits="copyable pressable"
  data-trait-copyable-value="npm install @nonoun/native-ui"&gt;
  npm install @nonoun/native-ui
&lt;/inject-demo&gt;

&lt;inject-demo traits="copyable pressable"
  data-trait-copyable-value="sk-proj-abc123..."
  data-trait-copyable-feedback-duration="3000"&gt;
  sk-proj-abc123...
&lt;/inject-demo&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Editable ── -->

    <h3>Editable</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        <code>traits="editable"</code> — double-click to edit, Enter to commit, Escape to cancel. Configurable trigger via <code>data-trait-editable-trigger</code>.
      </span></div>
      <n-stack>
        <inject-demo traits="editable" class="edit-item">
          Double-click me to edit
        </inject-demo>
        <inject-demo traits="editable" data-trait-editable-trigger="click" class="edit-item">
          Single click to edit (data-trait-editable-trigger="click")
        </inject-demo>
      </n-stack>
      <div id="edit-log" class="output"></div>
      <pre class="code-block"><code>&lt;inject-demo traits="editable"&gt;
  Double-click me to edit
&lt;/inject-demo&gt;

&lt;inject-demo traits="editable" data-trait-editable-trigger="click"&gt;
  Single click to edit
&lt;/inject-demo&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Swipeable ── -->

    <h3>Swipeable</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        <code>traits="swipeable"</code> — swipe left/right (mouse or touch). Configurable threshold and axis.
      </span></div>
      <inject-demo id="swipe-demo" traits="swipeable" data-trait-swipeable-axis="horizontal" data-trait-swipeable-threshold="40" class="swipe-card">
        <div id="swipe-page">Swipe left or right</div>
        <div class="swipe-indicator">
          <span class="swipe-dot" id="dot-0"></span>
          <span class="swipe-dot active" id="dot-1"></span>
          <span class="swipe-dot" id="dot-2"></span>
        </div>
      </inject-demo>
      <div id="swipe-log" class="output"></div>
      <pre class="code-block"><code set:html={codeExamples.injectionComplexTraitsInjection} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ══════════════════════════════════════════════
         PROVIDER PATTERN — SIMPLE
         ══════════════════════════════════════════════ -->

    <h2>Provider — Simple <span class="pattern-badge provider">Provider</span></h2>

    <!-- ── Wrapper mode ── -->

    <h3>Wrapper Mode (default)</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        No <code>for</code> — traits apply to first element child. Options live on the <code>&lt;n-controller&gt;</code>.
      </span></div>
      <n-controller traits="hoverable" data-trait-hoverable-delay="200">
        <div class="card">
          Wrapped child gets hoverable (200ms delay)
        </div>
      </n-controller>
      <div id="wrapper-log" class="output"></div>
      <pre class="code-block"><code>&lt;n-controller traits="hoverable" data-trait-hoverable-delay="200"&gt;
  &lt;div class="card"&gt;
    Wrapped child gets hoverable (200ms delay)
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Selector mode: hoverable ── -->

    <h3>Selector Mode — Hoverable</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        <code>for=".card"</code> applies <code>hoverable</code> to all matching descendants. One controller, many targets.
      </span></div>
      <n-controller traits="hoverable" data-trait-hoverable-delay="100" for=".card">
        <n-stack direction="row" wrap>
          <div class="card card ctrl-flex-item">Card A</div>
          <div class="card card ctrl-flex-item">Card B</div>
          <div class="card card ctrl-flex-item">Card C</div>
        </n-stack>
      </n-controller>
      <div id="selector-hover-log" class="output"></div>
      <pre class="code-block"><code>&lt;n-controller traits="hoverable" data-trait-hoverable-delay="100" for=".card"&gt;
  &lt;div class="flex-row"&gt;
    &lt;div class="card"&gt;Card A&lt;/div&gt;
    &lt;div class="card"&gt;Card B&lt;/div&gt;
    &lt;div class="card"&gt;Card C&lt;/div&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Dynamic children ── -->

    <h3>Dynamic Children (auto-wiring)</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        MutationObserver auto-wires traits when new children matching the selector are added.
      </span></div>
      <n-controller traits="hoverable pressable" for=".dynamic-item">
        <n-stack id="dynamic-list"></n-stack>
      </n-controller>
      <div class="ctrl-actions">
        <n-button id="add-item-btn" size="sm">Add Item</n-button>
        <n-button id="clear-items-btn" size="sm" variant="ghost">Clear</n-button>
      </div>
      <div id="dynamic-log" class="output"></div>
      <pre class="code-block"><code>&lt;n-controller traits="hoverable pressable" for=".dynamic-item"&gt;
  &lt;div id="dynamic-list"&gt;&lt;/div&gt;
&lt;/n-controller&gt;

// New items automatically get hoverable + pressable
const item = document.createElement('div');
item.className = 'dynamic-item';
list.appendChild(item);</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Live option updates ── -->

    <h3>Live Option Updates</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        Changing <code>data-trait-hoverable-delay</code> on the controller updates all managed targets via <code>update()</code>.
      </span></div>
      <n-controller id="live-ctrl" traits="hoverable" data-trait-hoverable-delay="0" for=".live-target">
        <n-stack direction="row" wrap>
          <div class="live-target card ctrl-flex-item">Target A</div>
          <div class="live-target card ctrl-flex-item">Target B</div>
        </n-stack>
      </n-controller>
      <div class="ctrl-delay-row"><n-stack direction="row" gap="2" align="center">
        <span class="ctrl-label">Hover delay:</span>
        <n-button id="delay-0" size="sm" variant="ghost">0ms</n-button>
        <n-button id="delay-300" size="sm" variant="ghost">300ms</n-button>
        <n-button id="delay-800" size="sm" variant="ghost">800ms</n-button>
      </n-stack></div>
      <pre class="code-block"><code>&lt;n-controller id="ctrl" traits="hoverable" data-trait-hoverable-delay="0" for=".target"&gt;
  ...
&lt;/n-controller&gt;

// Change delay at runtime — all targets update
ctrl.setAttribute('data-trait-hoverable-delay', '800');</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ══════════════════════════════════════════════
         PROVIDER PATTERN — COMPLEX
         ══════════════════════════════════════════════ -->

    <h2>Provider — Complex Traits <span class="pattern-badge provider">Provider</span></h2>

    <!-- ── Draggable: vertical slot ── -->

    <h3>Draggable — Vertical Reorder (slot)</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        <code>data-trait-draggable-mode="slot"</code> shows a gap indicator. Drop inserts at that position. All options on the controller.
      </span></div>
      <n-controller
        traits="draggable"
        for="#drag-provider-list"
        data-trait-draggable-selector=".drag-item"
        data-trait-draggable-axis="vertical"
        data-trait-draggable-mode="slot"
      >
        <n-stack id="drag-provider-list">
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Research</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Prototype</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Build</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Test</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Ship</span></div>
        </n-stack>
      </n-controller>
      <div id="drag-provider-log" class="output"></div>
      <pre class="code-block"><code>&lt;n-controller
  traits="draggable"
  for="#list"
  data-trait-draggable-selector=".drag-item"
  data-trait-draggable-axis="vertical"
  data-trait-draggable-mode="slot"
&gt;
  &lt;div id="list"&gt;
    &lt;div class="drag-item"&gt;Research&lt;/div&gt;
    &lt;div class="drag-item"&gt;Prototype&lt;/div&gt;
    ...
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Draggable: horizontal ── -->

    <h3>Draggable — Horizontal Cards (slot)</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        <code>data-trait-draggable-axis="horizontal"</code> for a row of cards. Same slot mode — vertical placeholder becomes horizontal.
      </span></div>
      <n-controller
        traits="draggable"
        for="#drag-horiz-list"
        data-trait-draggable-selector=".drag-card"
        data-trait-draggable-axis="horizontal"
        data-trait-draggable-mode="slot"
      >
        <div id="drag-horiz-list" class="ctrl-horiz-list">
          <div class="drag-card">A</div>
          <div class="drag-card">B</div>
          <div class="drag-card">C</div>
          <div class="drag-card">D</div>
        </div>
      </n-controller>
      <pre class="code-block"><code>&lt;n-controller
  traits="draggable"
  for="#row"
  data-trait-draggable-selector=".drag-card"
  data-trait-draggable-axis="horizontal"
  data-trait-draggable-mode="slot"
&gt;
  &lt;div id="row" style="display: flex; gap: 0.5rem;"&gt;
    &lt;div class="drag-card"&gt;A&lt;/div&gt;
    &lt;div class="drag-card"&gt;B&lt;/div&gt;
    ...
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Draggable: drop swap ── -->

    <h3>Draggable — Swap (drop)</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        <code>data-trait-draggable-mode="drop"</code> highlights the target. Consumer decides the swap logic on <code>native:drop</code>.
      </span></div>
      <n-controller
        traits="draggable"
        for="#drag-swap-list"
        data-trait-draggable-selector=".drag-item"
        data-trait-draggable-axis="vertical"
        data-trait-draggable-mode="drop"
      >
        <n-stack id="drag-swap-list">
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Design</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Develop</span></div>
          <div class="drag-item"><span class="handle">&#x2807;</span><span class="label">Deploy</span></div>
        </n-stack>
      </n-controller>
      <div id="drag-swap-log" class="output"></div>
      <pre class="code-block"><code set:html={codeExamples.providerComplexTraitsProvider} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Resizable ── -->

    <h3>Resizable</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        <code>traits="resizable"</code> with <code>data-trait-resizable-handle-selector</code>, <code>data-trait-resizable-axis</code>, <code>data-trait-resizable-min</code>, <code>data-trait-resizable-max</code>. Drag the edge handle to resize.
      </span></div>
      <n-stack gap="4">
        <n-controller
          traits="resizable"
          for="#resize-h"
          data-trait-resizable-handle-selector=".resize-handle"
          data-trait-resizable-axis="horizontal"
          data-trait-resizable-min="120"
          data-trait-resizable-max="500"
        >
          <div id="resize-h" class="resize-box">
            <div>Horizontal resize</div>
            <div class="ctrl-resize-hint">min: 120px, max: 500px</div>
            <div class="resize-handle"></div>
          </div>
        </n-controller>

        <n-controller
          traits="resizable"
          for="#resize-v"
          data-trait-resizable-handle-selector=".resize-handle-v"
          data-trait-resizable-axis="vertical"
          data-trait-resizable-min="60"
          data-trait-resizable-max="300"
        >
          <div id="resize-v" class="resize-box-v">
            <div>Vertical resize</div>
            <div class="ctrl-resize-hint">min: 60px, max: 300px</div>
            <div class="resize-handle-v"></div>
          </div>
        </n-controller>
      </n-stack>
      <div id="resize-log" class="output"></div>
      <pre class="code-block"><code>&lt;n-controller
  traits="resizable"
  for="#panel"
  data-trait-resizable-handle-selector=".resize-handle"
  data-trait-resizable-axis="horizontal"
  data-trait-resizable-min="120"
  data-trait-resizable-max="500"
&gt;
  &lt;div id="panel"&gt;
    Horizontal resize
    &lt;div class="resize-handle"&gt;&lt;/div&gt;
  &lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Selectable ── -->

    <h3>Selectable — Multi-Select List</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        <code>traits="selectable"</code> with <code>data-trait-selectable-mode="multiple"</code>. Click to select, Ctrl+click to toggle, Shift+click for range. Sets <code>aria-selected</code> on items.
      </span></div>
      <n-controller
        traits="selectable"
        for="#select-list"
        data-trait-selectable-selector=".select-item"
        data-trait-selectable-mode="multiple"
      >
        <n-stack id="select-list">
          <div class="select-item" data-value="inbox">Inbox</div>
