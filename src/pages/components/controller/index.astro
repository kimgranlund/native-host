    <!-- ── Editable (provider) ── -->

    <h3>Editable — Inline Edit List</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        <code>traits="editable"</code> via provider makes every <code>.edit-item</code> editable. Double-click to edit, Enter to commit, Escape to cancel.
      </span></div>
      <n-controller
        traits="editable"
        for="#edit-list"
        data-trait-editable-trigger="dblclick"
