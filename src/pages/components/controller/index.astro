    <!-- ── Multi-trait provider ── -->

    <h3>Multi-Trait — Hoverable + Pressable on All</h3>
    <n-container data-kind="panel" bordered>
      <div class="hint"><span class="text-xs text-muted">
        <code>traits="hoverable pressable"</code> applies both traits to every matching descendant.
      </span></div>
      <n-controller traits="hoverable pressable" for=".multi-target">
        <n-stack direction="row" wrap>
          <div class="multi-target card ctrl-flex-item ctrl-pressable">Alpha</div>
          <div class="multi-target card ctrl-flex-item ctrl-pressable">Bravo</div>
          <div class="multi-target card ctrl-flex-item ctrl-pressable">Charlie</div>
        </n-stack>
      </n-controller>
      <div id="multi-provider-log" class="output"></div>
      <pre class="code-block"><code>&lt;n-controller traits="hoverable pressable" for=".multi-target"&gt;
  &lt;div class="multi-target"&gt;Alpha&lt;/div&gt;
  &lt;div class="multi-target"&gt;Bravo&lt;/div&gt;
  &lt;div class="multi-target"&gt;Charlie&lt;/div&gt;
&lt;/n-controller&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ══════════════════════════════════════════════
         COMPARISON TABLE
         ══════════════════════════════════════════════ -->

    <h2>Pattern Comparison</h2>
      <n-table variant="plain" size="sm" cols="auto auto 1fr">
        <n-table-head>
          <n-table-row><n-table-header>Aspect</n-table-header><n-table-header>Injection</n-table-header><n-table-header>Provider</n-table-header></n-table-row>
        </n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell>Syntax</n-table-cell>
            <n-table-cell><code>&lt;el traits="hoverable"&gt;</code></n-table-cell>
            <n-table-cell><code>&lt;n-controller traits="hoverable" for=".x"&gt;</code></n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Options source</n-table-cell>
            <n-table-cell>On the element itself</n-table-cell>
            <n-table-cell>On the <code>&lt;n-controller&gt;</code></n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Targets</n-table-cell>
            <n-table-cell>The element itself</n-table-cell>
            <n-table-cell>Matched descendants (or first child)</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Dynamic</n-table-cell>
            <n-table-cell>Watches <code>traits</code> attribute changes</n-table-cell>
            <n-table-cell>Watches child additions/removals</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Requires NativeElement</n-table-cell>
            <n-table-cell>Yes (connectedCallback reads <code>traits</code>)</n-table-cell>
            <n-table-cell>No — targets can be plain <code>HTMLElement</code></n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Access controller</n-table-cell>
            <n-table-cell><code>el.getTraitController('name')</code></n-table-cell>
            <n-table-cell>Via adapter internals</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Best for</n-table-cell>
            <n-table-cell>Self-contained components</n-table-cell>
            <n-table-cell>Applying traits to plain HTML / third-party elements</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>

