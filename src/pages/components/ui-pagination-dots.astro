---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  events: `&lt;n-pagination-dots count="6" active="0" paddles id="my-dots"&gt;&lt;/n-pagination-dots&gt;

&lt;script&gt;
  document.getElementById('my-dots')
    .addEventListener('native:change', (e) =&gt; {
      console.log('index:', e.detail.index);
    });
&lt;/script&gt;`,
  programmatic: `const dots = document.querySelector('n-pagination-dots');
dots.active = 3;   // jump to index 3
dots.count = 8;    // change total count
dots.prev();       // go to previous
dots.next();       // go to next`,
};
---
<SidebarLayout title="Pagination Dots">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Pagination Dots</h1>
      </div>
    </div>
    <div data-slot="description">
      <span class="header-tag">&lt;n-pagination-dots&gt;</span> Pagination dot indicator for slideshows, onboarding flows, and step wizards. Sliding pill indicator, windowing for large counts, and optional prev/next paddles.
          </div>
  </header>

  <main>

    <!-- ── Basic ── -->

    <h2>Basic</h2>
    <n-panel bordered>
      <n-pagination-dots count="5" active="0"></n-pagination-dots>
    <pre class="layout-code"><code>&lt;n-pagination-dots count="5" active="0"&gt;&lt;/n-pagination-dots&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Different Counts ── -->

    <h2>Different Counts</h2>
    <n-panel bordered>
      <n-stack gap="4" align="start">
        <n-pagination-dots count="3" active="1"></n-pagination-dots>
        <n-pagination-dots count="5" active="2"></n-pagination-dots>
        <n-pagination-dots count="7" active="3"></n-pagination-dots>
        <n-pagination-dots count="10" active="5"></n-pagination-dots>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-pagination-dots count="3" active="1"&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="5" active="2"&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="7" active="3"&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="10" active="5"&gt;&lt;/n-pagination-dots&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Paddles ── -->

    <h2>Paddles</h2>
    <n-panel bordered>
      <n-stack gap="4" align="start">
        <n-pagination-dots count="5" active="0" paddles></n-pagination-dots>
        <n-pagination-dots count="10" active="4" paddles></n-pagination-dots>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-pagination-dots count="5" active="0" paddles&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="10" active="4" paddles&gt;&lt;/n-pagination-dots&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Vertical ── -->

    <h2>Vertical</h2>
    <n-panel bordered>
      <n-stack direction="row" gap="6" align="start">
        <n-pagination-dots count="5" active="2" orientation="vertical"></n-pagination-dots>
        <n-pagination-dots count="5" active="1" orientation="vertical" paddles></n-pagination-dots>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-pagination-dots count="5" active="2" orientation="vertical"&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="5" active="1" orientation="vertical" paddles&gt;&lt;/n-pagination-dots&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Max Dots (windowing) ── -->

    <h2>Max Dots (windowing)</h2>
    <n-panel bordered>
      <n-stack gap="4" align="start">
        <div>
          <div class="layout-label" style="margin-bottom: 0.25rem;">15 dots, max-dots=7 (default)</div>
          <n-pagination-dots count="15" active="7" paddles></n-pagination-dots>
        </div>
        <div>
          <div class="layout-label" style="margin-bottom: 0.25rem;">20 dots, max-dots=5</div>
          <n-pagination-dots count="20" active="10" paddles max-dots="5"></n-pagination-dots>
        </div>
        <div>
          <div class="layout-label" style="margin-bottom: 0.25rem;">12 dots, max-dots=3</div>
          <n-pagination-dots count="12" active="0" paddles max-dots="3"></n-pagination-dots>
        </div>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-pagination-dots count="15" active="7" paddles&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="20" active="10" paddles max-dots="5"&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="12" active="0" paddles max-dots="3"&gt;&lt;/n-pagination-dots&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-panel bordered>
      <n-stack gap="4" align="start">
        <n-stack direction="row" wrap align="center">
          <span class="layout-label">xs</span>
          <n-pagination-dots count="5" active="2" size="xs"></n-pagination-dots>
        </n-stack>
        <n-stack direction="row" wrap align="center">
          <span class="layout-label">sm</span>
          <n-pagination-dots count="5" active="2" size="sm"></n-pagination-dots>
        </n-stack>
        <n-stack direction="row" wrap align="center">
          <span class="layout-label">md</span>
          <n-pagination-dots count="5" active="2"></n-pagination-dots>
        </n-stack>
        <n-stack direction="row" wrap align="center">
          <span class="layout-label">lg</span>
          <n-pagination-dots count="5" active="2" size="lg"></n-pagination-dots>
        </n-stack>
        <n-stack direction="row" wrap align="center">
          <span class="layout-label">xl</span>
          <n-pagination-dots count="5" active="2" size="xl"></n-pagination-dots>
        </n-stack>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-pagination-dots count="5" active="2" size="xs"&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="5" active="2" size="sm"&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="5" active="2"&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="5" active="2" size="lg"&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="5" active="2" size="xl"&gt;&lt;/n-pagination-dots&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Intents ── -->

    <h2>Intents</h2>
    <n-panel bordered>
      <n-stack gap="4" align="start">
        <n-pagination-dots count="5" active="2"></n-pagination-dots>
        <n-pagination-dots count="5" active="2" intent="accent"></n-pagination-dots>
        <n-pagination-dots count="5" active="2" intent="info"></n-pagination-dots>
        <n-pagination-dots count="5" active="2" intent="success"></n-pagination-dots>
        <n-pagination-dots count="5" active="2" intent="warning"></n-pagination-dots>
        <n-pagination-dots count="5" active="2" intent="danger"></n-pagination-dots>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-pagination-dots count="5" active="2" intent="accent"&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="5" active="2" intent="success"&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="5" active="2" intent="danger"&gt;&lt;/n-pagination-dots&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Variant: plain ── -->

    <h2>Variant: plain (no container)</h2>
    <n-panel bordered>
      <n-pagination-dots count="5" active="2" variant="plain"></n-pagination-dots>
    <pre class="layout-code"><code>&lt;n-pagination-dots count="5" active="2" variant="plain"&gt;&lt;/n-pagination-dots&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Radius ── -->

    <h2>Radius</h2>
    <n-panel bordered>
      <n-stack gap="4" align="start">
        <n-stack direction="row" wrap align="center">
          <span class="layout-label">round (default)</span>
          <n-pagination-dots count="5" active="2"></n-pagination-dots>
        </n-stack>
        <n-stack direction="row" wrap align="center">
          <span class="layout-label">rounded</span>
          <n-pagination-dots count="5" active="2" radius="rounded"></n-pagination-dots>
        </n-stack>
        <n-stack direction="row" wrap align="center">
          <span class="layout-label">sharp</span>
          <n-pagination-dots count="5" active="2" radius="sharp"></n-pagination-dots>
        </n-stack>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-pagination-dots count="5" active="2"&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="5" active="2" radius="rounded"&gt;&lt;/n-pagination-dots&gt;
&lt;n-pagination-dots count="5" active="2" radius="sharp"&gt;&lt;/n-pagination-dots&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Disabled ── -->

    <h2>Disabled</h2>
    <n-panel bordered>
      <n-pagination-dots count="5" active="2" disabled></n-pagination-dots>
    <pre class="layout-code"><code>&lt;n-pagination-dots count="5" active="2" disabled&gt;&lt;/n-pagination-dots&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Events ── -->

    <h2>Interactive (event log)</h2>
    <n-panel bordered>
      <n-pagination-dots count="6" active="0" paddles id="event-demo"></n-pagination-dots>
      <div class="log" id="event-log"></div>
    <pre class="layout-code"><code set:html={codeExamples.events} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Programmatic control ── -->

    <h2>Programmatic control</h2>
    <n-panel bordered>
      <n-pagination-dots count="5" active="0" paddles id="prog-demo"></n-pagination-dots>
      <n-stack class="prog-controls" direction="row">
        <n-button size="sm" variant="secondary" id="prog-prev">Previous</n-button>
        <n-button size="sm" variant="secondary" id="prog-next">Next</n-button>
        <n-button size="sm" variant="secondary" id="prog-reset">Reset</n-button>
      </n-stack>
    <pre class="layout-code"><code set:html={codeExamples.programmatic} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Debug States ── -->

    <h2>Debug States (<code>force-*</code>)</h2>
    <n-panel bordered>
      <n-text size="xs" muted spacing="regular">
        Attribute-driven pseudo-state overrides for DevTools debugging and visual testing.
      </n-text>
      <n-stack gap="4" align="start">
        <div>
          <span class="layout-label">force-hover</span>
          <n-pagination-dots count="5" active="2" force-hover></n-pagination-dots>
        </div>
        <div>
          <span class="layout-label">force-active</span>
          <n-pagination-dots count="5" active="2" force-active></n-pagination-dots>
        </div>
        <div>
          <span class="layout-label">force-focus-visible</span>
          <n-pagination-dots count="5" active="2" force-focus-visible></n-pagination-dots>
        </div>
      </n-stack>
    </n-panel>
  </main>

  <script>
import { logPrepend } from '../../scripts/event-log';

document.addEventListener('astro:page-load', () => {
  const eventDemo = document.getElementById('event-demo');
  if (!eventDemo) return;
  const eventLog = document.getElementById('event-log');

  eventDemo.addEventListener('native:change', (e: any) => {
    logPrepend(eventLog, `native:change — index: ${e.detail.index}`);
  });

  // Programmatic control
  const prog = document.getElementById('prog-demo') as any;
  document.getElementById('prog-prev')?.addEventListener('native:press', () => prog.prev());
  document.getElementById('prog-next')?.addEventListener('native:press', () => prog.next());
  document.getElementById('prog-reset')?.addEventListener('native:press', () => { prog.active = 0; });
});
  </script>
  <style is:global>
    .prog-controls { margin-top: 0.75rem; }
  </style>
</SidebarLayout>
