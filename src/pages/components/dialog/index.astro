---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import ApiReference from '../../../components/ApiReference.astro';
import { dialogApi } from '../../../data/api/dialog';
---
<SidebarLayout title="Dialog">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Dialog</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-dialog&gt;</span> Modal dialog built on native <code>&lt;dialog&gt;</code>. Opens via <code>showModal()</code>, closes on backdrop click, Escape, or programmatically. Content is promoted to the top layer with full token re-establishment.
          </div>
  </header>

  <section>

    <!-- ── Basic Dialog ── -->

    <h2>Basic Dialog</h2>
    <n-container data-kind="panel" bordered>
      <n-button id="open-basic">Open Dialog</n-button>
      <n-dialog id="basic-dialog">
        <div class="dialog-card"><n-container>
          <n-header><span>Confirm Action</span></n-header>
          <n-body>
            <span class="text-muted">Are you sure you want to continue? This action cannot be undone.</span>
          </n-body>
          <n-footer>
            <n-button id="basic-cancel">Cancel</n-button>
            <n-button id="basic-confirm" intent="accent">Confirm</n-button>
          </n-footer>
        </n-container></div>
      </n-dialog>
      <pre class="code-block"><code>&lt;n-button id="open-btn"&gt;Open Dialog&lt;/n-button&gt;

&lt;n-dialog id="my-dialog"&gt;
  &lt;n-container&gt;
    &lt;n-header&gt;&lt;span slot="label"&gt;Confirm Action&lt;/span&gt;&lt;/n-header&gt;
    &lt;n-body&gt;
      &lt;p&gt;Are you sure you want to continue?&lt;/p&gt;
    &lt;/n-body&gt;
    &lt;n-footer&gt;
      &lt;n-button id="cancel-btn"&gt;Cancel&lt;/n-button&gt;
      &lt;n-button id="confirm-btn" intent="accent"&gt;Confirm&lt;/n-button&gt;
    &lt;/n-footer&gt;
  &lt;/n-container&gt;
&lt;/n-dialog&gt;

&lt;script&gt;
  const dialog = document.getElementById('my-dialog');
  document.getElementById('open-btn')
    .addEventListener('native:press', () =&gt; dialog.showModal());
  document.getElementById('cancel-btn')
    .addEventListener('native:press', () =&gt; dialog.close());
  document.getElementById('confirm-btn')
    .addEventListener('native:press', () =&gt; dialog.close());
&lt;/script&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Form Dialog ── -->

    <h2>Form Dialog</h2>
    <n-container data-kind="panel" bordered>
      <n-button id="open-form">Edit Profile</n-button>
      <n-dialog id="form-dialog">
        <div class="dialog-card"><n-container>
          <n-header><span>Edit Profile</span></n-header>
          <n-body>
            <span class="text-muted">Update your display name and email address.</span>
            <n-stack gap="3">
              <n-field>
                <label slot="label">Name</label>
                <n-input placeholder="Your name"></n-input>
              </n-field>
              <n-field>
                <label slot="label">Email</label>
                <n-input type="email" placeholder="you@example.com"></n-input>
              </n-field>
            </n-stack>
          </n-body>
          <n-footer>
            <n-button id="form-cancel">Cancel</n-button>
            <n-button id="form-save" intent="accent">Save Changes</n-button>
          </n-footer>
        </n-container></div>
      </n-dialog>
      <pre class="code-block"><code>&lt;n-dialog id="form-dialog"&gt;
  &lt;n-container&gt;
    &lt;n-header&gt;&lt;span slot="label"&gt;Edit Profile&lt;/span&gt;&lt;/n-header&gt;
    &lt;n-body&gt;
      &lt;n-stack gap="3"&gt;
        &lt;n-field&gt;
          &lt;label slot="label"&gt;Name&lt;/label&gt;
          &lt;n-input placeholder="Your name"&gt;&lt;/n-input&gt;
        &lt;/n-field&gt;
        &lt;n-field&gt;
          &lt;label slot="label"&gt;Email&lt;/label&gt;
          &lt;n-input type="email" placeholder="you@example.com"&gt;&lt;/n-input&gt;
        &lt;/n-field&gt;
      &lt;/n-stack&gt;
    &lt;/n-body&gt;
    &lt;n-footer&gt;
      &lt;n-button&gt;Cancel&lt;/n-button&gt;
      &lt;n-button intent="accent"&gt;Save Changes&lt;/n-button&gt;
    &lt;/n-footer&gt;
  &lt;/n-container&gt;
&lt;/n-dialog&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── No Close on Backdrop ── -->

    <h2>No Close on Backdrop</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-sm text-muted">
        This dialog has <code>no-close-on-backdrop</code> — clicking outside doesn't close it. You must use the button.
      </span>
      <n-button id="open-persistent">Open Persistent Dialog</n-button>
      <n-dialog id="persistent-dialog" no-close-on-backdrop>
        <div class="dialog-card"><n-container>
          <n-header><span>Important Notice</span></n-header>
          <n-body>
            <span class="text-muted">This dialog can only be closed by clicking the button below. Clicking the backdrop or pressing Escape won't dismiss it.</span>
          </n-body>
          <n-footer>
            <n-button id="persistent-close" intent="accent">Got it</n-button>
          </n-footer>
        </n-container></div>
      </n-dialog>
      <pre class="code-block"><code>&lt;n-dialog no-close-on-backdrop&gt;
  &lt;n-container&gt;
    &lt;n-header&gt;&lt;span slot="label"&gt;Important Notice&lt;/span&gt;&lt;/n-header&gt;
    &lt;n-body&gt;&lt;p&gt;Clicking outside won't close this dialog.&lt;/p&gt;&lt;/n-body&gt;
    &lt;n-footer&gt;
      &lt;n-button intent="accent"&gt;Got it&lt;/n-button&gt;
    &lt;/n-footer&gt;
  &lt;/n-container&gt;
&lt;/n-dialog&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── No Close on Escape ── -->

    <h2>No Close on Escape</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-sm text-muted">
        This dialog has <code>no-close-on-escape</code> — pressing Escape doesn't close it. Backdrop click still works.
      </span>
      <n-button id="open-no-esc">Open (no Escape close)</n-button>
      <n-dialog id="no-esc-dialog" no-close-on-escape>
        <div class="dialog-card"><n-container>
          <n-header><span>Escape Disabled</span></n-header>
          <n-body>
            <span class="text-muted">Press Escape — nothing happens. Click the backdrop or the button to close.</span>
          </n-body>
          <n-footer>
            <n-button id="no-esc-close">Close</n-button>
          </n-footer>
        </n-container></div>
      </n-dialog>
    </n-container>

    <!-- ── Danger Dialog ── -->

    <h2>Danger Variant</h2>
    <n-container data-kind="panel" bordered>
      <n-button id="open-danger" intent="danger">Delete Account</n-button>
      <n-dialog id="danger-dialog">
        <div class="dialog-card"><n-container>
          <n-header><span style="color: var(--n-ink-strong-danger);">Delete Account</span></n-header>
          <n-body>
            <span class="text-muted">This will permanently delete your account and all associated data. This action cannot be reversed.</span>
          </n-body>
          <n-footer>
            <n-button id="danger-cancel">Cancel</n-button>
            <n-button id="danger-confirm" intent="danger">Delete Forever</n-button>
          </n-footer>
        </n-container></div>
      </n-dialog>
      <pre class="code-block"><code>&lt;n-button intent="danger"&gt;Delete Account&lt;/n-button&gt;

&lt;n-dialog id="danger-dialog"&gt;
  &lt;n-container&gt;
    &lt;n-header&gt;
      &lt;span slot="label" style="color: var(--n-ink-strong-danger);"&gt;Delete Account&lt;/span&gt;
    &lt;/n-header&gt;
    &lt;n-body&gt;
      &lt;p&gt;This will permanently delete your account.&lt;/p&gt;
    &lt;/n-body&gt;
    &lt;n-footer&gt;
      &lt;n-button&gt;Cancel&lt;/n-button&gt;
      &lt;n-button intent="danger"&gt;Delete Forever&lt;/n-button&gt;
    &lt;/n-footer&gt;
  &lt;/n-container&gt;
&lt;/n-dialog&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <h2>API Reference</h2>
    <ApiReference data={dialogApi} />
  </section>

  <script>
    import './dialog.ts';
  </script>
  <style is:global>
    @import './dialog.css';
  </style>

</SidebarLayout>
