---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Avatar">
  <main>
<h1>&lt;n-avatar&gt;</h1>
    <p style="color: var(--n-ink-muted-neutral); font-size: 0.875rem; margin-bottom: 1.5rem;">
      User/entity image with initials fallback. Shows image, initials from name, or placeholder.
    </p>

    <!-- ── Initials ── -->

    <h2>Initials</h2>
    <div class="layout-section">
      <div class="layout-row">
        <n-avatar name="Kim Granlund"></n-avatar>
        <n-avatar name="Jane Doe"></n-avatar>
        <n-avatar name="Alice"></n-avatar>
        <n-avatar name="Bob Smith"></n-avatar>
      </div>
      <pre class="layout-code"><code>&lt;n-avatar name="Kim Granlund"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="Jane Doe"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="Alice"&gt;&lt;/n-avatar&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Fallback (no name, no src) ── -->

    <h2>Fallback</h2>
    <div class="layout-section">
      <div class="layout-row">
        <n-avatar></n-avatar>
      </div>
      <pre class="layout-code"><code>&lt;!-- No name or src: shows generic placeholder --&gt;
&lt;n-avatar&gt;&lt;/n-avatar&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Image (broken src shows initials) ── -->

    <h2>Image (broken src falls back)</h2>
    <div class="layout-section">
      <div class="layout-row">
        <n-avatar src="/nonexistent-image.jpg" name="Fallback User"></n-avatar>
      </div>
      <pre class="layout-code"><code>&lt;!-- Broken src falls back to initials from name --&gt;
&lt;n-avatar src="/photo.jpg" name="Fallback User"&gt;&lt;/n-avatar&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <div class="layout-section">
      <div class="layout-row">
        <n-avatar name="XS" size="xs"></n-avatar>
        <n-avatar name="SM" size="sm"></n-avatar>
        <n-avatar name="MD" size="md"></n-avatar>
        <n-avatar name="LG" size="lg"></n-avatar>
        <n-avatar name="XL" size="xl"></n-avatar>
      </div>
      <pre class="layout-code"><code>&lt;n-avatar name="XS" size="xs"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="SM" size="sm"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="MD" size="md"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="LG" size="lg"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="XL" size="xl"&gt;&lt;/n-avatar&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Intents ── -->

    <h2>Intents</h2>
    <div class="layout-section">
      <div class="layout-row">
        <n-avatar name="Default"></n-avatar>
        <n-avatar name="Accent" intent="accent"></n-avatar>
        <n-avatar name="Info" intent="info"></n-avatar>
        <n-avatar name="Success" intent="success"></n-avatar>
        <n-avatar name="Warning" intent="warning"></n-avatar>
        <n-avatar name="Danger" intent="danger"></n-avatar>
      </div>
      <pre class="layout-code"><code>&lt;n-avatar name="Accent" intent="accent"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="Success" intent="success"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="Danger" intent="danger"&gt;&lt;/n-avatar&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Radius ── -->

    <h2>Radius</h2>
    <div class="layout-section">
      <div class="layout-row">
        <n-avatar name="Circle"></n-avatar>
        <n-avatar name="Round" radius="round"></n-avatar>
        <n-avatar name="Sharp" radius="sharp"></n-avatar>
      </div>
      <pre class="layout-code"><code>&lt;n-avatar name="Circle"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="Round" radius="round"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="Sharp" radius="sharp"&gt;&lt;/n-avatar&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Group composition ── -->

    <h2>Avatar Group</h2>
    <div class="layout-section">
      <div class="layout-row" style="gap: -0.5rem;">
        <n-avatar name="Alice Johnson" style="outline: 2px solid var(--n-body-neutral);"></n-avatar>
        <n-avatar name="Bob Smith" style="margin-inline-start: -0.5rem; outline: 2px solid var(--n-body-neutral);"></n-avatar>
        <n-avatar name="Charlie Doe" style="margin-inline-start: -0.5rem; outline: 2px solid var(--n-body-neutral);"></n-avatar>
        <n-avatar style="margin-inline-start: -0.5rem; outline: 2px solid var(--n-body-neutral);">+3</n-avatar>
      </div>
      <pre class="layout-code"><code>&lt;!-- Overlapping avatar group with outline ring --&gt;
&lt;div style="display: flex;"&gt;
  &lt;n-avatar name="Alice" style="outline: 2px solid var(--n-body-neutral);"&gt;&lt;/n-avatar&gt;
  &lt;n-avatar name="Bob" style="margin-inline-start: -0.5rem; outline: 2px solid var(--n-body-neutral);"&gt;&lt;/n-avatar&gt;
  &lt;n-avatar style="margin-inline-start: -0.5rem; outline: 2px solid var(--n-body-neutral);"&gt;+3&lt;/n-avatar&gt;
&lt;/div&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>
  </main>

</SidebarLayout>
