---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Kbd">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Kbd</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-kbd&gt;</span> Keyboard shortcut indicator. Own font/size scale like n-badge.
          </div>
  </header>

  <section>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <span class="label">xs</span>
        <n-kbd size="xs"><n-icon name="command"></n-icon></n-kbd>
        <n-kbd size="xs">K</n-kbd>
        <n-kbd size="xs">Shift</n-kbd>
        <n-kbd size="xs"><n-icon name="command"></n-icon>K</n-kbd>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">sm</span>
        <n-kbd size="sm"><n-icon name="command"></n-icon></n-kbd>
        <n-kbd size="sm">K</n-kbd>
        <n-kbd size="sm">Shift</n-kbd>
        <n-kbd size="sm"><n-icon name="command"></n-icon>K</n-kbd>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">md</span>
        <n-kbd size="md"><n-icon name="command"></n-icon></n-kbd>
        <n-kbd size="md">K</n-kbd>
        <n-kbd size="md">Shift</n-kbd>
        <n-kbd size="md"><n-icon name="command"></n-icon>K</n-kbd>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">lg</span>
        <n-kbd size="lg"><n-icon name="command"></n-icon></n-kbd>
        <n-kbd size="lg">K</n-kbd>
        <n-kbd size="lg">Shift</n-kbd>
        <n-kbd size="lg"><n-icon name="command"></n-icon>K</n-kbd>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">xl</span>
        <n-kbd size="xl"><n-icon name="command"></n-icon></n-kbd>
        <n-kbd size="xl">K</n-kbd>
        <n-kbd size="xl">Shift</n-kbd>
        <n-kbd size="xl"><n-icon name="command"></n-icon>K</n-kbd>
      </n-stack>
      <pre class="code-block"><code>&lt;n-kbd size="sm"&gt;&lt;n-icon name="command"&gt;&lt;/n-icon&gt;K&lt;/n-kbd&gt;
&lt;n-kbd size="md"&gt;Shift&lt;/n-kbd&gt;
&lt;n-kbd size="lg"&gt;K&lt;/n-kbd&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Standalone (default = md) ── -->

    <h2>Standalone</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <n-kbd><n-icon name="command"></n-icon></n-kbd>
        <n-kbd>K</n-kbd>
        <n-kbd>Shift</n-kbd>
        <n-kbd><n-icon name="key-return"></n-icon></n-kbd>
        <n-kbd>Esc</n-kbd>
        <n-kbd><n-icon name="command"></n-icon>K</n-kbd>
        <n-kbd><n-icon name="option"></n-icon></n-kbd>
        <n-kbd><n-icon name="control"></n-icon></n-kbd>
        <n-kbd><n-icon name="backspace"></n-icon></n-kbd>
      </n-stack>
      <pre class="code-block"><code>&lt;n-kbd&gt;&lt;n-icon name="command"&gt;&lt;/n-icon&gt;&lt;/n-kbd&gt;
&lt;n-kbd&gt;K&lt;/n-kbd&gt;
&lt;n-kbd&gt;Shift&lt;/n-kbd&gt;
&lt;n-kbd&gt;&lt;n-icon name="key-return"&gt;&lt;/n-icon&gt;&lt;/n-kbd&gt;
&lt;n-kbd&gt;Esc&lt;/n-kbd&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Combinations ── -->

    <h2>Combinations</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <span><n-kbd><n-icon name="command"></n-icon></n-kbd> + <n-kbd>C</n-kbd> — Copy</span>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span><n-kbd><n-icon name="command"></n-icon></n-kbd> + <n-kbd>V</n-kbd> — Paste</span>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span><n-kbd><n-icon name="control"></n-icon></n-kbd> + <n-kbd>Shift</n-kbd> + <n-kbd>P</n-kbd> — Command palette</span>
      </n-stack>
      <pre class="code-block"><code>&lt;n-kbd&gt;&lt;n-icon name="command"&gt;&lt;/n-icon&gt;&lt;/n-kbd&gt; + &lt;n-kbd&gt;C&lt;/n-kbd&gt; — Copy
&lt;n-kbd&gt;&lt;n-icon name="command"&gt;&lt;/n-icon&gt;&lt;/n-kbd&gt; + &lt;n-kbd&gt;V&lt;/n-kbd&gt; — Paste</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Inside buttons ── -->

    <h2>Inside buttons</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <n-button size="sm">Search <n-kbd size="xs"><n-icon name="command"></n-icon>K</n-kbd></n-button>
        <n-button size="md">Save <n-kbd size="sm"><n-icon name="command"></n-icon>S</n-kbd></n-button>
        <n-button size="lg">Open <n-kbd size="sm"><n-icon name="command"></n-icon>O</n-kbd></n-button>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <n-button size="md" intent="accent">Copy <n-kbd size="sm"><n-icon name="command"></n-icon>C</n-kbd></n-button>
        <n-button size="md" intent="danger">Delete <n-kbd size="sm"><n-icon name="backspace"></n-icon></n-kbd></n-button>
      </n-stack>
      <pre class="code-block"><code>&lt;n-button size="sm"&gt;
  Search &lt;n-kbd size="xs"&gt;&lt;n-icon name="command"&gt;&lt;/n-icon&gt;K&lt;/n-kbd&gt;
&lt;/n-button&gt;
&lt;n-button size="md" intent="accent"&gt;
  Copy &lt;n-kbd size="sm"&gt;&lt;n-icon name="command"&gt;&lt;/n-icon&gt;C&lt;/n-kbd&gt;
&lt;/n-button&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Inline with text ── -->

    <h2>Inline with text</h2>
    <n-container data-kind="panel" bordered>
      <p style="font-size: 0.875rem; line-height: 1.5;">
        Press <n-kbd><n-icon name="command"></n-icon>K</n-kbd> to open search, <n-kbd>Esc</n-kbd> to close.
      </p>
      <pre class="code-block"><code>&lt;p&gt;
  Press &lt;n-kbd&gt;&lt;n-icon name="command"&gt;&lt;/n-icon&gt;K&lt;/n-kbd&gt; to open search,
  &lt;n-kbd&gt;Esc&lt;/n-kbd&gt; to close.
&lt;/p&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>
  </section>

</SidebarLayout>
