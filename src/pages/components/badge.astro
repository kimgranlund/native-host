---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Badge">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Badge</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-badge&gt;</span> Small count or status indicator. Can be standalone, overlaid (floating), or a dot.
          </div>
  </header>

  <section>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <span class="label">xs</span>
        <n-badge size="xs">3</n-badge>
        <n-badge size="xs">42</n-badge>
        <n-badge size="xs">New</n-badge>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">sm</span>
        <n-badge size="sm">3</n-badge>
        <n-badge size="sm">42</n-badge>
        <n-badge size="sm">New</n-badge>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">md</span>
        <n-badge size="md">3</n-badge>
        <n-badge size="md">42</n-badge>
        <n-badge size="md">New</n-badge>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">lg</span>
        <n-badge size="lg">3</n-badge>
        <n-badge size="lg">42</n-badge>
        <n-badge size="lg">New</n-badge>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">xl</span>
        <n-badge size="xl">3</n-badge>
        <n-badge size="xl">42</n-badge>
        <n-badge size="xl">New</n-badge>
      </n-stack>
      <pre class="code-block"><code>&lt;n-badge size="sm"&gt;3&lt;/n-badge&gt;
&lt;n-badge size="md"&gt;42&lt;/n-badge&gt;
&lt;n-badge size="lg"&gt;New&lt;/n-badge&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Intents ── -->

    <h2>Intents</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <n-badge>Default</n-badge>
        <n-badge intent="accent">Accent</n-badge>
        <n-badge intent="info">Info</n-badge>
        <n-badge intent="success">Success</n-badge>
        <n-badge intent="warning">Warning</n-badge>
        <n-badge intent="danger">Danger</n-badge>
      </n-stack>
      <pre class="code-block"><code>&lt;n-badge&gt;Default&lt;/n-badge&gt;
&lt;n-badge intent="accent"&gt;Accent&lt;/n-badge&gt;
&lt;n-badge intent="success"&gt;Success&lt;/n-badge&gt;
&lt;n-badge intent="danger"&gt;Danger&lt;/n-badge&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Variants ── -->

    <h2>Variants</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <span class="label">solid</span>
        <n-badge intent="accent">Accent</n-badge>
        <n-badge intent="info">Info</n-badge>
        <n-badge intent="success">Success</n-badge>
        <n-badge intent="warning">Warning</n-badge>
        <n-badge intent="danger">Danger</n-badge>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">outline</span>
        <n-badge variant="outline" intent="accent">Accent</n-badge>
        <n-badge variant="outline" intent="info">Info</n-badge>
        <n-badge variant="outline" intent="success">Success</n-badge>
        <n-badge variant="outline" intent="warning">Warning</n-badge>
        <n-badge variant="outline" intent="danger">Danger</n-badge>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">ghost</span>
        <n-badge variant="ghost" intent="accent">Accent</n-badge>
        <n-badge variant="ghost" intent="info">Info</n-badge>
        <n-badge variant="ghost" intent="success">Success</n-badge>
        <n-badge variant="ghost" intent="warning">Warning</n-badge>
        <n-badge variant="ghost" intent="danger">Danger</n-badge>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">default</span>
        <n-badge variant="default">Default</n-badge>
        <n-badge variant="default" intent="accent">Accent</n-badge>
        <n-badge variant="default" intent="info">Info</n-badge>
        <n-badge variant="default" intent="success">Success</n-badge>
        <n-badge variant="default" intent="warning">Warning</n-badge>
        <n-badge variant="default" intent="danger">Danger</n-badge>
      </n-stack>
      <pre class="code-block"><code>&lt;n-badge intent="accent"&gt;Solid (default)&lt;/n-badge&gt;
&lt;n-badge variant="outline" intent="accent"&gt;Outline&lt;/n-badge&gt;
&lt;n-badge variant="ghost" intent="accent"&gt;Ghost&lt;/n-badge&gt;
&lt;n-badge variant="default"&gt;Default&lt;/n-badge&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Sizes × Intents ── -->

    <h2>Sizes × Intents</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <span class="label">xs</span>
        <n-badge size="xs">7</n-badge>
        <n-badge size="xs" intent="accent">3</n-badge>
        <n-badge size="xs" intent="info">New</n-badge>
        <n-badge size="xs" intent="success">OK</n-badge>
        <n-badge size="xs" intent="warning">!</n-badge>
        <n-badge size="xs" intent="danger">5</n-badge>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">sm</span>
        <n-badge size="sm">7</n-badge>
        <n-badge size="sm" intent="accent">3</n-badge>
        <n-badge size="sm" intent="info">New</n-badge>
        <n-badge size="sm" intent="success">OK</n-badge>
        <n-badge size="sm" intent="warning">!</n-badge>
        <n-badge size="sm" intent="danger">5</n-badge>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">md</span>
        <n-badge size="md">7</n-badge>
        <n-badge size="md" intent="accent">3</n-badge>
        <n-badge size="md" intent="info">New</n-badge>
        <n-badge size="md" intent="success">OK</n-badge>
        <n-badge size="md" intent="warning">!</n-badge>
        <n-badge size="md" intent="danger">5</n-badge>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">lg</span>
        <n-badge size="lg">7</n-badge>
        <n-badge size="lg" intent="accent">3</n-badge>
        <n-badge size="lg" intent="info">New</n-badge>
        <n-badge size="lg" intent="success">OK</n-badge>
        <n-badge size="lg" intent="warning">!</n-badge>
        <n-badge size="lg" intent="danger">5</n-badge>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">xl</span>
        <n-badge size="xl">7</n-badge>
        <n-badge size="xl" intent="accent">3</n-badge>
        <n-badge size="xl" intent="info">New</n-badge>
        <n-badge size="xl" intent="success">OK</n-badge>
        <n-badge size="xl" intent="warning">!</n-badge>
        <n-badge size="xl" intent="danger">5</n-badge>
      </n-stack>
    </n-container>

    <!-- ── Radius ── -->

    <h2>Radius</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <span class="label">sharp</span>
        <n-badge radius="sharp" intent="accent">3</n-badge>
        <n-badge radius="sharp" intent="info">New</n-badge>
        <n-badge radius="sharp" intent="danger">5</n-badge>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">default (pill)</span>
        <n-badge intent="accent">3</n-badge>
        <n-badge intent="info">New</n-badge>
        <n-badge intent="danger">5</n-badge>
      </n-stack>
    </n-container>

    <!-- ── Floating ── -->

    <h2>Floating (on icons)</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <div class="icon-badge-wrapper">
          <n-button variant="ghost"><n-icon name="bell"></n-icon></n-button>
          <n-badge intent="danger" floating>5</n-badge>
        </div>
        <div class="icon-badge-wrapper">
          <n-button variant="ghost"><n-icon name="envelope-simple"></n-icon></n-button>
          <n-badge intent="accent" floating>12</n-badge>
        </div>
        <div class="icon-badge-wrapper">
          <n-button variant="ghost"><n-icon name="chat-circle"></n-icon></n-button>
          <n-badge intent="success" floating dot></n-badge>
        </div>
      </n-stack>
      <pre class="code-block"><code>&lt;!-- Position: relative wrapper + floating badge --&gt;
&lt;div style="position: relative; display: inline-flex;"&gt;
  &lt;n-button variant="ghost"&gt;
    &lt;n-icon name="bell"&gt;&lt;/n-icon&gt;
  &lt;/n-button&gt;
  &lt;n-badge intent="danger" floating&gt;5&lt;/n-badge&gt;
&lt;/div&gt;

&lt;!-- Dot indicator (no content) --&gt;
&lt;div style="position: relative; display: inline-flex;"&gt;
  &lt;n-button variant="ghost"&gt;
    &lt;n-icon name="chat-circle"&gt;&lt;/n-icon&gt;
  &lt;/n-button&gt;
  &lt;n-badge intent="success" floating dot&gt;&lt;/n-badge&gt;
&lt;/div&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Floating on Avatar ── -->

    <h2>Floating (on avatar)</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <div class="icon-badge-wrapper">
          <n-avatar name="Kim Granlund">KG</n-avatar>
          <n-badge intent="success" floating dot></n-badge>
        </div>
        <div class="icon-badge-wrapper">
          <n-avatar name="Jane Doe">JD</n-avatar>
          <n-badge intent="danger" floating>3</n-badge>
        </div>
        <div class="icon-badge-wrapper">
          <n-avatar name="Alex Smith">AS</n-avatar>
          <n-badge intent="warning" floating>!</n-badge>
        </div>
      </n-stack>
    </n-container>

    <!-- ── Dot ── -->

    <h2>Dot indicator</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <n-badge dot></n-badge>
        <n-badge intent="accent" dot></n-badge>
        <n-badge intent="info" dot></n-badge>
        <n-badge intent="success" dot></n-badge>
        <n-badge intent="warning" dot></n-badge>
        <n-badge intent="danger" dot></n-badge>
      </n-stack>
      <pre class="code-block"><code>&lt;n-badge dot&gt;&lt;/n-badge&gt;
&lt;n-badge intent="success" dot&gt;&lt;/n-badge&gt;
&lt;n-badge intent="danger" dot&gt;&lt;/n-badge&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Max ── -->

    <h2>Max (truncation)</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <n-badge max="99">150</n-badge>
        <n-badge max="9" intent="danger">12</n-badge>
        <n-badge max="99" intent="accent">5</n-badge>
        <n-badge max="999" intent="info">1234</n-badge>
      </n-stack>
      <pre class="code-block"><code>&lt;!-- Clamps display to max value --&gt;
&lt;n-badge max="99"&gt;150&lt;/n-badge&gt;   &lt;!-- shows "99+" --&gt;
&lt;n-badge max="9" intent="danger"&gt;12&lt;/n-badge&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Inline with text ── -->

    <h2>Inline with text</h2>
    <n-container data-kind="panel" bordered>
      <p style="font-size: 0.875rem; line-height: 1.5;">
        Messages <n-badge intent="accent">3</n-badge> &nbsp;
        Notifications <n-badge intent="danger">12</n-badge> &nbsp;
        Updates <n-badge intent="info">New</n-badge> &nbsp;
        Status <n-badge intent="success">OK</n-badge>
      </p>
    </n-container>

    <!-- ── Inline with buttons ── -->

    <h2>Inline with buttons</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <n-button size="sm">Inbox <n-badge intent="accent" size="xs">3</n-badge></n-button>
        <n-button size="md">Alerts <n-badge intent="danger" size="xs">7</n-badge></n-button>
        <n-button size="lg" intent="accent">Tasks <n-badge variant="outline" size="sm">12</n-badge></n-button>
      </n-stack>
      <pre class="code-block"><code>&lt;n-button&gt;
  Inbox &lt;n-badge intent="accent" size="xs"&gt;3&lt;/n-badge&gt;
&lt;/n-button&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>
  </section>

  <style is:global>
    .icon-badge-wrapper {
      position: relative;
      display: inline-flex;
    }

    /* ── Code Blocks ── */
</style>

</SidebarLayout>
