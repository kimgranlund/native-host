---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import ApiReference from '../../../components/ApiReference.astro';
import { commandApi } from '../../../data/api/command';

const codeExamples = {
  basicCommandPalette: `&lt;n-command&gt;
  &lt;n-command-input&gt;
    &lt;n-icon name="magnifying-glass"&gt;&lt;/n-icon&gt;
    &lt;input type="text" placeholder="Type to search..." /&gt;
  &lt;/n-command-input&gt;
  &lt;n-command-list&gt;
    &lt;n-command-item value="new-file"&gt;&lt;n-icon name="plus"&gt;&lt;/n-icon&gt; New File&lt;/n-command-item&gt;
    &lt;n-command-item value="open-file"&gt;&lt;n-icon name="folder-open"&gt;&lt;/n-icon&gt; Open File&lt;/n-command-item&gt;
    &lt;n-command-item value="save"&gt;&lt;n-icon name="floppy-disk"&gt;&lt;/n-icon&gt; Save&lt;/n-command-item&gt;
  &lt;/n-command-list&gt;
  &lt;n-command-empty&gt;No results found.&lt;/n-command-empty&gt;
&lt;/n-command&gt;

&lt;script&gt;
  command.addEventListener('native:change', (e) =&gt; {
    console.log(e.detail.value, e.detail.label);
  });
&lt;/script&gt;`,
};
---
<SidebarLayout title="Command">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Command</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-command&gt;</span> Command palette with search filtering, keyboard navigation, and grouped items.
          </div>
  </header>

  <section>

    <!-- ── Basic ── -->

    <h2>Basic Command Palette</h2>
    <n-container data-kind="panel" bordered intent="neutral" variant="secondary">
      <div class="grid">
        <n-stack>
          <span class="col-label">Simple list</span>
          <n-command id="basic-command">
            <n-command-input>
              <n-icon name="magnifying-glass"></n-icon>
              <input type="text" placeholder="Type to search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="new-file"><n-icon name="plus"></n-icon> New File</n-command-item>
              <n-command-item value="open-file"><n-icon name="folder-open"></n-icon> Open File</n-command-item>
              <n-command-item value="save"><n-icon name="floppy-disk"></n-icon> Save</n-command-item>
              <n-command-item value="save-as"><n-icon name="floppy-disk"></n-icon> Save As...</n-command-item>
              <n-command-item value="close"><n-icon name="x"></n-icon> Close Tab</n-command-item>
              <n-command-item value="settings"><n-icon name="gear"></n-icon> Settings</n-command-item>
            </n-command-list>
            <n-command-empty>No results found.</n-command-empty>
          </n-command>
          <div class="log" id="basic-log"></div>
        </n-stack>
      </div>
      <pre class="code-block"><code set:html={codeExamples.basicCommandPalette} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Grouped ── -->

    <h2>Grouped Commands</h2>
    <n-container data-kind="panel" bordered intent="neutral" variant="secondary">
      <div class="grid">
        <n-stack>
          <span class="col-label">With groups and shortcuts</span>
          <n-command id="grouped-command">
            <n-command-input>
              <n-icon name="magnifying-glass"></n-icon>
              <input type="text" placeholder="Search commands..." />
            </n-command-input>
            <n-command-list>
              <n-command-group>
                <div slot="heading">File</div>
                <n-command-item value="new-file" keywords="create">
                  <n-icon name="plus"></n-icon> New File <span class="shortcut">Cmd+N</span>
                </n-command-item>
                <n-command-item value="open-file" keywords="browse load">
                  <n-icon name="folder-open"></n-icon> Open File <span class="shortcut">Cmd+O</span>
                </n-command-item>
                <n-command-item value="save" keywords="write store">
                  <n-icon name="floppy-disk"></n-icon> Save <span class="shortcut">Cmd+S</span>
                </n-command-item>
              </n-command-group>
              <n-command-group>
                <div slot="heading">Edit</div>
                <n-command-item value="undo" keywords="revert">
                  <n-icon name="arrow-counter-clockwise"></n-icon> Undo <span class="shortcut">Cmd+Z</span>
                </n-command-item>
                <n-command-item value="redo">
                  <n-icon name="arrow-clockwise"></n-icon> Redo <span class="shortcut">Cmd+Shift+Z</span>
                </n-command-item>
                <n-command-item value="copy" keywords="clipboard">
                  <n-icon name="copy"></n-icon> Copy <span class="shortcut">Cmd+C</span>
                </n-command-item>
                <n-command-item value="paste" keywords="clipboard">
                  <n-icon name="clipboard-text"></n-icon> Paste <span class="shortcut">Cmd+V</span>
                </n-command-item>
              </n-command-group>
              <n-command-group>
                <div slot="heading">View</div>
                <n-command-item value="zoom-in" keywords="magnify enlarge">
                  <n-icon name="magnifying-glass-plus"></n-icon> Zoom In <span class="shortcut">Cmd++</span>
                </n-command-item>
                <n-command-item value="zoom-out" keywords="shrink reduce">
                  <n-icon name="magnifying-glass-minus"></n-icon> Zoom Out <span class="shortcut">Cmd+-</span>
                </n-command-item>
                <n-command-item value="fullscreen" keywords="maximize expand">
                  <n-icon name="arrows-out"></n-icon> Toggle Fullscreen <span class="shortcut">F11</span>
                </n-command-item>
              </n-command-group>
            </n-command-list>
            <n-command-empty>No matching commands.</n-command-empty>
          </n-command>
        </n-stack>
      </div>
      <pre class="code-block"><code>&lt;n-command&gt;
  &lt;n-command-input&gt;
    &lt;n-icon name="magnifying-glass"&gt;&lt;/n-icon&gt;
    &lt;input type="text" placeholder="Search commands..." /&gt;
  &lt;/n-command-input&gt;
  &lt;n-command-list&gt;
    &lt;n-command-group&gt;
      &lt;div slot="heading"&gt;File&lt;/div&gt;
      &lt;n-command-item value="new-file" keywords="create"&gt;
        &lt;n-icon name="plus"&gt;&lt;/n-icon&gt; New File
      &lt;/n-command-item&gt;
      &lt;n-command-item value="save" keywords="write store"&gt;
        &lt;n-icon name="floppy-disk"&gt;&lt;/n-icon&gt; Save
      &lt;/n-command-item&gt;
    &lt;/n-command-group&gt;
    &lt;n-command-group&gt;
      &lt;div slot="heading"&gt;Edit&lt;/div&gt;
      &lt;n-command-item value="undo"&gt;
        &lt;n-icon name="arrow-counter-clockwise"&gt;&lt;/n-icon&gt; Undo
      &lt;/n-command-item&gt;
    &lt;/n-command-group&gt;
  &lt;/n-command-list&gt;
  &lt;n-command-empty&gt;No matching commands.&lt;/n-command-empty&gt;
&lt;/n-command&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── With Disabled Items ── -->

    <h2>Disabled Items</h2>
    <n-container data-kind="panel" bordered intent="neutral" variant="secondary">
      <div class="grid">
        <n-stack>
          <span class="col-label">Some items disabled</span>
          <n-command>
            <n-command-input>
              <n-icon name="magnifying-glass"></n-icon>
              <input type="text" placeholder="Search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="cut"><n-icon name="scissors"></n-icon> Cut</n-command-item>
              <n-command-item value="copy"><n-icon name="copy"></n-icon> Copy</n-command-item>
              <n-command-item value="paste" disabled><n-icon name="clipboard-text"></n-icon> Paste (clipboard empty)</n-command-item>
              <n-command-item value="delete"><n-icon name="trash"></n-icon> Delete</n-command-item>
              <n-command-item value="select-all"><n-icon name="selection-all"></n-icon> Select All</n-command-item>
            </n-command-list>
          </n-command>
        </n-stack>
      </div>
      <pre class="code-block"><code>&lt;n-command-item value="paste" disabled&gt;
  &lt;n-icon name="clipboard-text"&gt;&lt;/n-icon&gt; Paste (clipboard empty)
&lt;/n-command-item&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-container data-kind="panel" bordered variant="secondary">
      <div class="grid">
        <n-stack>
          <span class="col-label">sm</span>
          <n-command size="sm">
            <n-command-input>
              <input type="text" placeholder="Search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="a">Alpha</n-command-item>
              <n-command-item value="b">Bravo</n-command-item>
              <n-command-item value="c">Charlie</n-command-item>
            </n-command-list>
          </n-command>
        </n-stack>
        <n-stack>
          <span class="col-label">md (default)</span>
          <n-command size="md">
            <n-command-input>
              <input type="text" placeholder="Search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="a">Alpha</n-command-item>
              <n-command-item value="b">Bravo</n-command-item>
              <n-command-item value="c">Charlie</n-command-item>
            </n-command-list>
          </n-command>
        </n-stack>
        <n-stack>
          <span class="col-label">lg</span>
          <n-command size="lg">
            <n-command-input>
              <input type="text" placeholder="Search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="a">Alpha</n-command-item>
              <n-command-item value="b">Bravo</n-command-item>
              <n-command-item value="c">Charlie</n-command-item>
            </n-command-list>
          </n-command>
        </n-stack>
      </div>
    </n-container>

    <!-- ── Variants ── -->

    <h2>Variants</h2>
    <n-container data-kind="panel" bordered size="sm">
      <div class="grid">
        <n-stack>
          <span class="col-label">secondary</span>
          <n-command variant="secondary">
            <n-command-input>
              <input type="text" placeholder="Search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="a">Alpha</n-command-item>
              <n-command-item value="b">Bravo</n-command-item>
              <n-command-item value="c">Charlie</n-command-item>
            </n-command-list>
          </n-command>
        </n-stack>
        <n-stack>
          <span class="col-label">outline</span>
          <n-command variant="outline">
            <n-command-input>
              <input type="text" placeholder="Search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="a">Alpha</n-command-item>
              <n-command-item value="b">Bravo</n-command-item>
              <n-command-item value="c">Charlie</n-command-item>
            </n-command-list>
          </n-command>
        </n-stack>
        <n-stack>
          <span class="col-label">default</span>
          <n-command variant="default">
            <n-command-input>
              <input type="text" placeholder="Search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="a">Alpha</n-command-item>
              <n-command-item value="b">Bravo</n-command-item>
              <n-command-item value="c">Charlie</n-command-item>
            </n-command-list>
          </n-command>
        </n-stack>
      </div>
    </n-container>

    <!-- ── Density ── -->

    <h2>Density</h2>
    <n-container data-kind="panel" bordered size="md" variant="secondary">
      <div class="grid">
        <n-stack density="loose">
          <span class="col-label">loose</span>
          <n-command>
            <n-command-input>
              <input type="text" placeholder="Search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="a">Alpha</n-command-item>
              <n-command-item value="b">Bravo</n-command-item>
              <n-command-item value="c">Charlie</n-command-item>
            </n-command-list>
          </n-command>
        </n-stack>
        <n-stack density="default">
          <span class="col-label">default</span>
          <n-command>
            <n-command-input>
              <input type="text" placeholder="Search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="a">Alpha</n-command-item>
              <n-command-item value="b">Bravo</n-command-item>
              <n-command-item value="c">Charlie</n-command-item>
            </n-command-list>
          </n-command>
        </n-stack>
        <n-stack density="compact">
          <span class="col-label">compact</span>
          <n-command>
            <n-command-input>
              <input type="text" placeholder="Search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="a">Alpha</n-command-item>
              <n-command-item value="b">Bravo</n-command-item>
              <n-command-item value="c">Charlie</n-command-item>
            </n-command-list>
          </n-command>
        </n-stack>
      </div>
    </n-container>

    <!-- ── Radius ── -->

    <h2>Radius</h2>
    <n-container data-kind="panel" bordered size="sm" variant="secondary">
      <div class="grid">
        <n-stack radius="sharp">
          <span class="col-label">sharp</span>
          <n-command>
            <n-command-input>
              <input type="text" placeholder="Search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="a">Alpha</n-command-item>
              <n-command-item value="b">Bravo</n-command-item>
              <n-command-item value="c">Charlie</n-command-item>
            </n-command-list>
          </n-command>
        </n-stack>
        <n-stack radius="default">
          <span class="col-label">default</span>
          <n-command>
            <n-command-input>
              <input type="text" placeholder="Search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="a">Alpha</n-command-item>
              <n-command-item value="b">Bravo</n-command-item>
              <n-command-item value="c">Charlie</n-command-item>
            </n-command-list>
          </n-command>
        </n-stack>
        <n-stack radius="round">
          <span class="col-label">round</span>
          <n-command>
            <n-command-input>
              <input type="text" placeholder="Search..." />
            </n-command-input>
            <n-command-list>
              <n-command-item value="a">Alpha</n-command-item>
              <n-command-item value="b">Bravo</n-command-item>
              <n-command-item value="c">Charlie</n-command-item>
            </n-command-list>
          </n-command>
        </n-stack>
      </div>
    </n-container>

    <!-- ── Cascading ── -->

    <h2>Cascading</h2>
    <n-container data-kind="panel" bordered>
      <h3>Section cascading all attributes</h3>
      <n-body size="sm" density="compact" radius="round" intent="accent">
        <div class="grid">
          <n-stack>
            <span class="col-label">All inherited (secondary)</span>
            <n-command variant="secondary">
              <n-command-input>
                <input type="text" placeholder="Search..." />
              </n-command-input>
              <n-command-list>
                <n-command-item value="a">Alpha</n-command-item>
                <n-command-item value="b">Bravo</n-command-item>
                <n-command-item value="c">Charlie</n-command-item>
              </n-command-list>
            </n-command>
          </n-stack>
          <n-stack>
            <span class="col-label">All inherited (outline)</span>
            <n-command variant="outline">
              <n-command-input>
                <input type="text" placeholder="Search..." />
              </n-command-input>
              <n-command-list>
                <n-command-item value="a">Alpha</n-command-item>
                <n-command-item value="b">Bravo</n-command-item>
                <n-command-item value="c">Charlie</n-command-item>
              </n-command-list>
            </n-command>
          </n-stack>
        </div>
      </n-body>
    </n-container>

    <!-- ── Keyboard Instructions ── -->

    <h2>Keyboard Navigation</h2>
    <n-container data-kind="panel" bordered>
      <div class="keyboard-table">
      <n-table variant="plain" size="sm" cols="auto 1fr">
        <n-table-head>
          <n-table-row>
            <n-table-header>Key</n-table-header>
            <n-table-header>Action</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body>
          <n-table-row><n-table-cell><code>Arrow Down</code></n-table-cell><n-table-cell>Move to next item</n-table-cell></n-table-row>
          <n-table-row><n-table-cell><code>Arrow Up</code></n-table-cell><n-table-cell>Move to previous item</n-table-cell></n-table-row>
          <n-table-row><n-table-cell><code>Home</code></n-table-cell><n-table-cell>Jump to first item</n-table-cell></n-table-row>
          <n-table-row><n-table-cell><code>End</code></n-table-cell><n-table-cell>Jump to last item</n-table-cell></n-table-row>
          <n-table-row><n-table-cell><code>Enter</code></n-table-cell><n-table-cell>Select active item</n-table-cell></n-table-row>
          <n-table-row><n-table-cell><code>Escape</code></n-table-cell><n-table-cell>Dismiss (fires native:dismiss event)</n-table-cell></n-table-row>
          <n-table-row><n-table-cell><code>Type</code></n-table-cell><n-table-cell>Filter items by search text</n-table-cell></n-table-row>
        </n-table-body>
      </n-table>
      </div>
    </n-container>

    <h2>API Reference</h2>
    <ApiReference data={commandApi} />
  </section>

  <script>
    import './command.ts';
  </script>
  <style is:global>
    @import './command.css';
  </style>

</SidebarLayout>
