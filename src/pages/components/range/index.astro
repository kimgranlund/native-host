---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import ApiReference from '../../../components/ApiReference.astro';
import { rangeApi } from '../../../data/api/range';

const codeExamples = {
  liveValue: `&lt;n-range id="zoom" min="50" max="200" step="10" value="100"&gt;&lt;/n-range&gt;

&lt;script&gt;
  document.getElementById('zoom')
    .addEventListener('native:input', (e) =&gt; {
      console.log('Zoom:', e.detail.value + '%');
    });
&lt;/script&gt;`,
};
---
<SidebarLayout title="Range">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Range</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-range&gt;</span> Slider input with thumb on a track. Keyboard: Arrow ±step, Page ±10×step, Home/End.
          </div>
  </header>

  <section>

    <!-- ── Basic ── -->

    <h2>Basic</h2>
    <n-container data-kind="panel" bordered>
      <n-stack gap="4">
        <n-field>
          <label slot="label">Volume</label>
          <n-range value="75"></n-range>
        </n-field>
        <n-field>
          <label slot="label">Brightness</label>
          <n-range value="50"></n-range>
        </n-field>
      </n-stack>
    <pre class="code-block"><code>&lt;n-field&gt;
  &lt;label slot="label"&gt;Volume&lt;/label&gt;
  &lt;n-range value="75"&gt;&lt;/n-range&gt;
&lt;/n-field&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Custom Range ── -->

    <h2>Custom Range</h2>
    <n-container data-kind="panel" bordered>
      <n-stack gap="4">
        <n-field>
          <label slot="label">Temperature (°F)</label>
          <n-range min="60" max="85" step="1" value="72"></n-range>
          <span slot="description">60°F – 85°F</span>
        </n-field>
        <n-field>
          <label slot="label">Opacity</label>
          <n-range min="0" max="1" step="0.1" value="0.8"></n-range>
          <span slot="description">0 – 1, step 0.1</span>
        </n-field>
      </n-stack>
    <pre class="code-block"><code>&lt;n-field&gt;
  &lt;label slot="label"&gt;Temperature (&deg;F)&lt;/label&gt;
  &lt;n-range min="60" max="85" step="1" value="72"&gt;&lt;/n-range&gt;
  &lt;span slot="description"&gt;60&deg;F &ndash; 85&deg;F&lt;/span&gt;
&lt;/n-field&gt;

&lt;n-field&gt;
  &lt;label slot="label"&gt;Opacity&lt;/label&gt;
  &lt;n-range min="0" max="1" step="0.1" value="0.8"&gt;&lt;/n-range&gt;
&lt;/n-field&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Disabled ── -->

    <h2>Disabled</h2>
    <n-container data-kind="panel" bordered>
      <n-field disabled>
        <label slot="label">Locked slider</label>
        <n-range value="30"></n-range>
      </n-field>
    <pre class="code-block"><code>&lt;n-field disabled&gt;
  &lt;label slot="label"&gt;Locked slider&lt;/label&gt;
  &lt;n-range value="30"&gt;&lt;/n-range&gt;
&lt;/n-field&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <span class="label">xs</span>
        <n-range size="xs" value="40"></n-range>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">sm</span>
        <n-range size="sm" value="50"></n-range>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">md</span>
        <n-range size="md" value="60"></n-range>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">lg</span>
        <n-range size="lg" value="70"></n-range>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">xl</span>
        <n-range size="xl" value="80"></n-range>
      </n-stack>
      <pre class="code-block"><code>&lt;n-range size="xs" value="40"&gt;&lt;/n-range&gt;
&lt;n-range size="sm" value="50"&gt;&lt;/n-range&gt;
&lt;n-range size="md" value="60"&gt;&lt;/n-range&gt;
&lt;n-range size="lg" value="70"&gt;&lt;/n-range&gt;
&lt;n-range size="xl" value="80"&gt;&lt;/n-range&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Density ── -->

    <h2>Density</h2>
    <n-container data-kind="panel" bordered>
      <h3>compact</h3>
      <n-stack gap="4" density="compact">
        <n-range size="sm" value="40"></n-range>
        <n-range value="60"></n-range>
        <n-range size="lg" value="80"></n-range>
      </n-stack>
      <h3>default</h3>
      <n-stack gap="4">
        <n-range size="sm" value="40"></n-range>
        <n-range value="60"></n-range>
        <n-range size="lg" value="80"></n-range>
      </n-stack>
      <h3>loose</h3>
      <n-stack gap="4" density="loose">
        <n-range size="sm" value="40"></n-range>
        <n-range value="60"></n-range>
        <n-range size="lg" value="80"></n-range>
      </n-stack>
      <pre class="code-block"><code>&lt;div density="compact"&gt;
  &lt;n-range value="60"&gt;&lt;/n-range&gt;
&lt;/div&gt;
&lt;n-range value="60"&gt;&lt;/n-range&gt;
&lt;div density="loose"&gt;
  &lt;n-range value="60"&gt;&lt;/n-range&gt;
&lt;/div&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Intents ── -->

    <h2>Intents</h2>
    <n-container data-kind="panel" bordered>
      <n-stack gap="4">
        <n-range intent="neutral" value="50"></n-range>
        <n-range intent="accent" value="65"></n-range>
        <n-range intent="info" value="55"></n-range>
        <n-range intent="success" value="85"></n-range>
        <n-range intent="warning" value="45"></n-range>
        <n-range intent="danger" value="25"></n-range>
      </n-stack>
    <pre class="code-block"><code>&lt;n-range intent="accent" value="65"&gt;&lt;/n-range&gt;
&lt;n-range intent="success" value="85"&gt;&lt;/n-range&gt;
&lt;n-range intent="warning" value="45"&gt;&lt;/n-range&gt;
&lt;n-range intent="danger" value="25"&gt;&lt;/n-range&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Validation ── -->

    <h2>Validation</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Range sliders support <code>required</code> — reports <code>valueMissing</code> when required.
      </span>
      <n-field required>
        <label slot="label">Rating</label>
        <n-range required min="1" max="10" name="rating"></n-range>
        <span slot="description">Rate from 1 to 10</span>
        <span slot="error">A rating is required</span>
      </n-field>
      <pre class="code-block"><code>&lt;n-field required&gt;
  &lt;label slot="label"&gt;Rating&lt;/label&gt;
  &lt;n-range required min="1" max="10" name="rating"&gt;&lt;/n-range&gt;
  &lt;span slot="error"&gt;A rating is required&lt;/span&gt;
&lt;/n-field&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Cascading ── -->

    <h2>Cascading</h2>
    <n-container data-kind="panel" bordered>
      <h3>Parent size="sm", intent="success"</h3>
      <n-stack gap="4" size="sm" intent="success">
        <n-range value="50"></n-range>
        <n-range size="lg" value="70"></n-range>
        <n-range intent="danger" value="30"></n-range>
      </n-stack>
      <pre class="code-block"><code>&lt;div size="sm" intent="success"&gt;
  &lt;n-range value="50"&gt;&lt;/n-range&gt;
  &lt;n-range size="lg" value="70"&gt;&lt;/n-range&gt;
  &lt;n-range intent="danger" value="30"&gt;&lt;/n-range&gt;
&lt;/div&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Live Value ── -->

    <h2>Live Value</h2>
    <n-container data-kind="panel" bordered>
      <n-field>
        <label slot="label">Zoom: <span id="zoom-value" class="value-display">100%</span></label>
        <n-range id="zoom-range" min="50" max="200" step="10" value="100"></n-range>
      </n-field>
    <pre class="code-block"><code set:html={codeExamples.liveValue} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Debug States (force-*) ── -->

    <h2>Debug States (<code>force-*</code>)</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Attribute-driven pseudo-state overrides for DevTools debugging and visual testing.
      </span>
      <n-stack gap="4">
        <div>
          <div class="label" style="width: auto; margin-bottom: 0.5rem;">force-hover</div>
          <n-range force-hover value="50"></n-range>
        </div>
        <div>
          <div class="label" style="width: auto; margin-bottom: 0.5rem;">force-active</div>
          <n-range force-active value="50"></n-range>
        </div>
        <div>
          <div class="label" style="width: auto; margin-bottom: 0.5rem;">force-focus-visible</div>
          <n-range force-focus-visible value="50"></n-range>
        </div>
      </n-stack>
    </n-container>

    <h2>API Reference</h2>
    <ApiReference data={rangeApi} />
  </section>

  <script>
    import './range.ts';
  </script>
  <style is:global>
    @import './range.css';
  </style>

</SidebarLayout>
