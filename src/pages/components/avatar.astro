---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  group: `&lt;!-- Overlapping avatar group with outline ring --&gt;
&lt;div class="avatar-group"&gt;
  &lt;n-avatar name="Alice"&gt;&lt;/n-avatar&gt;
  &lt;n-avatar name="Bob"&gt;&lt;/n-avatar&gt;
  &lt;n-avatar&gt;+3&lt;/n-avatar&gt;
&lt;/div&gt;

&lt;style&gt;
  .avatar-group { display: flex; }
  .avatar-group n-avatar + n-avatar { margin-inline-start: -0.5rem; }
  .avatar-group n-avatar { outline: 2px solid var(--n-body-neutral); }
&lt;/style&gt;`,
};
---
<SidebarLayout title="Avatar">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Avatar</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-avatar&gt;</span> User/entity image with initials fallback. Shows image, initials from name, or placeholder.
          </div>
  </header>

  <section>

    <!-- ── Initials ── -->

    <h2>Initials</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <n-avatar name="Kim Granlund"></n-avatar>
        <n-avatar name="Jane Doe"></n-avatar>
        <n-avatar name="Alice"></n-avatar>
        <n-avatar name="Bob Smith"></n-avatar>
      </n-stack>
      <pre class="code-block"><code>&lt;n-avatar name="Kim Granlund"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="Jane Doe"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="Alice"&gt;&lt;/n-avatar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Fallback (no name, no src) ── -->

    <h2>Fallback</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <n-avatar></n-avatar>
      </n-stack>
      <pre class="code-block"><code>&lt;!-- No name or src: shows generic placeholder --&gt;
&lt;n-avatar&gt;&lt;/n-avatar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Image (broken src shows initials) ── -->

    <h2>Image (broken src falls back)</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <n-avatar src="/nonexistent-image.jpg" name="Fallback User"></n-avatar>
      </n-stack>
      <pre class="code-block"><code>&lt;!-- Broken src falls back to initials from name --&gt;
&lt;n-avatar src="/photo.jpg" name="Fallback User"&gt;&lt;/n-avatar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <n-avatar name="XS" size="xs"></n-avatar>
        <n-avatar name="SM" size="sm"></n-avatar>
        <n-avatar name="MD" size="md"></n-avatar>
        <n-avatar name="LG" size="lg"></n-avatar>
        <n-avatar name="XL" size="xl"></n-avatar>
      </n-stack>
      <pre class="code-block"><code>&lt;n-avatar name="XS" size="xs"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="SM" size="sm"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="MD" size="md"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="LG" size="lg"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="XL" size="xl"&gt;&lt;/n-avatar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Intents ── -->

    <h2>Intents</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <n-avatar name="Default"></n-avatar>
        <n-avatar name="Accent" intent="accent"></n-avatar>
        <n-avatar name="Info" intent="info"></n-avatar>
        <n-avatar name="Success" intent="success"></n-avatar>
        <n-avatar name="Warning" intent="warning"></n-avatar>
        <n-avatar name="Danger" intent="danger"></n-avatar>
      </n-stack>
      <pre class="code-block"><code>&lt;n-avatar name="Accent" intent="accent"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="Success" intent="success"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="Danger" intent="danger"&gt;&lt;/n-avatar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Radius ── -->

    <h2>Radius</h2>
    <n-panel bordered>
      <n-stack direction="row" wrap align="center">
        <n-avatar name="Circle"></n-avatar>
        <n-avatar name="Round" radius="round"></n-avatar>
        <n-avatar name="Sharp" radius="sharp"></n-avatar>
      </n-stack>
      <pre class="code-block"><code>&lt;n-avatar name="Circle"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="Round" radius="round"&gt;&lt;/n-avatar&gt;
&lt;n-avatar name="Sharp" radius="sharp"&gt;&lt;/n-avatar&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Group composition ── -->

    <h2>Avatar Group</h2>
    <n-panel bordered>
      <div class="avatar-group">
        <n-avatar name="Alice Johnson"></n-avatar>
        <n-avatar name="Bob Smith"></n-avatar>
        <n-avatar name="Charlie Doe"></n-avatar>
        <n-avatar>+3</n-avatar>
      </div>
      <pre class="code-block"><code set:html={codeExamples.group} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>
  </section>

  <style is:global>
    .avatar-group {
      display: flex;
    }
    /* TODO(T0071): avatar-group pattern needs component API (n-avatar-group) */
    .avatar-group n-avatar + n-avatar {
      margin-inline-start: -0.5rem;
    }
    .avatar-group n-avatar {
      outline: 2px solid var(--n-body-neutral);
    }
  </style>
</SidebarLayout>
