---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import ApiReference from '../../../components/ApiReference.astro';
import { slideshowApi } from '../../../data/api/slideshow';

const codeExamples = {
  eventLog: `&lt;n-slideshow controls indicators id="my-slideshow"&gt;
  &lt;n-slide&gt;&lt;div&gt;A&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;B&lt;/div&gt;&lt;/n-slide&gt;
&lt;/n-slideshow&gt;

&lt;script&gt;
  document.getElementById('my-slideshow')
    .addEventListener('native:slide-change', (e) =&gt; {
      console.log('index:', e.detail.index);
    });
&lt;/script&gt;`,
};
---
<SidebarLayout title="Slideshow">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Slideshow</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-slideshow&gt;</span> CSS-first carousel using scroll-snap, IntersectionObserver, and zero JS for touch/swipe.
          </div>
  </header>

  <section>

    <!-- ── Basic ── -->

    <h2>Basic (swipe to navigate)</h2>
    <n-container data-kind="panel" bordered>
      <n-slideshow>
        <n-slide><div class="slide-content slide-1">1</div></n-slide>
        <n-slide><div class="slide-content slide-2">2</div></n-slide>
        <n-slide><div class="slide-content slide-3">3</div></n-slide>
      </n-slideshow>
    <pre class="code-block"><code>&lt;n-slideshow&gt;
  &lt;n-slide&gt;&lt;div&gt;Slide 1&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;Slide 2&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;Slide 3&lt;/div&gt;&lt;/n-slide&gt;
&lt;/n-slideshow&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Controls + Indicators ── -->

    <h2>Controls + Indicators</h2>
    <n-container data-kind="panel" bordered>
      <n-slideshow controls indicators>
        <n-slide><div class="slide-content slide-1">Slide 1</div></n-slide>
        <n-slide><div class="slide-content slide-2">Slide 2</div></n-slide>
        <n-slide><div class="slide-content slide-3">Slide 3</div></n-slide>
        <n-slide><div class="slide-content slide-4">Slide 4</div></n-slide>
      </n-slideshow>
    <pre class="code-block"><code>&lt;n-slideshow controls indicators&gt;
  &lt;n-slide&gt;&lt;div&gt;Slide 1&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;Slide 2&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;Slide 3&lt;/div&gt;&lt;/n-slide&gt;
&lt;/n-slideshow&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Autoplay + Loop ── -->

    <h2>Autoplay + Loop</h2>
    <n-container data-kind="panel" bordered>
      <n-slideshow controls indicators autoplay interval="3000" loop>
        <n-slide><div class="slide-content slide-1">A</div></n-slide>
        <n-slide><div class="slide-content slide-2">B</div></n-slide>
        <n-slide><div class="slide-content slide-3">C</div></n-slide>
      </n-slideshow>
    <pre class="code-block"><code>&lt;n-slideshow controls indicators autoplay interval="3000" loop&gt;
  &lt;n-slide&gt;&lt;div&gt;A&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;B&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;C&lt;/div&gt;&lt;/n-slide&gt;
&lt;/n-slideshow&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Vertical ── -->

    <h2>Vertical</h2>
    <n-container data-kind="panel" bordered>
      <div class="vertical-demo"><n-slideshow direction="vertical" controls indicators>
        <n-slide><div class="slide-content slide-1">Top</div></n-slide>
        <n-slide><div class="slide-content slide-2">Middle</div></n-slide>
        <n-slide><div class="slide-content slide-3">Bottom</div></n-slide>
      </n-slideshow></div>
    <pre class="code-block"><code>&lt;n-slideshow direction="vertical" controls indicators&gt;
  &lt;n-slide&gt;&lt;div&gt;Top&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;Middle&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;Bottom&lt;/div&gt;&lt;/n-slide&gt;
&lt;/n-slideshow&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Peek ── -->

    <h2>Peek (adjacent slides visible)</h2>
    <n-container data-kind="panel" bordered>
      <n-slideshow controls indicators peek>
        <n-slide><div class="slide-content slide-1">1</div></n-slide>
        <n-slide><div class="slide-content slide-2">2</div></n-slide>
        <n-slide><div class="slide-content slide-3">3</div></n-slide>
        <n-slide><div class="slide-content slide-4">4</div></n-slide>
        <n-slide><div class="slide-content slide-5">5</div></n-slide>
      </n-slideshow>
    <pre class="code-block"><code>&lt;n-slideshow controls indicators peek&gt;
  &lt;n-slide&gt;&lt;div&gt;1&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;2&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;3&lt;/div&gt;&lt;/n-slide&gt;
&lt;/n-slideshow&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Per-view 3 with gap ── -->

    <h2>Per-view 3 + Gap</h2>
    <n-container data-kind="panel" bordered>
      <n-slideshow controls indicators per-view="3" gap>
        <n-slide><div class="slide-content slide-short slide-1">1</div></n-slide>
        <n-slide><div class="slide-content slide-short slide-2">2</div></n-slide>
        <n-slide><div class="slide-content slide-short slide-3">3</div></n-slide>
        <n-slide><div class="slide-content slide-short slide-4">4</div></n-slide>
        <n-slide><div class="slide-content slide-short slide-5">5</div></n-slide>
        <n-slide><div class="slide-content slide-short slide-1">6</div></n-slide>
      </n-slideshow>
    <pre class="code-block"><code>&lt;n-slideshow controls indicators per-view="3" gap&gt;
  &lt;n-slide&gt;&lt;div&gt;1&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;2&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;3&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;4&lt;/div&gt;&lt;/n-slide&gt;
&lt;/n-slideshow&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Per-view 2 + Peek + Gap ── -->

    <h2>Per-view 2 + Peek + Gap</h2>
    <n-container data-kind="panel" bordered>
      <n-slideshow controls indicators per-view="2" peek gap>
        <n-slide><div class="slide-content slide-short slide-1">1</div></n-slide>
        <n-slide><div class="slide-content slide-short slide-2">2</div></n-slide>
        <n-slide><div class="slide-content slide-short slide-3">3</div></n-slide>
        <n-slide><div class="slide-content slide-short slide-4">4</div></n-slide>
      </n-slideshow>
    <pre class="code-block"><code>&lt;n-slideshow controls indicators per-view="2" peek gap&gt;
  &lt;n-slide&gt;&lt;div&gt;1&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;2&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;3&lt;/div&gt;&lt;/n-slide&gt;
&lt;/n-slideshow&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Intent colors ── -->

    <h2>Intent (accent)</h2>
    <n-container data-kind="panel" bordered>
      <n-slideshow controls indicators intent="accent">
        <n-slide><div class="slide-content slide-1">Accent 1</div></n-slide>
        <n-slide><div class="slide-content slide-2">Accent 2</div></n-slide>
        <n-slide><div class="slide-content slide-3">Accent 3</div></n-slide>
      </n-slideshow>
    <pre class="code-block"><code>&lt;n-slideshow controls indicators intent="accent"&gt;
  &lt;n-slide&gt;&lt;div&gt;Slide 1&lt;/div&gt;&lt;/n-slide&gt;
  &lt;n-slide&gt;&lt;div&gt;Slide 2&lt;/div&gt;&lt;/n-slide&gt;
&lt;/n-slideshow&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Event log ── -->

    <h2>Event log</h2>
    <n-container data-kind="panel" bordered>
      <n-slideshow controls indicators id="event-demo">
        <n-slide><div class="slide-content slide-1">A</div></n-slide>
        <n-slide><div class="slide-content slide-2">B</div></n-slide>
        <n-slide><div class="slide-content slide-3">C</div></n-slide>
      </n-slideshow>
      <pre id="event-log" style="margin-top: 0.75rem; font-size: 0.75rem; font-family: ui-monospace, monospace; color: var(--n-ink-muted-neutral); min-height: 2rem;"></pre>
    <pre class="code-block"><code set:html={codeExamples.eventLog} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Debug States (force-*) ── -->

    <h2>Debug States (<code>force-*</code>)</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Attribute-driven pseudo-state overrides for DevTools debugging and visual testing. Applied to the host element, targets internal controls and indicators.
      </span>
      <n-stack direction="row" gap="6" wrap>
        <div>
          <div class="col-label slideshow-debug-label">force-hover</div>
          <div class="debug-slideshow"><n-slideshow controls indicators force-hover>
            <n-slide><div class="slide-content slide-1">A</div></n-slide>
            <n-slide><div class="slide-content slide-2">B</div></n-slide>
          </n-slideshow></div>
        </div>
        <div>
          <div class="col-label slideshow-debug-label">force-focus-visible</div>
          <div class="debug-slideshow"><n-slideshow controls indicators force-focus-visible>
            <n-slide><div class="slide-content slide-1">A</div></n-slide>
            <n-slide><div class="slide-content slide-2">B</div></n-slide>
          </n-slideshow></div>
        </div>
      </n-stack>
    </n-container>

    <h2>API Reference</h2>
    <ApiReference data={slideshowApi} />
  </section>

  <script>
    import './slideshow.ts';
  </script>
  <style is:global>
    @import './slideshow.css';
  </style>

</SidebarLayout>
