---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  liveValue: `&lt;n-input-otp id="otp-live" length="6"&gt;&lt;/n-input-otp&gt;

&lt;script&gt;
  otp.addEventListener('native:input', (e) =&gt; {
    console.log(e.detail.value);
  });
&lt;/script&gt;`,
};
---
<SidebarLayout title="Input OTP">
  <main>
<h1>&lt;n-input-otp&gt;</h1>
    <p style="color: var(--n-ink-muted-neutral); font-size: 0.875rem; margin-bottom: 1.5rem;">
      Segmented OTP input. Auto-advance on entry, backspace returns, paste fills all cells.
    </p>

    <!-- ── Basic ── -->

    <h2>Basic (6 digits)</h2>
    <div class="layout-section">
      <n-field>
        <label slot="label">Verification code</label>
        <n-input-otp></n-input-otp>
        <span slot="description">Enter the 6-digit code sent to your phone.</span>
      </n-field>
      <pre class="layout-code"><code>&lt;n-field&gt;
  &lt;label slot="label"&gt;Verification code&lt;/label&gt;
  &lt;n-input-otp&gt;&lt;/n-input-otp&gt;
  &lt;span slot="description"&gt;Enter the 6-digit code.&lt;/span&gt;
&lt;/n-field&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── 4 Digits ── -->

    <h2>4 Digits</h2>
    <div class="layout-section">
      <n-field>
        <label slot="label">PIN</label>
        <n-input-otp length="4"></n-input-otp>
      </n-field>
          <pre class="layout-code"><code>&lt;n-input-otp length="4"&gt;&lt;/n-input-otp&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Masked ── -->

    <h2>Masked</h2>
    <div class="layout-section">
      <n-field>
        <label slot="label">Security code</label>
        <n-input-otp mask></n-input-otp>
        <span slot="description">Characters are hidden for security.</span>
      </n-field>
          <pre class="layout-code"><code>&lt;n-input-otp mask&gt;&lt;/n-input-otp&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── With Value ── -->

    <h2>Pre-filled</h2>
    <div class="layout-section">
      <n-field>
        <label slot="label">Confirmation</label>
        <n-input-otp value="123456"></n-input-otp>
      </n-field>
          <pre class="layout-code"><code>&lt;n-input-otp value="123456"&gt;&lt;/n-input-otp&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Disabled ── -->

    <h2>Disabled</h2>
    <div class="layout-section">
      <n-field disabled>
        <label slot="label">Locked code</label>
        <n-input-otp value="847291"></n-input-otp>
      </n-field>
    </div>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <div class="layout-section">
      <n-stack gap="4">
        <n-field size="sm">
          <label slot="label">Small</label>
          <n-input-otp length="4"></n-input-otp>
        </n-field>
        <n-field>
          <label slot="label">Default</label>
          <n-input-otp length="4"></n-input-otp>
        </n-field>
        <n-field size="lg">
          <label slot="label">Large</label>
          <n-input-otp length="4"></n-input-otp>
        </n-field>
      </n-stack>
      <pre class="layout-code"><code>&lt;n-input-otp length="4" size="sm"&gt;&lt;/n-input-otp&gt;
&lt;n-input-otp length="4"&gt;&lt;/n-input-otp&gt;
&lt;n-input-otp length="4" size="lg"&gt;&lt;/n-input-otp&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Live Value ── -->

    <h2>Live Value</h2>
    <div class="layout-section">
      <n-field>
        <label slot="label">Code: <span id="otp-value" style="font-size: 0.8125rem; color: var(--n-ink-muted-neutral); font-variant-numeric: tabular-nums;">______</span></label>
        <n-input-otp id="otp-live" length="6"></n-input-otp>
      </n-field>
      <pre class="layout-code"><code set:html={codeExamples.liveValue} /><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Debug States (force-*) ── -->

    <h2>Debug States (<code>force-*</code>)</h2>
    <div class="layout-section">
      <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin: 0 0 1rem;">
        Attribute-driven pseudo-state overrides for DevTools debugging and visual testing.
      </p>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
          <div style="font-size: 0.625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--n-ink-muted-neutral); margin-bottom: 0.5rem;">force-hover</div>
          <n-input-otp force-hover length="4"></n-input-otp>
        </div>
        <div>
          <div style="font-size: 0.625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--n-ink-muted-neutral); margin-bottom: 0.5rem;">force-focus</div>
          <n-input-otp force-focus length="4"></n-input-otp>
        </div>
      </div>
    </div>
  </main>

  <script>
import '../../scripts/copy-buttons';
const otp = document.getElementById('otp-live');
      const display = document.getElementById('otp-value');
      otp?.addEventListener('native:input', (e) => {
        const val = e.detail.value;
        display.textContent = val.padEnd(6, '_');
      });
  </script>
</SidebarLayout>
