---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  liveClickToNavigate: `&lt;n-pagination total="15" value="5"&gt;&lt;/n-pagination&gt;

&lt;script&gt;
  const pag = document.querySelector('n-pagination');
  pag.addEventListener('native:change', (e) =&gt; {
    console.log('Page:', e.detail.value);
  });
&lt;/script&gt;`,
};
---
<SidebarLayout title="Pagination">
  <main>
<h1>&lt;n-pagination&gt;</h1>
    <p style="color: var(--n-ink-muted-neutral); font-size: 0.875rem; margin-bottom: 1.5rem;">
      Page navigation. Stamps prev/next + page numbers with ellipsis truncation.
    </p>

    <!-- ── Basic ── -->

    <h2>Basic</h2>
    <div class="layout-section">
      <n-pagination total="10" value="1"></n-pagination>
        <pre class="layout-code"><code>&lt;n-pagination total="10" value="1"&gt;&lt;/n-pagination&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Middle page ── -->

    <h2>Middle Page</h2>
    <div class="layout-section">
      <n-pagination total="20" value="10"></n-pagination>
        <pre class="layout-code"><code>&lt;n-pagination total="20" value="10"&gt;&lt;/n-pagination&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Few pages ── -->

    <h2>Few Pages</h2>
    <div class="layout-section">
      <n-pagination total="3" value="2"></n-pagination>
        <pre class="layout-code"><code>&lt;n-pagination total="3" value="2"&gt;&lt;/n-pagination&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Many pages ── -->

    <h2>Many Pages</h2>
    <div class="layout-section">
      <n-pagination total="100" value="50" siblings="2"></n-pagination>
        <pre class="layout-code"><code>&lt;n-pagination total="100" value="50" siblings="2"&gt;&lt;/n-pagination&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Boundaries ── -->

    <h2>Boundaries</h2>
    <div class="layout-section">
      <n-stack gap="4">
        <div>
          <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin: 0 0 0.5rem;">boundaries="2" (show 2 pages at each edge)</p>
          <n-pagination total="50" value="25" boundaries="2"></n-pagination>
        </div>
        <div>
          <p style="font-size: 0.75rem; color: var(--n-ink-muted-neutral); margin: 0 0 0.5rem;">boundaries="0" (no boundary pages)</p>
          <n-pagination total="50" value="25" boundaries="0"></n-pagination>
        </div>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-pagination total="50" value="25" boundaries="2"&gt;&lt;/n-pagination&gt;
&lt;n-pagination total="50" value="25" boundaries="0"&gt;&lt;/n-pagination&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <div class="layout-section">
      <n-stack gap="4">
        <n-pagination total="10" value="3" size="sm"></n-pagination>
        <n-pagination total="10" value="3"></n-pagination>
        <n-pagination total="10" value="3" size="lg"></n-pagination>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-pagination total="10" value="3" size="sm"&gt;&lt;/n-pagination&gt;
&lt;n-pagination total="10" value="3"&gt;&lt;/n-pagination&gt;
&lt;n-pagination total="10" value="3" size="lg"&gt;&lt;/n-pagination&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Live ── -->

    <h2>Live (click to navigate)</h2>
    <div class="layout-section">
      <p style="font-size: 0.8125rem; color: var(--n-ink-muted-neutral); margin-bottom: 0.75rem;">
        Current page: <strong id="page-display">5</strong>
      </p>
      <n-pagination id="live-pagination" total="15" value="5"></n-pagination>
    <pre class="layout-code"><code set:html={codeExamples.liveClickToNavigate} /><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>

    <!-- ── Disabled ── -->

    <h2>Disabled</h2>
    <div class="layout-section">
      <n-pagination total="10" value="5" disabled></n-pagination>
        <pre class="layout-code"><code>&lt;n-pagination total="10" value="5" disabled&gt;&lt;/n-pagination&gt;</code><n-button class="copy-btn" size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </div>
  </main>

  <script>
const pag = document.getElementById('live-pagination');
      const display = document.getElementById('page-display');
      pag?.addEventListener('native:change', (e) => {
        display.textContent = String(e.detail.value);
      });
  </script>
</SidebarLayout>
