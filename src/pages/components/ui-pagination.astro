---
import SidebarLayout from '../../layouts/SidebarLayout.astro';

const codeExamples = {
  liveClickToNavigate: `&lt;n-pagination total="15" value="5"&gt;&lt;/n-pagination&gt;

&lt;script&gt;
  const pag = document.querySelector('n-pagination');
  pag.addEventListener('native:change', (e) =&gt; {
    console.log('Page:', e.detail.value);
  });
&lt;/script&gt;`,
};
---
<SidebarLayout title="Pagination">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Pagination</h1>
      </div>
    </div>
    <div data-slot="description">
      <span class="header-tag">&lt;n-pagination&gt;</span> Page navigation. Stamps prev/next + page numbers with ellipsis truncation.
          </div>
  </header>

  <main>

    <!-- ── Basic ── -->

    <h2>Basic</h2>
    <n-panel bordered>
      <n-pagination total="10" value="1"></n-pagination>
        <pre class="layout-code"><code>&lt;n-pagination total="10" value="1"&gt;&lt;/n-pagination&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Middle page ── -->

    <h2>Middle Page</h2>
    <n-panel bordered>
      <n-pagination total="20" value="10"></n-pagination>
        <pre class="layout-code"><code>&lt;n-pagination total="20" value="10"&gt;&lt;/n-pagination&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Few pages ── -->

    <h2>Few Pages</h2>
    <n-panel bordered>
      <n-pagination total="3" value="2"></n-pagination>
        <pre class="layout-code"><code>&lt;n-pagination total="3" value="2"&gt;&lt;/n-pagination&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Many pages ── -->

    <h2>Many Pages</h2>
    <n-panel bordered>
      <n-pagination total="100" value="50" siblings="2"></n-pagination>
        <pre class="layout-code"><code>&lt;n-pagination total="100" value="50" siblings="2"&gt;&lt;/n-pagination&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Boundaries ── -->

    <h2>Boundaries</h2>
    <n-panel bordered>
      <n-stack gap="4">
        <div>
          <n-text class="variant-label" size="xs" muted>boundaries="2" (show 2 pages at each edge)</n-text>
          <n-pagination total="50" value="25" boundaries="2"></n-pagination>
        </div>
        <div>
          <n-text class="variant-label" size="xs" muted>boundaries="0" (no boundary pages)</n-text>
          <n-pagination total="50" value="25" boundaries="0"></n-pagination>
        </div>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-pagination total="50" value="25" boundaries="2"&gt;&lt;/n-pagination&gt;
&lt;n-pagination total="50" value="25" boundaries="0"&gt;&lt;/n-pagination&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-panel bordered>
      <n-stack gap="4">
        <n-pagination total="10" value="3" size="sm"></n-pagination>
        <n-pagination total="10" value="3"></n-pagination>
        <n-pagination total="10" value="3" size="lg"></n-pagination>
      </n-stack>
    <pre class="layout-code"><code>&lt;n-pagination total="10" value="3" size="sm"&gt;&lt;/n-pagination&gt;
&lt;n-pagination total="10" value="3"&gt;&lt;/n-pagination&gt;
&lt;n-pagination total="10" value="3" size="lg"&gt;&lt;/n-pagination&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Live ── -->

    <h2>Live (click to navigate)</h2>
    <n-panel bordered>
      <n-text size="sm" muted spacing="tight">
        Current page: <strong id="page-display">5</strong>
      </n-text>
      <n-pagination id="live-pagination" total="15" value="5"></n-pagination>
    <pre class="layout-code"><code set:html={codeExamples.liveClickToNavigate} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>

    <!-- ── Disabled ── -->

    <h2>Disabled</h2>
    <n-panel bordered>
      <n-pagination total="10" value="5" disabled></n-pagination>
        <pre class="layout-code"><code>&lt;n-pagination total="10" value="5" disabled&gt;&lt;/n-pagination&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-panel>
  </main>

  <script>
document.addEventListener('astro:page-load', () => {
  const pag = document.getElementById('live-pagination');
  if (!pag) return;
  const display = document.getElementById('page-display');
  pag.addEventListener('native:change', (e) => {
    display?.textContent && (display.textContent = String(e.detail.value));
  });
});
  </script>
  <style is:global>
    .variant-label { margin: 0 0 0.5rem; }
  </style>
</SidebarLayout>
