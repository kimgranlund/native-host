---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import ApiReference from '../../../components/ApiReference.astro';
import { breadcrumbApi } from '../../../data/api/breadcrumb';
---
<SidebarLayout title="Breadcrumb">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Breadcrumb</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-breadcrumb&gt;</span> Path-based navigation with separator between items. Last item with <code>current</code> is non-interactive.
          </div>
  </header>

  <section>

    <!-- ── Basic ── -->

    <h2>Basic</h2>
    <n-container data-kind="panel" bordered>
      <n-breadcrumb>
        <n-breadcrumb-item href="/">Home</n-breadcrumb-item>
        <n-breadcrumb-item href="/products">Products</n-breadcrumb-item>
        <n-breadcrumb-item current>Widget Pro</n-breadcrumb-item>
      </n-breadcrumb>
      <pre class="code-block"><code>&lt;n-breadcrumb&gt;
  &lt;n-breadcrumb-item href="/"&gt;Home&lt;/n-breadcrumb-item&gt;
  &lt;n-breadcrumb-item href="/products"&gt;Products&lt;/n-breadcrumb-item&gt;
  &lt;n-breadcrumb-item current&gt;Widget Pro&lt;/n-breadcrumb-item&gt;
&lt;/n-breadcrumb&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Deep path ── -->

    <h2>Deep Path</h2>
    <n-container data-kind="panel" bordered>
      <n-breadcrumb>
        <n-breadcrumb-item href="/">Home</n-breadcrumb-item>
        <n-breadcrumb-item href="/docs">Documentation</n-breadcrumb-item>
        <n-breadcrumb-item href="/docs/components">Components</n-breadcrumb-item>
        <n-breadcrumb-item href="/docs/components/buttons">Buttons</n-breadcrumb-item>
        <n-breadcrumb-item current>Primary Button</n-breadcrumb-item>
      </n-breadcrumb>
      <pre class="code-block"><code>&lt;n-breadcrumb&gt;
  &lt;n-breadcrumb-item href="/"&gt;Home&lt;/n-breadcrumb-item&gt;
  &lt;n-breadcrumb-item href="/docs"&gt;Documentation&lt;/n-breadcrumb-item&gt;
  &lt;n-breadcrumb-item href="/docs/components"&gt;Components&lt;/n-breadcrumb-item&gt;
  &lt;n-breadcrumb-item href="/docs/components/buttons"&gt;Buttons&lt;/n-breadcrumb-item&gt;
  &lt;n-breadcrumb-item current&gt;Primary Button&lt;/n-breadcrumb-item&gt;
&lt;/n-breadcrumb&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-container data-kind="panel" bordered>
      <n-stack gap="4">
        <n-breadcrumb size="sm">
          <n-breadcrumb-item href="/">Home</n-breadcrumb-item>
          <n-breadcrumb-item current>Settings</n-breadcrumb-item>
        </n-breadcrumb>
        <n-breadcrumb>
          <n-breadcrumb-item href="/">Home</n-breadcrumb-item>
          <n-breadcrumb-item current>Settings</n-breadcrumb-item>
        </n-breadcrumb>
        <n-breadcrumb size="lg">
          <n-breadcrumb-item href="/">Home</n-breadcrumb-item>
          <n-breadcrumb-item current>Settings</n-breadcrumb-item>
        </n-breadcrumb>
      </n-stack>
      <pre class="code-block"><code>&lt;n-breadcrumb size="sm"&gt;
  &lt;n-breadcrumb-item href="/"&gt;Home&lt;/n-breadcrumb-item&gt;
  &lt;n-breadcrumb-item current&gt;Settings&lt;/n-breadcrumb-item&gt;
&lt;/n-breadcrumb&gt;

&lt;n-breadcrumb size="lg"&gt;
  &lt;n-breadcrumb-item href="/"&gt;Home&lt;/n-breadcrumb-item&gt;
  &lt;n-breadcrumb-item current&gt;Settings&lt;/n-breadcrumb-item&gt;
&lt;/n-breadcrumb&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Debug States (force-*) ── -->

    <h2>Debug States (<code>force-*</code>)</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Attribute-driven pseudo-state overrides for DevTools debugging and visual testing.
      </span>
      <n-breadcrumb>
        <n-breadcrumb-item href="/" force-hover>Force hover</n-breadcrumb-item>
        <n-breadcrumb-item href="/" force-focus-visible>Force focus-visible</n-breadcrumb-item>
        <n-breadcrumb-item current>Current</n-breadcrumb-item>
      </n-breadcrumb>
    </n-container>

    <h2>API Reference</h2>
    <ApiReference data={breadcrumbApi} />
  </section>

</SidebarLayout>
