---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import ApiReference from '../../../components/ApiReference.astro';
import { tableApi } from '../../../data/api/table';
---
<SidebarLayout title="Table">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Table</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-table&gt;</span> Data table with sortable columns and selectable rows. Uses CSS grid with <code>subgrid</code> for column alignment.
          </div>
  </header>

  <section>

    <!-- ── Basic Table ── -->

    <h2>Basic Table</h2>
    <n-container data-kind="panel" bordered>
      <n-table cols="1fr 1fr 1fr">
        <n-table-head>
          <n-table-row>
            <n-table-header>Name</n-table-header>
            <n-table-header>Role</n-table-header>
            <n-table-header>Status</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell>Alice Johnson</n-table-cell>
            <n-table-cell>Engineer</n-table-cell>
            <n-table-cell>Active</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Bob Smith</n-table-cell>
            <n-table-cell>Designer</n-table-cell>
            <n-table-cell>Active</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Carol White</n-table-cell>
            <n-table-cell>Manager</n-table-cell>
            <n-table-cell>Away</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
    <pre class="code-block"><code>&lt;n-table style="grid-template-columns: 1fr 1fr 1fr;"&gt;
  &lt;n-table-head&gt;
    &lt;n-table-row&gt;
      &lt;n-table-header&gt;Name&lt;/n-table-header&gt;
      &lt;n-table-header&gt;Role&lt;/n-table-header&gt;
      &lt;n-table-header&gt;Status&lt;/n-table-header&gt;
    &lt;/n-table-row&gt;
  &lt;/n-table-head&gt;
  &lt;n-table-body&gt;
    &lt;n-table-row&gt;
      &lt;n-table-cell&gt;Alice&lt;/n-table-cell&gt;
      &lt;n-table-cell&gt;Engineer&lt;/n-table-cell&gt;
      &lt;n-table-cell&gt;Active&lt;/n-table-cell&gt;
    &lt;/n-table-row&gt;
  &lt;/n-table-body&gt;
&lt;/n-table&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Sortable Columns ── -->

    <h2>Sortable Columns</h2>
    <n-container data-kind="panel" bordered>
      <n-table id="sortable-table" cols="2fr 1fr 80px">
        <n-table-head>
          <n-table-row>
            <n-table-header sortable column="name">Name</n-table-header>
            <n-table-header sortable column="language">Language</n-table-header>
            <n-table-header sortable column="stars">Stars</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body id="sortable-body">
        </n-table-body>
      </n-table>
    <pre class="code-block"><code>&lt;n-table style="grid-template-columns: 2fr 1fr 80px;"&gt;
  &lt;n-table-head&gt;
    &lt;n-table-row&gt;
      &lt;n-table-header sortable column="name"&gt;Name&lt;/n-table-header&gt;
      &lt;n-table-header sortable column="lang"&gt;Language&lt;/n-table-header&gt;
      &lt;n-table-header sortable column="stars"&gt;Stars&lt;/n-table-header&gt;
    &lt;/n-table-row&gt;
  &lt;/n-table-head&gt;
  &lt;n-table-body&gt;...&lt;/n-table-body&gt;
&lt;/n-table&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Selectable Rows ── -->

    <h2>Selectable Rows</h2>
    <n-container data-kind="panel" bordered>
      <n-table selectable cols="1fr 1fr 100px">
        <n-table-head>
          <n-table-row>
            <n-table-header>Product</n-table-header>
            <n-table-header>Category</n-table-header>
            <n-table-header>Price</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body>
          <n-table-row value="keyboard">
            <n-table-cell>Mechanical Keyboard</n-table-cell>
            <n-table-cell>Peripherals</n-table-cell>
            <n-table-cell>$149</n-table-cell>
          </n-table-row>
          <n-table-row value="monitor">
            <n-table-cell>4K Monitor</n-table-cell>
            <n-table-cell>Displays</n-table-cell>
            <n-table-cell>$499</n-table-cell>
          </n-table-row>
          <n-table-row value="mouse">
            <n-table-cell>Wireless Mouse</n-table-cell>
            <n-table-cell>Peripherals</n-table-cell>
            <n-table-cell>$79</n-table-cell>
          </n-table-row>
          <n-table-row value="headphones">
            <n-table-cell>Studio Headphones</n-table-cell>
            <n-table-cell>Audio</n-table-cell>
            <n-table-cell>$299</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <div class="log" id="selection-log"></div>
    <pre class="code-block"><code>&lt;n-table selectable style="grid-template-columns: 1fr 1fr 100px;"&gt;
  &lt;n-table-head&gt;
    &lt;n-table-row&gt;
      &lt;n-table-header&gt;Product&lt;/n-table-header&gt;
      &lt;n-table-header&gt;Category&lt;/n-table-header&gt;
      &lt;n-table-header&gt;Price&lt;/n-table-header&gt;
    &lt;/n-table-row&gt;
  &lt;/n-table-head&gt;
  &lt;n-table-body&gt;
    &lt;n-table-row value="keyboard"&gt;
      &lt;n-table-cell&gt;Keyboard&lt;/n-table-cell&gt;
      &lt;n-table-cell&gt;Peripherals&lt;/n-table-cell&gt;
      &lt;n-table-cell&gt;$149&lt;/n-table-cell&gt;
    &lt;/n-table-row&gt;
  &lt;/n-table-body&gt;
&lt;/n-table&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-container data-kind="panel" bordered>
      <h3>sm</h3>
      <n-table size="sm" cols="1fr 1fr 1fr">
        <n-table-head>
          <n-table-row>
            <n-table-header>Key</n-table-header>
            <n-table-header>Value</n-table-header>
            <n-table-header>Type</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell>NODE_ENV</n-table-cell>
            <n-table-cell>production</n-table-cell>
            <n-table-cell>string</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>PORT</n-table-cell>
            <n-table-cell>3000</n-table-cell>
            <n-table-cell>number</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>

      <h3>md (default)</h3>
      <n-table cols="1fr 1fr 1fr">
        <n-table-head>
          <n-table-row>
            <n-table-header>Key</n-table-header>
            <n-table-header>Value</n-table-header>
            <n-table-header>Type</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell>NODE_ENV</n-table-cell>
            <n-table-cell>production</n-table-cell>
            <n-table-cell>string</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>PORT</n-table-cell>
            <n-table-cell>3000</n-table-cell>
            <n-table-cell>number</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>

      <h3>lg</h3>
      <n-table size="lg" cols="1fr 1fr 1fr">
        <n-table-head>
          <n-table-row>
            <n-table-header>Key</n-table-header>
            <n-table-header>Value</n-table-header>
            <n-table-header>Type</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell>NODE_ENV</n-table-cell>
            <n-table-cell>production</n-table-cell>
            <n-table-cell>string</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>PORT</n-table-cell>
            <n-table-cell>3000</n-table-cell>
            <n-table-cell>number</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
    <pre class="code-block"><code>&lt;n-table size="sm" style="grid-template-columns: 1fr 1fr 1fr;"&gt;...&lt;/n-table&gt;
&lt;n-table style="grid-template-columns: 1fr 1fr 1fr;"&gt;...&lt;/n-table&gt;
&lt;n-table size="lg" style="grid-template-columns: 1fr 1fr 1fr;"&gt;...&lt;/n-table&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Plain Variant ── -->

    <h2>Plain Variant</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Editorial / documentation tables that sit inline with prose. No outer border, no radius, no header fill, no row hover.
      </span>
      <n-table variant="plain" size="sm" cols="auto 1fr 1fr">
        <n-table-head>
          <n-table-row>
            <n-table-header>Token</n-table-header>
            <n-table-header>Resolves</n-table-header>
            <n-table-header>Usage</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell><code>--n-size</code></n-table-cell>
            <n-table-cell>Size scale vertical sizing</n-table-cell>
            <n-table-cell>All interactive components</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>--n-font-size</code></n-table-cell>
            <n-table-cell>Size scale typography</n-table-cell>
            <n-table-cell>Text content, labels</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>--n-space</code></n-table-cell>
            <n-table-cell>Size scale spacing unit</n-table-cell>
            <n-table-cell>Padding, gaps, margins</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell><code>--n-radius</code></n-table-cell>
            <n-table-cell>Radius attribute override</n-table-cell>
            <n-table-cell>Border radius on containers</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
    <pre class="code-block"><code>&lt;n-table variant="plain" size="sm" style="grid-template-columns: auto 1fr 1fr;"&gt;
  &lt;n-table-head&gt;
    &lt;n-table-row&gt;
      &lt;n-table-header&gt;Token&lt;/n-table-header&gt;
      &lt;n-table-header&gt;Resolves&lt;/n-table-header&gt;
      &lt;n-table-header&gt;Usage&lt;/n-table-header&gt;
    &lt;/n-table-row&gt;
  &lt;/n-table-head&gt;
  &lt;n-table-body&gt;...&lt;/n-table-body&gt;
&lt;/n-table&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Colspan Rows ── -->

    <h2>Colspan Rows</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Full-width category headers that opt out of subgrid. Hidden automatically when the table is sorted.
      </span>
      <n-table id="colspan-table" cols="2fr 1fr 80px">
        <n-table-head>
          <n-table-row>
            <n-table-header sortable column="name">Name</n-table-header>
            <n-table-header sortable column="role">Role</n-table-header>
            <n-table-header sortable column="salary">Salary</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body>
          <n-table-row colspan>
            <n-table-cell>Engineering</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Alice Johnson</n-table-cell>
            <n-table-cell>Senior Engineer</n-table-cell>
            <n-table-cell>$180k</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Bob Smith</n-table-cell>
            <n-table-cell>Staff Engineer</n-table-cell>
            <n-table-cell>$210k</n-table-cell>
          </n-table-row>
          <n-table-row colspan>
            <n-table-cell>Design</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Carol White</n-table-cell>
            <n-table-cell>Lead Designer</n-table-cell>
            <n-table-cell>$165k</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Dan Lee</n-table-cell>
            <n-table-cell>UX Researcher</n-table-cell>
            <n-table-cell>$140k</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
    <pre class="code-block"><code>&lt;n-table style="grid-template-columns: 2fr 1fr 80px;"&gt;
  &lt;n-table-body&gt;
    &lt;n-table-row colspan&gt;
      &lt;n-table-cell&gt;Engineering&lt;/n-table-cell&gt;
    &lt;/n-table-row&gt;
    &lt;n-table-row&gt;
      &lt;n-table-cell&gt;Alice&lt;/n-table-cell&gt;
      &lt;n-table-cell&gt;Engineer&lt;/n-table-cell&gt;
      &lt;n-table-cell&gt;$180k&lt;/n-table-cell&gt;
    &lt;/n-table-row&gt;
  &lt;/n-table-body&gt;
&lt;/n-table&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Sticky Header ── -->

    <h2>Sticky Header</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Header row stays fixed when scrolling vertically. Requires constrained height on the table.
      </span>
      <div class="sticky-demo"><n-table sticky-header cols="1fr 1fr 100px">
        <n-table-head>
          <n-table-row>
            <n-table-header>Name</n-table-header>
            <n-table-header>Department</n-table-header>
            <n-table-header>Status</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body id="sticky-body">
        </n-table-body>
      </n-table></div>
    <pre class="code-block"><code>&lt;n-table sticky-header style="grid-template-columns: 1fr 1fr 100px; max-height: 200px;"&gt;
  &lt;n-table-head&gt;
    &lt;n-table-row&gt;
      &lt;n-table-header&gt;Name&lt;/n-table-header&gt;
      &lt;n-table-header&gt;Department&lt;/n-table-header&gt;
      &lt;n-table-header&gt;Status&lt;/n-table-header&gt;
    &lt;/n-table-row&gt;
  &lt;/n-table-head&gt;
  &lt;n-table-body&gt;...&lt;/n-table-body&gt;
&lt;/n-table&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Sticky Column ── -->

    <h2>Sticky Column</h2>
    <div class="sticky-col-panel"><n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        First column stays fixed when scrolling horizontally. Requires constrained width.
      </span>
      <n-table sticky-column cols="120px 150px 150px 150px 150px">
        <n-table-head>
          <n-table-row>
            <n-table-header>Name</n-table-header>
            <n-table-header>Q1</n-table-header>
            <n-table-header>Q2</n-table-header>
            <n-table-header>Q3</n-table-header>
            <n-table-header>Q4</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body>
          <n-table-row>
            <n-table-cell>Alice</n-table-cell>
            <n-table-cell>$42,500</n-table-cell>
            <n-table-cell>$48,200</n-table-cell>
            <n-table-cell>$51,800</n-table-cell>
            <n-table-cell>$55,100</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Bob</n-table-cell>
            <n-table-cell>$38,100</n-table-cell>
            <n-table-cell>$41,300</n-table-cell>
            <n-table-cell>$43,700</n-table-cell>
            <n-table-cell>$46,200</n-table-cell>
          </n-table-row>
          <n-table-row>
            <n-table-cell>Carol</n-table-cell>
            <n-table-cell>$55,000</n-table-cell>
            <n-table-cell>$58,400</n-table-cell>
            <n-table-cell>$62,100</n-table-cell>
            <n-table-cell>$67,800</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
    <pre class="code-block"><code>&lt;n-table sticky-column style="grid-template-columns: 120px 150px 150px 150px;"&gt;
  &lt;n-table-head&gt;
    &lt;n-table-row&gt;
      &lt;n-table-header&gt;Name&lt;/n-table-header&gt;
      &lt;n-table-header&gt;Q1&lt;/n-table-header&gt;
      &lt;n-table-header&gt;Q2&lt;/n-table-header&gt;
      &lt;n-table-header&gt;Q3&lt;/n-table-header&gt;
    &lt;/n-table-row&gt;
  &lt;/n-table-head&gt;
  &lt;n-table-body&gt;...&lt;/n-table-body&gt;
&lt;/n-table&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container></div>

    <!-- ── Sticky Colspan Rows ── -->

    <h2>Sticky Colspan Rows</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Section headers stick below the table header as you scroll, like iOS section headers.
        Each section header pushes the previous one up.
      </span>
      <div class="sticky-colspan-demo"><n-table sticky-header cols="2fr 1fr 80px">
        <n-table-head>
          <n-table-row>
            <n-table-header>Name</n-table-header>
            <n-table-header>Role</n-table-header>
            <n-table-header>Salary</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body id="sticky-colspan-body">
        </n-table-body>
      </n-table></div>
    <pre class="code-block"><code>&lt;n-table sticky-header style="grid-template-columns: 2fr 1fr 80px; max-height: 280px;"&gt;
  &lt;n-table-body&gt;
    &lt;n-table-row colspan sticky&gt;
      &lt;n-table-cell&gt;Section Header&lt;/n-table-cell&gt;
    &lt;/n-table-row&gt;
    &lt;n-table-row&gt;...&lt;/n-table-row&gt;
  &lt;/n-table-body&gt;
&lt;/n-table&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Reorderable Rows ── -->

    <h2>Reorderable Rows</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Drag rows to reorder. DOM is auto-reordered unless the <code>native:table-reorder</code> event is cancelled.
      </span>
      <n-table reorderable cols="1fr 1fr 100px">
        <n-table-head>
          <n-table-row>
            <n-table-header>Task</n-table-header>
            <n-table-header>Priority</n-table-header>
            <n-table-header>Status</n-table-header>
          </n-table-row>
        </n-table-head>
        <n-table-body>
          <n-table-row value="task-1">
            <n-table-cell>Implement auth</n-table-cell>
            <n-table-cell>High</n-table-cell>
            <n-table-cell>In Progress</n-table-cell>
          </n-table-row>
          <n-table-row value="task-2">
            <n-table-cell>Design system tokens</n-table-cell>
            <n-table-cell>Medium</n-table-cell>
            <n-table-cell>Done</n-table-cell>
          </n-table-row>
          <n-table-row value="task-3">
            <n-table-cell>Write tests</n-table-cell>
            <n-table-cell>High</n-table-cell>
            <n-table-cell>Todo</n-table-cell>
          </n-table-row>
          <n-table-row value="task-4">
            <n-table-cell>Deploy to staging</n-table-cell>
            <n-table-cell>Low</n-table-cell>
            <n-table-cell>Todo</n-table-cell>
          </n-table-row>
          <n-table-row value="task-5">
            <n-table-cell>Code review</n-table-cell>
            <n-table-cell>Medium</n-table-cell>
            <n-table-cell>In Progress</n-table-cell>
          </n-table-row>
        </n-table-body>
      </n-table>
      <div class="log" id="reorder-log"></div>
    <pre class="code-block"><code>&lt;n-table reorderable style="grid-template-columns: 1fr 1fr 100px;"&gt;
  &lt;n-table-body&gt;
    &lt;n-table-row value="task-1"&gt;
      &lt;n-table-cell&gt;Implement auth&lt;/n-table-cell&gt;
      &lt;n-table-cell&gt;High&lt;/n-table-cell&gt;
      &lt;n-table-cell&gt;In Progress&lt;/n-table-cell&gt;
    &lt;/n-table-row&gt;
  &lt;/n-table-body&gt;
&lt;/n-table&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Resizable Columns ── -->

    <h2>Resizable Columns</h2>
    <n-container data-kind="panel" bordered>
      <span class="text-xs text-muted">
        Drag the right edge of any header cell to resize columns.
      </span>
      <n-table resizable cols="2fr 1fr 1fr">
        <n-table-head>
