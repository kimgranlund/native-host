---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import ApiReference from '../../../components/ApiReference.astro';
import { navApi } from '../../../data/api/nav';

const codeExamples = {
  events: `&lt;n-sidebar-nav id="my-nav"&gt;
  &lt;n-sidebar-nav-item value="home"&gt;Home&lt;/n-sidebar-nav-item&gt;
  &lt;n-sidebar-nav-item value="docs"&gt;Documentation&lt;/n-sidebar-nav-item&gt;
  &lt;n-sidebar-nav-item value="api"&gt;API Reference&lt;/n-sidebar-nav-item&gt;
&lt;/n-sidebar-nav&gt;

&lt;script&gt;
  myNav.addEventListener('native:change', (e) =&gt; {
    console.log(e.detail.value);
  });
&lt;/script&gt;`,
};
---
<SidebarLayout title="Nav">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Sidebar Nav</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-sidebar-nav&gt;</span> Sidebar navigation list with keyboard nav and selection. Transparent wrapper — items sit flush with no inline padding.
          </div>
  </header>

  <section>

    <!-- ── Basic ── -->

    <h2>Basic Nav</h2>
    <n-container data-kind="panel" bordered>
      <div class="grid">
        <n-stack>
          <span class="col-label">Flat items</span>
          <n-sidebar-nav id="basic-nav" size="sm">
            <n-sidebar-nav-item value="home">Home</n-sidebar-nav-item>
            <n-sidebar-nav-item value="about">About</n-sidebar-nav-item>
            <n-sidebar-nav-item value="blog">Blog</n-sidebar-nav-item>
            <n-sidebar-nav-item value="contact">Contact</n-sidebar-nav-item>
          </n-sidebar-nav>
          <div>Selected: <span class="value-display" id="basic-value">none</span></div>
        </n-stack>

        <n-stack>
          <span class="col-label">With disabled item</span>
          <n-sidebar-nav size="sm">
            <n-sidebar-nav-item value="dashboard">Dashboard</n-sidebar-nav-item>
            <n-sidebar-nav-item value="settings">Settings</n-sidebar-nav-item>
            <n-sidebar-nav-item value="admin" disabled>Admin (restricted)</n-sidebar-nav-item>
            <n-sidebar-nav-item value="logout">Log Out</n-sidebar-nav-item>
          </n-sidebar-nav>
        </n-stack>
      </div>
      <pre class="code-block"><code>&lt;n-sidebar-nav&gt;
  &lt;n-sidebar-nav-item value="home"&gt;Home&lt;/n-sidebar-nav-item&gt;
  &lt;n-sidebar-nav-item value="about"&gt;About&lt;/n-sidebar-nav-item&gt;
  &lt;n-sidebar-nav-item value="blog"&gt;Blog&lt;/n-sidebar-nav-item&gt;
  &lt;n-sidebar-nav-item value="contact" disabled&gt;Contact&lt;/n-sidebar-nav-item&gt;
&lt;/n-sidebar-nav&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Grouped with Icons ── -->

    <h2>Grouped with Icons</h2>
    <n-container data-kind="panel" bordered>
      <div class="grid">
        <n-stack>
          <span class="col-label">Sidebar nav pattern</span>
          <n-sidebar-nav id="grouped-nav" size="sm">
            <n-sidebar-group open>
              <n-sidebar-group-header><n-icon name="house"></n-icon> Getting Started</n-sidebar-group-header>
              <n-sidebar-nav-item value="install">Installation</n-sidebar-nav-item>
              <n-sidebar-nav-item value="structure">Project Structure</n-sidebar-nav-item>
            </n-sidebar-group>
            <n-sidebar-group open>
              <n-sidebar-group-header><n-icon name="rocket-launch"></n-icon> Build Your Application</n-sidebar-group-header>
              <n-sidebar-nav-item value="routing">Routing</n-sidebar-nav-item>
              <n-sidebar-nav-item value="data">Data Fetching</n-sidebar-nav-item>
              <n-sidebar-nav-item value="caching">Caching</n-sidebar-nav-item>
              <n-sidebar-nav-item value="styling">Styling</n-sidebar-nav-item>
              <n-sidebar-nav-item value="optimizing">Optimizing</n-sidebar-nav-item>
            </n-sidebar-group>
            <n-sidebar-group open>
              <n-sidebar-group-header><n-icon name="book-open"></n-icon> Reference</n-sidebar-group-header>
              <n-sidebar-nav-item value="api">API Reference</n-sidebar-nav-item>
              <n-sidebar-nav-item value="config">Configuration</n-sidebar-nav-item>
              <n-sidebar-nav-item value="examples">Examples</n-sidebar-nav-item>
            </n-sidebar-group>
          </n-sidebar-nav>
          <div>Selected: <span class="value-display" id="grouped-value">none</span></div>
        </n-stack>

        <n-stack>
          <span class="col-label">Without icons</span>
          <n-sidebar-nav size="sm">
            <n-sidebar-group open>
              <n-sidebar-group-header>Fruits</n-sidebar-group-header>
              <n-sidebar-nav-item value="apple">Apple</n-sidebar-nav-item>
              <n-sidebar-nav-item value="banana">Banana</n-sidebar-nav-item>
              <n-sidebar-nav-item value="cherry">Cherry</n-sidebar-nav-item>
            </n-sidebar-group>
            <n-sidebar-group open>
              <n-sidebar-group-header>Vegetables</n-sidebar-group-header>
              <n-sidebar-nav-item value="carrot">Carrot</n-sidebar-nav-item>
              <n-sidebar-nav-item value="broccoli">Broccoli</n-sidebar-nav-item>
              <n-sidebar-nav-item value="spinach">Spinach</n-sidebar-nav-item>
            </n-sidebar-group>
          </n-sidebar-nav>
        </n-stack>
      </div>
      <pre class="code-block"><code>&lt;n-sidebar-nav size="sm"&gt;
  &lt;n-sidebar-group&gt;
    &lt;n-sidebar-group-header&gt;
      &lt;n-icon name="house"&gt;&lt;/n-icon&gt; Getting Started
    &lt;/n-sidebar-group-header&gt;
    &lt;n-sidebar-nav-item value="install"&gt;Installation&lt;/n-sidebar-nav-item&gt;
    &lt;n-sidebar-nav-item value="structure"&gt;Project Structure&lt;/n-sidebar-nav-item&gt;
  &lt;/n-sidebar-group&gt;
&lt;/n-sidebar-nav&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Collapsible Groups ── -->

    <h2>Collapsible Groups</h2>
    <n-container data-kind="panel" bordered>
      <div class="grid">
        <n-stack>
          <span class="col-label">Expanded (all groups open)</span>
          <n-sidebar-nav size="sm">
            <n-sidebar-group open>
              <n-sidebar-group-header><n-icon name="house"></n-icon> Overview</n-sidebar-group-header>
              <n-sidebar-nav-item value="intro">Introduction</n-sidebar-nav-item>
              <n-sidebar-nav-item value="quickstart">Quick Start</n-sidebar-nav-item>
            </n-sidebar-group>
            <n-sidebar-group open>
              <n-sidebar-group-header><n-icon name="book-open"></n-icon> Guides</n-sidebar-group-header>
              <n-sidebar-nav-item value="auth">Authentication</n-sidebar-nav-item>
              <n-sidebar-nav-item value="deploy">Deployment</n-sidebar-nav-item>
              <n-sidebar-nav-item value="testing">Testing</n-sidebar-nav-item>
            </n-sidebar-group>
          </n-sidebar-nav>
        </n-stack>

        <n-stack>
          <span class="col-label">Collapsed (default state)</span>
          <n-sidebar-nav size="sm">
            <n-sidebar-group>
              <n-sidebar-group-header>Section A</n-sidebar-group-header>
              <n-sidebar-nav-item value="a1">Item A1</n-sidebar-nav-item>
              <n-sidebar-nav-item value="a2">Item A2</n-sidebar-nav-item>
            </n-sidebar-group>
            <n-sidebar-group>
              <n-sidebar-group-header>Section B</n-sidebar-group-header>
              <n-sidebar-nav-item value="b1">Item B1</n-sidebar-nav-item>
              <n-sidebar-nav-item value="b2">Item B2</n-sidebar-nav-item>
              <n-sidebar-nav-item value="b3">Item B3</n-sidebar-nav-item>
            </n-sidebar-group>
          </n-sidebar-nav>
        </n-stack>
      </div>
    </n-container>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-container data-kind="panel" bordered>
      <div class="grid">
        <n-stack>
          <span class="col-label">xs</span>
          <n-sidebar-nav size="xs">
            <n-sidebar-nav-item value="a">Item A</n-sidebar-nav-item>
            <n-sidebar-nav-item value="b">Item B</n-sidebar-nav-item>
            <n-sidebar-nav-item value="c">Item C</n-sidebar-nav-item>
          </n-sidebar-nav>
        </n-stack>
        <n-stack>
          <span class="col-label">sm</span>
          <n-sidebar-nav size="sm">
            <n-sidebar-nav-item value="a">Item A</n-sidebar-nav-item>
            <n-sidebar-nav-item value="b">Item B</n-sidebar-nav-item>
            <n-sidebar-nav-item value="c">Item C</n-sidebar-nav-item>
          </n-sidebar-nav>
        </n-stack>
        <n-stack>
          <span class="col-label">md</span>
          <n-sidebar-nav size="md">
            <n-sidebar-nav-item value="a">Item A</n-sidebar-nav-item>
            <n-sidebar-nav-item value="b">Item B</n-sidebar-nav-item>
            <n-sidebar-nav-item value="c">Item C</n-sidebar-nav-item>
          </n-sidebar-nav>
        </n-stack>
        <n-stack>
          <span class="col-label">lg</span>
          <n-sidebar-nav size="lg">
            <n-sidebar-nav-item value="a">Item A</n-sidebar-nav-item>
            <n-sidebar-nav-item value="b">Item B</n-sidebar-nav-item>
            <n-sidebar-nav-item value="c">Item C</n-sidebar-nav-item>
          </n-sidebar-nav>
        </n-stack>
      </div>
      <pre class="code-block"><code>&lt;n-sidebar-nav size="sm"&gt;...&lt;/n-sidebar-nav&gt;
&lt;n-sidebar-nav size="md"&gt;...&lt;/n-sidebar-nav&gt;
&lt;n-sidebar-nav size="lg"&gt;...&lt;/n-sidebar-nav&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Events ── -->

    <h2>Events</h2>
    <n-container data-kind="panel" bordered size="sm">
      <div class="demo-nav"><n-sidebar-nav id="event-nav">
        <n-sidebar-nav-item value="home">Home</n-sidebar-nav-item>
        <n-sidebar-nav-item value="docs">Documentation</n-sidebar-nav-item>
        <n-sidebar-nav-item value="api">API Reference</n-sidebar-nav-item>
        <n-sidebar-nav-item value="changelog">Changelog</n-sidebar-nav-item>
      </n-sidebar-nav></div>
      <div class="log" id="event-log"></div>
      <pre class="code-block"><code set:html={codeExamples.events} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Debug States (force-*) ── -->

    <h2>Debug States (<code>force-*</code>)</h2>
    <n-container data-kind="panel" bordered size="sm">
      <span class="text-xs text-muted">
        Attribute-driven pseudo-state overrides for DevTools debugging and visual testing. Applied to individual <code>n-sidebar-nav-item</code> elements.
      </span>
      <div class="demo-nav"><n-sidebar-nav>
        <n-sidebar-nav-item value="hover" force-hover>Force hover</n-sidebar-nav-item>
        <n-sidebar-nav-item value="active" force-active>Force active</n-sidebar-nav-item>
        <n-sidebar-nav-item value="focus" force-focus-visible>Force focus-visible</n-sidebar-nav-item>
        <n-sidebar-nav-item value="normal">Normal</n-sidebar-nav-item>
      </n-sidebar-nav></div>
    </n-container>

    <h2>API Reference</h2>
    <ApiReference data={navApi} />
  </section>

  <script>
    import './nav.ts';
  </script>
  <style is:global>
    @import './nav.css';
  </style>

</SidebarLayout>
