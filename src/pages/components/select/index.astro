---
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import ApiReference from '../../../components/ApiReference.astro';
import { selectApi } from '../../../data/api/select';

const codeExamples = {
  events: `&lt;n-select id="color-select" placeholder="Choose color"&gt;
  &lt;n-listbox popover&gt;
    &lt;n-option value="red"&gt;Red&lt;/n-option&gt;
    &lt;n-option value="blue"&gt;Blue&lt;/n-option&gt;
  &lt;/n-listbox&gt;
&lt;/n-select&gt;

&lt;script&gt;
  document.getElementById('color-select')
    .addEventListener('native:change', (e) =&gt; {
      console.log(e.detail.value, e.detail.label);
    });
&lt;/script&gt;`,
  dataDrivenInlineJson: `&lt;n-select
  placeholder="Choose a country"
  options='[{"value":"us","label":"United States"},{"value":"gb","label":"United Kingdom"}]'
&gt;&lt;/n-select&gt;`,
  dataDrivenPreSelectedValue: `&lt;n-select
  placeholder="Choose a country"
  value="de"
  options='[{"value":"us","label":"United States"},{"value":"de","label":"Germany"}]'
&gt;&lt;/n-select&gt;`,
  dataDrivenDisabledOptions: `&lt;n-select
  placeholder="Choose a role"
  options='[{"value":"viewer","label":"Viewer"},{"value":"admin","label":"Admin","disabled":true}]'
&gt;&lt;/n-select&gt;`,
  dataDrivenDynamicUpdate: `&lt;n-select id="my-select" placeholder="Choose a fruit" options="[]"&gt;&lt;/n-select&gt;

&lt;script&gt;
  const sel = document.getElementById('my-select');
  sel.options = [
    { value: 'apple', label: 'Apple' },
    { value: 'banana', label: 'Banana' },
  ];
&lt;/script&gt;`,
};
---
<SidebarLayout title="Select">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Select</h1>
      </div>
    </div>
    <div slot="description">
      <span class="header-tag">&lt;n-select&gt;</span> Coordinator element that wires a button trigger + popover listbox into a dropdown select.
          </div>
  </header>

  <section>

    <!-- ── Basic Usage ── -->

    <h2>Basic Usage</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <n-select placeholder="Choose a fruit">
          <n-listbox popover="manual">
            <n-option value="apple">Apple</n-option>
            <n-option value="banana">Banana</n-option>
            <n-option value="cherry">Cherry</n-option>
            <n-option value="grape">Grape</n-option>
            <n-option value="orange">Orange</n-option>
          </n-listbox>
        </n-select>
      </n-stack>
      <pre class="code-block"><code>&lt;n-select placeholder="Choose a fruit"&gt;
  &lt;n-listbox popover&gt;
    &lt;n-option value="apple"&gt;Apple&lt;/n-option&gt;
    &lt;n-option value="banana"&gt;Banana&lt;/n-option&gt;
    &lt;n-option value="cherry"&gt;Cherry&lt;/n-option&gt;
  &lt;/n-listbox&gt;
&lt;/n-select&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Pre-selected Value ── -->

    <h2>Pre-selected Value</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <n-select value="banana" placeholder="Choose a fruit">
          <n-listbox popover="manual">
            <n-option value="apple">Apple</n-option>
            <n-option value="banana">Banana</n-option>
            <n-option value="cherry">Cherry</n-option>
          </n-listbox>
        </n-select>
      </n-stack>
      <pre class="code-block"><code>&lt;n-select value="banana" placeholder="Choose a fruit"&gt;
  &lt;n-listbox popover&gt;
    &lt;n-option value="apple"&gt;Apple&lt;/n-option&gt;
    &lt;n-option value="banana"&gt;Banana&lt;/n-option&gt;
  &lt;/n-listbox&gt;
&lt;/n-select&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Sizes ── -->

    <h2>Sizes</h2>
    <n-container data-kind="panel" bordered>
      <n-stack direction="row" wrap align="center">
        <span class="label">xs</span>
        <n-select size="xs" placeholder="Extra small">
          <n-listbox popover="manual">
            <n-option value="a">Option A</n-option>
            <n-option value="b">Option B</n-option>
          </n-listbox>
        </n-select>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">sm</span>
        <n-select size="sm" placeholder="Small">
          <n-listbox popover="manual">
            <n-option value="a">Option A</n-option>
            <n-option value="b">Option B</n-option>
          </n-listbox>
        </n-select>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">md</span>
        <n-select size="md" placeholder="Medium">
          <n-listbox popover="manual">
            <n-option value="a">Option A</n-option>
            <n-option value="b">Option B</n-option>
          </n-listbox>
        </n-select>
      </n-stack>
      <n-stack direction="row" wrap align="center">
        <span class="label">lg</span>
        <n-select size="lg" placeholder="Large">
          <n-listbox popover="manual">
            <n-option value="a">Option A</n-option>
            <n-option value="b">Option B</n-option>
          </n-listbox>
        </n-select>
      </n-stack>
      <pre class="code-block"><code>&lt;n-select size="sm" placeholder="Small"&gt;
  &lt;n-listbox popover&gt;
    &lt;n-option value="a"&gt;Option A&lt;/n-option&gt;
  &lt;/n-listbox&gt;
&lt;/n-select&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Density ── -->

    <h2>Density</h2>
    <n-container data-kind="panel" bordered>
      <h3>xs</h3>
      <n-stack direction="row" wrap align="center" size="xs" density="compact">
        <span class="label">compact</span>
        <n-select placeholder="Compact">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="xs" density="default">
        <span class="label">default</span>
        <n-select placeholder="Default">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="xs" density="loose">
        <span class="label">loose</span>
        <n-select placeholder="Loose">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>

      <h3>sm</h3>
      <n-stack direction="row" wrap align="center" size="sm" density="compact">
        <span class="label">compact</span>
        <n-select placeholder="Compact">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="sm" density="default">
        <span class="label">default</span>
        <n-select placeholder="Default">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="sm" density="loose">
        <span class="label">loose</span>
        <n-select placeholder="Loose">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>

      <h3>md</h3>
      <n-stack direction="row" wrap align="center" size="md" density="compact">
        <span class="label">compact</span>
        <n-select placeholder="Compact">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="md" density="default">
        <span class="label">default</span>
        <n-select placeholder="Default">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="md" density="loose">
        <span class="label">loose</span>
        <n-select placeholder="Loose">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>

      <h3>lg</h3>
      <n-stack direction="row" wrap align="center" size="lg" density="compact">
        <span class="label">compact</span>
        <n-select placeholder="Compact">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="lg" density="default">
        <span class="label">default</span>
        <n-select placeholder="Default">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="lg" density="loose">
        <span class="label">loose</span>
        <n-select placeholder="Loose">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>

      <h3>xl</h3>
      <n-stack direction="row" wrap align="center" size="xl" density="compact">
        <span class="label">compact</span>
        <n-select placeholder="Compact">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="xl" density="default">
        <span class="label">default</span>
        <n-select placeholder="Default">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>
      <n-stack direction="row" wrap align="center" size="xl" density="loose">
        <span class="label">loose</span>
        <n-select placeholder="Loose">
          <n-listbox popover="manual"><n-option value="a">Alpha</n-option><n-option value="b">Bravo</n-option></n-listbox>
        </n-select>
      </n-stack>
      <pre class="code-block"><code>&lt;div density="compact"&gt;
  &lt;n-select&gt;...&lt;/n-select&gt;
&lt;/div&gt;

&lt;div density="loose"&gt;
  &lt;n-select&gt;...&lt;/n-select&gt;
&lt;/div&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Variants ── -->

    <h2>Variants</h2>
    <n-container data-kind="panel" bordered size="sm">
      <n-stack direction="row" wrap align="center">
        <n-select placeholder="Outline">
          <n-listbox popover="manual">
            <n-option value="a">Alpha</n-option>
            <n-option value="b">Bravo</n-option>
          </n-listbox>
        </n-select>
        <n-select variant="secondary" placeholder="Secondary">
          <n-listbox popover="manual">
            <n-option value="a">Alpha</n-option>
            <n-option value="b">Bravo</n-option>
          </n-listbox>
        </n-select>
        <n-select variant="default" placeholder="Default">
          <n-listbox popover="manual">
            <n-option value="a">Alpha</n-option>
            <n-option value="b">Bravo</n-option>
          </n-listbox>
        </n-select>
        <n-select variant="ghost" placeholder="Ghost">
          <n-listbox popover="manual">
            <n-option value="a">Alpha</n-option>
            <n-option value="b">Bravo</n-option>
          </n-listbox>
        </n-select>
      </n-stack>
      <pre class="code-block"><code>&lt;n-select variant="secondary" placeholder="Secondary"&gt;
  &lt;n-listbox popover&gt;
    &lt;n-option value="a"&gt;Alpha&lt;/n-option&gt;
  &lt;/n-listbox&gt;
&lt;/n-select&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Disabled ── -->

    <h2>Disabled</h2>
    <n-container data-kind="panel" bordered size="sm">
      <n-stack direction="row" wrap align="center">
        <n-select disabled placeholder="Disabled">
          <n-listbox popover="manual">
            <n-option value="a">Alpha</n-option>
          </n-listbox>
        </n-select>
      </n-stack>
      <pre class="code-block"><code>&lt;n-select disabled placeholder="Disabled"&gt;
  &lt;n-listbox popover&gt;
    &lt;n-option value="a"&gt;Alpha&lt;/n-option&gt;
  &lt;/n-listbox&gt;
&lt;/n-select&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Disabled Options ── -->

    <h2>Disabled Options</h2>
    <n-container data-kind="panel" bordered size="sm">
      <n-stack direction="row" wrap align="center">
        <n-select placeholder="Choose role">
          <n-listbox popover="manual">
            <n-option value="viewer">Viewer</n-option>
            <n-option value="editor">Editor</n-option>
            <n-option value="admin" disabled>Admin (restricted)</n-option>
            <n-option value="owner" disabled>Owner (restricted)</n-option>
          </n-listbox>
        </n-select>
      </n-stack>
      <pre class="code-block"><code>&lt;n-select placeholder="Choose role"&gt;
  &lt;n-listbox popover&gt;
    &lt;n-option value="viewer"&gt;Viewer&lt;/n-option&gt;
    &lt;n-option value="admin" disabled&gt;Admin&lt;/n-option&gt;
  &lt;/n-listbox&gt;
&lt;/n-select&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Events ── -->

    <h2>Events</h2>
    <n-container data-kind="panel" bordered size="sm">
      <n-select id="event-select" placeholder="Choose color">
        <n-listbox popover="manual">
          <n-option value="red" label="Red">Red</n-option>
          <n-option value="green" label="Green">Green</n-option>
          <n-option value="blue" label="Blue">Blue</n-option>
        </n-listbox>
      </n-select>
      <div class="log" id="event-log"></div>
    <pre class="code-block"><code set:html={codeExamples.events} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Form Association ── -->

    <h2>Form Association</h2>
    <n-container data-kind="panel" bordered size="sm">
      <form id="demo-form">
        <div class="form-fields"><n-stack>
          <n-select name="color" placeholder="Favorite color">
            <n-listbox popover="manual">
              <n-option value="red">Red</n-option>
              <n-option value="green">Green</n-option>
              <n-option value="blue">Blue</n-option>
            </n-listbox>
          </n-select>
          <n-select name="size" placeholder="T-Shirt size">
            <n-listbox popover="manual">
              <n-option value="xs">Extra Small</n-option>
              <n-option value="sm">Small</n-option>
              <n-option value="md">Medium</n-option>
              <n-option value="lg">Large</n-option>
              <n-option value="xl">Extra Large</n-option>
            </n-listbox>
          </n-select>
        </n-stack></div>
        <n-stack direction="row" wrap align="center">
          <n-button variant="primary" type="submit"><span>Submit</span></n-button>
          <n-button variant="secondary" type="reset"><span>Reset</span></n-button>
        </n-stack>
      </form>
      <div class="log" id="form-log"></div>
    <pre class="code-block"><code>&lt;form&gt;
  &lt;n-select name="color" placeholder="Favorite color"&gt;
    &lt;n-listbox popover&gt;
      &lt;n-option value="red"&gt;Red&lt;/n-option&gt;
      &lt;n-option value="blue"&gt;Blue&lt;/n-option&gt;
    &lt;/n-listbox&gt;
  &lt;/n-select&gt;
  &lt;button type="submit"&gt;Submit&lt;/button&gt;
&lt;/form&gt;</code><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Data-Driven: Inline JSON ── -->

    <h2>Data-Driven: Inline JSON</h2>
    <n-container data-kind="panel" bordered size="sm">
      <n-stack direction="row" wrap align="center">
        <n-select
          placeholder="Choose a country"
          options='[{"value":"us","label":"United States"},{"value":"gb","label":"United Kingdom"},{"value":"de","label":"Germany"},{"value":"fr","label":"France"},{"value":"jp","label":"Japan"}]'
        ></n-select>
      </n-stack>
      <pre class="code-block"><code set:html={codeExamples.dataDrivenInlineJson} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Data-Driven: Pre-selected ── -->

    <h2>Data-Driven: Pre-selected Value</h2>
    <n-container data-kind="panel" bordered size="sm">
      <n-stack direction="row" wrap align="center">
        <n-select
          placeholder="Choose a country"
          value="de"
          options='[{"value":"us","label":"United States"},{"value":"gb","label":"United Kingdom"},{"value":"de","label":"Germany"},{"value":"fr","label":"France"}]'
        ></n-select>
      </n-stack>
      <pre class="code-block"><code set:html={codeExamples.dataDrivenPreSelectedValue} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Data-Driven: Disabled Options ── -->

    <h2>Data-Driven: Disabled Options</h2>
    <n-container data-kind="panel" bordered size="sm">
      <n-stack direction="row" wrap align="center">
        <n-select
          placeholder="Choose a role"
          options='[{"value":"viewer","label":"Viewer"},{"value":"editor","label":"Editor"},{"value":"admin","label":"Admin (restricted)","disabled":true},{"value":"owner","label":"Owner (restricted)","disabled":true}]'
        ></n-select>
      </n-stack>
      <pre class="code-block"><code set:html={codeExamples.dataDrivenDisabledOptions} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <!-- ── Data-Driven: Dynamic Update ── -->

    <h2>Data-Driven: Dynamic Update</h2>
    <n-container data-kind="panel" bordered size="sm">
      <n-stack direction="row" wrap align="center">
        <n-select id="dynamic-select" placeholder="Choose a fruit" options="[]"></n-select>
      </n-stack>
      <div class="dynamic-actions"><n-stack direction="row" wrap align="center">
        <n-button id="load-fruits" size="sm" variant="secondary"><span>Load fruits</span></n-button>
        <n-button id="load-colors" size="sm" variant="secondary"><span>Load colors</span></n-button>
      </n-stack></div>
      <div class="log" id="dynamic-log"></div>
    <pre class="code-block"><code set:html={codeExamples.dataDrivenDynamicUpdate} /><n-button size="sm" variant="ghost" aria-label="Copy"><n-icon name="copy"></n-icon></n-button></pre>
    </n-container>

    <h2>API Reference</h2>
    <ApiReference data={selectApi} />
  </section>

  <script>
    import './select.ts';
  </script>
  <style is:global>
    @import './select.css';
  </style>
</SidebarLayout>
