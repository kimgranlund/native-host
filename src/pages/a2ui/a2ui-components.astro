---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="A2UI Components">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>A2UI Styled Components</h1>
      </div>
    </div>
    <div slot="description">
      All components below are rendered through the A2UI protocol adapter into the chat panel.
      Each element carries a <code>[data-a2ui]</code> attribute and is styled via <code>a2ui.css</code>.
    </div>
  </header>

  <section id="a2ui-components-page"></section>

  <script>
import { Kernel, resetKernel } from "@nonoun/native-ui/kernel";
import { createA2UIAdapter } from "@nonoun/native-ai";

document.addEventListener('astro:page-load', async () => {
      const pageEl = document.getElementById('a2ui-components-page');
      if (!pageEl) return;

      // ── Boot ──
      resetKernel();
      const kernel = new Kernel({ allowUnregistered: true });
      const messages = [];
      // WHY: Astro hoists module scripts — setup.ts (which registers native-chat-panel)
      // may not have run yet. Wait for the CE definition before using .ready.
      await customElements.whenDefined('native-chat-panel');
      const chatPanel = document.getElementById('chat-panel');
      if (!chatPanel) return;
      await chatPanel.ready;
      const target = chatPanel.querySelector('n-chat-content');
      if (!target) return;

      const adapter = createA2UIAdapter(kernel, {
        onClientMessage: (msg) => {
          messages.push(msg);
          console.log('[A2UI Client →]', JSON.stringify(msg, null, 2));
        },
        onRender: () => {
          chatPanel.setAttribute('open', '');
        },
      });

      // ── Demo Surfaces ──

      // 1. Text Variants
      adapter.receive({
        updateComponents: {
          surfaceId: 'text-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Text Variants', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'content' },
            { id: 'content', component: 'Column', children: ['text-h1', 'text-h2', 'text-h3', 'text-body', 'text-caption'] },
            { id: 'text-h1', component: 'Text', text: 'Heading 1', variant: 'h1' },
            { id: 'text-h2', component: 'Text', text: 'Heading 2', variant: 'h2' },
            { id: 'text-h3', component: 'Text', text: 'Heading 3', variant: 'h3' },
            { id: 'text-body', component: 'Text', text: 'Body text — the quick brown fox jumps over the lazy dog.' },
            { id: 'text-caption', component: 'Text', text: 'Caption text — secondary information', variant: 'caption' },
          ],
        },
      }, target);

      // 2. Buttons
      adapter.receive({
        updateComponents: {
          surfaceId: 'buttons-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Buttons', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'content' },
            { id: 'content', component: 'Row', children: ['button-primary', 'button-default', 'button-ghost', 'button-disabled'] },
            { id: 'button-primary', component: 'Button', text: 'Primary', variant: 'primary', action: { event: { name: 'click' } } },
            { id: 'button-default', component: 'Button', text: 'Default', action: { event: { name: 'click' } } },
            { id: 'button-ghost', component: 'Button', text: 'Ghost', variant: 'borderless', action: { event: { name: 'click' } } },
            { id: 'button-disabled', component: 'Button', text: 'Disabled', disabled: true },
          ],
        },
      }, target);

      // 3. Form Fields
      adapter.receive({
        updateComponents: {
          surfaceId: 'form-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Form Fields', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'content' },
            { id: 'content', component: 'Column', children: ['field-name', 'field-password', 'field-quantity', 'field-message', 'field-date', 'field-time'] },
            { id: 'field-name', component: 'TextField', placeholder: 'Enter your name', label: 'Name' },
            { id: 'field-password', component: 'TextField', placeholder: 'Password', label: 'Password', variant: 'obscured' },
            { id: 'field-quantity', component: 'TextField', placeholder: '0', label: 'Quantity', variant: 'number' },
            { id: 'field-message', component: 'TextArea', placeholder: 'Write a message...', label: 'Message' },
            { id: 'field-date', component: 'DateTimeInput', label: 'Date', enableDate: true },
            { id: 'field-time', component: 'DateTimeInput', label: 'Time', enableTime: true },
          ],
        },
      }, target);

      // 4. Toggles
      adapter.receive({
        updateComponents: {
          surfaceId: 'toggles-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Toggles', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'content' },
            { id: 'content', component: 'Row', children: ['checkbox-terms', 'checkbox-subscribe', 'switch-notifications', 'switch-dark-mode'] },
            { id: 'checkbox-terms', component: 'CheckBox', label: 'Agree to terms' },
            { id: 'checkbox-subscribe', component: 'CheckBox', label: 'Subscribe', disabled: true },
            { id: 'switch-notifications', component: 'Switch', label: 'Notifications' },
            { id: 'switch-dark-mode', component: 'Switch', label: 'Dark mode' },
          ],
        },
      }, target);

      // 5. Slider
      adapter.receive({
        updateComponents: {
          surfaceId: 'slider-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Slider', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'slider-volume' },
            { id: 'slider-volume', component: 'Slider', min: 0, max: 100, value: 50, label: 'Volume' },
          ],
        },
      }, target);

      // 6. List
      adapter.receive({
        updateComponents: {
          surfaceId: 'list-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'List', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'list-fruit' },
            { id: 'list-fruit', component: 'List', children: ['option-apple', 'option-banana', 'option-cherry'] },
            { id: 'option-apple', component: 'ListItem', label: 'Apple', value: 'apple' },
            { id: 'option-banana', component: 'ListItem', label: 'Banana', value: 'banana' },
            { id: 'option-cherry', component: 'ListItem', label: 'Cherry', value: 'cherry' },
          ],
        },
      }, target);

      // 7. Card
      adapter.receive({
        updateComponents: {
          surfaceId: 'card-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body', 'card-footer'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Card', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'description' },
            { id: 'description', component: 'Text', text: 'This is a card rendered entirely through the A2UI protocol. The agent describes the UI declaratively and the adapter renders it using native-ui components.' },
            { id: 'card-footer', component: 'Footer', child: 'actions-row' },
            { id: 'actions-row', component: 'Row', children: ['button-save', 'button-cancel'] },
            { id: 'button-save', component: 'Button', text: 'Save', variant: 'primary', action: { event: { name: 'save' } } },
            { id: 'button-cancel', component: 'Button', text: 'Cancel', variant: 'borderless', action: { event: { name: 'cancel' } } },
          ],
        },
      }, target);

      // 8. Badge & Avatar
      adapter.receive({
        updateComponents: {
          surfaceId: 'badge-avatar-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Badge & Avatar', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'content' },
            { id: 'content', component: 'Row', children: ['badge-count', 'badge-new', 'badge-overflow', 'avatar-user'] },
            { id: 'badge-count', component: 'Badge', text: '3' },
            { id: 'badge-new', component: 'Badge', text: 'New', variant: 'solid' },
            { id: 'badge-overflow', component: 'Badge', text: '99+' },
            { id: 'avatar-user', component: 'Avatar', src: 'https://i.pravatar.cc/96?u=a2ui', alt: 'User avatar' },
          ],
        },
      }, target);

      // 9. Divider
      adapter.receive({
        updateComponents: {
          surfaceId: 'divider-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Divider', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'content' },
            { id: 'content', component: 'Column', children: ['text-above', 'divider-main', 'text-below'] },
            { id: 'text-above', component: 'Text', text: 'Content above the divider' },
            { id: 'divider-main', component: 'Divider' },
            { id: 'text-below', component: 'Text', text: 'Content below the divider' },
          ],
        },
      }, target);

      // 10. Media
      adapter.receive({
        updateComponents: {
          surfaceId: 'media-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Image', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'image-landscape' },
            { id: 'image-landscape', component: 'Image', url: 'https://picsum.photos/600/200', alt: 'Random landscape' },
          ],
        },
      }, target);

      // 11. Icon
      adapter.receive({
        updateComponents: {
          surfaceId: 'icon-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Icon', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'content' },
            { id: 'content', component: 'Row', children: ['icon-house', 'icon-gear', 'icon-bell', 'icon-search'] },
            { id: 'icon-house', component: 'Icon', name: 'house' },
            { id: 'icon-gear', component: 'Icon', name: 'gear' },
            { id: 'icon-bell', component: 'Icon', name: 'bell' },
            { id: 'icon-search', component: 'Icon', name: 'magnifying-glass' },
          ],
        },
      }, target);

      // 12. Select (dropdown)
      adapter.receive({
        updateComponents: {
          surfaceId: 'select-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Select', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'select-option' },
            { id: 'select-option', component: 'Select', label: 'Pick an option', children: ['select-option-a', 'select-option-b', 'select-option-c'] },
            { id: 'select-option-a', component: 'ListItem', label: 'Option A', value: 'a' },
            { id: 'select-option-b', component: 'ListItem', label: 'Option B', value: 'b' },
            { id: 'select-option-c', component: 'ListItem', label: 'Option C', value: 'c' },
          ],
        },
      }, target);

      // 13. ChoicePicker
      adapter.receive({
        updateComponents: {
          surfaceId: 'choice-picker-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'ChoicePicker', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'picker-size' },
            { id: 'picker-size', component: 'ChoicePicker', label: 'Pick a size', children: ['choice-small', 'choice-medium', 'choice-large'], variant: 'mutuallyExclusive' },
            { id: 'choice-small', component: 'ListItem', label: 'Small', value: 'sm' },
            { id: 'choice-medium', component: 'ListItem', label: 'Medium', value: 'md' },
            { id: 'choice-large', component: 'ListItem', label: 'Large', value: 'lg' },
          ],
        },
      }, target);

      // 14. Modal
      adapter.receive({
        updateComponents: {
          surfaceId: 'modal-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Modal', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'content' },
            { id: 'content', component: 'Column', children: ['button-open-modal', 'modal-dialog'] },
            { id: 'button-open-modal', component: 'Button', text: 'Open Modal', action: { event: { name: 'open-modal' } } },
            { id: 'modal-dialog', component: 'Modal', children: ['modal-card'] },
            { id: 'modal-card', component: 'Card', children: ['modal-header', 'modal-body', 'modal-footer'] },
            { id: 'modal-header', component: 'Header', children: ['modal-title'] },
            { id: 'modal-title', component: 'Text', text: 'Dialog Title', variant: 'h3' },
            { id: 'modal-body', component: 'Body', child: 'modal-description' },
            { id: 'modal-description', component: 'Text', text: 'This is a modal dialog rendered through the A2UI protocol. Click the backdrop or press Escape to close.' },
            { id: 'modal-footer', component: 'Footer', child: 'button-close-modal' },
            { id: 'button-close-modal', component: 'Button', text: 'Close', variant: 'primary', action: { event: { name: 'close-modal' } } },
          ],
        },
      }, target);

      // Wire modal open/close
      kernel.bus.on(
        (cmd) => cmd.type === 'a2ui:modal-demo:button-open-modal:open-modal',
        () => {
          const dialog = target.querySelector('[data-a2ui="Modal"]');
          if (dialog) dialog.showModal();
        },
      );
      kernel.bus.on(
        (cmd) => cmd.type === 'a2ui:modal-demo:button-close-modal:close-modal',
        () => {
          const dialog = target.querySelector('[data-a2ui="Modal"]');
          if (dialog) dialog.close();
        },
      );

      // 15. Tabs
      adapter.receive({
        updateComponents: {
          surfaceId: 'tabs-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Tabs', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'tabs-product' },
            { id: 'tabs-product', component: 'Tabs', children: ['tab-overview', 'tab-features', 'tab-pricing'] },
            { id: 'tab-overview', component: 'Column', label: 'Overview', value: 'overview', children: ['tab-overview-text'] },
            { id: 'tab-overview-text', component: 'Text', text: 'This is the overview panel rendered through A2UI.' },
            { id: 'tab-features', component: 'Column', label: 'Features', value: 'features', children: ['tab-features-text'] },
            { id: 'tab-features-text', component: 'Text', text: 'Features include roving focus, ARIA semantics, and keyboard navigation.' },
            { id: 'tab-pricing', component: 'Column', label: 'Pricing', value: 'pricing', children: ['tab-pricing-text'] },
            { id: 'tab-pricing-text', component: 'Text', text: 'Pricing plans start at $0/month for open source projects.' },
          ],
        },
      }, target);

      // 16. Video
      adapter.receive({
        updateComponents: {
          surfaceId: 'video-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Video', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'video-flower' },
            { id: 'video-flower', component: 'Video', url: 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.webm' },
          ],
        },
      }, target);

      // 17. AudioPlayer
      adapter.receive({
        updateComponents: {
          surfaceId: 'audio-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'AudioPlayer', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'audio-sample' },
            { id: 'audio-sample', component: 'AudioPlayer', url: 'https://interactive-examples.mdn.mozilla.net/media/cc0-audio/t-rex-roar.mp3' },
          ],
        },
      }, target);

      // 18. Data Binding Demo
      const bindingContainer = document.createElement('div');
      target.appendChild(bindingContainer);

      adapter.receive({
        createSurface: { surfaceId: 'binding-demo' },
      }, bindingContainer);

      adapter.receive({
        updateComponents: {
          surfaceId: 'binding-demo',
          components: [
            { id: 'root', component: 'Card', children: ['card-header', 'card-body', 'card-footer'] },
            { id: 'card-header', component: 'Header', children: ['title'] },
            { id: 'title', component: 'Text', text: 'Data Binding', variant: 'h3' },
            { id: 'card-body', component: 'Body', child: 'content' },
            { id: 'content', component: 'Column', children: ['text-greeting', 'input-name'] },
            { id: 'text-greeting', component: 'Text', text: { path: '/greeting' } },
            { id: 'input-name', component: 'TextField', value: { path: '/name' }, placeholder: 'Type a name...', label: 'Name' },
            { id: 'card-footer', component: 'Footer', child: 'counter-row' },
            { id: 'counter-row', component: 'Row', children: ['text-count', 'button-increment'] },
            { id: 'text-count', component: 'Text', text: { path: '/countLabel' } },
            { id: 'button-increment', component: 'Button', text: 'Increment', action: { event: { name: 'increment' } } },
          ],
        },
      });

      adapter.receive({
        updateDataModel: {
          surfaceId: 'binding-demo',
          value: {
            greeting: 'Hello, World!',
            name: 'World',
            count: 0,
            countLabel: 'Count: 0',
          },
        },
      });

      // Listen for increment action
      kernel.bus.on(
        (cmd) => cmd.type === 'a2ui:binding-demo:button-increment:increment',
        () => {
          const model = adapter.getDataModel('binding-demo');
          const count = (Number(model?.count) || 0) + 1;
          adapter.receive({
            updateDataModel: {
              surfaceId: 'binding-demo',
              path: '/count',
              value: count,
            },
          });
          adapter.receive({
            updateDataModel: {
              surfaceId: 'binding-demo',
              path: '/countLabel',
              value: `Count: ${count}`,
            },
          });
        },
      );
});
  </script>
  <style is:global>
    @import '@nonoun/native-ai/css';

    .nav-main {
      padding: 2rem;
      max-width: 960px;
    }
</style>

</SidebarLayout>
