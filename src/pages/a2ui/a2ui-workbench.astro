---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="A2UI Workbench">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>A2UI Protocol Workbench</h1>
      </div>
    </div>
    <div data-slot="description">
      JSONL editor with sandboxed kernel preview and protocol inspector.
      Pick a preset from the dropdown or edit envelopes directly, then step through with the playback controls.
    </div>
  </header>

  <section id="a2ui-workbench-page">
    <native-a2ui id="workbench"></native-a2ui>
  </section>

  <style is:global>
    @import '@nonoun/native-ai/css';
    @import '@nonoun/native-code/css';
  </style>
</SidebarLayout>
