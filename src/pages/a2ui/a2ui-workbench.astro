  // ── Load Preset into Workbench ──

  function loadPreset(id: string) {
    const envelopes = PRESETS[id];
    if (!envelopes) return;
    (workbench as any).stream = envelopes
      .map((env: object) => JSON.stringify({ ...env, version: '0.9' }))
      .join('\n');
  }

  for (const id of Object.keys(PRESETS)) {
    const btn = page.querySelector(`#${id}`);
    btn?.addEventListener('native:press', () => loadPreset(id));
  }
