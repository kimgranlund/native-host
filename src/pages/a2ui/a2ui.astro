              { id: 'title', component: 'Text', text: 'Product Details', variant: 'h2' },
              { id: 'card-body', component: 'Body', child: 'card-content' },
              { id: 'card-content', component: 'Column', children: ['nav-row', 'overview-section', 'specs-section', 'reviews-section'] },
