                { id: 'card-second', component: 'Card', children: ['card-second-header', 'card-second-body'] },
                { id: 'card-second-header', component: 'Header', children: ['card-second-title'] },
                { id: 'card-second-title', component: 'Text', text: 'Second Result', variant: 'h3' },
                { id: 'card-second-body', component: 'Body', child: 'card-second-content' },
                { id: 'card-second-content', component: 'Text', text: 'Streamed alongside the first result.' },
              ],
            },
          };
          adapter.receive(phase2, container);
          log('STREAMING: Phase 2 — content cards', 'cmd');
        }, 800);

        // Phase 3: final update after 1600ms
        setTimeout(() => {
          const phase3 = {
            updateComponents: {
              surfaceId: 'demo',
              components: [
                { id: 'root', component: 'Card', children: ['card-header', 'card-body', 'card-footer'] },
                { id: 'card-header', component: 'Header', children: ['heading', 'status'] },
                { id: 'heading', component: 'Text', text: 'Streaming Demo', variant: 'h2' },
                { id: 'status', component: 'Badge', text: 'Complete' },
                { id: 'card-body', component: 'Body', child: 'card-content' },
                { id: 'card-content', component: 'Column', children: ['card-first', 'card-second', 'card-third'] },
                { id: 'card-first', component: 'Card', children: ['card-first-header', 'card-first-body'] },
                { id: 'card-first-header', component: 'Header', children: ['card-first-title'] },
                { id: 'card-first-title', component: 'Text', text: 'First Result', variant: 'h3' },
                { id: 'card-first-body', component: 'Body', child: 'card-first-content' },
                { id: 'card-first-content', component: 'Text', text: 'This card arrived in the second batch of components.' },
                { id: 'card-second', component: 'Card', children: ['card-second-header', 'card-second-body'] },
                { id: 'card-second-header', component: 'Header', children: ['card-second-title'] },
                { id: 'card-second-title', component: 'Text', text: 'Second Result', variant: 'h3' },
                { id: 'card-second-body', component: 'Body', child: 'card-second-content' },
                { id: 'card-second-content', component: 'Text', text: 'Streamed alongside the first result.' },
                { id: 'card-third', component: 'Card', children: ['card-third-header', 'card-third-body'] },
                { id: 'card-third-header', component: 'Header', children: ['card-third-title'] },
                { id: 'card-third-title', component: 'Text', text: 'Third Result', variant: 'h3' },
                { id: 'card-third-body', component: 'Body', child: 'card-third-content' },
                { id: 'card-third-content', component: 'Text', text: 'Final card — stream complete.' },
                { id: 'card-footer', component: 'Footer', children: ['card-actions'] },
                { id: 'card-actions', component: 'Row', children: ['button-refresh'] },
                { id: 'button-refresh', component: 'Button', text: 'Refresh Results', variant: 'primary', action: { event: { name: 'refresh' } } },
              ],
            },
          };
          adapter.receive(phase3, container);
          log('STREAMING: Phase 3 — complete', 'cmd');
        }, 1600);
      });

      // ── Multi-Surface Preset ──

      document.getElementById('preset-multi-surface')?.addEventListener('native:press', () => {
        clearChat();
        messageInput.value = '';

        appendUserMessage('Multi-Surface');
        const container = appendAssistantMessage();

        // Create two stacked containers inside the assistant message
        const containerA = document.createElement('div');
        const containerB = document.createElement('div');
        container.appendChild(containerA);
        container.appendChild(containerB);

        // Surface A: note-taking
        const surfaceA = {
          updateComponents: {
            surfaceId: 'surface-a',
            components: [
              { id: 'root', component: 'Card', children: ['card-header', 'card-body', 'card-footer'] },
              { id: 'card-header', component: 'Header', children: ['title', 'badge'] },
              { id: 'title', component: 'Text', text: 'Notes', variant: 'h3' },
              { id: 'badge', component: 'Badge', text: 'Surface A' },
              { id: 'card-body', component: 'Body', child: 'card-content' },
              { id: 'card-content', component: 'Column', children: ['note-input'] },
              { id: 'note-input', component: 'TextArea', placeholder: 'Write a note...' },
              { id: 'card-footer', component: 'Footer', children: ['card-actions'] },
              { id: 'card-actions', component: 'Row', children: ['button-save'] },
              { id: 'button-save', component: 'Button', text: 'Save Note', variant: 'primary', action: { event: { name: 'save_note' } } },
            ],
          },
        };

        // Surface B: task list
        const surfaceB = {
          updateComponents: {
            surfaceId: 'surface-b',
            components: [
              { id: 'root', component: 'Card', children: ['card-header', 'card-body', 'card-footer'] },
              { id: 'card-header', component: 'Header', children: ['title', 'badge'] },
              { id: 'title', component: 'Text', text: 'Tasks', variant: 'h3' },
              { id: 'badge', component: 'Badge', text: 'Surface B' },
              { id: 'card-body', component: 'Body', child: 'card-content' },
              { id: 'card-content', component: 'Column', children: ['task-list'] },
              { id: 'task-list', component: 'List', children: ['task-review', 'task-documentation', 'task-deploy'] },
              { id: 'task-review', component: 'ListItem', text: 'Review pull requests', value: 'pr' },
              { id: 'task-documentation', component: 'ListItem', text: 'Write documentation', value: 'docs' },
              { id: 'task-deploy', component: 'ListItem', text: 'Deploy to staging', value: 'deploy' },
              { id: 'card-footer', component: 'Footer', children: ['card-actions'] },
              { id: 'card-actions', component: 'Row', children: ['button-add'] },
              { id: 'button-add', component: 'Button', text: 'Add Task', action: { event: { name: 'add_task' } } },
            ],
          },
        };

        chatPanel.setAttribute('open', '');
        adapter.receive(surfaceA, containerA);
        adapter.receive(surfaceB, containerB);
        surfaceCountEl.textContent = adapter.getSurfaceIds().length;
        log('MULTI: Created surfaces A (notes) and B (tasks)', 'cmd');
      });

      // Clear button
      document.getElementById('preset-clear').addEventListener('native:press', () => {
        clearChat();
        chatPanel.removeAttribute('open');
        messageInput.value = '';
        log('Surface cleared', '');
      });

      // ── Chat Input ──

      chatPanel.addEventListener('native:send', (e) => {
        const value = e.detail?.value?.trim();
        if (!value) return;

        try {
          const msg = JSON.parse(value);
          const key = Object.keys(msg)[0];
          log(`RECEIVE: ${key}`, 'cmd');
          clearChat();
          appendUserMessage(key);
          const container = appendAssistantMessage();
          adapter.receive(msg, container);
          surfaceCountEl.textContent = adapter.getSurfaceIds().length;
        } catch {
          appendUserMessage(value);
        }
      });

      // ── Emit ──

      document.getElementById('emit-form').addEventListener('native:press', () => {
        const result = Planner.form(
          [
            { name: 'email', type: 'email', label: 'Email' },
            { name: 'password', type: 'password', label: 'Password' },
          ],
          { title: 'Login', submitLabel: 'Sign In', submitCommand: 'auth.login' },
        );
        const msg = adapter.emitPlanResult(result, 'login-surface');
        emitOutput.textContent = JSON.stringify(msg, null, 2);
        log('EMIT: Planner.form() → A2UI updateComponents', 'cmd');
      });

      document.getElementById('emit-actions').addEventListener('native:press', () => {
        const result = Planner.actions(
          [
            { label: 'Save', command: 'doc.save', variant: 'primary' },
            { label: 'Discard', command: 'doc.discard' },
            { label: 'Preview', command: 'doc.preview' },
          ],
        );
        const msg = adapter.emitPlanResult(result, 'actions-surface');
        emitOutput.textContent = JSON.stringify(msg, null, 2);
        log('EMIT: Planner.actions() → A2UI updateComponents', 'cmd');
      });

      document.getElementById('emit-card').addEventListener('native:press', () => {
        const result = Planner.card({
          heading: 'Welcome Back',
          body: 'You have 3 unread notifications and 2 pending tasks.',
          footer: [
            { label: 'View All', command: 'nav.notifications', variant: 'primary' },
            { label: 'Dismiss', command: 'dismiss' },
          ],
        });
        const msg = adapter.emitPlanResult(result, 'card-surface');
        emitOutput.textContent = JSON.stringify(msg, null, 2);
        log('EMIT: Planner.card() → A2UI updateComponents', 'cmd');
      });
});
  </script>
  <style is:global>
    @import '../../styles/native-ai.css';

    .status-bar {
      display: flex;
      gap: 1rem;
      align-items: center;
      font-size: 0.75rem;
      font-family: ui-monospace, monospace;
      margin-top: 0.75rem;
      padding: 0.5rem 0.75rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.375rem;
    }

    .status-bar .label {
      color: var(--n-ink-muted-neutral);
    }

    .status-bar .value {
      color: var(--n-ink-accent);
      font-weight: 600;
    }

    .plan-input n-textarea {
      font-family: ui-monospace, monospace;
      font-size: 0.75rem;
      tab-size: 2;
      white-space: pre-wrap;
      word-break: break-all;
      height: calc(var(--n-size) * 5);
    }
</style>

</SidebarLayout>
