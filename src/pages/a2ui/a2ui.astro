              { id: 'reviews-text', component: 'Text', text: 'No reviews yet. Be the first to review this product!' },
            ],
          },
        },

        'preset-data': {
          updateComponents: {
            surfaceId: 'demo',
            components: [
              { id: 'root', component: 'Card', children: ['card-header', 'card-body'] },
