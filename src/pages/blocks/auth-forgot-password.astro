---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Auth Forgot Password" panels={[]}>
  <main>
<h1>Forgot Password</h1>
    <p class="demo-desc">
      Minimal password reset request card with email input and back-to-login link.
    </p>

    <!-- ── Reset Password Card ── -->

    <h2>Reset Password</h2>
    <div class="demo-section">
      <div class="auth-centered auth-centered-compact">
        <div class="auth-card-wrapper">
          <div class="auth-icon-circle">
            <n-icon name="envelope" size="lg"></n-icon>
          </div>
          <p class="auth-heading">Reset your password</p>
          <p class="auth-subheading">
            Enter the email address associated with your account and we'll send you a link to reset your password.
          </p>
          <div class="auth-card">
            <n-card>
              <form>
                <n-stack gap="6">
                  <n-field required>
                    <label slot="label">Email address</label>
                    <n-input type="email" placeholder="kim@example.com" name="email">
                      <n-icon name="envelope" slot="leading"></n-icon>
                    </n-input>
                  </n-field>
                  <n-button variant="primary" intent="accent" type="submit">
                    <span slot="label">Send Reset Link</span>
                  </n-button>
                </n-stack>
              </form>
            </n-card>
          </div>
          <a href="#" class="auth-back-link">
            <n-icon name="arrow-left" size="sm"></n-icon>
            Back to sign in
          </a>
        </div>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('astro:page-load', () => {
      if (!document.querySelector('.auth-back-link')) return;
      for (const form of document.querySelectorAll('form')) {
        form.addEventListener('submit', (e) => e.preventDefault());
      }
    });
  </script>
  <style is:global>
    .auth-centered {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: calc(100vh - 8rem);
    }

    .auth-card-wrapper {
      width: 100%;
      max-width: 26rem;
    }

    .auth-card {
      padding: 2.25rem;
    }

    /* TODO(T0071): n-field needs gap attribute */
    .auth-card n-field {
      gap: calc(var(--n-space) * 2);
    }

    .auth-icon-circle {
      width: 3rem;
      height: 3rem;
      border-radius: 50%;
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
    }

    .auth-heading {
      text-align: center;
      margin-bottom: 0.25rem;
      font-size: 1.25rem;
      font-weight: 700;
    }

    .auth-subheading {
      text-align: center;
      color: var(--n-ink-muted-neutral);
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
      line-height: 1.5;
    }

    .auth-back-link {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      font-size: 0.8125rem;
      color: var(--n-ink-muted-neutral);
      text-decoration: none;
      margin-top: 1.5rem;
    }

    .auth-back-link:hover {
      color: var(--n-ink-neutral);
    }

    .auth-centered-compact {
      min-height: 32rem;
    }
</style>

</SidebarLayout>
