---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Command Palette">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Command Palette</h1>
      </div>
    </div>
    <div data-slot="description">

      Quick-access command palette in a dialog overlay. Searchable, keyboard navigable,
      and grouped by category. Opens via button click or <kbd>Ctrl+K</kbd> shortcut.

    </div>
  </header>
  <section>
<n-stack gap="6">

    <!-- -- Trigger Area -- -->

    <n-stack gap="4">
    <h2>Open Command Palette</h2>
    <div class="trigger-area">
      <n-button id="open-palette" intent="accent" size="lg">
        <n-icon name="magnifying-glass" slot="leading"></n-icon>
        <span>Open Command Palette</span>
      </n-button>
      <p class="trigger-hint">
        or press <kbd>Ctrl</kbd> + <kbd>K</kbd> anywhere on the page
      </p>
    </div>

    <!-- -- Dialog with Command Palette -- -->

    <n-dialog id="palette-dialog">
      <div class="dialog-panel">
        <n-command id="palette-command">
          <n-command-input>
            <n-icon name="magnifying-glass"></n-icon>
            <input type="text" placeholder="Type a command or search..." />
          </n-command-input>
          <n-command-list>
            <n-command-group>
              <div slot="heading">Recent</div>
              <n-command-item value="go-dashboard" keywords="home overview">
                <n-icon name="house"></n-icon> Dashboard
              </n-command-item>
              <n-command-item value="go-settings" keywords="preferences config">
                <n-icon name="gear"></n-icon> Settings
              </n-command-item>
              <n-command-item value="go-profile" keywords="account user">
                <n-icon name="user"></n-icon> Profile
              </n-command-item>
            </n-command-group>
            <n-command-group>
              <div slot="heading">Actions</div>
              <n-command-item value="create-project" keywords="new add">
                <n-icon name="plus"></n-icon> Create new project
                <span class="shortcut">Ctrl+N</span>
              </n-command-item>
              <n-command-item value="invite-member" keywords="team add user">
                <n-icon name="user-plus"></n-icon> Invite team member
              </n-command-item>
              <n-command-item value="export-data" keywords="download csv">
                <n-icon name="arrow-right"></n-icon> Export data
              </n-command-item>
            </n-command-group>
            <n-command-group>
              <div slot="heading">Navigation</div>
              <n-command-item value="nav-dashboard" keywords="home">
                <n-icon name="house"></n-icon> Go to Dashboard
                <span class="shortcut">G D</span>
              </n-command-item>
              <n-command-item value="nav-projects" keywords="work tasks">
                <n-icon name="folder"></n-icon> Go to Projects
                <span class="shortcut">G P</span>
              </n-command-item>
              <n-command-item value="nav-settings" keywords="preferences">
                <n-icon name="gear"></n-icon> Go to Settings
                <span class="shortcut">G S</span>
              </n-command-item>
            </n-command-group>
          </n-command-list>
          <n-command-empty>No matching commands found.</n-command-empty>
        </n-command>
      </div>
    </n-dialog>
    </n-stack>

    <!-- -- Inline Preview -- -->

    <n-stack gap="4">
    <div>
      <h2>Inline Preview</h2>
      <p class="demo-text-sm">
        The same command palette rendered inline for reference.
      </p>
    </div>
    <div class="inline-preview">
      <n-command>
        <n-command-input>
          <n-icon name="magnifying-glass"></n-icon>
          <input type="text" placeholder="Type a command or search..." />
        </n-command-input>
        <n-command-list>
          <n-command-group>
            <div slot="heading">Recent</div>
            <n-command-item value="preview-dashboard">
              <n-icon name="house"></n-icon> Dashboard
            </n-command-item>
            <n-command-item value="preview-settings">
              <n-icon name="gear"></n-icon> Settings
            </n-command-item>
          </n-command-group>
          <n-command-group>
            <div slot="heading">Actions</div>
            <n-command-item value="preview-create">
              <n-icon name="plus"></n-icon> Create new project
            </n-command-item>
            <n-command-item value="preview-invite">
              <n-icon name="user-plus"></n-icon> Invite team member
            </n-command-item>
          </n-command-group>
        </n-command-list>
        <n-command-empty>No results.</n-command-empty>
      </n-command>
    </div>
    </n-stack>
    </n-stack>
  </section>

  <script>
    document.addEventListener('astro:page-load', () => {
      const dialog = document.getElementById('palette-dialog');
      if (!dialog) return;
      const command = document.getElementById('palette-command');

      // Open via button
      document.getElementById('open-palette')?.addEventListener('native:press', () => {
        dialog.showModal();
      });

      // Open via Ctrl+K global shortcut
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          dialog.showModal();
        }
      });

      // Close dialog on command selection
      command?.addEventListener('native:change', () => {
        dialog.close();
      });

      // Close dialog on Escape (native:dismiss from command)
      command?.addEventListener('native:dismiss', () => {
        dialog.close();
      });
    });
  </script>
  <style is:global>
    .dialog-panel {
      background: var(--n-body-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.75rem;
      box-shadow:
        0 8px 30px oklch(0% 0 0 / 0.12),
        0 2px 8px oklch(0% 0 0 / 0.06);
      width: min(32rem, calc(100vw - 2rem));
      overflow: hidden;
    }

    .shortcut {
      font-family: ui-monospace, monospace;
      font-size: 0.625rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.25rem;
      padding: 0.125rem 0.375rem;
      margin-left: auto;
      color: var(--n-ink-muted-neutral);
    }

    .trigger-area {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      padding: 3rem 2rem;
      background: var(--n-body-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.75rem;
      text-align: center;
    }

    .trigger-hint {
      font-size: 0.8125rem;
      color: var(--n-ink-muted-neutral);
    }

    .inline-preview {
      max-width: 32rem;
    }

    .trigger-hint kbd {
      font-family: ui-monospace, monospace;
      font-size: 0.75rem;
      background: var(--n-panel-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.25rem;
      padding: 0.125rem 0.375rem;
    }
</style>

</SidebarLayout>
