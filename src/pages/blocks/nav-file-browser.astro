---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="File Browser">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>File Browser</h1>
      </div>
    </div>
    <div data-slot="description">

      File navigation layout with a tree sidebar, breadcrumb path bar, and file grid.
      Demonstrates <code>n-tree</code>, <code>n-breadcrumb</code>, and <code>n-icon</code> together.

    </div>
  </header>
  <main>
<n-stack gap="6">

    <div class="browser-shell">
      <!-- ── Sidebar: Tree Navigation ── -->
      <aside class="browser-sidebar">
        <div class="browser-sidebar-header">
          <span class="browser-brand-icon"><n-icon name="folder"></n-icon></span>
          <span class="browser-project-name">my-project</span>
        </div>
        <n-tree id="file-tree">
          <n-tree-item expanded>
            <span slot="label"><n-icon name="folder-open" size="sm"></n-icon> src</span>
            <n-tree-item expanded>
              <span slot="label"><n-icon name="folder-open" size="sm"></n-icon> components</span>
              <n-tree-item>
                <span slot="label"><n-icon name="file-text" size="sm"></n-icon> Button.tsx</span>
              </n-tree-item>
              <n-tree-item selected>
                <span slot="label"><n-icon name="file-text" size="sm"></n-icon> Dialog.tsx</span>
              </n-tree-item>
              <n-tree-item>
                <span slot="label"><n-icon name="file-text" size="sm"></n-icon> Input.tsx</span>
              </n-tree-item>
              <n-tree-item>
                <span slot="label"><n-icon name="file-text" size="sm"></n-icon> Table.tsx</span>
              </n-tree-item>
            </n-tree-item>
            <n-tree-item>
              <span slot="label"><n-icon name="folder" size="sm"></n-icon> styles</span>
              <n-tree-item>
                <span slot="label"><n-icon name="file-text" size="sm"></n-icon> globals.css</span>
              </n-tree-item>
              <n-tree-item>
                <span slot="label"><n-icon name="file-text" size="sm"></n-icon> tokens.css</span>
              </n-tree-item>
            </n-tree-item>
            <n-tree-item>
              <span slot="label"><n-icon name="folder" size="sm"></n-icon> utils</span>
              <n-tree-item>
                <span slot="label"><n-icon name="file-text" size="sm"></n-icon> helpers.ts</span>
              </n-tree-item>
              <n-tree-item>
                <span slot="label"><n-icon name="file-text" size="sm"></n-icon> format.ts</span>
              </n-tree-item>
            </n-tree-item>
            <n-tree-item>
              <span slot="label"><n-icon name="file-text" size="sm"></n-icon> index.ts</span>
            </n-tree-item>
          </n-tree-item>
          <n-tree-item>
            <span slot="label"><n-icon name="folder" size="sm"></n-icon> public</span>
            <n-tree-item>
              <span slot="label"><n-icon name="image" size="sm"></n-icon> logo.svg</span>
            </n-tree-item>
            <n-tree-item>
              <span slot="label"><n-icon name="image" size="sm"></n-icon> favicon.ico</span>
            </n-tree-item>
          </n-tree-item>
          <n-tree-item>
            <span slot="label"><n-icon name="file-text" size="sm"></n-icon> package.json</span>
          </n-tree-item>
          <n-tree-item>
            <span slot="label"><n-icon name="file-text" size="sm"></n-icon> tsconfig.json</span>
          </n-tree-item>
        </n-tree>
      </aside>

      <!-- ── Main Content ── -->
      <div class="browser-main">
        <!-- ── Path Bar ── -->
        <div class="browser-path-bar">
          <n-breadcrumb size="sm">
            <n-breadcrumb-item>my-project</n-breadcrumb-item>
            <n-breadcrumb-item>src</n-breadcrumb-item>
            <n-breadcrumb-item current>components</n-breadcrumb-item>
          </n-breadcrumb>
          <div class="browser-path-actions">
            <n-button variant="ghost" size="sm" aria-label="Grid view">
              <n-icon name="grid-four"></n-icon>
            </n-button>
            <n-button variant="ghost" size="sm" aria-label="List view">
              <n-icon name="list"></n-icon>
            </n-button>
          </div>
        </div>

        <!-- ── File Grid ── -->
        <div class="file-grid">
          <div class="file-item folder">
            <n-icon name="folder" size="lg"></n-icon>
            <span class="file-name">styles</span>
            <span class="file-meta">2 items</span>
          </div>
          <div class="file-item folder">
            <n-icon name="folder" size="lg"></n-icon>
            <span class="file-name">utils</span>
            <span class="file-meta">2 items</span>
          </div>
          <div class="file-item">
            <n-icon name="file-text" size="lg"></n-icon>
            <span class="file-name">Button.tsx</span>
            <span class="file-meta">2.4 KB</span>
          </div>
          <div class="file-item selected">
            <n-icon name="file-text" size="lg"></n-icon>
            <span class="file-name">Dialog.tsx</span>
            <span class="file-meta">5.1 KB</span>
          </div>
          <div class="file-item">
            <n-icon name="file-text" size="lg"></n-icon>
            <span class="file-name">Input.tsx</span>
            <span class="file-meta">3.8 KB</span>
          </div>
          <div class="file-item">
            <n-icon name="file-text" size="lg"></n-icon>
            <span class="file-name">Table.tsx</span>
            <span class="file-meta">7.2 KB</span>
          </div>
          <div class="file-item">
            <n-icon name="file-text" size="lg"></n-icon>
            <span class="file-name">index.ts</span>
            <span class="file-meta">0.3 KB</span>
          </div>
        </div>

        <!-- ── Status Bar ── -->
        <div class="browser-status-bar">
          <span>7 items</span>
          <span>4 files, 2 folders</span>
        </div>
      </div>
    </div>
    </n-stack>
  </main>
  <style is:global>
    .browser-shell {
      display: grid;
      grid-template-columns: 14rem 1fr;
      gap: 1px;
      background: var(--n-border-muted-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.5rem;
      overflow: hidden;
      min-height: 28rem;
    }

    @media (max-width: 40rem) {
      .browser-shell {
        grid-template-columns: 1fr;
      }
      .browser-sidebar {
        display: none;
      }
    }

    .browser-sidebar {
      background: var(--n-body-neutral);
      padding: 0.75rem;
      overflow-y: auto;
    }

    .browser-sidebar-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 700;
      font-size: 0.8125rem;
      padding: 0.25rem 0.375rem 0.75rem;
      border-bottom: 1px solid var(--n-border-muted-neutral);
      margin-bottom: 0.5rem;
    }

    .browser-project-name {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .browser-main {
      background: var(--n-doc-neutral);
      display: flex;
      flex-direction: column;
    }

    .browser-path-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.5rem 1rem;
      border-bottom: 1px solid var(--n-border-muted-neutral);
      background: var(--n-body-neutral);
    }

    .browser-path-actions {
      display: flex;
      gap: 0.5rem;
    }

    .file-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
      gap: 0.75rem;
      padding: 1rem;
      flex: 1;
    }

    .file-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.375rem;
      padding: 1rem 0.5rem;
      border-radius: 0.375rem;
      cursor: pointer;
      text-align: center;
      transition: background 100ms ease;
    }

    .file-item:hover {
      background: var(--n-panel-neutral);
    }

    .file-item.selected {
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
    }

    .file-item.selected .file-meta {
      color: var(--n-surface-ink-accent);
      opacity: 0.7;
    }

    .file-item.folder {
      color: var(--n-ink-strong-accent);
    }

    .file-name {
      font-size: 0.75rem;
      font-weight: 500;
      word-break: break-all;
      line-height: 1.3;
    }

    .file-meta {
      font-size: 0.625rem;
      color: var(--n-ink-muted-neutral);
    }

    .browser-status-bar {
      display: flex;
      justify-content: space-between;
      padding: 0.375rem 1rem;
      font-size: 0.6875rem;
      color: var(--n-ink-muted-neutral);
      border-top: 1px solid var(--n-border-muted-neutral);
      background: var(--n-body-neutral);
    }

    .browser-brand-icon {
      display: inline-flex;
      color: var(--n-ink-strong-accent);
    }
</style>

</SidebarLayout>
