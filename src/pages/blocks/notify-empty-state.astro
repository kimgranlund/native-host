---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Empty State">
  <main>
<n-stack gap="6">
    <div>
      <h1>Empty States</h1>
      <p class="demo-desc">
        Placeholder patterns shown when content areas have no data.
        Each variant communicates context and offers a clear next action.
      </p>
    </div>

    <!-- -- No Data -- -->

    <n-stack gap="4">
    <h2>No Data</h2>
    <div class="empty-state">
      <n-icon name="folder" size="xl" aria-hidden="true"></n-icon>
      <h3>No projects yet</h3>
      <p>Create your first project to get started. Projects help you organize tasks, track progress, and collaborate with your team.</p>
      <n-button intent="accent">
        <n-icon name="plus" slot="leading"></n-icon>
        <span slot="label">Create Project</span>
      </n-button>
    </div>
    </n-stack>

    <!-- -- No Search Results -- -->

    <n-stack gap="4">
    <h2>No Search Results</h2>
    <div class="empty-state">
      <n-icon name="magnifying-glass" size="xl" aria-hidden="true"></n-icon>
      <h3>No results found</h3>
      <p>We couldn't find anything matching "quarterly report". Try adjusting your search terms or clearing filters.</p>
      <n-stack direction="row" gap="3">
        <n-button id="clear-search-btn">
          <n-icon name="x" slot="leading"></n-icon>
          <span slot="label">Clear Search</span>
        </n-button>
        <n-button id="browse-all-btn">
          <span slot="label">Browse All</span>
        </n-button>
      </n-stack>
    </div>
    </n-stack>

    <!-- -- Error State -- -->

    <n-stack gap="4">
    <h2>Error State</h2>
    <div class="empty-state">
      <n-icon name="warning" size="xl" aria-hidden="true" class="danger"></n-icon>
      <h3>Something went wrong</h3>
      <p>We couldn't load your projects. This might be a temporary issue. Please check your connection and try again.</p>
      <n-stack direction="row" gap="3">
        <n-button intent="accent" id="retry-btn">
          <span slot="label">Try Again</span>
        </n-button>
        <n-button id="support-btn">
          <span slot="label">Contact Support</span>
        </n-button>
      </n-stack>
    </div>
    </n-stack>
    </n-stack>
  </main>
  <style is:global>
    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 3rem 2rem;
      background: var(--n-body-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.75rem;
    }


    .empty-state h3 {
      font-size: 1.0625rem;
      font-weight: 700;
      margin: 0 0 0.5rem;
    }

    .empty-state p {
      font-size: 0.875rem;
      color: var(--n-ink-muted-neutral);
      margin: 0 0 1.25rem;
      max-width: 24rem;
      line-height: 1.5;
    }

    .empty-state > n-icon {
      color: var(--n-ink-muted-neutral);
      margin-bottom: 1rem;
    }

    .empty-state > n-icon.danger {
      color: var(--n-ink-strong-danger);
    }
</style>

</SidebarLayout>
