---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Error Page">
  <main>
<n-stack gap="6">
    <div>
      <h1>Error Pages</h1>
      <p style="color: var(--n-ink-muted-neutral); font-size: 0.875rem;">
        Full-page error patterns for common HTTP errors and maintenance windows.
        Each variant provides clear messaging and an actionable recovery path.
      </p>
    </div>

    <!-- -- 404 Not Found -- -->

    <n-stack gap="4">
    <h2>404 — Not Found</h2>
    <div class="error-page">
      <div class="error-code" aria-hidden="true">404</div>
      <h3>Page not found</h3>
      <p>The page you're looking for doesn't exist or has been moved. Check the URL or head back to the homepage.</p>
      <n-button variant="primary" intent="accent">
        <n-icon name="house" slot="leading"></n-icon>
        <span slot="label">Go Home</span>
      </n-button>
    </div>
    </n-stack>

    <!-- -- 500 Server Error -- -->

    <n-stack gap="4">
    <h2>500 — Server Error</h2>
    <div class="error-page">
      <div class="error-code" aria-hidden="true">500</div>
      <h3>Server error</h3>
      <p>Something went wrong on our end. Our team has been notified and is working on a fix. Please try again in a few moments.</p>
      <n-stack direction="row" gap="3">
        <n-button variant="primary" intent="accent" id="retry-btn">
          <span slot="label">Try Again</span>
        </n-button>
        <n-button>
          <n-icon name="house" slot="leading"></n-icon>
          <span slot="label">Go Home</span>
        </n-button>
      </n-stack>
    </div>
    </n-stack>

    <!-- -- Maintenance -- -->

    <n-stack gap="4">
    <h2>Maintenance</h2>
    <div class="error-page">
      <n-icon name="gear" size="xl" aria-hidden="true" style="color: var(--n-ink-muted-neutral); margin-bottom: 1rem;"></n-icon>
      <h3>We'll be back soon</h3>
      <p>We're performing scheduled maintenance to improve your experience. This usually takes less than 30 minutes. Thank you for your patience.</p>
      <n-button>
        <n-icon name="info" slot="leading"></n-icon>
        <span slot="label">Check Status</span>
      </n-button>
    </div>
    </n-stack>
    </n-stack>
  </main>
  <style is:global>
    .error-page {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 4rem 2rem;
      background: var(--n-body-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: 0.75rem;
      min-height: 20rem;
    }

    .error-code {
      font-size: 4.5rem;
      font-weight: 800;
      line-height: 1;
      color: var(--n-ink-muted-neutral);
      margin-bottom: 0.75rem;
      letter-spacing: -0.02em;
    }

    .error-page h3 {
      font-size: 1.25rem;
      font-weight: 700;
      margin: 0 0 0.5rem;
    }

    .error-page p {
      font-size: 0.875rem;
      color: var(--n-ink-muted-neutral);
      margin: 0 0 1.5rem;
      max-width: 28rem;
      line-height: 1.5;
    }

</style>

</SidebarLayout>
