---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Nav Header">
  <main>
<n-stack gap="6">
    <div>
      <h1>Top Navigation Bar</h1>
      <p style="color: var(--n-ink-muted-neutral); font-size: 0.875rem;">
        Horizontal application header with brand, navigation, search, and user controls.
        Demonstrates two layout variants: breadcrumb-centered and search-centered.
      </p>
    </div>

    <!-- -- With Breadcrumb -- -->

    <n-stack gap="4">
    <h2>With Breadcrumb Navigation</h2>
    <nav class="nav-bar" aria-label="Main navigation">
      <div class="nav-brand">
        <n-icon name="house" aria-hidden="true" style="color: var(--n-ink-strong-accent);"></n-icon>
        Acme Inc
      </div>

      <n-divider orientation="vertical"></n-divider>

      <div class="nav-center">
        <n-breadcrumb size="sm">
          <n-breadcrumb-item href="/">Dashboard</n-breadcrumb-item>
          <n-breadcrumb-item href="/projects">Projects</n-breadcrumb-item>
          <n-breadcrumb-item current>Alpha</n-breadcrumb-item>
        </n-breadcrumb>
      </div>

      <div class="nav-actions">
        <n-button variant="ghost" size="sm" aria-label="Search">
          <n-icon name="magnifying-glass"></n-icon>
        </n-button>
        <div class="icon-badge-wrapper">
          <n-button variant="ghost" size="sm" aria-label="Notifications">
            <n-icon name="bell"></n-icon>
          </n-button>
          <n-badge intent="danger" floating>3</n-badge>
        </div>
        <n-divider orientation="vertical"></n-divider>
        <div class="nav-user">
          <n-avatar name="Kim Granlund" size="sm"></n-avatar>
          <span class="nav-user-name">Kim Granlund</span>
          <n-icon name="caret-down" aria-hidden="true" style="color: var(--n-ink-muted-neutral);"></n-icon>
        </div>
      </div>
    </nav>
    </n-stack>

    <!-- -- With Search Input -- -->

    <n-stack gap="4">
    <h2>With Search Input</h2>
    <nav class="nav-bar" aria-label="Main navigation with search">
      <div class="nav-brand">
        <n-icon name="house" aria-hidden="true" style="color: var(--n-ink-strong-accent);"></n-icon>
        Acme Inc
      </div>

      <n-divider orientation="vertical"></n-divider>

      <div class="nav-center">
        <div class="search-input-wrapper">
          <n-input size="sm" placeholder="Search projects, people, tasks...">
            <n-icon name="magnifying-glass" slot="leading"></n-icon>
          </n-input>
        </div>
      </div>

      <div class="nav-actions">
        <div class="icon-badge-wrapper">
          <n-button variant="ghost" size="sm" aria-label="Notifications">
            <n-icon name="bell"></n-icon>
          </n-button>
          <n-badge intent="danger" floating>3</n-badge>
        </div>
        <n-divider orientation="vertical"></n-divider>
        <div class="nav-user">
          <n-avatar name="Kim Granlund" size="sm"></n-avatar>
          <span class="nav-user-name">Kim Granlund</span>
          <n-icon name="caret-down" aria-hidden="true" style="color: var(--n-ink-muted-neutral);"></n-icon>
        </div>
      </div>
    </nav>
    </n-stack>

    <!-- -- Compact Variant -- -->

    <n-stack gap="4">
    <h2>Compact (density)</h2>
    <nav class="nav-bar" aria-label="Compact navigation" density="compact">
      <div class="nav-brand">
        <n-icon name="house" aria-hidden="true" style="color: var(--n-ink-strong-accent);"></n-icon>
        Acme Inc
      </div>

      <n-divider orientation="vertical"></n-divider>

      <div class="nav-center">
        <n-breadcrumb size="sm">
          <n-breadcrumb-item href="/">Dashboard</n-breadcrumb-item>
          <n-breadcrumb-item current>Overview</n-breadcrumb-item>
        </n-breadcrumb>
      </div>

      <div class="nav-actions">
        <n-button variant="ghost" size="sm" aria-label="Search">
          <n-icon name="magnifying-glass"></n-icon>
        </n-button>
        <div class="icon-badge-wrapper">
          <n-button variant="ghost" size="sm" aria-label="Notifications">
            <n-icon name="bell"></n-icon>
          </n-button>
          <n-badge intent="danger" floating>3</n-badge>
        </div>
        <n-divider orientation="vertical"></n-divider>
        <div class="nav-user">
          <n-avatar name="Kim Granlund" size="xs"></n-avatar>
        </div>
      </div>
    </nav>
    </n-stack>
    </n-stack>
  </main>
  <style is:global>
    .nav-bar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 1rem;
      background: var(--n-body-neutral);
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: var(--n-radius);
      min-height: 3rem;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 700;
      font-size: 0.9375rem;
      white-space: nowrap;
      flex-shrink: 0;
    }


    .nav-center {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 0;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      flex-shrink: 0;
    }

    .nav-user {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding-inline-start: 0.25rem;
      cursor: default;
    }

    .nav-user-name {
      font-size: 0.8125rem;
      font-weight: 600;
      white-space: nowrap;
    }

    .icon-badge-wrapper {
      position: relative;
      display: inline-flex;
    }

    .search-input-wrapper {
      max-width: 20rem;
      width: 100%;
    }
</style>

</SidebarLayout>
