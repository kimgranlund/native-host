---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Form Contact">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Contact Us</h1>
      </div>
    </div>
    <div data-slot="description">

      Have a question or feedback? Fill out the form below and we'll get back to you within 24 hours.

    </div>
  </header>
  <main>
<n-stack gap="6">

    <div class="form-wrapper">
      <n-card>
        <n-header>
          <span slot="label">Send us a message</span>
        </n-header>
        <n-body>
          <form id="contact-form">
            <n-stack gap="8">
              <n-field required>
                <label slot="label">Full name</label>
                <n-input placeholder="Jane Doe" name="name">
                  <n-icon name="user" slot="leading"></n-icon>
                </n-input>
              </n-field>

              <n-field required>
                <label slot="label">Email address</label>
                <n-input placeholder="you@example.com" name="email">
                  <n-icon name="envelope" slot="leading"></n-icon>
                </n-input>
                <span slot="description">We'll never share your email with anyone else.</span>
              </n-field>

              <n-field required>
                <label slot="label">Subject</label>
                <n-select name="subject" placeholder="Select a topic">
                  <n-button justify="spread">
                    <span slot="label">Select a topic</span>
                    <n-icon name="caret-up-down" slot="trailing"></n-icon>
                  </n-button>
                  <n-listbox popover="manual">
                    <n-option value="general">General Inquiry</n-option>
                    <n-option value="support">Technical Support</n-option>
                    <n-option value="sales">Sales</n-option>
                    <n-option value="partnership">Partnership</n-option>
                  </n-listbox>
                </n-select>
              </n-field>

              <n-field required>
                <label slot="label">Message</label>
                <n-textarea placeholder="Tell us how we can help..." rows="5" name="message" autogrow></n-textarea>
                <span slot="description">Minimum 20 characters.</span>
              </n-field>
            </n-stack>
          </form>
        </n-body>
        <n-footer>
          <n-button variant="ghost"><span slot="label">Cancel</span></n-button>
          <n-button variant="primary" intent="accent" type="submit" form="contact-form">
            <n-icon name="envelope" slot="leading"></n-icon>
            <span slot="label">Send Message</span>
          </n-button>
        </n-footer>
      </n-card>
    </div>
    </n-stack>
  </main>

  <script>
    document.addEventListener('astro:page-load', () => {
      const form = document.getElementById('contact-form');
      if (!form) return;
      form.addEventListener('submit', (e) => e.preventDefault());
    });
  </script>
  <style is:global>
    .form-wrapper {
      max-width: 36rem;
    }

    /* TODO(T0071): n-body needs padding attribute */
    .form-wrapper n-body {
      padding: 2.25rem;
    }

    /* TODO(T0071): n-field needs gap attribute */
    .form-wrapper n-field {
      gap: calc(var(--n-space) * 2);
    }
</style>

</SidebarLayout>
