---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Auth OTP">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>OTP Verification</h1>
      </div>
    </div>
    <div data-slot="description">

      6-digit one-time password verification step with resend and back link.

    </div>
  </header>
  <main>

    <!-- ── OTP Verification Card ── -->

    <h2>Enter Verification Code</h2>
    <div class="demo-section">
      <div class="auth-centered auth-centered-compact">
        <div class="auth-card-wrapper">
          <div class="auth-icon-circle">
            <n-icon name="shield-check" size="lg"></n-icon>
          </div>
          <p class="auth-heading">Enter verification code</p>
          <p class="auth-subheading">
            We sent a 6-digit code to <span class="auth-email-highlight">kim@example.com</span>. Enter it below to verify your identity.
          </p>
          <div class="auth-card">
            <n-card padding="relaxed">
              <section>
                <n-stack gap="8">
                  <form>
                    <n-stack gap="6">
                      <div class="otp-center">
                        <n-input-otp name="otp" length="6"></n-input-otp>
                      </div>
                      <n-button variant="primary" intent="accent" type="submit">
                        <span slot="label">Verify</span>
                      </n-button>
                    </n-stack>
                  </form>
                  <p class="auth-resend-text">
                    Didn't receive a code? <button class="auth-resend-link" type="button">Resend code</button>
                  </p>
                </n-stack>
              </section>
            </n-card>
          </div>
          <a href="#" class="auth-back-link">
            <n-icon name="arrow-left" size="sm"></n-icon>
            Back to sign in
          </a>
        </div>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('astro:page-load', () => {
      if (!document.querySelector('.otp-center')) return;
      for (const form of document.querySelectorAll('form')) {
        form.addEventListener('submit', (e) => e.preventDefault());
      }
    });
  </script>
  <style is:global>
    .auth-centered {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: calc(100vh - 8rem);
    }

    .auth-card-wrapper {
      width: 100%;
      max-width: 26rem;
    }

    .auth-card {
      padding: 2.25rem;
    }
    .auth-icon-circle {
      width: 3rem;
      height: 3rem;
      border-radius: 50%;
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
    }

    .auth-heading {
      text-align: center;
      margin-bottom: 0.25rem;
      font-size: 1.25rem;
      font-weight: 700;
    }

    .auth-subheading {
      text-align: center;
      color: var(--n-ink-muted-neutral);
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
      line-height: 1.5;
    }

    .auth-email-highlight {
      font-weight: 600;
      color: var(--n-ink-strong-neutral);
    }

    .auth-resend-text {
      text-align: center;
      font-size: 0.8125rem;
      color: var(--n-ink-muted-neutral);
    }

    .auth-resend-link {
      color: var(--n-ink-accent);
      text-decoration: none;
      font-weight: 500;
      cursor: pointer;
      background: none;
      border: none;
      font-size: inherit;
      padding: 0;
    }

    .auth-resend-link:hover {
      text-decoration: underline;
    }

    .auth-back-link {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      font-size: 0.8125rem;
      color: var(--n-ink-muted-neutral);
      text-decoration: none;
      margin-top: 1.5rem;
    }

    .auth-back-link:hover {
      color: var(--n-ink-neutral);
    }

    .auth-centered-compact {
      min-height: 32rem;
    }

    .otp-center {
      display: flex;
      justify-content: center;
    }
</style>

</SidebarLayout>
