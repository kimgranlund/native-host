                <n-table-cell>Admin</n-table-cell>
                <n-table-cell>
                  <n-stack direction="row" gap="2">
                    <n-button variant="ghost" size="xs" aria-label="Edit"><n-icon name="pencil-simple"></n-icon></n-button>
                    <n-button variant="ghost" size="xs" intent="danger" aria-label="Delete"><n-icon name="trash"></n-icon></n-button>
                  </n-stack>
                </n-table-cell>
              </n-table-row>
              <n-table-row>
