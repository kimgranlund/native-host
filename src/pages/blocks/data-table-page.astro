---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Data Table Page">
  <header>
    <div slot="title">
      <div slot="content">
        <h1>Users</h1>
      </div>
      <div slot="actions">
        <n-button variant="primary" intent="accent" size="md">
          <n-icon name="plus" slot="leading"></n-icon>
          <span>New User</span>
        </n-button>
      </div>
    </div>
    <div slot="description">

      Manage your team members and their account permissions.

    </div>
  </header>
  <section>
<n-stack gap="6">

    <!-- ── Table Card ── -->
    <n-container>
      <n-header>
        <nav><n-icon name="users"></n-icon></nav>
        <span>All Users</span>
      </n-header>

      <n-body>
        <!-- ── Toolbar ── -->
        <n-stack direction="row" gap="3" align="center" wrap>
          <div class="table-search-input"><n-input id="table-search" size="sm" placeholder="Search users...">
            <n-icon name="magnifying-glass" slot="leading"></n-icon>
          </n-input></div>
          <n-select id="table-status-filter" size="sm" placeholder="All statuses"
            options='[{"value":"all","label":"All Statuses"},{"value":"active","label":"Active"},{"value":"inactive","label":"Inactive"}]'>
          </n-select>
          <n-select id="table-role-filter" size="sm" placeholder="All roles"
            options='[{"value":"all","label":"All Roles"},{"value":"admin","label":"Admin"},{"value":"editor","label":"Editor"},{"value":"viewer","label":"Viewer"}]'>
