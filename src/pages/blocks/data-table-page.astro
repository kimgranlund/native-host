                    <n-button variant="ghost" size="xs" aria-label="Edit"><n-icon name="pencil-simple"></n-icon></n-button>
                    <n-button variant="ghost" size="xs" intent="danger" aria-label="Delete"><n-icon name="trash"></n-icon></n-button>
                  </n-stack>
                </n-table-cell>
              </n-table-row>
            </n-table-body>
          </n-table>
        </div>
      </n-body>

      <n-footer justify="between">
        <span class="demo-text-sm">Showing 1-10 of 87 users</span>
        <n-pagination total="9" value="1" size="sm"></n-pagination>
      </n-footer>
    </n-card>
    </n-stack>
  </main>
  <script>
    const table = document.getElementById('users-table');
    const body = table.querySelector('n-table-body');
    const columnMap = { name: 0, email: 1, role: 3 };

    table.addEventListener('native:table-sort', (e) => {
      const { column, direction } = e.detail;
      if (direction === 'none') return;

      const colIndex = columnMap[column];
      if (colIndex === undefined) return;

      const rows = [...body.querySelectorAll('n-table-row')];
      rows.sort((a, b) => {
        const aVal = a.querySelectorAll('n-table-cell')[colIndex].textContent.trim();
        const bVal = b.querySelectorAll('n-table-cell')[colIndex].textContent.trim();
        const cmp = aVal.localeCompare(bVal, undefined, { numeric: true });
        return direction === 'asc' ? cmp : -cmp;
      });
      for (const row of rows) body.appendChild(row);
    });
  </script>
  <style is:global>
    .table-scroll {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
</style>

</SidebarLayout>
