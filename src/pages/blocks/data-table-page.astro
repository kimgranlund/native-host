---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Data Table Page">
  <main>
<n-stack gap="6">

    <!-- ── Page Header ── -->
    <n-stack direction="row" align="center" justify="between" wrap gap="4">
      <n-stack gap="1">
        <h1>Users</h1>
        <p class="demo-desc">
          Manage your team members and their account permissions.
        </p>
      </n-stack>
      <n-button variant="primary" intent="accent" size="sm">
        <n-icon name="plus" slot="leading"></n-icon>
        <span slot="label">New User</span>
      </n-button>
    </n-stack>

    <!-- ── Table Card ── -->
    <n-card>
      <n-header>
        <n-icon name="users" slot="leading"></n-icon>
        <span slot="label">All Users</span>
      </n-header>

      <n-body>
        <!-- ── Toolbar ── -->
        <n-stack direction="row" gap="3" align="center" wrap>
          <n-input size="sm" placeholder="Search users..." style="flex: 1; min-width: 12rem;">
            <n-icon name="magnifying-glass" slot="leading"></n-icon>
          </n-input>
          <n-select size="sm" placeholder="All statuses"
            options='[{"value":"all","label":"All Statuses"},{"value":"active","label":"Active"},{"value":"inactive","label":"Inactive"}]'>
          </n-select>
          <n-select size="sm" placeholder="All roles"
            options='[{"value":"all","label":"All Roles"},{"value":"admin","label":"Admin"},{"value":"editor","label":"Editor"},{"value":"viewer","label":"Viewer"}]'>
          </n-select>
        </n-stack>

        <!-- ── Data Table ── -->
        <div class="table-scroll">
          <n-table id="users-table" style="grid-template-columns: 2fr 2fr 100px 100px 120px;">
            <n-table-head>
              <n-table-row>
                <n-table-header sortable column="name">Name</n-table-header>
                <n-table-header sortable column="email">Email</n-table-header>
                <n-table-header>Status</n-table-header>
                <n-table-header sortable column="role">Role</n-table-header>
                <n-table-header>Actions</n-table-header>
              </n-table-row>
            </n-table-head>
            <n-table-body>
