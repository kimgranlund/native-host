---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Nav Sidebar">
  <main>
<n-stack gap="6">
    <div>
      <h1>Application Sidebar</h1>
      <p class="demo-desc">
        Vertical navigation sidebar using <code>n-sidebar</code> with grouped nav items,
        collapsible sections, header with brand switcher, and user footer.
        Two variants: expanded and collapsed (icon-only).
      </p>
    </div>

    <!-- ── Full Sidebar ── -->

    <n-stack gap="4">
    <h2>Expanded</h2>
    <div class="sidebar-preview">
      <n-sidebar>
        <aside slot="sidebar">
          <n-sidebar-header>
            <n-sidebar-item>
              <span slot="icon" class="sidebar-demo-mark">N</span>
              <span slot="label">Native UI</span>
              <n-icon name="caret-up-down" slot="trailing"></n-icon>
            </n-sidebar-item>
            <n-sidebar-item>
              <span slot="icon"><n-icon name="magnifying-glass"></n-icon></span>
              <span slot="label">Search</span>
              <n-kbd slot="trailing"><n-icon name="command"></n-icon>K</n-kbd>
            </n-sidebar-item>
          </n-sidebar-header>

          <n-sidebar-content>
            <n-sidebar-nav value="/dashboard">
              <n-sidebar-nav-item value="/dashboard" aria-current="page">
                <n-icon name="house"></n-icon> Dashboard
              </n-sidebar-nav-item>

              <n-sidebar-group open>
                <n-sidebar-group-header><n-icon name="folder"></n-icon> Workspace</n-sidebar-group-header>
                <n-sidebar-nav-item value="/projects">Projects</n-sidebar-nav-item>
                <n-sidebar-nav-item value="/team">Team Members</n-sidebar-nav-item>
                <n-sidebar-nav-item value="/reports">Reports</n-sidebar-nav-item>
                <n-sidebar-nav-item value="/calendar">Calendar</n-sidebar-nav-item>
              </n-sidebar-group>

              <n-sidebar-group open>
                <n-sidebar-group-header><n-icon name="gear"></n-icon> Settings</n-sidebar-group-header>
                <n-sidebar-nav-item value="/general">General</n-sidebar-nav-item>
                <n-sidebar-nav-item value="/billing">Billing</n-sidebar-nav-item>
                <n-sidebar-nav-item value="/integrations">Integrations</n-sidebar-nav-item>
              </n-sidebar-group>
            </n-sidebar-nav>
          </n-sidebar-content>

          <n-sidebar-footer>
            <n-sidebar-item>
              <span slot="icon"><n-avatar name="Kim Granlund" size="xs" intent="accent"></n-avatar></span>
              <span slot="label">Kim Granlund</span>
              <n-icon name="caret-up-down" slot="trailing"></n-icon>
            </n-sidebar-item>
          </n-sidebar-footer>
        </aside>

        <div class="sidebar-main-area">
          <span class="demo-text-sm">Main content area</span>
        </div>
      </n-sidebar>
    </div>
    </n-stack>

    <!-- ── Collapsed Sidebar ── -->

    <n-stack gap="4">
    <h2>Collapsed (icon-only)</h2>
    <div class="sidebar-preview sidebar-preview-collapsed">
      <n-sidebar collapsed>
        <aside slot="sidebar">
          <n-sidebar-header>
            <n-sidebar-item>
              <span slot="icon" class="sidebar-demo-mark">N</span>
              <span slot="label">Native UI</span>
            </n-sidebar-item>
          </n-sidebar-header>

          <n-sidebar-content>
            <n-sidebar-nav value="/dashboard">
              <n-sidebar-nav-item value="/dashboard" aria-current="page">
                <n-icon name="house"></n-icon> Dashboard
              </n-sidebar-nav-item>
              <n-sidebar-nav-item value="/projects">
                <n-icon name="folder"></n-icon> Projects
              </n-sidebar-nav-item>
              <n-sidebar-nav-item value="/team">
                <n-icon name="users"></n-icon> Team
              </n-sidebar-nav-item>
              <n-sidebar-nav-item value="/reports">
                <n-icon name="chart-bar"></n-icon> Reports
              </n-sidebar-nav-item>
              <n-sidebar-nav-item value="/calendar">
                <n-icon name="calendar"></n-icon> Calendar
              </n-sidebar-nav-item>
              <n-sidebar-nav-item value="/settings">
                <n-icon name="gear"></n-icon> Settings
              </n-sidebar-nav-item>
            </n-sidebar-nav>
          </n-sidebar-content>

          <n-sidebar-footer>
            <n-sidebar-item>
              <span slot="icon"><n-avatar name="Kim Granlund" size="xs" intent="accent"></n-avatar></span>
              <span slot="label">Kim Granlund</span>
            </n-sidebar-item>
          </n-sidebar-footer>
        </aside>

        <div class="sidebar-main-area">
          <span class="demo-text-sm">Main content area</span>
        </div>
      </n-sidebar>
    </div>
    </n-stack>
    </n-stack>
  </main>
  <style is:global>
    .sidebar-preview {
      border: 1px solid var(--n-border-muted-neutral);
      border-radius: var(--n-radius);
      overflow: hidden;
      min-height: 32rem;
    }

    .sidebar-preview-collapsed {
      min-height: 28rem;
    }

    .sidebar-demo-mark {
      width: 1.5rem;
      height: 1.5rem;
      border-radius: 0.25rem;
      background: var(--n-surface-accent);
      color: var(--n-surface-ink-accent);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.75rem;
    }

    .sidebar-main-area {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--n-doc-neutral);
      padding: 1.5rem;
    }
</style>

</SidebarLayout>
