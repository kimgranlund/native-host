---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
import Logo from '../../components/Logo.astro';
---
<SidebarLayout title="Auth Register">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Sign Up</h1>
      </div>
    </div>
    <div data-slot="description">

      Registration form with name, email, password, confirmation, and terms acceptance.

    </div>
  </header>
  <main>

    <!-- ── Registration Form ── -->

    <h2>Create Account</h2>
    <div class="demo-section">
      <div class="auth-centered auth-centered-tall">
        <div class="auth-card-wrapper">
          <div class="auth-logo">
            <Logo size={40} />
          </div>
          <p class="auth-heading">Create your account</p>
          <p class="auth-subheading">Start your free 14-day trial, no credit card required</p>
          <div class="auth-card">
            <n-card>
              <n-stack gap="8">
                <form>
                  <n-stack gap="6">
                    <n-field required>
                      <label slot="label">Full name</label>
                      <n-input placeholder="Kim Granlund" name="name">
                        <n-icon name="user" slot="leading"></n-icon>
                      </n-input>
                    </n-field>
                    <n-field required>
                      <label slot="label">Email</label>
                      <n-input type="email" placeholder="kim@example.com" name="email">
                        <n-icon name="envelope" slot="leading"></n-icon>
                      </n-input>
                    </n-field>
                    <n-field required>
                      <label slot="label">Password</label>
                      <n-input type="password" placeholder="At least 8 characters" name="password">
                        <n-icon name="lock" slot="leading"></n-icon>
                      </n-input>
                      <span slot="description">Must contain at least 8 characters, one uppercase letter, and one number.</span>
                    </n-field>
                    <n-field required>
                      <label slot="label">Confirm password</label>
                      <n-input type="password" placeholder="Repeat your password" name="password_confirm">
                        <n-icon name="lock" slot="leading"></n-icon>
                      </n-input>
                    </n-field>
                    <n-checkbox name="terms" required>
                      <span class="terms-text">I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a></span>
                    </n-checkbox>
                    <n-button variant="primary" intent="accent" type="submit">
                      <span slot="label">Create Account</span>
                    </n-button>
                  </n-stack>
                </form>
                <n-divider>or continue with</n-divider>
                <div class="oauth-row">
                  <n-button>
                    <n-icon name="google-logo" slot="leading"></n-icon>
                    <span slot="label">Google</span>
                  </n-button>
                  <n-button>
                    <n-icon name="github-logo" slot="leading"></n-icon>
                    <span slot="label">GitHub</span>
                  </n-button>
                </div>
              </n-stack>
            </n-card>
          </div>
          <p class="auth-footer-text">
            Already have an account? <a href="#">Sign in</a>
          </p>
        </div>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('astro:page-load', () => {
      if (!document.querySelector('.terms-text')) return;
      for (const form of document.querySelectorAll('form')) {
        form.addEventListener('submit', (e) => e.preventDefault());
      }
    });
  </script>
  <style is:global>
    .auth-centered {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: calc(100vh - 8rem);
    }

    .auth-card-wrapper {
      width: 100%;
      max-width: 26rem;
    }

    .auth-card {
      padding: 2.25rem;
    }

    /* TODO(T0071): n-field needs gap attribute */
    .auth-card n-field {
      gap: calc(var(--n-space) * 2);
    }

    .auth-logo {
      display: flex;
      justify-content: center;
      margin-bottom: 1.5rem;
    }

    .auth-heading {
      text-align: center;
      margin-bottom: 0.25rem;
      font-size: 1.25rem;
      font-weight: 700;
    }

    .auth-subheading {
      text-align: center;
      color: var(--n-ink-muted-neutral);
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
    }

    .auth-footer-text {
      text-align: center;
      font-size: 0.8125rem;
      color: var(--n-ink-muted-neutral);
      margin-top: 1.5rem;
    }

    .auth-footer-text a {
      color: var(--n-ink-accent);
      text-decoration: none;
      font-weight: 500;
    }

    .auth-footer-text a:hover {
      text-decoration: underline;
    }

    .terms-text {
      font-size: 0.8125rem;
      color: var(--n-ink-muted-neutral);
    }

    .terms-text a {
      color: var(--n-ink-accent);
      text-decoration: none;
    }

    .terms-text a:hover {
      text-decoration: underline;
    }

    .oauth-row {
      display: flex;
      gap: calc(var(--n-space) * 3);
    }

    .oauth-row > * {
      flex: 1;
    }

    .auth-centered-tall {
      min-height: 48rem;
    }
</style>

</SidebarLayout>
