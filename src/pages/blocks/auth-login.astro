---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
import Logo from '../../components/Logo.astro';
---
<SidebarLayout title="Auth Login">
  <header>
    <div data-slot="title">
      <div data-slot="content">
        <h1>Sign In</h1>
      </div>
    </div>
    <div data-slot="description">

      Login block with provider login, centered card, and split layout variants.

    </div>
  </header>
  <main>

    <!-- ── Variant 1: Provider Login ── -->

    <h2>Provider Login</h2>
    <div class="demo-section">
      <div class="auth-centered auth-centered-tall">
        <div class="auth-card-wrapper">
          <div class="auth-logo">
            <Logo size={48} />
          </div>
          <p class="auth-heading">Log in to NativeUI</p>
          <div class="auth-provider-stack">
          <n-stack gap="4">
            <n-button variant="primary" intent="accent" size="lg">
              <n-icon name="google-logo" slot="leading"></n-icon>
              <span slot="label">Continue with Google</span>
            </n-button>
            <n-button size="lg">
              <n-icon name="envelope" slot="leading"></n-icon>
              <span slot="label">Continue with email</span>
            </n-button>
            <n-button size="lg">
              <n-icon name="shield-check" slot="leading"></n-icon>
              <span slot="label">Continue with SAML SSO</span>
            </n-button>
            <n-button size="lg">
              <n-icon name="lock" slot="leading"></n-icon>
              <span slot="label">Log in with passkey</span>
            </n-button>
          </n-stack>
          </div>
          <p class="auth-footer-text">
            Don't have an account? <a href="#">Sign up</a> or <a href="#">learn more</a>
          </p>
        </div>
      </div>
    </div>

    <!-- ── Variant 2: Centered Card ── -->

    <h2>Centered Card</h2>
    <div class="demo-section">
      <div class="auth-centered auth-centered-tall">
        <div class="auth-card-wrapper">
          <div class="auth-logo">
            <Logo size={40} />
          </div>
          <p class="auth-heading">Welcome back</p>
          <p class="auth-subheading">Sign in to your account to continue</p>
          <div class="auth-card">
            <n-card>
              <n-body>
                <n-stack gap="8">
                  <form>
                    <n-stack gap="6">
                      <n-field required>
                        <label slot="label">Email</label>
                        <n-input type="email" placeholder="kim@example.com" name="email">
                          <n-icon name="envelope" slot="leading"></n-icon>
                        </n-input>
                      </n-field>
                      <n-field required>
                        <label slot="label">Password</label>
                        <n-input type="password" placeholder="Enter your password" name="password">
                          <n-icon name="lock" slot="leading"></n-icon>
                        </n-input>
                      </n-field>
                      <div class="auth-row-between">
                        <n-checkbox name="remember">Remember me</n-checkbox>
                        <a href="#" class="auth-forgot-link">Forgot password?</a>
                      </div>
                      <n-button variant="primary" intent="accent" type="submit">
                        <span slot="label">Sign In</span>
                      </n-button>
                    </n-stack>
                  </form>
                  <n-divider>or continue with</n-divider>
                  <div class="oauth-row">
                    <n-button>
                      <n-icon name="google-logo" slot="leading"></n-icon>
                      <span slot="label">Google</span>
                    </n-button>
                    <n-button>
                      <n-icon name="github-logo" slot="leading"></n-icon>
                      <span slot="label">GitHub</span>
                    </n-button>
                  </div>
                </n-stack>
              </n-body>
            </n-card>
          </div>
          <p class="auth-footer-text">
            Don't have an account? <a href="#">Sign up</a>
          </p>
        </div>
      </div>
    </div>

    <!-- ── Variant 3: Split Layout ── -->

    <h2>Split Layout</h2>
    <div class="demo-section">
      <div class="auth-split auth-split-tall">
        <div class="auth-split-image">
          <n-stack align="center" gap="4">
            <Logo size={56} />
            <p class="auth-hero-tagline">Build something great.</p>
            <p class="demo-text auth-hero-subtitle">Trusted by over 10,000 teams worldwide.</p>
          </n-stack>
        </div>
        <div class="auth-split-form">
          <div class="auth-card-wrapper">
            <p class="auth-heading">Welcome back</p>
            <p class="auth-subheading">Sign in to your account to continue</p>
            <form>
              <n-stack gap="6">
                <n-field required>
                  <label slot="label">Email</label>
                  <n-input type="email" placeholder="kim@example.com" name="email">
                    <n-icon name="envelope" slot="leading"></n-icon>
                  </n-input>
                </n-field>
                <n-field required>
                  <label slot="label">Password</label>
                  <n-input type="password" placeholder="Enter your password" name="password">
                    <n-icon name="lock" slot="leading"></n-icon>
                  </n-input>
                </n-field>
                <div class="auth-row-between">
                  <n-checkbox name="remember">Remember me</n-checkbox>
                  <a href="#" class="auth-forgot-link">Forgot password?</a>
                </div>
                <n-button variant="primary" intent="accent" type="submit">
                  <span slot="label">Sign In</span>
                </n-button>
                <n-divider>or continue with</n-divider>
                <div class="oauth-row">
                  <n-button>
                    <n-icon name="google-logo" slot="leading"></n-icon>
                    <span slot="label">Google</span>
                  </n-button>
                  <n-button>
                    <n-icon name="github-logo" slot="leading"></n-icon>
                    <span slot="label">GitHub</span>
                  </n-button>
                </div>
              </n-stack>
            </form>
            <p class="auth-footer-text">
              Don't have an account? <a href="#">Sign up</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('astro:page-load', () => {
      if (!document.querySelector('.auth-split')) return;
      for (const form of document.querySelectorAll('form')) {
        form.addEventListener('submit', (e) => e.preventDefault());
      }
    });
  </script>
  <style is:global>
    /* ── Centered card variant ── */
    .auth-centered {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: calc(100vh - 8rem);
    }

    .auth-card-wrapper {
      width: 100%;
      max-width: 26rem;
    }

    .auth-card {
      padding: 2.25rem;
    }

    /* TODO(T0071): n-field needs gap attribute */
    .auth-card n-field {
      gap: calc(var(--n-space) * 2);
    }

    .auth-logo {
      display: flex;
      justify-content: center;
      margin-bottom: 1.5rem;
    }

    .auth-heading {
      text-align: center;
      margin-bottom: 0.25rem;
      font-size: 1.25rem;
      font-weight: 700;
    }

    .auth-subheading {
      text-align: center;
      color: var(--n-ink-muted-neutral);
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
    }

    .auth-footer-text {
      text-align: center;
      font-size: 0.8125rem;
      color: var(--n-ink-muted-neutral);
      margin-top: 1.5rem;
    }

    .auth-footer-text a {
      color: var(--n-ink-accent);
      text-decoration: none;
      font-weight: 500;
    }

    .auth-footer-text a:hover {
      text-decoration: underline;
    }

    .auth-row-between {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .auth-forgot-link {
      font-size: 0.8125rem;
      color: var(--n-ink-accent);
      text-decoration: none;
      font-weight: 500;
    }

    .auth-forgot-link:hover {
      text-decoration: underline;
    }

    .oauth-row {
      display: flex;
      gap: calc(var(--n-space) * 3);
    }

    .oauth-row > * {
      flex: 1;
    }

    /* ── Split layout variant ── */
    .auth-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: calc(100vh - 8rem);
    }

    @media (max-width: 48rem) {
      .auth-split {
        grid-template-columns: 1fr;
      }
      .auth-split-image {
        display: none;
      }
    }

    .auth-split-image {
      background: linear-gradient(135deg, var(--n-surface-accent), var(--n-surface-info));
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--n-surface-ink-accent);
      font-size: 1.125rem;
      font-weight: 600;
      padding: 2rem;
    }

    .auth-split-form {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .auth-split-form .auth-card-wrapper {
      max-width: 22rem;
      width: 100%;
    }

    .auth-split-form .auth-heading,
    .auth-split-form .auth-subheading,
    .auth-split-form .auth-footer-text {
      text-align: left;
    }

    .auth-centered-tall {
      min-height: 42rem;
    }

    .auth-split-tall {
      min-height: 36rem;
    }

    .auth-hero-tagline {
      font-size: 1.5rem;
    }

    .auth-hero-subtitle {
      opacity: 0.8;
    }

    /* Provider login */
    .auth-provider-stack {
      margin-top: 0.5rem;
    }
</style>

</SidebarLayout>
