---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
---
<SidebarLayout title="Form Checkout" panels={[]}>
  <main>
<n-stack gap="6">
    <div>
      <h1>Checkout</h1>
      <p class="demo-desc">
        Complete your purchase by filling in the details below.
      </p>
    </div>

    <form id="checkout-form">
      <div class="checkout-layout">
        <!-- ── Left Column: Shipping + Payment ── -->
        <n-stack gap="6">
          <!-- ── Shipping Information ── -->
          <n-card>
            <n-header>
              <n-icon name="package" slot="leading"></n-icon>
              <span slot="label">Shipping Information</span>
            </n-header>
            <n-body>
              <n-stack gap="6">
                <div class="grid-2">
                  <n-field required>
                    <label slot="label">First name</label>
                    <n-input placeholder="Jane" name="first_name"></n-input>
                  </n-field>
                  <n-field required>
                    <label slot="label">Last name</label>
                    <n-input placeholder="Doe" name="last_name"></n-input>
                  </n-field>
                </div>

                <n-field required>
                  <label slot="label">Street address</label>
                  <n-input placeholder="123 Main Street, Apt 4B" name="address">
                    <n-icon name="map-pin" slot="leading"></n-icon>
                  </n-input>
                </n-field>

                <div class="grid-3">
                  <n-field required>
                    <label slot="label">City</label>
                    <n-input placeholder="San Francisco" name="city"></n-input>
                  </n-field>
                  <n-field required>
                    <label slot="label">State</label>
                    <n-input placeholder="CA" name="state"></n-input>
                  </n-field>
                  <n-field required>
                    <label slot="label">ZIP code</label>
                    <n-input placeholder="94102" name="zip"></n-input>
                  </n-field>
                </div>

                <n-field required>
                  <label slot="label">Country</label>
                  <n-select name="country">
                    <n-button justify="spread">
                      <span slot="label">Select country</span>
                      <n-icon name="caret-up-down" slot="trailing"></n-icon>
                    </n-button>
                    <n-listbox popover="manual">
                      <n-option value="us">United States</n-option>
                      <n-option value="ca">Canada</n-option>
                      <n-option value="gb">United Kingdom</n-option>
                      <n-option value="de">Germany</n-option>
                      <n-option value="fr">France</n-option>
                      <n-option value="au">Australia</n-option>
                    </n-listbox>
                  </n-select>
                </n-field>
              </n-stack>
            </n-body>
          </n-card>

          <!-- ── Payment Method ── -->
          <n-card>
            <n-header>
              <n-icon name="credit-card" slot="leading"></n-icon>
              <span slot="label">Payment Method</span>
            </n-header>
            <n-body>
              <n-stack gap="6">
                <n-field>
                  <label slot="label">Payment type</label>
                  <n-radio-group name="payment_method" value="credit-card" orientation="horizontal">
                    <n-radio value="credit-card">Credit Card</n-radio>
                    <n-radio value="paypal">PayPal</n-radio>
                    <n-radio value="bank-transfer">Bank Transfer</n-radio>
                  </n-radio-group>
                </n-field>

                <n-field required>
                  <label slot="label">Card number</label>
                  <n-input placeholder="4242 4242 4242 4242" name="card_number">
                    <n-icon name="credit-card" slot="leading"></n-icon>
                  </n-input>
                </n-field>

                <div class="grid-2">
                  <n-field required>
                    <label slot="label">Expiry date</label>
                    <n-input placeholder="MM / YY" name="card_expiry"></n-input>
                  </n-field>
                  <n-field required>
                    <label slot="label">CVV</label>
                    <n-input placeholder="123" name="card_cvv"></n-input>
                  </n-field>
                </div>

                <n-field required>
                  <label slot="label">Name on card</label>
                  <n-input placeholder="Jane Doe" name="card_name"></n-input>
                </n-field>

                <n-checkbox name="save_card">Save card for future purchases</n-checkbox>
              </n-stack>
            </n-body>
          </n-card>
        </n-stack>

        <!-- ── Right Column: Order Summary ── -->
        <div>
          <n-card>
            <n-header>
              <n-icon name="receipt" slot="leading"></n-icon>
              <span slot="label">Order Summary</span>
            </n-header>
            <n-body>
              <n-stack gap="4">
                <div class="summary-line">
                  <div>
                    <span class="item-name">Wireless Headphones</span>
                    <span class="item-qty"> x 1</span>
                  </div>
                  <span class="item-price">$149.00</span>
                </div>
                <div class="summary-line">
                  <div>
                    <span class="item-name">USB-C Charging Cable</span>
                    <span class="item-qty"> x 2</span>
                  </div>
                  <span class="item-price">$25.98</span>
                </div>
                <div class="summary-line">
                  <div>
                    <span class="item-name">Protective Case</span>
                    <span class="item-qty"> x 1</span>
                  </div>
                  <span class="item-price">$29.99</span>
                </div>

                <n-divider></n-divider>

                <div class="summary-line">
                  <span class="checkout-label">Subtotal</span>
                  <span class="item-price">$204.97</span>
                </div>
                <div class="summary-line">
                  <span class="checkout-label">Shipping</span>
                  <span class="item-price">$9.99</span>
                </div>
                <div class="summary-line">
                  <span class="checkout-label">Tax</span>
                  <span class="item-price">$17.42</span>
                </div>

                <div class="summary-line total">
                  <span>Total</span>
                  <span class="item-price">$232.38</span>
                </div>
              </n-stack>
            </n-body>
            <n-footer justify="center">
              <n-stack gap="3" align="stretch">
                <n-button variant="primary" intent="accent" type="submit" form="checkout-form">
                  <n-icon name="shopping-cart" slot="leading"></n-icon>
                  <span slot="label">Place Order</span>
                </n-button>
                <p class="demo-caption checkout-secure-note">
                  Your payment information is encrypted and secure.
                </p>
              </n-stack>
            </n-footer>
          </n-card>
        </div>
      </div>
    </form>
    </n-stack>
  </main>

  <script>
    import { onPageLoad } from '../../scripts/on-page-load';

    onPageLoad('checkout-form', (form) => {
      form.addEventListener('submit', (e) => e.preventDefault());
    });
  </script>
  <style is:global>
    .checkout-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      max-width: 56rem;
    }

    @media (min-width: 48rem) {
      .checkout-layout {
        grid-template-columns: 1fr 20rem;
      }
    }

    .section-title {
      font-size: 0.875rem;
      font-weight: 600;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1rem;
    }

    @media (max-width: 30rem) {
      .grid-2,
      .grid-3 {
        grid-template-columns: 1fr;
      }
    }

    .summary-line {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.625rem 0;
      font-size: 0.875rem;
    }

    .summary-line.total {
      font-weight: 700;
      font-size: 1rem;
      border-top: 1px solid var(--n-border-muted-neutral);
      margin-top: 0.5rem;
      padding-top: 0.75rem;
    }

    .item-name {
      color: var(--n-ink-strong-neutral);
    }

    .item-price {
      font-weight: 500;
      font-variant-numeric: tabular-nums;
    }

    .item-qty {
      color: var(--n-ink-muted-neutral);
      font-size: 0.8125rem;
    }

    .checkout-label {
      color: var(--n-ink-muted-neutral);
    }

    .checkout-secure-note {
      text-align: center;
    }

    /* TODO(T0071): n-field needs gap attribute */
    .checkout-layout n-field {
      gap: calc(var(--n-space) * 2);
    }
</style>

</SidebarLayout>
