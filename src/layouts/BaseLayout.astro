---
import { parsePreferences } from '../lib/preferences';

interface Props {
  title: string;
}
const { title } = Astro.props;
const prefs = parsePreferences(Astro.cookies);
---
<!doctype html>
<html lang="en" style={prefs.colorScheme ? `color-scheme: ${prefs.colorScheme}` : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} — native-ui</title>
    <style is:global>
      @import '@nonoun/native-ui/css/foundation';
      @import '@nonoun/native-ui/css/components';
      @import '@nonoun/native-app/css';
    </style>
    <!-- One-time migration: copy localStorage prefs into cookies for SSR -->
    <script is:inline>
      try {
        var keys = ['nav-color-scheme', 'nav-sidebar-collapsed', 'nav-group-states', 'demo-show-code'];
        var needsMigration = false;
        for (var i = 0; i < keys.length; i++) {
          if (localStorage.getItem(keys[i]) && !document.cookie.includes(keys[i])) {
            needsMigration = true;
            break;
          }
        }
        if (needsMigration) {
          var exp = new Date(Date.now() + 365*864e5).toUTCString();
          for (var i = 0; i < keys.length; i++) {
            var v = localStorage.getItem(keys[i]);
            if (v) document.cookie = keys[i] + '=' + encodeURIComponent(v) + ';path=/;expires=' + exp + ';SameSite=Lax';
          }
          location.reload();
        }
      } catch(e) {}
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/icons';
      import '../scripts/setup';
    </script>
  </body>
</html>
