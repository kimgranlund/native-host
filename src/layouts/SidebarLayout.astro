---
import BaseLayout from './BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { sitemap, type PageEntry, type BadgeKind, getNewAndUpdatedPages, demoHighlights, caseStudyGroups, nativeGroups } from '../data/pages';
import { loadPreferences } from '../lib/preferences';
import { resolveUserTier, type Tier } from '../lib/permissions';

const badgeLabels: Record<BadgeKind, string> = { new: 'New', updated: 'Updated', recent: 'Recent' };
const badgeIntents: Record<BadgeKind, string> = { new: 'danger', updated: 'accent', recent: 'warning' };

interface Props {
  title: string;
}
const { title } = Astro.props;
const prefs = await loadPreferences(Astro.locals, Astro.cookies);
const user = Astro.locals.user;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const currentEntry = sitemap.find(e => e.path === currentPath);

// Resolve tier for admin sidebar visibility
let userTier: Tier | null = null;
if (user) {
  const orgId = (Astro.locals.session as Record<string, unknown>)?.activeOrganizationId as string | undefined;
  if (orgId) {
    userTier = await resolveUserTier(user.id, orgId);
  }
}
const showAdmin = userTier === 'owner' || userTier === 'admin';


// Group sitemap entries
const groups = new Map<string, PageEntry[]>();
for (const entry of sitemap) {
  if (!groups.has(entry.group)) groups.set(entry.group, []);
  groups.get(entry.group)!.push(entry);
}

const newAndUpdatedPages = getNewAndUpdatedPages();

// Group sitemap into section buckets
const caseStudyGroupEntries = caseStudyGroups
  .map(name => [name, groups.get(name) || []] as const)
  .filter(([, entries]) => entries.length > 0);

const nativeGroupEntries = nativeGroups
  .map(name => [name, groups.get(name) || []] as const)
  .filter(([, entries]) => entries.length > 0);

const otherEntries = groups.get('Other') || [];

const groupIcons: Record<string, string> = {
  'Pinned': 'star',
  'New & Updates': 'sparkle',
  'Demo Highlights': 'game-controller',
  'Agentic AI': 'robot',
  Traits: 'lightning',
  Gateways: 'plugs-connected',
  Controllers: 'sliders',
  Utilities: 'wrench',
  Blocks: 'squares-four',
  Components: 'cube',
  Containers: 'package',
  'Core Systems': 'cpu',
  Other: 'dots-three',
};
---
<BaseLayout title={title}>
  <style is:global>
    @import '../styles/global.css';
    @import '../styles/chrome.css';
    @import '../styles/content.css';
    @import '../styles/demo.css';
    @import '@nonoun/native-design/css';
  </style>

  <native-app id="layout-sidebar" collapsed={prefs.sidebarCollapsed ? '' : undefined} data-authenticated={user ? '' : undefined} style={prefs.sidebarWidth ? `--n-sidebar-width: ${prefs.sidebarWidth}` : undefined}>
    <n-sidebar slot="sidebar" transition:animate="none" style={!prefs.sidebarCollapsed && prefs.sidebarWidth ? `width: ${prefs.sidebarWidth}` : undefined}>
      <n-sidebar-header>
        <n-sidebar-item>
          <span class="nav-logo" slot="icon"><Logo /></span>
          <span slot="label">NativeUI</span>
          <n-icon name="caret-up-down" slot="trailing"></n-icon>
          <n-listbox popover="manual">
            <n-option-group>
              <n-option-group-header>Teams</n-option-group-header>
              <n-option value="native-ui" selected>
                <span class="nav-logo"><Logo size={16} /></span>
                NativeUI
              </n-option>
            </n-option-group>
            {showAdmin && (
              <n-option-group>
                <n-option-group-header>Admin</n-option-group-header>
                <n-option value="/admin/members"><n-icon name="users"></n-icon> Members</n-option>
                <n-option value="/admin/groups"><n-icon name="users-three"></n-icon> Groups</n-option>
                <n-option value="/admin/permissions"><n-icon name="shield-check"></n-icon> Permissions</n-option>
                <n-option value="/admin/content-types"><n-icon name="list-dashes"></n-icon> Content Types</n-option>
                <n-option value="/admin/registry/llm"><n-icon name="sparkle"></n-icon> LLM Registry</n-option>
                <n-option value="/admin/registry/connectors"><n-icon name="plug"></n-icon> Connectors</n-option>
              </n-option-group>
            )}
            <n-option-group>
              <n-option value="add-team"><n-icon name="plus"></n-icon> Add team</n-option>
            </n-option-group>
          </n-listbox>
        </n-sidebar-item>
        <n-sidebar-item>
          <span slot="icon"><n-icon name="magnifying-glass"></n-icon></span>
          <n-button
            justify="spread"
            id="nav-search-btn"
          >
            <n-icon name="magnifying-glass" slot="leading"></n-icon>
            <span slot="label">Search</span>
            <n-kbd slot="trailing"><n-icon name="command"></n-icon>K</n-kbd>
          </n-button>
        </n-sidebar-item>
      </n-sidebar-header>

      <n-sidebar-content>
        <n-sidebar-nav value={currentEntry?.path}>

          {/* ── PINNED ── */}
          {prefs.pinnedPages.length > 0 && (
            <>
              <n-sidebar-section-label>Pinned</n-sidebar-section-label>
              <n-sidebar-group open="" id="pinned-group">
                <n-sidebar-group-header>
                  <n-icon name="star"></n-icon>
                  Pinned
                </n-sidebar-group-header>
                {prefs.pinnedPages.map(path => {
                  const entry = sitemap.find(e => e.path === path);
                  if (!entry) return null;
                  return (
                    <n-sidebar-nav-item
                      value={entry.path}
                      aria-current={currentPath === entry.path ? 'page' : undefined}
                    >
                      {entry.title}
                    </n-sidebar-nav-item>
                  );
                })}
              </n-sidebar-group>
            </>
          )}

          {/* ── NEW & UPDATES ── */}
          {newAndUpdatedPages.length > 0 && (
            <>
              <n-sidebar-section-label>New & Updates</n-sidebar-section-label>
              <n-sidebar-group open={prefs.groupStates['New & Updates'] ?? true ? '' : undefined} data-has-badges="">
                <n-sidebar-group-header>
                  <n-icon name="sparkle"></n-icon>
                  New & Updates
                </n-sidebar-group-header>
                {newAndUpdatedPages.map(e => (
                  <n-sidebar-nav-item
                    value={e.path}
                    aria-current={currentPath === e.path ? 'page' : undefined}
                  >
                    {e.title}
                    {e.badge && <n-badge slot="trailing" size="xs" intent={badgeIntents[e.badge]}>{badgeLabels[e.badge]}</n-badge>}
                  </n-sidebar-nav-item>
                ))}
              </n-sidebar-group>
            </>
          )}

          {/* ── DEMO HIGHLIGHTS ── */}
          <n-sidebar-group open={prefs.groupStates['Demo Highlights'] ?? false ? '' : undefined}>
            <n-sidebar-group-header>
              <n-icon name="game-controller"></n-icon>
              Demo Highlights
            </n-sidebar-group-header>
            {demoHighlights.map(item => (
              <n-sidebar-nav-item
                value={item.path}
                aria-current={currentPath === item.path ? 'page' : undefined}
              >
                {item.title}
              </n-sidebar-nav-item>
            ))}
          </n-sidebar-group>

          {/* ── CASE STUDIES ── */}
          <n-sidebar-section-label>Case Studies</n-sidebar-section-label>
          {caseStudyGroupEntries.map(([groupName, entries]) => {
            const isOpen = prefs.groupStates[groupName] ?? false;
            return (
              <n-sidebar-group open={isOpen ? '' : undefined} data-has-badges={entries.some(e => e.badge) ? '' : undefined}>
                <n-sidebar-group-header>
                  <n-icon name={groupIcons[groupName] || 'compass'}></n-icon>
                  {groupName}
                </n-sidebar-group-header>
                {entries.map(e => (
                  <n-sidebar-nav-item
                    value={e.path}
                    aria-current={currentPath === e.path ? 'page' : undefined}
                  >
                    {e.title}
                    {e.badge && <n-badge slot="trailing" size="xs" intent={badgeIntents[e.badge]}>{badgeLabels[e.badge]}</n-badge>}
                  </n-sidebar-nav-item>
                ))}
              </n-sidebar-group>
            );
          })}

          {/* ── NATIVE ── */}
          <n-sidebar-section-label>Native</n-sidebar-section-label>
          {nativeGroupEntries.map(([groupName, entries]) => {
            const isOpen = prefs.groupStates[groupName] ?? (groupName === 'Components');
            return (
              <n-sidebar-group open={isOpen ? '' : undefined}>
                <n-sidebar-group-header>
                  <n-icon name={groupIcons[groupName] || 'compass'}></n-icon>
                  {groupName}
                </n-sidebar-group-header>
                {entries.map(e => (
                  <n-sidebar-nav-item
                    value={e.path}
                    aria-current={currentPath === e.path ? 'page' : undefined}
                  >
                    {e.title}
                  </n-sidebar-nav-item>
                ))}
              </n-sidebar-group>
            );
          })}

          {/* ── OTHER ── */}
          <n-sidebar-section-label>Other</n-sidebar-section-label>
          <n-sidebar-group open={prefs.groupStates['Other'] ?? false ? '' : undefined}>
            <n-sidebar-group-header>
              <n-icon name="dots-three"></n-icon>
              Other
            </n-sidebar-group-header>
            {otherEntries.map(e => (
              <n-sidebar-nav-item
                value={e.path}
                aria-current={currentPath === e.path ? 'page' : undefined}
              >
                {e.title}
              </n-sidebar-nav-item>
            ))}
          </n-sidebar-group>


        </n-sidebar-nav>
      </n-sidebar-content>

      <n-sidebar-footer>
        {user ? (
          <n-sidebar-item id="user-menu">
            <span slot="icon">
              {user.image
                ? <n-avatar size="xs"><img src={`/api/avatar/${user.id}`} alt={user.name || 'User'}></n-avatar>
                : <n-icon name="user-circle"></n-icon>}
            </span>
            <span slot="label">{user.name || user.email}</span>
            <n-icon name="caret-up-down" slot="trailing"></n-icon>
            <n-listbox popover="manual">
              <n-option-group>
                <n-option-group-header>Account</n-option-group-header>
                <n-option value="/account/profile"><n-icon name="gear"></n-icon> Settings</n-option>
              </n-option-group>
              <n-option-group>
                <n-option value="sign-out"><n-icon name="sign-out"></n-icon> Log out</n-option>
              </n-option-group>
            </n-listbox>
          </n-sidebar-item>
        ) : (
          <n-sidebar-item>
            <span slot="icon"><n-icon name="user-circle"></n-icon></span>
            <a href="/" slot="label" style="text-decoration:none;color:inherit">Sign In</a>
          </n-sidebar-item>
        )}
      </n-sidebar-footer>
    </n-sidebar>

    <section>
      <nav>
        <n-button
          variant="ghost"
          size="sm"
          aria-label="Toggle sidebar"
          id="sidebar-toggle"
        >
          <n-icon name="sidebar-simple" size="md" weight={prefs.sidebarCollapsed ? 'fill' : undefined}></n-icon>
        </n-button>

        <n-breadcrumb>
          {currentEntry ? (
            <>
              <n-breadcrumb-item>{currentEntry.group}</n-breadcrumb-item>
              <n-breadcrumb-item current>{currentEntry.title}</n-breadcrumb-item>
            </>
          ) : currentPath.startsWith('/admin/') ? (
            <>
              <n-breadcrumb-item>Admin</n-breadcrumb-item>
              <n-breadcrumb-item current>{title}</n-breadcrumb-item>
            </>
          ) : currentPath.startsWith('/account/') ? (
            <>
              <n-breadcrumb-item>Account</n-breadcrumb-item>
              <n-breadcrumb-item current>{title.replace(/ - Settings$/, '')}</n-breadcrumb-item>
            </>
          ) : (
            <n-breadcrumb-item current>Home</n-breadcrumb-item>
          )}
        </n-breadcrumb>

        <aside style="display:flex;align-items:center;gap:0.125rem">
          {currentEntry && (
            <n-button variant="ghost" size="sm" aria-label="Pin page" id="pin-toggle" data-path={currentEntry.path}>
              <n-icon name="star" size="md" weight={prefs.pinnedPages.includes(currentEntry.path) ? 'fill' : undefined}></n-icon>
            </n-button>
          )}
          <n-button variant="ghost" size="sm" aria-label="Toggle inspector" id="inspector-toggle">
            <n-icon name="sliders-horizontal" size="md"></n-icon>
          </n-button>
          <n-button variant="ghost" size="sm" aria-label="Toggle chat" id="chat-toggle">
            <n-icon name="chat-dots" size="md"></n-icon>
          </n-button>
          <n-button variant="ghost" size="sm" aria-label="Toggle source code" id="code-toggle" disabled>
            <n-icon name="code" size="md"></n-icon>
          </n-button>
          <n-button variant="ghost" size="sm" aria-label="Toggle color scheme" id="theme-toggle">
            <n-icon name={prefs.colorScheme === 'dark' ? 'sun' : 'moon'} size="md"></n-icon>
          </n-button>
        </aside>
      </nav>

      <section class="content">
        <main transition:animate="fade">
          <slot />
        </main>
        <n-gripper mode="resize-horizontal" for="inspector-panel" placement="start" min="280" max="480" reverse></n-gripper>
        <n-aside id="inspector-panel">
          <native-design-panel aside></native-design-panel>
        </n-aside>
        <n-gripper mode="resize-horizontal" for="chat-panel" placement="start" min="280" max="480" reverse></n-gripper>
        <n-aside id="chat-panel">
          <native-chat-panel aside gateway="claude" gateway-url="/api/anthropic" model="claude-haiku-4-5-20251001" models="claude-haiku-4-5-20251001,claude-sonnet-4-6-20250514,claude-opus-4-20250514,gpt-4.1-nano,gpt-4.1-mini,gpt-4.1,o3-mini,o3,o4-mini" gateway-urls='{"claude":"/api/anthropic","openai":"/api/openai"}'></native-chat-panel>
        </n-aside>
      </section>
    </section>
  </native-app>

  <n-dialog id="nav-cmd-dialog" transition:animate="none">
    <div class="nav-cmd-wrap"><n-command>
      <n-command-input>
        <n-icon name="magnifying-glass"></n-icon>
        <input type="text" placeholder="Search pages..." />
      </n-command-input>
      <n-command-list>
        {[...groups.entries()].map(([groupName, entries]) => (
          <n-command-group>
            <div slot="heading">{groupName}</div>
            {entries.map(entry => (
              <n-command-item value={entry.path} keywords={entry.group}>
                {entry.title}
              </n-command-item>
            ))}
          </n-command-group>
        ))}
      </n-command-list>
      <n-command-empty>No pages found.</n-command-empty>
    </n-command></div>
  </n-dialog>

  <script is:inline type="application/json" id="sitemap-data" set:html={JSON.stringify(sitemap.map(e => ({ path: e.path, title: e.title, group: e.group })))}></script>

  <script>
    import '../scripts/layout.ts';
  </script>
</BaseLayout>
